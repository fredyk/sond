// Self-test for the X25519 library: includes it and checks RFC 7748 5.2 vector 1.

include "any/crypto/dh/x25519.snd"

fn test_field_ops() -> i64 {
    let mut all_pass = 1
    let mut a[32]; x25_fe_copy(a, x25_A_LIMBS)
    let mut b[32]; x25_fe_copy(b, x25_B_LIMBS)
    let mut c[32]; let mut ok = 1; let mut i = 0

    x25_fe_add(c, a, b)
    ok = 1; i = 0
    for i < 32 { if c[i] != x25_ADD_EXP[i] { ok = 0 }; i = i + 1 }
    if ok != 0 { print("x25_fe_add MATCH") } else { print("x25_fe_add FAIL"); all_pass = 0 }

    x25_fe_sub(c, a, b)
    ok = 1; i = 0
    for i < 32 { if c[i] != x25_SUB_EXP[i] { ok = 0 }; i = i + 1 }
    if ok != 0 { print("x25_fe_sub MATCH") } else { print("x25_fe_sub FAIL"); all_pass = 0 }

    x25_fe_mul(c, a, b)
    ok = 1; i = 0
    for i < 32 { if c[i] != x25_MUL_EXP[i] { ok = 0 }; i = i + 1 }
    if ok != 0 { print("x25_fe_mul MATCH") } else { print("x25_fe_mul FAIL"); all_pass = 0 }

    x25_fe_sq(c, a)
    ok = 1; i = 0
    for i < 32 { if c[i] != x25_SQ_EXP[i] { ok = 0 }; i = i + 1 }
    if ok != 0 { print("x25_fe_sq MATCH") } else { print("x25_fe_sq FAIL"); all_pass = 0 }

    x25_fe_invert(c, a)
    ok = 1; i = 0
    for i < 32 { if c[i] != x25_INV_EXP[i] { ok = 0 }; i = i + 1 }
    if ok != 0 { print("fe_inv MATCH") } else { print("fe_inv FAIL"); all_pass = 0 }

    let mut inv_a[32]; x25_fe_copy(inv_a, c)
    x25_fe_mul(c, a, inv_a)
    let mut one[32]; x25_fe_one(one)
    ok = 1; i = 0
    for i < 32 { if c[i] != one[i] { ok = 0 }; i = i + 1 }
    if ok != 0 { print("a*inv(a)=1 MATCH") } else { print("a*inv(a)=1 FAIL"); all_pass = 0 }

    let mut pm1[32]
    pm1[0] = 0xEC
    i = 1
    for i < 31 { pm1[i] = 0xFF; i = i + 1 }
    pm1[31] = 0x7F
    x25_fe_sq(c, pm1)
    ok = 1; i = 0
    for i < 32 { if c[i] != one[i] { ok = 0 }; i = i + 1 }
    if ok != 0 { print("(p-1)^2=1 MATCH") } else { print("(p-1)^2=1 FAIL"); all_pass = 0 }

    if all_pass != 0 { print("All field ops PASS") } else { print("Field ops FAILED") }
    all_pass
}

// ── RFC 7748 §5.2 Test Vectors ──

let SCALAR_VEC[32] = [
    0xa5, 0x46, 0xe3, 0x6b, 0xf0, 0x52, 0x7c, 0x9d,
    0x3b, 0x16, 0x15, 0x4b, 0x82, 0x46, 0x5e, 0xdd,
    0x62, 0x14, 0x4c, 0x0a, 0xc1, 0xfc, 0x5a, 0x18,
    0x50, 0x6a, 0x22, 0x44, 0xba, 0x44, 0x9a, 0xc4
]

let U_VEC[32] = [
    0xe6, 0xdb, 0x68, 0x67, 0x58, 0x30, 0x30, 0xdb,
    0x35, 0x94, 0xc1, 0xa4, 0x24, 0xb1, 0x5f, 0x7c,
    0x72, 0x66, 0x24, 0xec, 0x26, 0xb3, 0x35, 0x3b,
    0x10, 0xa9, 0x03, 0xa6, 0xd0, 0xab, 0x1c, 0x4c
]

let EXPECTED_VEC[32] = [
    0xc3, 0xda, 0x55, 0x37, 0x9d, 0xe9, 0xc6, 0x90,
    0x8e, 0x94, 0xea, 0x4d, 0xf2, 0x8d, 0x08, 0x4f,
    0x32, 0xec, 0xcf, 0x03, 0x49, 0x1c, 0x71, 0xf7,
    0x54, 0xb4, 0x07, 0x55, 0x77, 0xa2, 0x85, 0x52
]

fn main() -> i64 {
    print("=== X25519 RFC 7748 self-test (x25519(ptr) library) ===")

    if test_field_ops() == 0 {
        print("ABORT: field ops failed")
        return 1
    }

    print("=== RFC 7748 §5.2 Test Vector 1 ===")

    // build packed-byte scalar/u from the module-level word-per-byte vectors
    let scalar_b[4]
    let u_b[4]
    i = 0
    for i < 32 {
        poke8(scalar_b + i, SCALAR_VEC[i])
        poke8(u_b + i, U_VEC[i])
        i = i + 1
    }

    // call the LIBRARY function with packed-byte buffers (peek8/poke8 convention)
    let out_bytes[4]
    x25519(scalar_b, u_b, out_bytes)

    // print output bytes (each 0-255) via peek8
    print("output bytes: ")
    i = 0
    for i < 32 {
        print_int(peek8(out_bytes + i))
        if i < 31 { print(" ") }
        i = i + 1
    }
    print("")

    // print expected bytes (each 0-255)
    print("expected bytes: ")
    i = 0
    for i < 32 {
        print_int(EXPECTED_VEC[i])
        if i < 31 { print(" ") }
        i = i + 1
    }
    print("")

    // compare word-by-word
    let mut ok = 1
    let mut i = 0
    for i < 32 {
        if peek8(out_bytes + i) != EXPECTED_VEC[i] {
            ok = 0
        }
        i = i + 1
    }

    if ok != 0 {
        print("PASS: output matches RFC 7748 test vector 1")
        0
    } else {
        print("FAIL")
        1
    }
}
