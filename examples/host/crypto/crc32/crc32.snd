fn main() -> i64 {
    let mut crc: i64 = 0xFFFFFFFF
    let data = "123456789"
    let len = 9

    // We need to iterate over bytes. Since we can't index strings directly,
    // we use character literals for '1' through '9'
    // '1'=49, '2'=50, '3'=51, '4'=52, '5'=53, '6'=54, '7'=55, '8'=56, '9'=57

    let mut i: i64 = 0
    for i < 9 {
        let byte: i64 = if i == 0 { 49 } else if i == 1 { 50 } else if i == 2 { 51 } else if i == 3 { 52 } else if i == 4 { 53 } else if i == 5 { 54 } else if i == 6 { 55 } else if i == 7 { 56 } else { 57 }

        crc = crc ^ byte

        let mut j: i64 = 0
        for j < 8 {
            if crc & 1 == 1 {
                crc = (crc >> 1) ^ 0xEDB88320
            } else {
                crc = crc >> 1
            }
            crc = crc & 0xFFFFFFFF
            j = j + 1
        }

        crc = crc & 0xFFFFFFFF
        i = i + 1
    }

    crc = crc ^ 0xFFFFFFFF
    crc = crc & 0xFFFFFFFF

    print_int(crc)
    0
}
