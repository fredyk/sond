// Self-test: ed25519_sign_h signs a 32-byte message (the KEX-hash use case) and
// matches a Python (cryptography) Ed25519 signature.

include "any/crypto/sign/ed25519-sign.snd"

fn main() -> i64 {
    let SK[4]
    poke8(SK + 0, 0x9d)
    poke8(SK + 1, 0x61)
    poke8(SK + 2, 0xb1)
    poke8(SK + 3, 0x9d)
    poke8(SK + 4, 0xef)
    poke8(SK + 5, 0xfd)
    poke8(SK + 6, 0x5a)
    poke8(SK + 7, 0x60)
    poke8(SK + 8, 0xba)
    poke8(SK + 9, 0x84)
    poke8(SK + 10, 0x4a)
    poke8(SK + 11, 0xf4)
    poke8(SK + 12, 0x92)
    poke8(SK + 13, 0xec)
    poke8(SK + 14, 0x2c)
    poke8(SK + 15, 0xc4)
    poke8(SK + 16, 0x44)
    poke8(SK + 17, 0x49)
    poke8(SK + 18, 0xc5)
    poke8(SK + 19, 0x69)
    poke8(SK + 20, 0x7b)
    poke8(SK + 21, 0x32)
    poke8(SK + 22, 0x69)
    poke8(SK + 23, 0x19)
    poke8(SK + 24, 0x70)
    poke8(SK + 25, 0x3b)
    poke8(SK + 26, 0xac)
    poke8(SK + 27, 0x03)
    poke8(SK + 28, 0x1c)
    poke8(SK + 29, 0xae)
    poke8(SK + 30, 0x7f)
    poke8(SK + 31, 0x60)
    let H[4]
    poke8(H + 0, 0x00)
    poke8(H + 1, 0x01)
    poke8(H + 2, 0x02)
    poke8(H + 3, 0x03)
    poke8(H + 4, 0x04)
    poke8(H + 5, 0x05)
    poke8(H + 6, 0x06)
    poke8(H + 7, 0x07)
    poke8(H + 8, 0x08)
    poke8(H + 9, 0x09)
    poke8(H + 10, 0x0a)
    poke8(H + 11, 0x0b)
    poke8(H + 12, 0x0c)
    poke8(H + 13, 0x0d)
    poke8(H + 14, 0x0e)
    poke8(H + 15, 0x0f)
    poke8(H + 16, 0x10)
    poke8(H + 17, 0x11)
    poke8(H + 18, 0x12)
    poke8(H + 19, 0x13)
    poke8(H + 20, 0x14)
    poke8(H + 21, 0x15)
    poke8(H + 22, 0x16)
    poke8(H + 23, 0x17)
    poke8(H + 24, 0x18)
    poke8(H + 25, 0x19)
    poke8(H + 26, 0x1a)
    poke8(H + 27, 0x1b)
    poke8(H + 28, 0x1c)
    poke8(H + 29, 0x1d)
    poke8(H + 30, 0x1e)
    poke8(H + 31, 0x1f)
    let EXP[8]
    poke8(EXP + 0, 0x00)
    poke8(EXP + 1, 0xc1)
    poke8(EXP + 2, 0xdb)
    poke8(EXP + 3, 0x98)
    poke8(EXP + 4, 0x8b)
    poke8(EXP + 5, 0xb1)
    poke8(EXP + 6, 0x2f)
    poke8(EXP + 7, 0xd7)
    poke8(EXP + 8, 0x35)
    poke8(EXP + 9, 0x1a)
    poke8(EXP + 10, 0x60)
    poke8(EXP + 11, 0x54)
    poke8(EXP + 12, 0xae)
    poke8(EXP + 13, 0x3f)
    poke8(EXP + 14, 0xac)
    poke8(EXP + 15, 0x90)
    poke8(EXP + 16, 0xfa)
    poke8(EXP + 17, 0xb7)
    poke8(EXP + 18, 0xe4)
    poke8(EXP + 19, 0xfc)
    poke8(EXP + 20, 0x56)
    poke8(EXP + 21, 0xb1)
    poke8(EXP + 22, 0x65)
    poke8(EXP + 23, 0x1c)
    poke8(EXP + 24, 0x71)
    poke8(EXP + 25, 0x81)
    poke8(EXP + 26, 0xf5)
    poke8(EXP + 27, 0xf5)
    poke8(EXP + 28, 0x5f)
    poke8(EXP + 29, 0x89)
    poke8(EXP + 30, 0x6f)
    poke8(EXP + 31, 0x66)
    poke8(EXP + 32, 0x39)
    poke8(EXP + 33, 0x33)
    poke8(EXP + 34, 0xd3)
    poke8(EXP + 35, 0xa9)
    poke8(EXP + 36, 0x06)
    poke8(EXP + 37, 0x05)
    poke8(EXP + 38, 0xd9)
    poke8(EXP + 39, 0x05)
    poke8(EXP + 40, 0x8e)
    poke8(EXP + 41, 0x9d)
    poke8(EXP + 42, 0x0a)
    poke8(EXP + 43, 0xc4)
    poke8(EXP + 44, 0x59)
    poke8(EXP + 45, 0x50)
    poke8(EXP + 46, 0xee)
    poke8(EXP + 47, 0x2d)
    poke8(EXP + 48, 0x3c)
    poke8(EXP + 49, 0x9c)
    poke8(EXP + 50, 0x9b)
    poke8(EXP + 51, 0x14)
    poke8(EXP + 52, 0x85)
    poke8(EXP + 53, 0x74)
    poke8(EXP + 54, 0x15)
    poke8(EXP + 55, 0x58)
    poke8(EXP + 56, 0x71)
    poke8(EXP + 57, 0x79)
    poke8(EXP + 58, 0xfe)
    poke8(EXP + 59, 0x0c)
    poke8(EXP + 60, 0xca)
    poke8(EXP + 61, 0xc3)
    poke8(EXP + 62, 0x5f)
    poke8(EXP + 63, 0x09)
    let sig[8]
    ed25519_sign_h(SK, H, sig)
    if bytes_cmp(sig, EXP, 64) == 1 {
        print("PASS: ed25519_sign_h matches Python reference")
        0
    } else {
        print("FAIL")
        1
    }
}
