// Self-test for the SHA-256 library: includes it and checks FIPS 180-4 vectors.

include "any/crypto/hash/sha256.snd"

fn hex_digit(v: i64) -> i64 {
    if v < 10 { 48 + v } else { 87 + v }
}

fn print_hash(out: i64) {
    let mut i = 0
    for i < 32 {
        let b = peek8(out + i)
        print_char(hex_digit((b >> 4) & 0xF))
        print_char(hex_digit(b & 0xF))
        i = i + 1
    }
    print("")
}

fn words_match(hash: i64, exp: i64) -> i64 {
    let mut i = 0
    for i < 8 {
        let b0 = peek8(hash + i * 4)
        let b1 = peek8(hash + i * 4 + 1)
        let b2 = peek8(hash + i * 4 + 2)
        let b3 = peek8(hash + i * 4 + 3)
        let word = (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
        if word != peek64(exp + i * 8) { return 0 }
        i = i + 1
    }
    1
}

fn test_vector(msg: i64, len: i64, exp: i64) -> i64 {
    let hash[32]
    sha256_hash(msg, len, hash)
    if words_match(hash, exp) == 0 {
        print_hash(hash)
        return 0
    }
    1
}

fn main() -> i64 {
    let msg_abc[1]
    poke8(msg_abc, 0x61)
    poke8(msg_abc + 1, 0x62)
    poke8(msg_abc + 2, 0x63)

    let msg_a100[13]
    let mut j = 0
    for j < 100 {
        poke8(msg_a100 + j, 0x61)
        j = j + 1
    }

    if test_vector(0, 0, EXP_EMPTY) != 0 {
        print("PASS: empty string")
    } else {
        print("FAIL: empty string")
        return 1
    }

    if test_vector(msg_abc, 3, EXP_ABC) != 0 {
        print("PASS: abc")
    } else {
        print("FAIL: abc")
        return 1
    }

    if test_vector(msg_a100, 100, EXP_A100) != 0 {
        print("PASS: a*100")
    } else {
        print("FAIL: a*100")
        return 1
    }

    print("All tests passed")
    0
}