// Self-test for Ed25519 scalar arithmetic mod L (sc_reduce, sc_muladd).

include "any/crypto/scalar/ed25519-scalar.snd"

fn main() -> i64 {
    let buf[24]
    let out[8]
    let mut failures = 0
    let mut passed = 0
    let mut total = 6

    if test_reduce(1, inp1, exp1, buf, out) != 0 {
        passed = passed + 1
    } else {
        failures = failures + 1
    }
    if test_reduce(2, inp2, exp2, buf, out) != 0 {
        passed = passed + 1
    } else {
        failures = failures + 1
    }
    if test_reduce(3, inp3, exp3, buf, out) != 0 {
        passed = passed + 1
    } else {
        failures = failures + 1
    }
    if test_muladd(4, a4, b4, c4, exp4, buf, out) != 0 {
        passed = passed + 1
    } else {
        failures = failures + 1
    }
    if test_muladd(5, a5, b5, c5, exp5, buf, out) != 0 {
        passed = passed + 1
    } else {
        failures = failures + 1
    }
    if test_muladd(6, a6, b6, c6, exp6, buf, out) != 0 {
        passed = passed + 1
    } else {
        failures = failures + 1
    }

    print_int(passed)
    print("/")
    print_int(total)
    print(" passed")
    if failures == 0 {
        print("ALL PASS")
    } else {
        print("SOME FAILED")
    }
    return failures
}