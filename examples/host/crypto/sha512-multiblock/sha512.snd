    0x28db77f523047d84, 0x32caab7b40c72493, 0x3c9ebe0a15c9bebc, 0x431d67c49c100d4c,
    0x4cc5d4becb3e42b6, 0x597f299cfc657e2a, 0x5fcb6fab3ad6faec, 0x6c44198c4a475817
]

let mut H0 = 0
let mut H1 = 0
let mut H2 = 0
let mut H3 = 0
let mut H4 = 0
let mut H5 = 0
let mut H6 = 0
let mut H7 = 0

fn rot_r(x: i64, n: i64) -> i64 {
    (x >>> n) | (x << (64 - n))
}

fn ch(x: i64, y: i64, z: i64) -> i64 {
    (x & y) ^ ((~x) & z)
}

fn maj(x: i64, y: i64, z: i64) -> i64 {
    (x & y) ^ (x & z) ^ (y & z)
}

fn sigma0(x: i64) -> i64 {
    rot_r(x, 1) ^ rot_r(x, 8) ^ (x >>> 7)
}

fn sigma1(x: i64) -> i64 {
    rot_r(x, 19) ^ rot_r(x, 61) ^ (x >>> 6)
}

fn Sig0(x: i64) -> i64 {
    rot_r(x, 28) ^ rot_r(x, 34) ^ rot_r(x, 39)
}

fn Sig1(x: i64) -> i64 {
    rot_r(x, 14) ^ rot_r(x, 18) ^ rot_r(x, 41)
}

fn be_load64(p: i64) -> i64 {
    let b0 = peek8(p)
    let b1 = peek8(p + 1)
    let b2 = peek8(p + 2)
    let b3 = peek8(p + 3)
    let b4 = peek8(p + 4)
    let b5 = peek8(p + 5)
    let b6 = peek8(p + 6)
    let b7 = peek8(p + 7)
    (b0 << 56) | (b1 << 48) | (b2 << 40) | (b3 << 32) | (b4 << 24) | (b5 << 16) | (b6 << 8) | b7
}

fn be_store64(p: i64, v: i64) {
    poke8(p, (v >> 56) & 0xFF)
    poke8(p + 1, (v >> 48) & 0xFF)
    poke8(p + 2, (v >> 40) & 0xFF)
    poke8(p + 3, (v >> 32) & 0xFF)
    poke8(p + 4, (v >> 24) & 0xFF)
    poke8(p + 5, (v >> 16) & 0xFF)
    poke8(p + 6, (v >> 8) & 0xFF)
    poke8(p + 7, v & 0xFF)
}

fn hex_digit(n: i64) -> i64 {
    if n < 10 { '0' + n } else { 'a' + n - 10 }
}

fn print_hex64(v: i64) {
    let mut i = 60
    for i >= 0 {
        let d = (v >> i) & 0xF
        print_char(hex_digit(d))
        i = i - 4
    }
}

fn hex_to_bytes(h: i64, out: i64) {
    let mut i = 0
    for i < 128 {
        let c = peek8(h + i)
        let mut v = 0
        if c >= '0' && c <= '9' {
            v = c - '0'
        } else if c >= 'a' && c <= 'f' {
            v = c - 'a' + 10
        } else if c >= 'A' && c <= 'F' {
            v = c - 'A' + 10
        }
        if i % 2 == 0 {
            poke8(out + i / 2, v << 4)
        } else {
            poke8(out + i / 2, peek8(out + i / 2) | v)
        }
        i = i + 1
    }
}

fn sha512_init() {
    H0 = 0x6a09e667f3bcc908
    H1 = 0xbb67ae8584caa73b
    H2 = 0x3c6ef372fe94f82b
    H3 = 0xa54ff53a5f1d36f1
    H4 = 0x510e527fade682d1
    H5 = 0x9b05688c2b3e6c1f
    H6 = 0x1f83d9abfb41bd6b
    H7 = 0x5be0cd19137e2179
}

fn sha512_block(block: i64) {
    let W[80]
    let mut t = 0

    for t < 16 {
        W[t] = be_load64(block + t * 8)
        t = t + 1
    }

    for t < 80 {
        W[t] = sigma1(W[t - 2]) + W[t - 7] + sigma0(W[t - 15]) + W[t - 16]
        t = t + 1
    }

    let mut a = H0
    let mut b = H1
    let mut c = H2
    let mut d = H3
    let mut e = H4
    let mut f = H5
    let mut g = H6
    let mut h_var = H7

    t = 0
    for t < 80 {
        let T1 = h_var + Sig1(e) + ch(e, f, g) + K[t] + W[t]
        let T2 = Sig0(a) + maj(a, b, c)
        h_var = g
        g = f
        f = e
        e = d + T1
        d = c
        c = b
        b = a
        a = T1 + T2
        t = t + 1
    }

    H0 = H0 + a
    H1 = H1 + b
    H2 = H2 + c
    H3 = H3 + d
    H4 = H4 + e
    H5 = H5 + f
    H6 = H6 + g
    H7 = H7 + h_var
}

fn sha512_hash(msg: i64, len: i64, out: i64) {
    sha512_init()

    let full = len / 128
    let rem = len % 128
    let mut i = 0

    for i < full {
        sha512_block(msg + i * 128)
        i = i + 1
    }

    let buf[16]
    i = 0
    for i < rem {
        poke8(buf + i, peek8(msg + full * 128 + i))
        i = i + 1
    }

    poke8(buf + rem, 0x80)

    let bit_len = len * 8

    if rem < 112 {
        i = rem + 1
        for i < 112 {
            poke8(buf + i, 0)
            i = i + 1
        }

        i = 112
        for i < 120 {
            poke8(buf + i, 0)
            i = i + 1
        }

        be_store64(buf + 120, bit_len)

        sha512_block(buf)
    } else {
        i = rem + 1
        for i < 128 {
            poke8(buf + i, 0)
            i = i + 1
        }

        sha512_block(buf)

        let buf2[16]
        i = 0
        for i < 112 {
            poke8(buf2 + i, 0)
            i = i + 1
        }
        i = 112
        for i < 120 {
            poke8(buf2 + i, 0)
            i = i + 1
        }
        be_store64(buf2 + 120, bit_len)

        sha512_block(buf2)
    }

    be_store64(out, H0)
    be_store64(out + 8, H1)
    be_store64(out + 16, H2)
    be_store64(out + 24, H3)
    be_store64(out + 32, H4)
    be_store64(out + 40, H5)
    be_store64(out + 48, H6)
    be_store64(out + 56, H7)
}

fn print_digest(out: i64) {
    print_hex64(be_load64(out))
    print_hex64(be_load64(out + 8))
    print_hex64(be_load64(out + 16))
    print_hex64(be_load64(out + 24))
    print_hex64(be_load64(out + 32))
    print_hex64(be_load64(out + 40))
    print_hex64(be_load64(out + 48))
    print_hex64(be_load64(out + 56))
    print("")
}

fn hex_eq(out: i64, expected: i64) -> bool {
    let mut i = 0
    for i < 8 {
        if be_load64(out + i * 8) != be_load64(expected + i * 8) {
            return false
        }
        i = i + 1
    }
    true
}

fn main() -> i64 {
    let mut test_passed = 0
    let mut test_failed = 0

    let exp1[8]
    hex_to_bytes("cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e", exp1)

    let exp2[8]
    hex_to_bytes("ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f", exp2)

    let exp3[8]
    hex_to_bytes("4b11459c33f52a22ee8236782714c150a3b2c60994e9acee17fe68947a3e6789f31e7668394592da7bef827cddca88c4e6f86e4df7ed1ae6cba71f3e98faee9f", exp3)

    let msg200[25]
    let mut i = 0
    for i < 200 {
        poke8(msg200 + i, 'a')
        i = i + 1
    }

    let msg3[3]
    poke8(msg3, 'a')
    poke8(msg3 + 1, 'b')
    poke8(msg3 + 2, 'c')

    let dig1[8]
    sha512_hash(0, 0, dig1)
    print("SHA512(\"\"): ")
    print_digest(dig1)
    if hex_eq(dig1, exp1) {
        print("  PASS")
        test_passed = test_passed + 1
    } else {
        print("  FAIL")
        test_failed = test_failed + 1
    }

    let dig2[8]
    sha512_hash(msg3, 3, dig2)
    print("SHA512(\"abc\"): ")
    print_digest(dig2)
    if hex_eq(dig2, exp2) {
        print("  PASS")
        test_passed = test_passed + 1
    } else {
        print("  FAIL")
        test_failed = test_failed + 1
    }

    let dig3[8]
    sha512_hash(msg200, 200, dig3)
    print("SHA512(200x'a'): ")
    print_digest(dig3)
    if hex_eq(dig3, exp3) {
        print("  PASS")
        test_passed = test_passed + 1
    } else {
        print("  FAIL")
        test_failed = test_failed + 1
    }

    print("")
    print_int(test_passed)
    print(" passed, ")
    print_int(test_failed)
    print(" failed")
    print("")

    if test_failed > 0 { 1 } else { 0 }
}