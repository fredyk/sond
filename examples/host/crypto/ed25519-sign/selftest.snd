// Self-test: Ed25519 signing matches RFC 8032 Test 1 signature.

include "any/crypto/sign/ed25519-sign.snd"

// RFC 8032 Test 1 secret key (32 bytes, LE layout)
let SK[4] = [
    0x605afdef9db1619d,
    0xc42cec92f44a84ba,
    0x1969327b69c54944,
    0x607fae1c03ac3b70
]

// Expected signature (64 bytes, LE layout)
let EXP_SIG[8] = [
    0x72ac60c3004356e5,
    0x8a826e80cce28690,
    0x74d9e5b81e7f8784,
    0x5501492265e073d8,
    0xac3ba3901582b85f,
    0x6bb4f91c70391ec6,
    0x24be5b59f0f55bd2,
    0x0b107a8e43415165
]

fn main() -> i64 {
    // 1. SHA512(sk) → 64-byte hash
    let hash[8]
    sha512_hash(SK, 32, hash)

    // 2. Lower 32 bytes → clamp → secret scalar s (16 limbs)
    let s_limbs[16]
    get_clamped_scalar(hash, s_limbs)

    // 3. s as 32 bytes for scalar arithmetic
    let s_bytes[4]
    limbs16_to_bytes32(s_bytes, s_limbs)

    // 4. Base point B in extended coords: BZ = 1, BT = BX*BY mod p
    let BZ[16]; fe_one(BZ)
    let BT[16]; fe_mul(BT, BX, BY)

    // 5. A = encode([s]B)
    let ax[16]; let ay[16]; let az[16]; let at[16]
    let A_bytes[4]
    point_scalar_mul(ax, ay, az, at, s_limbs, BX, BY, BZ, BT)
    point_encode(A_bytes, ax, ay, az)

    // 6. Upper 32 bytes of hash = prefix
    // r = SHA512(prefix) mod L  (M is empty)
    let r_hash[8]
    sha512_hash(hash + 32, 32, r_hash)
    let r_bytes[4]
    sc_reduce(r_bytes, r_hash)

    // 7. Convert r to 16-limb form for point_scalar_mul
    let r_limbs[16]
    bytes32_to_limbs16(r_limbs, r_bytes)

    // 8. R = encode([r]B)
    let rx[16]; let ry[16]; let rz[16]; let rt[16]
    let R_bytes[4]
    point_scalar_mul(rx, ry, rz, rt, r_limbs, BX, BY, BZ, BT)
    point_encode(R_bytes, rx, ry, rz)

    // 9. k = SHA512(R || A) mod L  (M is empty)
    let ra_buf[8]
    copy_bytes(ra_buf, R_bytes, 32)
    copy_bytes(ra_buf + 32, A_bytes, 32)
    let k_hash[8]
    sha512_hash(ra_buf, 64, k_hash)
    let k_bytes[4]
    sc_reduce(k_bytes, k_hash)

    // 10. S = (r + k*s) mod L = sc_muladd(k, s, r)
    let S_bytes[4]
    sc_muladd(S_bytes, k_bytes, s_bytes, r_bytes)

    // 11. Build signature = R (32 bytes) || S (32 bytes)
    let sig[8]
    copy_bytes(sig, R_bytes, 32)
    copy_bytes(sig + 32, S_bytes, 32)

    // 12. Compare with expected
    if bytes_cmp(sig, EXP_SIG, 64) == 1 {
        print("PASS")
        0
    } else {
        print("FAIL")
        1
    }
}