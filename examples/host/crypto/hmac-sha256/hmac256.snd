// Clean-room HMAC-SHA-256 from RFC 2104 + FIPS 180-4. Original work; no
// third-party source copied.

let K[64] = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
    0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
    0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
    0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
    0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
    0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
    0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
    0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
    0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
]

fn rotr(x: i64, n: i64) -> i64 {
    (x >>> n) | (x << (32 - n))
}

fn Ch(x: i64, y: i64, z: i64) -> i64 {
    (x & y) ^ ((~x & 0xFFFFFFFF) & z)
}

fn Maj(x: i64, y: i64, z: i64) -> i64 {
    (x & y) ^ (x & z) ^ (y & z)
}

fn Sigma0(x: i64) -> i64 {
    rotr(x, 2) ^ rotr(x, 13) ^ rotr(x, 22)
}

fn Sigma1(x: i64) -> i64 {
    rotr(x, 6) ^ rotr(x, 11) ^ rotr(x, 25)
}

fn sigma0(x: i64) -> i64 {
    rotr(x, 7) ^ rotr(x, 18) ^ (x >>> 3)
}

fn sigma1(x: i64) -> i64 {
    rotr(x, 17) ^ rotr(x, 19) ^ (x >>> 10)
}

fn be32(addr: i64) -> i64 {
    let b0 = peek8(addr)
    let b1 = peek8(addr + 1)
    let b2 = peek8(addr + 2)
    let b3 = peek8(addr + 3)
    (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
}

fn compress(state: i64, block: i64) -> i64 {
    let a = state[0] & 0xFFFFFFFF
    let b = state[1] & 0xFFFFFFFF
    let c = state[2] & 0xFFFFFFFF
    let d = state[3] & 0xFFFFFFFF
    let e = state[4] & 0xFFFFFFFF
    let f = state[5] & 0xFFFFFFFF
    let g = state[6] & 0xFFFFFFFF
    let h = state[7] & 0xFFFFFFFF

    let W[64]

    let mut i = 0
    for i < 16 {
        W[i] = be32(block + i * 4)
        i = i + 1
    }

    let mut j = 0
    for j < 48 {
        let t = 16 + j
        let s1 = sigma1(W[t - 2])
        let s0 = sigma0(W[t - 15])
        W[t] = (s1 + W[t - 7] + s0 + W[t - 16]) & 0xFFFFFFFF
        j = j + 1
    }

    let mut t = 0
    for t < 64 {
        let T1 = (h + Sigma1(e) + Ch(e, f, g) + K[t] + W[t]) & 0xFFFFFFFF
        let T2 = (Sigma0(a) + Maj(a, b, c)) & 0xFFFFFFFF
        h = g
        g = f
        f = e
        e = (d + T1) & 0xFFFFFFFF
        d = c
        c = b
        b = a
        a = (T1 + T2) & 0xFFFFFFFF
        t = t + 1
    }

    state[0] = (state[0] + a) & 0xFFFFFFFF
    state[1] = (state[1] + b) & 0xFFFFFFFF
    state[2] = (state[2] + c) & 0xFFFFFFFF
    state[3] = (state[3] + d) & 0xFFFFFFFF
    state[4] = (state[4] + e) & 0xFFFFFFFF
    state[5] = (state[5] + f) & 0xFFFFFFFF
    state[6] = (state[6] + g) & 0xFFFFFFFF
    state[7] = (state[7] + h) & 0xFFFFFFFF

    0
}

fn sha256(msg: i64, len: i64, digest: i64) -> i64 {
    let state[8]
    state[0] = 0x6a09e667
    state[1] = 0xbb67ae85
    state[2] = 0x3c6ef372
    state[3] = 0xa54ff53a
    state[4] = 0x510e527f
    state[5] = 0x9b05688c
    state[6] = 0x1f83d9ab
    state[7] = 0x5be0cd19

    let block[8]
    let mut i = 0

    for i + 64 <= len {
        let mut j = 0
        for j < 64 {
            poke8(block + j, peek8(msg + i + j))
            j = j + 1
        }
        compress(state, block)
        i = i + 64
    }

    let mut rem = len - i
    let mut j = 0
    for j < rem {
        poke8(block + j, peek8(msg + i + j))
        j = j + 1
    }

    poke8(block + rem, 0x80)
    rem = rem + 1

    if rem + 8 > 64 {
        let mut j = 0
        for j < 64 - rem {
            poke8(block + rem + j, 0)
            j = j + 1
        }
        compress(state, block)
        let mut j = 0
        for j < 56 {
            poke8(block + j, 0)
            j = j + 1
        }
    } else {
        let mut j = 0
        for j < 56 - rem {
            poke8(block + rem + j, 0)
            j = j + 1
        }
    }

    let bits = len * 8
    poke8(block + 56, (bits >> 56) & 0xFF)
    poke8(block + 57, (bits >> 48) & 0xFF)
    poke8(block + 58, (bits >> 40) & 0xFF)
    poke8(block + 59, (bits >> 32) & 0xFF)
    poke8(block + 60, (bits >> 24) & 0xFF)
    poke8(block + 61, (bits >> 16) & 0xFF)
    poke8(block + 62, (bits >> 8) & 0xFF)
    poke8(block + 63, bits & 0xFF)

    compress(state, block)

    let mut i = 0
    for i < 8 {
        let val = state[i] & 0xFFFFFFFF
        poke8(digest + i*4 + 0, (val >> 24) & 0xFF)
        poke8(digest + i*4 + 1, (val >> 16) & 0xFF)
        poke8(digest + i*4 + 2, (val >> 8) & 0xFF)
        poke8(digest + i*4 + 3, val & 0xFF)
        i = i + 1
    }

    0
}

fn main() -> i64 {
    let key_pad[8]
    let mut i = 0
    for i < 8 {
        key_pad[i] = 0
        i = i + 1
    }
    poke8(key_pad + 0, 0x4A)
    poke8(key_pad + 1, 0x65)
    poke8(key_pad + 2, 0x66)
    poke8(key_pad + 3, 0x65)

    let msg[4]
    let mut i = 0
    for i < 4 {
        msg[i] = 0
        i = i + 1
    }
    poke8(msg + 0, 0x77)
    poke8(msg + 1, 0x68)
    poke8(msg + 2, 0x61)
    poke8(msg + 3, 0x74)
    poke8(msg + 4, 0x20)
    poke8(msg + 5, 0x64)
    poke8(msg + 6, 0x6F)
    poke8(msg + 7, 0x20)
    poke8(msg + 8, 0x79)
    poke8(msg + 9, 0x61)
    poke8(msg + 10, 0x20)
    poke8(msg + 11, 0x77)
    poke8(msg + 12, 0x61)
    poke8(msg + 13, 0x6E)
    poke8(msg + 14, 0x74)
    poke8(msg + 15, 0x20)
    poke8(msg + 16, 0x66)
    poke8(msg + 17, 0x6F)
    poke8(msg + 18, 0x72)
    poke8(msg + 19, 0x20)
    poke8(msg + 20, 0x6E)
    poke8(msg + 21, 0x6F)
    poke8(msg + 22, 0x74)
    poke8(msg + 23, 0x68)
    poke8(msg + 24, 0x69)
    poke8(msg + 25, 0x6E)
    poke8(msg + 26, 0x67)
    poke8(msg + 27, 0x3F)

    let inner_buf[12]
    let mut i = 0
    for i < 12 {
        inner_buf[i] = 0
        i = i + 1
    }
    let mut i = 0
    for i < 64 {
        let xored = peek8(key_pad + i) ^ 0x36
        poke8(inner_buf + i, xored)
        i = i + 1
    }
    let mut i = 0
    for i < 28 {
        poke8(inner_buf + 64 + i, peek8(msg + i))
        i = i + 1
    }

    let inner_digest[4]
    let mut i = 0
    for i < 4 {
        inner_digest[i] = 0
        i = i + 1
    }
    sha256(inner_buf, 92, inner_digest)

    let outer_buf[12]
    let mut i = 0
    for i < 12 {
        outer_buf[i] = 0
        i = i + 1
    }
    let mut i = 0
    for i < 64 {
        let xored = peek8(key_pad + i) ^ 0x5C
        poke8(outer_buf + i, xored)
        i = i + 1
    }
    let mut i = 0
    for i < 32 {
        poke8(outer_buf + 64 + i, peek8(inner_digest + i))
        i = i + 1
    }

    let outer_digest[4]
    let mut i = 0
    for i < 4 {
        outer_digest[i] = 0
        i = i + 1
    }
    sha256(outer_buf, 96, outer_digest)

    let mut i = 0
    for i < 32 {
        print_int(peek8(outer_digest + i))
        print("")
        i = i + 1
    }

    0
}