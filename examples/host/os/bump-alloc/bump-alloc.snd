// Bump allocator with alignment
let mut next = 0x1000

fn balloc(size: i64, align: i64) -> i64 {
    // Round up next to alignment: (next + align - 1) & -(align)
    let mask = 0 - align
    let aligned = (next + align - 1) & mask
    next = aligned + size
    aligned
}

fn main() -> i64 {
    let r1 = balloc(10, 8)
    print_int(r1)
    print(" ")
    let r2 = balloc(100, 16)
    print_int(r2)
    print("")
    0
}
