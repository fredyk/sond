// ELF64 header parser, Fase 3 loader
// Build a header, verify magic, read fields, print results.

// Get little-endian 16-bit from byte buffer at offset
fn get_le16(buf: i64, off: i64) -> i64 {
    let mut lo = peek8(buf + off)
    let mut hi = peek8(buf + off + 1)
    hi << 8 | lo
}

// Get little-endian 64-bit from byte buffer at offset
fn get_le64(buf: i64, off: i64) -> i64 {
    let mut v = 0
    let mut i = 0
    for i < 8 {
        let mut b = peek8(buf + off + 7 - i)
        v = v << 8 | b
        i = i + 1
    }
    v
}

// Check if buffer starts with ELF magic: 0x7F 'E' 'L' 'F'
fn is_elf(buf: i64) -> i64 {
    if peek8(buf + 0) == 0x7F {
        if peek8(buf + 1) == 'E' {
            if peek8(buf + 2) == 'L' {
                if peek8(buf + 3) == 'F' {
                    return 1
                }
            }
        }
    }
    0
}

fn main() -> i64 {
    let a[64]
    let buf = a

    // ELF magic: 7F 45 4C 46
    poke8(buf + 0, 0x7F)
    poke8(buf + 1, 'E')
    poke8(buf + 2, 'L')
    poke8(buf + 3, 'F')

    // Byte 4: class = 2 (ELFCLASS64)
    poke8(buf + 4, 2)

    // Byte 5: data = 1 (ELFDATA2LSB, little-endian)
    poke8(buf + 5, 1)

    // Byte 6: version = 1
    poke8(buf + 6, 1)

    // Byte 7: OS/ABI = 0 (ELFOSABI_NONE, System V)
    poke8(buf + 7, 0)

    // Bytes 8-15: padding (zero)
    let mut p = 8
    for p < 16 {
        poke8(buf + p, 0)
        p = p + 1
    }

    // e_type (le16 at offset 16): ET_EXEC = 2
    poke8(buf + 16, 2 & 0xFF)
    poke8(buf + 17, 2 >> 8)

    // e_machine (le16 at offset 18): EM_X86_64 = 0x3E = 62
    poke8(buf + 18, 0x3E & 0xFF)
    poke8(buf + 19, 0x3E >> 8)

    // e_version (le32 at offset 20): 1
    poke8(buf + 20, 1 & 0xFF)
    poke8(buf + 21, 1 >> 8)
    poke8(buf + 22, 0)
    poke8(buf + 23, 0)

    // e_entry (le64 at offset 24): 0x401000 = 4198400
    // LE bytes: 00 10 40 00 00 00 00 00
    poke8(buf + 24, 0x00)
    poke8(buf + 25, 0x10)
    poke8(buf + 26, 0x40)
    poke8(buf + 27, 0x00)
    poke8(buf + 28, 0x00)
    poke8(buf + 29, 0x00)
    poke8(buf + 30, 0x00)
    poke8(buf + 31, 0x00)

    // Output: is_elf e_type e_machine e_entry
    print_int(is_elf(buf))
    print(" ")
    print_int(get_le16(buf, 16))
    print(" ")
    print_int(get_le16(buf, 18))
    print(" ")
    print_int(get_le64(buf, 24))
    print("")

    0
}
