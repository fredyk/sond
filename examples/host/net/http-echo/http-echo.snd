// Copyright 2026 Jhon Magdalena Vila and the Sond contributors
//
// A real HTTP request/response over a loopback TCP socket, end to end in Sond: the byte
// buffer, the arena, the HTTP layer and the socket wrappers working together. A forked child
// is the client (sends a GET, checks the status line); the parent is the server (accepts,
// parses the path, echoes it in a 200 response). Exit code 0 iff the client verified the
// reply, so it doubles as an executable test of the whole stack.
//
//   sondc examples/host/net/http-echo/http-echo.snd -o http-echo && ./http-echo ; echo $?

include "x86_64/linux/io.snd"
include "x86_64/linux/net.snd"
include "x86_64/linux/http.snd"

fn main() -> i64 {
    let port = 48219
    let ip = 0x7f000001                 // 127.0.0.1

    let sfd = sock(AF_INET, SOCK_STREAM, 0)
    if sfd < 0 { return 1 }
    set_reuseaddr(sfd)
    let sa[2]
    sockaddr_in_build(sa, ip, port)
    if bind_sock(sfd, sa, 16) < 0 { return 1 }
    if listen_sock(sfd, 4) < 0 { return 1 }

    let pid = syscall(SYS_fork)
    if pid == 0 {
        // CLIENT: connect, send a request, verify the status line, exit accordingly.
        let cfd = sock(AF_INET, SOCK_STREAM, 0)
        let ca[2]
        sockaddr_in_build(ca, ip, port)
        if connect_sock(cfd, ca, 16) < 0 { syscall(SYS_exit, 2) }
        write_buf(cfd, "GET /hello HTTP/1.1\r\n\r\n", 22)
        let rbuf[256]
        let rn = read_buf(cfd, rbuf, 256)
        close_fd(cfd)
        let resp = bytes_from_raw(rbuf, rn)
        let want = bytes_from_cstr("HTTP/1.1 200 OK")
        let mut ok = 1
        let mut i = 0
        for i < 15 {
            if bytes_get(resp, i) != bytes_get(want, i) { ok = 0 }
            i = i + 1
        }
        if ok == 1 { syscall(SYS_exit, 0) } else { syscall(SYS_exit, 3) }
    }

    // SERVER: accept one connection, parse the path, echo it back in a 200.
    let afd = accept_sock(sfd, 0, 0)
    if afd < 0 { return 1 }
    let reqbuf[256]
    let reqn = read_buf(afd, reqbuf, 256)
    let req = bytes_from_raw(reqbuf, reqn)
    let body = bytes_new()
    bytes_append_cstr(body, "you asked for ")
    bytes_append(body, http_path(req))
    let resp = http_response("200 OK", body)
    write_buf(afd, peek64(resp), bytes_len(resp))
    close_fd(afd)

    let st[1]
    syscall(SYS_wait4, pid, st, 0, 0)
    (st[0] >> 8) & 255                  // the client's exit status: 0 = it verified the reply
}
