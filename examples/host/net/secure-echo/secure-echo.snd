// Copyright 2026 Jhon Magdalena Vila and the Sond contributors
//
// An AUTHENTICATED, ENCRYPTED HTTP exchange over a real loopback socket, the HTTPS-shaped
// litmus milestone, end to end in Sond. A forked client and the parent server run a Noise-IK
// handshake over TCP (client knows the server's static public key), derive session keys, and
// then carry one HTTP request/response encrypted with ChaCha20-Poly1305. Exit 0 iff the
// client completes the handshake AND decrypts a valid 200 response, so it is also a test of
// the whole crypto + net + http stack.
//
//   sondc examples/host/net/secure-echo/secure-echo.snd -o secure-echo && ./secure-echo; echo $?

include "x86_64/linux/io.snd"
include "x86_64/linux/net.snd"
include "x86_64/linux/http.snd"
include "any/crypto/noise/noise-ik.snd"
include "any/crypto/aead/chacha20poly1305.snd"

// Send a sealed message on `fd`: 1-byte length, then ciphertext, then the 16-byte tag.
fn send_sealed(fd: i64, key: i64, pt: i64, n: i64) {
    let nonce[2]
    let mut z = 0
    for z < 12 { poke8(nonce + z, 0) z = z + 1 }
    let ct[64]
    let tag[2]
    aead_seal(key, nonce, 0, 0, pt, n, ct, tag)
    let frame[80]
    poke8(frame, n)
    let mut i = 0
    for i < n { poke8(frame + 1 + i, peek8(ct + i)) i = i + 1 }
    i = 0
    for i < 16 { poke8(frame + 1 + n + i, peek8(tag + i)) i = i + 1 }
    write_buf(fd, frame, 1 + n + 16)
}

// Receive a sealed message on `fd` into `pt`; returns plaintext length, or -1 if the tag fails.
fn recv_sealed(fd: i64, key: i64, pt: i64) -> i64 {
    let nonce[2]
    let mut z = 0
    for z < 12 { poke8(nonce + z, 0) z = z + 1 }
    let frame[80]
    read_buf(fd, frame, 80)
    let n = peek8(frame)
    let ct[64]
    let mut i = 0
    for i < n { poke8(ct + i, peek8(frame + 1 + i)) i = i + 1 }
    let tag[2]
    i = 0
    for i < 16 { poke8(tag + i, peek8(frame + 1 + n + i)) i = i + 1 }
    if aead_open(key, nonce, 0, 0, ct, n, tag, pt) != 0 { return 0 - 1 }
    n
}

fn main() -> i64 {
    let port = 48231
    let ip = 0x7f000001

    // Test keypairs (fixed, distinct). The client is pinned to the server's static pubkey.
    let ss_priv[4]
    let se_priv[4]
    let cs_priv[4]
    let ce_priv[4]
    let mut i = 0
    for i < 32 { poke8(ss_priv + i, 0x31 + i) i = i + 1 }
    i = 0
    for i < 32 { poke8(se_priv + i, 0x51 + i) i = i + 1 }
    i = 0
    for i < 32 { poke8(cs_priv + i, 0x11 + i) i = i + 1 }
    i = 0
    for i < 32 { poke8(ce_priv + i, 0x71 + i) i = i + 1 }
    let bp[4]
    ns_basepoint(bp)
    let ss_pub[4]
    x25519(ss_priv, bp, ss_pub)

    let sfd = sock(AF_INET, SOCK_STREAM, 0)
    if sfd < 0 { return 1 }
    set_reuseaddr(sfd)
    let sa[2]
    sockaddr_in_build(sa, ip, port)
    if bind_sock(sfd, sa, 16) < 0 { return 1 }
    if listen_sock(sfd, 4) < 0 { return 1 }

    let pid = syscall(SYS_fork)
    if pid == 0 {
        // CLIENT
        let cfd = sock(AF_INET, SOCK_STREAM, 0)
        let ca[2]
        sockaddr_in_build(ca, ip, port)
        if connect_sock(cfd, ca, 16) < 0 { syscall(SYS_exit, 2) }
        let cst[40]
        noise_ik_client_init(cst, cs_priv, ss_pub, ce_priv)
        let m1[16]
        let l1 = noise_ik_client_msg1(cst, m1)
        write_buf(cfd, m1, l1)
        let m2[16]
        read_buf(cfd, m2, 48)
        if noise_ik_client_msg2(cst, m2, 48) != 0 { syscall(SYS_exit, 3) }
        let kc2s[4]
        let ks2c[4]
        noise_ik_session_keys(cst, kc2s, ks2c)
        // encrypted request
        send_sealed(cfd, kc2s, cstr("GET /hi HTTP/1.1\r\n\r\n"), 20)
        // encrypted response
        let resp[64]
        let rn = recv_sealed(cfd, ks2c, resp)
        close_fd(cfd)
        if rn < 15 { syscall(SYS_exit, 4) }
        let ok = bytes_eq(bytes_from_raw(resp, 15), bytes_from_cstr(cstr("HTTP/1.1 200 OK")))
        if ok == 1 { syscall(SYS_exit, 0) } else { syscall(SYS_exit, 5) }
    }

    // SERVER
    let afd = accept_sock(sfd, 0, 0)
    if afd < 0 { return 1 }
    let sst[40]
    noise_ik_server_init(sst, ss_priv, se_priv)
    let m1[16]
    read_buf(afd, m1, 96)
    let got_cs[4]
    if noise_ik_server_msg1(sst, m1, 96, got_cs) != 0 { return 1 }
    let m2[16]
    let l2 = noise_ik_server_msg2(sst, m2)
    write_buf(afd, m2, l2)
    let kc2s[4]
    let ks2c[4]
    noise_ik_session_keys(sst, kc2s, ks2c)
    // decrypt request, build + encrypt response
    let req[64]
    let qn = recv_sealed(afd, kc2s, req)
    let body = bytes_new()
    bytes_append_cstr(body, cstr("secure "))
    bytes_append(body, http_path(bytes_from_raw(req, qn)))
    let resp = http_response(cstr("200 OK"), body)
    send_sealed(afd, ks2c, peek64(resp), bytes_len(resp))
    close_fd(afd)

    let st[1]
    syscall(SYS_wait4, pid, st, 0, 0)
    (st[0] >> 8) & 255
}
