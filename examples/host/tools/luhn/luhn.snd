fn luhn_valid(n: i64, len: i64) -> i64 {
    let mut num = n
    let mut sum = 0
    let mut pos = 0
    let mut i = len - 1
    for i >= 0 {
        let mut d = num % 10
        num = num / 10
        if pos % 2 == 1 {
            d = d * 2
            if d > 9 {
                d = d - 9
            }
        }
        sum = sum + d
        pos = pos + 1
        i = i - 1
    }
    if sum % 10 == 0 { 1 } else { 0 }
}

fn main() -> i64 {
    let r1 = luhn_valid(79927398713, 11)
    let r2 = luhn_valid(79927398714, 11)

    print_int(r1)
    print("")
    print_int(r2)
    print("")

    0
}
