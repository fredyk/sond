fn main() -> i64 {
    let mut a[5]
    a[0] = 17
    a[1] = 3
    a[2] = 42
    a[3] = 8
    a[4] = 25

    let mut i = 0
    let mut sum = 0
    let mut min = a[0]
    let mut max = a[0]

    for i < 5 {
        let mut v = a[i]
        sum = sum + v
        if v < min {
            min = v
        }
        if v > max {
            max = v
        }
        i = i + 1
    }

    print_int(sum)
    print(" ")
    print_int(min)
    print(" ")
    print_int(max)
    0
}
