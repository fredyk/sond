//
// Real SSH KEX shared secret K, the DH core: the server computes
// K = X25519(server_ephemeral_private, Q_C), where Q_C is the client's ephemeral
// public key parsed from KEX_ECDH_INIT. Verified against RFC 7748 §6.1: with the
// server holding "Alice" and the client sending "Bob"'s public key, both sides
// derive the same K. This is the real crypto for the K slot of kex-server-flow.

include "any/crypto/dh/x25519.snd"

fn main() -> i64 {
    // Server ephemeral private key (RFC 7748 §6.1 "Alice").
    let sk[4]
    poke8(sk + 0, 0x77)  poke8(sk + 1, 0x07)  poke8(sk + 2, 0x6d)  poke8(sk + 3, 0x0a)
    poke8(sk + 4, 0x73)  poke8(sk + 5, 0x18)  poke8(sk + 6, 0xa5)  poke8(sk + 7, 0x7d)
    poke8(sk + 8, 0x3c)  poke8(sk + 9, 0x16)  poke8(sk + 10, 0xc1) poke8(sk + 11, 0x72)
    poke8(sk + 12, 0x51) poke8(sk + 13, 0xb2) poke8(sk + 14, 0x66) poke8(sk + 15, 0x45)
    poke8(sk + 16, 0xdf) poke8(sk + 17, 0x4c) poke8(sk + 18, 0x2f) poke8(sk + 19, 0x87)
    poke8(sk + 20, 0xeb) poke8(sk + 21, 0xc0) poke8(sk + 22, 0x99) poke8(sk + 23, 0x2a)
    poke8(sk + 24, 0xb1) poke8(sk + 25, 0x77) poke8(sk + 26, 0xfb) poke8(sk + 27, 0xa5)
    poke8(sk + 28, 0x1d) poke8(sk + 29, 0xb9) poke8(sk + 30, 0x2c) poke8(sk + 31, 0x2a)

    // Client ephemeral public Q_C (RFC 7748 §6.1 "Bob's public"), as if parsed
    // from the client's KEX_ECDH_INIT.
    let qc[4]
    poke8(qc + 0, 0xde)  poke8(qc + 1, 0x9e)  poke8(qc + 2, 0xdb)  poke8(qc + 3, 0x7d)
    poke8(qc + 4, 0x7b)  poke8(qc + 5, 0x7d)  poke8(qc + 6, 0xc1)  poke8(qc + 7, 0xb4)
    poke8(qc + 8, 0xd3)  poke8(qc + 9, 0x5b)  poke8(qc + 10, 0x61) poke8(qc + 11, 0xc2)
    poke8(qc + 12, 0xec) poke8(qc + 13, 0xe4) poke8(qc + 14, 0x35) poke8(qc + 15, 0x37)
    poke8(qc + 16, 0x3f) poke8(qc + 17, 0x83) poke8(qc + 18, 0x43) poke8(qc + 19, 0xc8)
    poke8(qc + 20, 0x5b) poke8(qc + 21, 0x78) poke8(qc + 22, 0x67) poke8(qc + 23, 0x4d)
    poke8(qc + 24, 0xad) poke8(qc + 25, 0xfc) poke8(qc + 26, 0x7e) poke8(qc + 27, 0x14)
    poke8(qc + 28, 0x6f) poke8(qc + 29, 0x88) poke8(qc + 30, 0x2b) poke8(qc + 31, 0x4f)

    // K = X25519(server_private, Q_C), the shared secret.
    let k[4]
    x25519(sk, qc, k)

    // Expected shared secret (RFC 7748 §6.1).
    let exp[4]
    poke8(exp + 0, 0x4a)  poke8(exp + 1, 0x5d)  poke8(exp + 2, 0x9d)  poke8(exp + 3, 0x5b)
    poke8(exp + 4, 0xa4)  poke8(exp + 5, 0xce)  poke8(exp + 6, 0x2d)  poke8(exp + 7, 0xe1)
    poke8(exp + 8, 0x72)  poke8(exp + 9, 0x8e)  poke8(exp + 10, 0x3b) poke8(exp + 11, 0xf4)
    poke8(exp + 12, 0x80) poke8(exp + 13, 0x35) poke8(exp + 14, 0x0f) poke8(exp + 15, 0x25)
    poke8(exp + 16, 0xe0) poke8(exp + 17, 0x7e) poke8(exp + 18, 0x21) poke8(exp + 19, 0xc9)
    poke8(exp + 20, 0x47) poke8(exp + 21, 0xd1) poke8(exp + 22, 0x9e) poke8(exp + 23, 0x33)
    poke8(exp + 24, 0x76) poke8(exp + 25, 0xf0) poke8(exp + 26, 0x9b) poke8(exp + 27, 0x3c)
    poke8(exp + 28, 0x1e) poke8(exp + 29, 0x16) poke8(exp + 30, 0x17) poke8(exp + 31, 0x42)

    let mut ok = 1
    let mut i = 0
    for i < 32 {
        if peek8(k + i) != peek8(exp + i) { ok = 0 }
        i = i + 1
    }
    if ok == 1 { print("PASS: real X25519 shared secret K matches RFC 7748\n") }
    else { print("FAIL: K mismatch\n") }
    0
}
