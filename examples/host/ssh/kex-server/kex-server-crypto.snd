    let mut ok = 1

    // Compute the whole KEX through the reusable server_kex(), then verify each
    // output against the reference vectors set up above.
    let QS[4]
    let K[4]
    let H[4]
    let SIG[8]
    server_kex(EPH, QC, HSK, HPUB, VC, VS, IC, IS, EDSTR, QS, K, H, SIG)
    if bytes_cmp(QS, QS_EXP, 32) == 0 { print("FAIL Q_S") ok = 0 } else { print("OK Q_S") }
    if bytes_cmp(K, K_EXP, 32) == 0 { print("FAIL K") ok = 0 } else { print("OK K") }
    if bytes_cmp(H, H_EXP, 32) == 0 { print("FAIL H") ok = 0 } else { print("OK H") }
    if bytes_cmp(SIG, SIG_EXP, 64) == 0 { print("FAIL signature") ok = 0 } else { print("OK signature") }

    if ok == 1 { print("ALL PASS: server KEX crypto matches reference") }
    else { print("SOME FAILED") }
    0
