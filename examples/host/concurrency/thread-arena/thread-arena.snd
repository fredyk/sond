//
// Two threads allocate concurrently, thousands of times each, and verify nobody
// overwrote their memory. Each thread bumps its OWN arena (through the reserved
// arena register), so there is no shared allocator pointer to race on. Prints
// "0 0": zero corruptions across both threads. If the arenas were shared, the
// threads would hand out overlapping addresses and clobber each other's writes.

include "x86_64/linux/bytes.snd"

// Guarda las direcciones asignadas, escribe un patrón único por hilo, y al final
// relee TODAS: si dos hilos comparten el mismo bump pointer, se pisan y falla.
fn hammer(tag: i64, out: i64, addrs: i64) -> i64 {
    let mut i = 0
    for i < 3000 {
        let b = heap_alloc(64)
        poke64(addrs + i * 8, b)
        poke64(b, tag * 100000000 + i)
        i = i + 1
    }
    let mut errors = 0
    let mut j = 0
    for j < 3000 {
        let b = peek64(addrs + j * 8)
        if peek64(b) != tag * 100000000 + j { errors = errors + 1 }
        j = j + 1
    }
    poke64(out, errors)
    0
}

fn main() -> i64 {
    let r1[1]
    let r2[1]
    let a1[3000]
    let a2[3000]
    poke64(r1, 0)
    poke64(r2, 0)
    spawn hammer(1, r1, a1)
    hammer(2, r2, a2)
    print_int(peek64(r1))
    print_int(peek64(r2))
    0
}
