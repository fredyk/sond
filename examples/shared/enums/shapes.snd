//
// SUM TYPES: the "illegal states unrepresentable" mechanism (what Go never had).
// An `enum` is a closed set of variants; a `match` on it MUST handle every one, or the
// compiler REJECTS the program:
//   sondc: non-exhaustive match on `Shape`: missing ["Triangle"]. …
// So an AI (or a human) can never silently forget a case. A variant lowers to its
// integer tag (declaration order); across the .so it is an i64.

enum Shape { Circle, Square, Triangle }

pub fn sides(s: Shape) -> i64 {
    match s {
        Circle => 0,
        Square => 4,
        Triangle => 3,
    }
}

pub fn make_square() -> Shape { Square }
