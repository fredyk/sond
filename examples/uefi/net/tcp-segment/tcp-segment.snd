// TCP segment header parsing and construction (RFC 793)
// Header layout (big-endian on wire):
//   @0  src port    be16
//   @2  dst port    be16
//   @4  seq num     be32
//   @8  ack num     be32
//  @10  data offset (high nibble of byte, *4 = header length)
//       flags (6 bits): URG=0x20 ACK=0x10 PSH=0x08 RST=0x04 SYN=0x02 FIN=0x01
//  @12  window      be16  (task says @14, we follow task spec)
//  @14  checksum    be16
//  @16  urgent ptr  be16

fn get_be16(buf: i64, off: i64) -> i64 {
    let hi = peek8(buf+off) & 0xFF
    let lo = peek8(buf+off+1) & 0xFF
    hi << 8 | lo
}

fn get_be32(buf: i64, off: i64) -> i64 {
    let b0 = peek8(buf+off) & 0xFF
    let b1 = peek8(buf+off+1) & 0xFF
    let b2 = peek8(buf+off+2) & 0xFF
    let b3 = peek8(buf+off+3) & 0xFF
    b0 << 24 | b1 << 16 | b2 << 8 | b3
}

fn put_be16(buf: i64, off: i64, val: i64) {
    poke8(buf+off, val >> 8 & 0xFF)
    poke8(buf+off+1, val & 0xFF)
}

fn put_be32(buf: i64, off: i64, val: i64) {
    poke8(buf+off, val >> 24 & 0xFF)
    poke8(buf+off+1, val >> 16 & 0xFF)
    poke8(buf+off+2, val >> 8 & 0xFF)
    poke8(buf+off+3, val & 0xFF)
}

// Parse TCP header from buf.
// Returns flags | (window << 8) so caller can extract both.
fn parse_tcp(buf: i64) -> i64 {
    // src port be16 @0
    let _src = get_be16(buf, 0)
    // dst port be16 @2
    let _dst = get_be16(buf, 2)
    // seq be32 @4
    let _seq = get_be32(buf, 4)
    // ack be32 @8
    let _ack = get_be32(buf, 8)

    // data offset: high nibble of byte 10 (RFC offset 10), times 4 = header length
    let byte10 = peek8(buf+10)
    let data_offset = byte10 >> 4 & 0xF
    let _header_len = data_offset * 4

    // flags: byte 10 bits 0-5 (URG=0x20 ACK=0x10 PSH=0x08 RST=0x04 SYN=0x02 FIN=0x01)
    let flags = byte10 & 0x3F

    // window be16 @14 (per task spec)
    let window = get_be16(buf, 14)

    flags | window << 8
}

// Build a SYN segment in buf with given fields.
fn build_syn(buf: i64, sport: i64, dport: i64, seq: i64) {
    put_be16(buf, 0, sport)
    put_be16(buf, 2, dport)
    put_be32(buf, 4, seq)
    put_be32(buf, 8, 0)
    // data offset = 5 (20-byte header), reserved=0 => byte10 = 0x50
    poke8(buf+10, 5 << 4)
    // flags: SYN = 0x02 => byte11 = 0x02
    poke8(buf+11, 2)
    // window be16 @12
    put_be16(buf, 12, 512)
    // checksum = 0
    put_be16(buf, 14, 0)
    // urgent pointer = 0
    put_be16(buf, 16, 0)
}

// Minimal TCP 3-way handshake state machine (RFC 793).
// CLOSED=0, SYN_SENT=1, ESTABLISHED=2
// Given current state and flags of incoming segment, return next state.
fn tcp_next_state(state: i64, flags: i64) -> i64 {
    if state == 0 {
        if flags & 2 != 0 { 1 }
        else { 0 }
    }
    else {
        if state == 1 {
            if flags & 16 != 0 { 2 }
            else { 0 }
        }
        else { 0 }
    }
}

fn efi_main() -> i64 {
    // Allocate a buffer for the TCP segment
    let buf = alloc(32)

    // Build a SYN segment
    build_syn(buf, 12345, 80, 1000)

    // Parse it back
    let result = parse_tcp(buf)
    let flags = result & 0xFF
    let window = result >> 8

    print("TCP flags = ")
    print_int(flags)
    print(" window = ")
    print_int(window)
    print("")

    // State machine: CLOSED + SYN => SYN_SENT
    let s1 = tcp_next_state(0, 2)
    print("state(0, SYN) = ")
    print_int(s1)
    print("")

    // State machine: SYN_SENT + ACK => ESTABLISHED
    let s2 = tcp_next_state(1, 16)
    print("state(1, ACK) = ")
    print_int(s2)
    print("")

    0
}
