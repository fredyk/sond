// Intel 8253/8254 PIT driver in Sond for UEFI
//
// PIT port layout:
//   0x40 - Channel 0 data (count register)
//   0x41 - Channel 1 data
//   0x42 - Channel 2 data
//   0x43 - Command/Control register
//
// Command byte (to port 0x43):
//   Bits 7-6: Channel select (00 = channel 0)
//   Bits 5-4: Access mode  (11 = lobyte then hibyte)
//   Bits 3-1: Operating mode (011 = mode 3 square wave)
//   Bit 0:    Binary mode (0 = binary)
//   => 0x36 = 00 11 011 0

fn pit_set_divisor(div: i64) {
    outb(0x40, div)
    outb(0x40, div >> 8)
}

fn pit_set_frequency_port() {
    // Command byte: channel 0, lobyte/hibyte access, mode 3 square wave, binary
    // 0x36 = 00 11 011 0
    outb(0x43, 0x36)
    // Divisor for ~1193182 / 1820 ≈ 655 units (roughly 18.2 Hz tick)
    // Using divisor 65535 (0xFFFF) for a slow visible count
    pit_set_divisor(65535)
}

fn read_count() -> i64 {
    // Latch count command for channel 0: same command byte to trigger latch
    outb(0x43, 0x30)
    // Now read lobyte then hibyte
    let lo = inb(0x40)
    let hi = inb(0x40)
    hi << 8 | lo
}

fn busy_delay() {
    let mut i = 0
    for i < 100000 {
        i = i + 1
    }
}

fn efi_main() -> i64 {
    print("PIT driver test")
    print("")

    // Program the PIT with divisor 65535 (mode 3 square wave)
    pit_set_frequency_port()
    print("PIT programmed with divisor 65535")

    // Read count a couple of times
    busy_delay()
    let c1 = read_count()
    print("Count after first delay:")
    print_int(c1)
    print("")

    busy_delay()
    let c2 = read_count()
    print("Count after second delay:")
    print_int(c2)
    print("")

    0
}
