// UTF-8 decoder in Sond for UEFI
// UTF-8 spec (RFC 3629):
//   1-byte: 0xxxxxxx
//   2-byte: 110xxxxx 10xxxxxx
//   3-byte: 1110xxxx 10xxxxxx 10xxxxxx
//   4-byte: 11110xxx 10xxxxxx 10xxxxxx

fn utf8_next(buf: i64, pos: i64, out_bytes: i64) -> i64 {
    let mut b0 = peek8(buf + pos)
    let mut codepoint = 0
    let mut nbytes = 1

    if b0 & 0x80 == 0 {
        codepoint = b0 & 0x7F
        nbytes = 1
    } else {
        if b0 & 0xE0 == 0xC0 {
            let mut b1 = peek8(buf + pos + 1)
            codepoint = (b0 & 0x1F) << 5 | b1 & 0x3F
            nbytes = 2
        } else {
            if b0 & 0xF0 == 0xE0 {
                let mut b1 = peek8(buf + pos + 1)
                let mut b2 = peek8(buf + pos + 2)
                codepoint = (b0 & 0x0F) << 10 | (b1 & 0x3F) << 4 | b2 & 0x3F
                nbytes = 3
            } else {
                if b0 & 0xF8 == 0xF0 {
                    let mut b1 = peek8(buf + pos + 1)
                    let mut b2 = peek8(buf + pos + 2)
                    let mut b3 = peek8(buf + pos + 3)
                    codepoint = (b0 & 0x07) << 15 | (b1 & 0x3F) << 10 | (b2 & 0x3F) << 4 | b3 & 0x3F
                    nbytes = 4
                }
            }
        }
    }

    poke8(out_bytes, nbytes)
    codepoint
}

fn efi_main() -> i64 {
    let mut buf = alloc(8)

    poke8(buf + 0, 0x41)
    poke8(buf + 1, 0xE2)
    poke8(buf + 2, 0x82)
    poke8(buf + 3, 0xAC)
    poke8(buf + 4, 0)

    let mut out_bytes = alloc(1)
    let cp1 = utf8_next(buf, 0, out_bytes)
    print("codepoint 1 = ")
    print_int(cp1)
    let cp2 = utf8_next(buf, 1, out_bytes)
    print("codepoint 2 = ")
    print_int(cp2)

    0
}
