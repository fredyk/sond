// Base64 encoding per RFC 4648, Sond program for UEFI
// Test: "Man" → "TWFu"

fn b64_char(v: i64) -> i64 {
    if v < 26 {
        'A' + v
    } else {
        if v < 52 {
            'a' + (v - 26)
        } else {
            if v < 62 {
                '0' + (v - 52)
            } else {
                if v == 62 {
                    '+'
                } else {
                    '/'
                }
            }
        }
    }
}

fn b64_encode(inbuf: i64, inlen: i64, outbuf: i64) -> i64 {
    let mut i = 0
    let mut out = outbuf
    let mut full = inlen / 3
    let mut left = inlen % 3

    for i < full {
        let mut b0 = peek8(inbuf + i * 3)
        let mut b1 = peek8(inbuf + i * 3 + 1)
        let mut b2 = peek8(inbuf + i * 3 + 2)

        poke8(out, b64_char(b0 >> 2))
        poke8(out + 1, b64_char(((b0 & 3) << 4) | (b1 >> 4)))
        poke8(out + 2, b64_char(((b1 & 15) << 2) | (b2 >> 6)))
        poke8(out + 3, b64_char(b2 & 63))

        out = out + 4
        i = i + 1
    }

    if left == 2 {
        let mut b0 = peek8(inbuf + i * 3)
        let mut b1 = peek8(inbuf + i * 3 + 1)
        poke8(out, b64_char(b0 >> 2))
        poke8(out + 1, b64_char(((b0 & 3) << 4) | (b1 >> 4)))
        poke8(out + 2, b64_char((b1 & 15) << 2))
        poke8(out + 3, '=')
    } else {
        if left == 1 {
            let mut b0 = peek8(inbuf + i * 3)
            poke8(out, b64_char(b0 >> 2))
            poke8(out + 1, b64_char((b0 & 3) << 4))
            poke8(out + 2, '=')
            poke8(out + 3, '=')
        }
    }

    0
}

fn efi_main() -> i64 {
    let mut input = alloc(3)
    poke8(input, 'M')
    poke8(input + 1, 'a')
    poke8(input + 2, 'n')

    let mut output = alloc(4)
    b64_encode(input, 3, output)

    let mut i = 0
    for i < 4 {
        print_char(peek8(output + i))
        i = i + 1
    }
    print_char('\n')

    0
}
