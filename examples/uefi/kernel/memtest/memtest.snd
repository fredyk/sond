fn efi_main() -> i64 {
    let mut a[100]
    let p = alloc(4096)
    let mut mismatches = 0
    let mut i = 0
    for i < 100 {
        let mut val = (i * 2654435761) & 0xFFFFFFFF
        a[i] = val
        i = i + 1
    }
    let mut i = 0
    for i < 100 {
        let mut val = (i * 2654435761) & 0xFFFFFFFF
        let r = a[i]
        if r != val {
            mismatches = mismatches + 1
        }
        i = i + 1
    }
    serial_print("Mismatches: ")
    serial_int(mismatches)
    if mismatches == 0 {
        serial_print("PASS")
    } else {
        serial_print("FAIL")
    }
    halt()
    0
}
