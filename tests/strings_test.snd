//
// tests/strings_test.snd: tests for lib/any/strings.snd
//
// Each test builds a byte buffer with poke8, calls a function from
// strings.snd, and checks the result.  The last expression of main
// is the exit code: 0 = all pass, 1 = failure.

include "lib/any/strings.snd"

fn test_strlen() -> i64 {
    let mut buf[20]
    // "abc"
    poke8(buf + 0, 97)
    poke8(buf + 1, 98)
    poke8(buf + 2, 99)
    poke8(buf + 3, 0)
    let n = strlen(buf)
    if n == 3 { 0 } else { 1 }
}

fn test_strlen_empty() -> i64 {
    let mut buf[20]
    poke8(buf + 0, 0)
    let n = strlen(buf)
    if n == 0 { 0 } else { 1 }
}

fn test_strlen_longer() -> i64 {
    let mut buf[20]
    poke8(buf + 0, 72)
    poke8(buf + 1, 105)
    poke8(buf + 2, 0)
    let n = strlen(buf)
    if n == 2 { 0 } else { 1 }
}

fn test_memcmp_equal() -> i64 {
    let mut a[10]
    let mut b[10]
    poke8(a + 0, 1); poke8(a + 1, 2); poke8(a + 2, 3)
    poke8(b + 0, 1); poke8(b + 1, 2); poke8(b + 2, 3)
    let r = memcmp(a, b, 3)
    if r == 0 { 0 } else { 1 }
}

fn test_memcmp_diff() -> i64 {
    let mut a[10]
    let mut b[10]
    poke8(a + 0, 1); poke8(a + 1, 2); poke8(a + 2, 3)
    poke8(b + 0, 1); poke8(b + 1, 5); poke8(b + 2, 3)
    let r = memcmp(a, b, 3)
    if r != 0 { 0 } else { 1 }
}

fn test_streq_yes() -> i64 {
    let mut a[10]
    let mut b[10]
    poke8(a + 0, 104); poke8(a + 1, 105); poke8(a + 2, 0)
    poke8(b + 0, 104); poke8(b + 1, 105); poke8(b + 2, 0)
    let r = streq(a, b)
    if r == 1 { 0 } else { 1 }
}

fn test_streq_no() -> i64 {
    let mut a[10]
    let mut b[10]
    poke8(a + 0, 104); poke8(a + 1, 105); poke8(a + 2, 0)
    poke8(b + 0, 104); poke8(b + 1, 111); poke8(b + 2, 0)
    let r = streq(a, b)
    if r == 0 { 0 } else { 1 }
}

fn test_starts_with_yes() -> i64 {
    let mut buf[10]
    poke8(buf + 0, 104); poke8(buf + 1, 105); poke8(buf + 2, 32)
    poke8(buf + 3, 109); poke8(buf + 4, 117); poke8(buf + 5, 110)
    poke8(buf + 6, 100); poke8(buf + 7, 111); poke8(buf + 8, 110)
    poke8(buf + 9, 0)
    let mut pre[2]
    poke8(pre + 0, 104); poke8(pre + 1, 105)
    let r = starts_with(buf, pre)
    if r == 1 { 0 } else { 1 }
}

fn test_starts_with_no() -> i64 {
    let mut buf[10]
    poke8(buf + 0, 104); poke8(buf + 1, 105); poke8(buf + 2, 0)
    let mut pre[2]
    poke8(pre + 0, 97); poke8(pre + 1, 98)
    let r = starts_with(buf, pre)
    if r == 0 { 0 } else { 1 }
}

fn test_itoa() -> i64 {
    let mut buf[20]
    let n = itoa(42, buf)
    if n != 2 { return 1 }
    if peek8(buf + 0) != 52 { return 1 }
    if peek8(buf + 1) != 50 { return 1 }
    if peek8(buf + 2) != 0 { return 1 }
    0
}

fn test_itoa_zero() -> i64 {
    let mut buf[20]
    let n = itoa(0, buf)
    if n != 1 { return 1 }
    if peek8(buf + 0) != 48 { return 1 }
    0
}

fn test_itoa_negative() -> i64 {
    let mut buf[20]
    let n = itoa(-1, buf)
    if n != 2 { return 1 }
    if peek8(buf + 0) != 45 { return 1 }
    if peek8(buf + 1) != 49 { return 1 }
    0
}

fn test_atoi() -> i64 {
    let mut buf[10]
    poke8(buf + 0, 50); poke8(buf + 1, 55); poke8(buf + 2, 0)
    let n = atoi(buf)
    if n == 27 { 0 } else { 1 }
}

fn test_atoi_negative() -> i64 {
    let mut buf[10]
    poke8(buf + 0, 45); poke8(buf + 1, 49); poke8(buf + 2, 0)
    let n = atoi(buf)
    if n == -1 { 0 } else { 1 }
}

fn test_find_byte_found() -> i64 {
    let mut buf[10]
    poke8(buf + 0, 104); poke8(buf + 1, 105); poke8(buf + 2, 32)
    poke8(buf + 3, 109); poke8(buf + 4, 117); poke8(buf + 5, 110)
    poke8(buf + 6, 100); poke8(buf + 7, 111); poke8(buf + 8, 110)
    poke8(buf + 9, 0)
    let idx = find_byte(buf, 9, 109)
    if idx == 3 { 0 } else { 1 }
}

fn test_find_byte_notfound() -> i64 {
    let mut buf[10]
    poke8(buf + 0, 104); poke8(buf + 1, 105); poke8(buf + 2, 0)
    let idx = find_byte(buf, 3, 97)
    if idx == -1 { 0 } else { 1 }
}

fn test_memcpy() -> i64 {
    let mut src[10]
    let mut dst[10]
    poke8(src + 0, 11); poke8(src + 1, 22); poke8(src + 2, 33)
    memcpy(dst, src, 3)
    let r0 = peek8(dst + 0)
    let r1 = peek8(dst + 1)
    let r2 = peek8(dst + 2)
    if r0 == 11 && r1 == 22 && r2 == 33 { 0 } else { 1 }
}

fn test_strlen_empty_check() -> i64 {
    let mut buf[20]
    poke8(buf + 0, 0)
    let n = strlen(buf)
    if n == 0 { 0 } else { 1 }
}

fn main() -> i64 {
    let mut failures = 0

    let r = test_strlen()
    if r != 0 { failures = failures + 1 }

    let r = test_strlen_empty()
    if r != 0 { failures = failures + 1 }

    let r = test_strlen_longer()
    if r != 0 { failures = failures + 1 }

    let r = test_memcmp_equal()
    if r != 0 { failures = failures + 1 }

    let r = test_memcmp_diff()
    if r != 0 { failures = failures + 1 }

    let r = test_streq_yes()
    if r != 0 { failures = failures + 1 }

    let r = test_streq_no()
    if r != 0 { failures = failures + 1 }

    let r = test_starts_with_yes()
    if r != 0 { failures = failures + 1 }

    let r = test_starts_with_no()
    if r != 0 { failures = failures + 1 }

    let r = test_itoa()
    if r != 0 { failures = failures + 1 }

    let r = test_itoa_zero()
    if r != 0 { failures = failures + 1 }

    let r = test_itoa_negative()
    if r != 0 { failures = failures + 1 }

    let r = test_atoi()
    if r != 0 { failures = failures + 1 }

    let r = test_atoi_negative()
    if r != 0 { failures = failures + 1 }

    let r = test_find_byte_found()
    if r != 0 { failures = failures + 1 }

    let r = test_find_byte_notfound()
    if r != 0 { failures = failures + 1 }

    let r = test_memcpy()
    if r != 0 { failures = failures + 1 }

    let r = test_strlen_empty_check()
    if r != 0 { failures = failures + 1 }

    print("")
    print_int(failures)
    print("")

    failures
}
