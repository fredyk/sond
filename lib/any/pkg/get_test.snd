// Copyright 2026 Jhon Magdalena Vila and the Sond contributors
//
// Tests for the package manager (lib/any/pkg/get.snd). None of them leave the machine:
// the GitHub API is answered either by a table of recorded responses the seam in get.snd
// serves, or by a minimal TLS server on loopback whose certificates chain to a test root.
// A test that depended on the real GitHub would go red on its own one day, without anyone
// having touched anything.
//
// The module under the hammer is the two-file conformance vector of canon.snd: "año.snd"
// ("fn añadir() -> i64 { 42 }\n") and "sub/niño.snd" ("fn niño() -> i64 { 7 }\n"), whose
// canonical SHA-256 is the frozen value below. If a served tree does not hash to it, the
// hash moved, not the test.

include "any/pkg/get.snd"
include "x86_64/linux/testing.snd"

let TEST_SHA: string = "1111222233334444555566667777888899990000"
let EXPECTED_HASH: string = "923345ba8a4816339aeac609bef11aaa7dd88d46459bf8886ed8cc68833b3a8d"

// Recorded request targets (what pkg_raw_get asks for) and the raw responses it must answer.
let H_PATH_COMMITS: string = "/repos/example/strings/commits/v1.4.2"
let H_PATH_REPO: string = "/repos/example/strings"
let H_PATH_TREE_BASE: string = "/repos/example/strings/git/trees/"
let H_PATH_RAW_A: string = "/example/strings/1111222233334444555566667777888899990000/a%C3%B1o.snd"
let H_PATH_RAW_SUB: string = "/example/strings/1111222233334444555566667777888899990000/sub/ni%C3%B1o.snd"
let H_PATH_RAW_BAD: string = "/example/strings/1111222233334444555566667777888899990000/a%C3%B1o.snd"

let R_COMMITS_OK: string = "HTTP/1.1 200 OK\r\n\r\n{\"sha\":\"1111222233334444555566667777888899990000\"}"
let R_REPO_OK: string = "HTTP/1.1 200 OK\r\n\r\n{\"full_name\":\"example/strings\"}"
let R_404: string = "HTTP/1.1 404 Not Found\r\n\r\n{\"message\":\"Not Found\"}"
let R_TREE_OK: string = "HTTP/1.1 200 OK\r\n\r\n{\"sha\":\"1111222233334444555566667777888899990000\",\"truncated\":false,\"tree\":[{\"path\":\"año.snd\",\"mode\":\"100644\",\"type\":\"blob\",\"sha\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"size\":27,\"url\":\"u\"},{\"path\":\"sub/niño.snd\",\"mode\":\"100644\",\"type\":\"blob\",\"sha\":\"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\",\"size\":24,\"url\":\"u\"},{\"path\":\"README.md\",\"mode\":\"100644\",\"type\":\"blob\",\"sha\":\"cccccccccccccccccccccccccccccccccccccccc\",\"size\":10,\"url\":\"u\"}]}"
let R_TRUNCATED: string = "HTTP/1.1 200 OK\r\n\r\n{\"sha\":\"1111222233334444555566667777888899990000\",\"truncated\":true,\"tree\":[]}"
let R_RAW_A: string = "HTTP/1.1 200 OK\r\n\r\nfn añadir() -> i64 { 42 }\n"
let R_RAW_SUB: string = "HTTP/1.1 200 OK\r\n\r\nfn niño() -> i64 { 7 }\n"
let R_RAW_A_CHANGED: string = "HTTP/1.1 200 OK\r\n\r\nfn añadir() -> i64 { 0 }\n"

let H_TREE_CHANGED: string = "/repos/example/strings/git/trees/1111222233334444555566667777888899990000?recursive=1"

let R_TREE_NOSND: string = "HTTP/1.1 200 OK\r\n\r\n{\"sha\":\"1111222233334444555566667777888899990000\",\"truncated\":false,\"tree\":[{\"path\":\"README.md\",\"mode\":\"100644\",\"type\":\"blob\",\"sha\":\"cccccccccccccccccccccccccccccccccccccccc\",\"size\":10,\"url\":\"u\"}]}"

// A SECOND commit of the same repo (what "sond get ...@v1.4.3" would resolve to), with its
// own tree and raw-file targets: same content, different commit pin in the from URL.
let TEST_SHA2: string = "4444555566667777888899990000111122223333"
let H_COMMITS2: string = "/repos/example/strings/commits/v1.4.3"
let H_TREE2: string = "/repos/example/strings/git/trees/4444555566667777888899990000111122223333?recursive=1"
let H_RAW_A2: string = "/example/strings/4444555566667777888899990000111122223333/a%C3%B1o.snd"
let H_RAW_SUB2: string = "/example/strings/4444555566667777888899990000111122223333/sub/ni%C3%B1o.snd"
let R_COMMITS_OK2: string = "HTTP/1.1 200 OK\r\n\r\n{\"sha\":\"4444555566667777888899990000111122223333\"}"

let mut h_rec_cnt = 0

fn h_rec_add(path: i64, resp: i64) {
    // The table is 16 slots. Overflowing it is not swallowed in silence: nothing is written, and
    // the missing slot makes pkg_raw_get return -2 for that target, which is a RED test you see.
    if h_rec_cnt >= 0 && h_rec_cnt < 16 {
        pkg_rec_path[h_rec_cnt] = path
        pkg_rec_resp[h_rec_cnt] = resp
        h_rec_cnt = h_rec_cnt + 1
    }
}

fn h_rec_clear() {
    h_rec_cnt = 0
    pkg_rec_n = 0
    pkg_rec_calls = 0
}

// Arms the recorded-response seam with the standard success fixture: the commits endpoint,
// the recursive tree and the two module files (a non-.snd README.md is in the tree but must
// NOT end up fetched or cached).
fn h_rec_ok() {
    h_rec_clear()
    h_rec_add(H_PATH_COMMITS.utf8, R_COMMITS_OK.utf8)
    h_rec_add(H_TREE_CHANGED.utf8, R_TREE_OK.utf8)
    h_rec_add(H_PATH_RAW_A.utf8, R_RAW_A.utf8)
    h_rec_add(H_PATH_RAW_SUB.utf8, R_RAW_SUB.utf8)
    pkg_rec_n = h_rec_cnt
}

// Arms the same module at a different ref (v1.4.3 -> TEST_SHA2), for the "replace the block
// of another ref" test.
fn h_rec_ok2() {
    h_rec_clear()
    h_rec_add(H_COMMITS2.utf8, R_COMMITS_OK2.utf8)
    h_rec_add(H_TREE2.utf8, R_TREE_OK.utf8)
    h_rec_add(H_RAW_A2.utf8, R_RAW_A.utf8)
    h_rec_add(H_RAW_SUB2.utf8, R_RAW_SUB.utf8)
    pkg_rec_n = h_rec_cnt
}

// Writes the bytes buffer `nb` to `path` (creating the parents first).
fn h_write_file(path: i64, nb: i64) {
    pkg_mkdir_parents(path)
    let fd = open_file(path, O_WRONLY | O_CREAT | O_TRUNC, PKG_FILE_MODE)
    assert(fd >= 0)
    let w = write_buf(fd, peek64(nb), bytes_len(nb))
    close_fd(fd)
    assert_eq(w, bytes_len(nb))
}

// Points the managed globals at the given test dir and clears that dir.
fn h_cfg(troot: i64, cache: i64, deps: i64) {
    pkg_resolve_dns = 0
    pkg_roots = 0
    pkg_nroots = 0
    pkg_now = 0
    pkg_cache_root = cache
    pkg_deps_path = deps
    pkg_rmtree(troot)
}

// ── plain unit tests ────────────────────────────────────────────────────────────────────────

test "pkg: parse splits host/owner/repo/ref/name" {
    let spec: string = "github.com/example/strings@v1.4.2"
    let hb[128]
    let ob[128]
    let rb[128]
    let fb[128]
    let nb[128]
    assert_eq(pkg_parse_spec(spec.utf8, hb, ob, rb, fb, nb), 0)
    let hostw: string = "github.com"
    assert_eq(streq(hb, hostw.utf8), 1)
    let ow: string = "example"
    assert_eq(streq(ob, ow.utf8), 1)
    let rw: string = "strings"
    assert_eq(streq(rb, rw.utf8), 1)
    let fw: string = "v1.4.2"
    assert_eq(streq(fb, fw.utf8), 1)
    assert_eq(streq(nb, rw.utf8), 1)
}

test "pkg: a spec without a host defaults to github.com" {
    let spec: string = "example/strings@v1.4.2"
    let hb[128]
    let ob[128]
    let rb[128]
    let fb[128]
    let nb[128]
    assert_eq(pkg_parse_spec(spec.utf8, hb, ob, rb, fb, nb), 0)
    let hostw: string = "github.com"
    assert_eq(streq(hb, hostw.utf8), 1)
}

test "pkg: malformed specs are refused" {
    let hb[128]
    let ob[128]
    let rb[128]
    let fb[128]
    let nb[128]
    let s1: string = "no-at-sign-here"
    let s2: string = "owner/repo"                 // no @ref
    let s3: string = "owner/repo@"                // empty ref
    let s4: string = "@ref"                       // no path
    assert_ne(pkg_parse_spec(s1.utf8, hb, ob, rb, fb, nb), 0)
    assert_ne(pkg_parse_spec(s2.utf8, hb, ob, rb, fb, nb), 0)
    assert_ne(pkg_parse_spec(s3.utf8, hb, ob, rb, fb, nb), 0)
    assert_ne(pkg_parse_spec(s4.utf8, hb, ob, rb, fb, nb), 0)
}

test "pkg: url encoding keeps ASCII and percent-encodes the accented bytes" {
    let o: string = "example"
    let r: string = "strings"
    let p: string = "sub/niño.snd"
    let u = pkg_url_path(o.utf8, r.utf8, TEST_SHA.utf8, p.utf8)
    let wantw: string = "/example/strings/1111222233334444555566667777888899990000/sub/ni%C3%B1o.snd"
    assert_eq(streq(u, wantw.utf8), 1)
}

// ── recorded-seam integration tests ──────────────────────────────────────────────────────────
// Every request pkg_get would make against GitHub is answered from the recorded table
// (pkg_rec_n > 0 arms the seam), so the whole fetch runs with no network and no sockets.

// 1 if a regular file exists at the cstr path `path`.
fn h_fexists(path: i64) -> i64 {
    let fd = open_file(path, O_RDONLY, 0)
    if fd >= 0 { close_fd(fd); return 1 }
    0
}

// The exact deps.snd bytes a successful get of the standard fixture must leave behind:
// "use strings = sond:sha256:<hash>\n    from \"github.com/example/strings@<sha>\"\n
//     grants {}\n".
fn h_expect_deps() -> i64 {
    let b = bytes_new()
    let u: string = "use "
    bytes_append_str(b, u)
    let nm: string = "strings"
    bytes_append_str(b, nm)
    let e1: string = " = sond:sha256:"
    bytes_append_str(b, e1)
    bytes_append_cstr(b, EXPECTED_HASH.utf8)
    bytes_push(b, 10)
    let f1: string = "    from \""
    bytes_append_str(b, f1)
    let src: string = "github.com/example/strings"
    bytes_append_str(b, src)
    bytes_push(b, 64)
    bytes_append_cstr(b, TEST_SHA.utf8)
    bytes_push(b, 34)
    bytes_push(b, 10)
    let g1: string = "    grants {}"
    bytes_append_str(b, g1)
    bytes_push(b, 10)
    b
}

fn pkg_test_anio() -> i64 { let s: string = "año.snd"; s.utf8 }
fn pkg_test_subnino() -> i64 { let s: string = "sub/niño.snd"; s.utf8 }
fn pkg_test_readme() -> i64 { let s: string = "README.md"; s.utf8 }
fn pkg_test_modname() -> i64 { let s: string = "strings"; s.utf8 }

// Builds the exact `use` block bytes pkg_deps_write produces, for hand-written fixtures.
fn h_block(name: i64, src: i64, sha: i64, hash: i64) -> i64 {
    let b = bytes_new()
    let u: string = "use "
    bytes_append_str(b, u)
    bytes_append_cstr(b, name)
    let e1: string = " = sond:sha256:"
    bytes_append_str(b, e1)
    bytes_append_cstr(b, hash)
    bytes_push(b, 10)
    let f1: string = "    from \""
    bytes_append_str(b, f1)
    bytes_append_cstr(b, src)
    bytes_push(b, 64)
    bytes_append_cstr(b, sha)
    bytes_push(b, 34)
    bytes_push(b, 10)
    let g1: string = "    grants {}"
    bytes_append_str(b, g1)
    bytes_push(b, 10)
    b
}

test "pkg: get fetches the module, caches it under the frozen hash, and skips the README" {
    let troot: string = "/tmp/sond-pkg-t1"
    let cac: string = "/tmp/sond-pkg-t1/cache"
    let dep: string = "/tmp/sond-pkg-t1/deps.snd"
    h_cfg(troot.utf8, cac.utf8, dep.utf8)
    h_rec_ok()
    let spec: string = "github.com/example/strings@v1.4.2"
    assert_eq(pkg_get(spec.utf8), 0)
    // exactly four recorded fetches: commits, tree, and the two .snd files. A fifth
    // request (for the README that sits in the tree) would leave the seam's -2 path.
    assert_eq(pkg_rec_calls, 4)
    let mdir = pkg_join2(cac.utf8, EXPECTED_HASH.utf8)
    assert_eq(pkg_dir_exists(mdir), 1)
    let f1 = pkg_join2(mdir, pkg_test_anio())
    assert_eq(h_fexists(f1), 1)
    let f2 = pkg_join2(mdir, pkg_test_subnino())
    assert_eq(h_fexists(f2), 1)
    let f3 = pkg_join2(mdir, pkg_test_readme())
    assert_eq(h_fexists(f3), 0)
    // año.snd content is the served body, byte for byte
    let fbuf = heap_alloc(4096)
    let flen = read_file(f1, fbuf, 4096)
    assert(flen > 0)
    let want: string = "fn añadir() -> i64 { 42 }\n"
    assert_eq(bytes_eq(bytes_from_raw(fbuf, flen), bytes_from_cstr(want.utf8)), 1)
    // deps.snd pins the resolved commit and the content hash
    let dbuf = heap_alloc(4096)
    let dlen = read_file(dep.utf8, dbuf, 4096)
    assert(dlen > 0)
    assert_eq(bytes_eq(bytes_from_raw(dbuf, dlen), h_expect_deps()), 1)
}

test "pkg: a second get of the same ref downloads nothing and rewrites nothing" {
    let troot: string = "/tmp/sond-pkg-t2"
    let cac: string = "/tmp/sond-pkg-t2/cache"
    let dep: string = "/tmp/sond-pkg-t2/deps.snd"
    h_cfg(troot.utf8, cac.utf8, dep.utf8)
    h_rec_ok()
    let spec: string = "github.com/example/strings@v1.4.2"
    assert_eq(pkg_get(spec.utf8), 0)
    assert_eq(pkg_rec_calls, 4)
    let dbuf1 = heap_alloc(4096)
    let dlen1 = read_file(dep.utf8, dbuf1, 4096)
    assert(dlen1 > 0)
    let dep1 = bytes_from_raw(dbuf1, dlen1)
    // second get: only the commit re-resolution is replayed, never the tree or the files
    assert_eq(pkg_get(spec.utf8), 0)
    assert_eq(pkg_rec_calls, 5)
    let dbuf2 = heap_alloc(4096)
    let dlen2 = read_file(dep.utf8, dbuf2, 4096)
    assert(dlen2 > 0)
    assert_eq(bytes_eq(dep1, bytes_from_raw(dbuf2, dlen2)), 1)
    let mdir = pkg_join2(cac.utf8, EXPECTED_HASH.utf8)
    assert_eq(pkg_dir_exists(mdir), 1)
}

test "pkg: a module half written never appears under the hash name" {
    let troot: string = "/tmp/sond-pkg-t3"
    let cac: string = "/tmp/sond-pkg-t3/cache"
    let dep: string = "/tmp/sond-pkg-t3/deps.snd"
    h_cfg(troot.utf8, cac.utf8, dep.utf8)
    // Two records: the second one (a.snd/b.snd) cannot be created because a.snd exists as a
    // regular file, so the write fails mid-way. Whatever was written must be cleaned up and
    // the hash name must never appear.
    let recs[2]
    let p1: string = "a.snd"
    let p2: string = "a.snd/b.snd"
    let d1: string = "AAA"
    let d2: string = "BBB"
    let r1 = heap_alloc(24)
    poke64(r1, p1.utf8)
    poke64(r1 + 8, d1.utf8)
    poke64(r1 + 16, 3)
    poke64(recs + 0, r1)
    let r2 = heap_alloc(24)
    poke64(r2, p2.utf8)
    poke64(r2 + 8, d2.utf8)
    poke64(r2 + 16, 3)
    poke64(recs + 8, r2)
    assert_eq(pkg_write_cache(EXPECTED_HASH.utf8, recs, 2), 0)
    let mdir = pkg_join2(cac.utf8, EXPECTED_HASH.utf8)
    assert_eq(pkg_dir_exists(mdir), 0)
    let tmp = pkg_cat4(cac.utf8, pkg_slash_lit(), pkg_getdash_lit(), EXPECTED_HASH.utf8)
    assert_eq(pkg_dir_exists(tmp), 0)
}

test "pkg: verify is silent when the cache matches and faults when it does not" {
    let troot: string = "/tmp/sond-pkg-t4"
    let cac: string = "/tmp/sond-pkg-t4/cache"
    let dep: string = "/tmp/sond-pkg-t4/deps.snd"
    h_cfg(troot.utf8, cac.utf8, dep.utf8)
    h_rec_ok()
    let spec: string = "github.com/example/strings@v1.4.2"
    assert_eq(pkg_get(spec.utf8), 0)
    assert_eq(pkg_verify(), 0)
    // rewrite año.snd in the cache with different bytes: the content no longer hashes to
    // what deps.snd recorded, so verify must flag the module.
    let mdir = pkg_join2(cac.utf8, EXPECTED_HASH.utf8)
    let f1 = pkg_join2(mdir, pkg_test_anio())
    let fd = open_file(f1, O_WRONLY | O_TRUNC, 0)
    assert(fd >= 0)
    let junk: string = "fn añadir() -> i64 { 0 }\n"
    assert_eq(write_buf(fd, junk.utf8, strlen(junk.utf8)), strlen(junk.utf8))
    close_fd(fd)
    assert_eq(pkg_verify(), 1)
}

test "pkg: get reports -2 when the repo does not exist" {
    let troot: string = "/tmp/sond-pkg-t5"
    let cac: string = "/tmp/sond-pkg-t5/cache"
    let dep: string = "/tmp/sond-pkg-t5/deps.snd"
    h_cfg(troot.utf8, cac.utf8, dep.utf8)
    h_rec_clear()
    h_rec_add(H_PATH_COMMITS.utf8, R_404.utf8)
    h_rec_add(H_PATH_REPO.utf8, R_404.utf8)
    pkg_rec_n = h_rec_cnt
    let spec: string = "github.com/example/strings@v1.4.2"
    assert_eq(pkg_get(spec.utf8), 0 - 2)
}

test "pkg: get reports -3 when the ref does not exist" {
    let troot: string = "/tmp/sond-pkg-t6"
    let cac: string = "/tmp/sond-pkg-t6/cache"
    let dep: string = "/tmp/sond-pkg-t6/deps.snd"
    h_cfg(troot.utf8, cac.utf8, dep.utf8)
    h_rec_clear()
    h_rec_add(H_PATH_COMMITS.utf8, R_404.utf8)
    h_rec_add(H_PATH_REPO.utf8, R_REPO_OK.utf8)
    pkg_rec_n = h_rec_cnt
    let spec: string = "github.com/example/strings@v1.4.2"
    assert_eq(pkg_get(spec.utf8), 0 - 3)
}

test "pkg: get reports -4 when the git tree is truncated" {
    let troot: string = "/tmp/sond-pkg-t7"
    let cac: string = "/tmp/sond-pkg-t7/cache"
    let dep: string = "/tmp/sond-pkg-t7/deps.snd"
    h_cfg(troot.utf8, cac.utf8, dep.utf8)
    h_rec_clear()
    h_rec_add(H_PATH_COMMITS.utf8, R_COMMITS_OK.utf8)
    h_rec_add(H_TREE_CHANGED.utf8, R_TRUNCATED.utf8)
    pkg_rec_n = h_rec_cnt
    let spec: string = "github.com/example/strings@v1.4.2"
    assert_eq(pkg_get(spec.utf8), 0 - 4)
}

test "pkg: get reports -9 when the module has no .snd files" {
    let troot: string = "/tmp/sond-pkg-t8"
    let cac: string = "/tmp/sond-pkg-t8/cache"
    let dep: string = "/tmp/sond-pkg-t8/deps.snd"
    h_cfg(troot.utf8, cac.utf8, dep.utf8)
    h_rec_clear()
    h_rec_add(H_PATH_COMMITS.utf8, R_COMMITS_OK.utf8)
    h_rec_add(H_TREE_CHANGED.utf8, R_TREE_NOSND.utf8)
    pkg_rec_n = h_rec_cnt
    let spec: string = "github.com/example/strings@v1.4.2"
    assert_eq(pkg_get(spec.utf8), 0 - 9)
}

test "pkg: a get of another ref replaces that block and leaves comments and other entries intact" {
    let troot: string = "/tmp/sond-pkg-t9"
    let cac: string = "/tmp/sond-pkg-t9/cache"
    let dep: string = "/tmp/sond-pkg-t9/deps.snd"
    h_cfg(troot.utf8, cac.utf8, dep.utf8)
    // hand-write a deps.snd with a comment, module A pinned at TEST_SHA, and a second module
    let b = bytes_new()
    let c: string = "// first batch of dependencies\n"
    bytes_append_str(b, c)
    let srcA: string = "github.com/example/strings"
    let srcB: string = "github.com/example/json"
    let nameB: string = "json"
    let hashB: string = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    let shaB: string = "9999999999999999999999999999999999999999"
    let blkA = h_block(pkg_test_modname(), srcA.utf8, TEST_SHA.utf8, EXPECTED_HASH.utf8)
    let blkB = h_block(nameB.utf8, srcB.utf8, shaB.utf8, hashB.utf8)
    bytes_append(b, blkA)
    bytes_append(b, blkB)
    h_write_file(dep.utf8, b)
    // now get the SAME module at a different ref: only its block moves
    h_rec_ok2()
    let spec: string = "github.com/example/strings@v1.4.3"
    assert_eq(pkg_get(spec.utf8), 0)
    let want = bytes_new()
    bytes_append_str(want, c)
    bytes_append(want, blkB)
    let blkA2 = h_block(pkg_test_modname(), srcA.utf8, TEST_SHA2.utf8, EXPECTED_HASH.utf8)
    bytes_append(want, blkA2)
    let dbuf = heap_alloc(4096)
    let dlen = read_file(dep.utf8, dbuf, 4096)
    assert(dlen > 0)
    assert_eq(bytes_eq(bytes_from_raw(dbuf, dlen), want), 1)
}

test "pkg: verify reads several blocks, including one without a from" {
    let troot: string = "/tmp/sond-pkg-t10"
    let cac: string = "/tmp/sond-pkg-t10/cache"
    let dep: string = "/tmp/sond-pkg-t10/deps.snd"
    h_cfg(troot.utf8, cac.utf8, dep.utf8)
    h_rec_ok()
    let spec: string = "github.com/example/strings@v1.4.2"
    assert_eq(pkg_get(spec.utf8), 0)
    // a from-less entry shares the same content hash, so no extra cache dir is needed
    let b = bytes_new()
    let srcA: string = "github.com/example/strings"
    bytes_append(b, h_block(pkg_test_modname(), srcA.utf8, TEST_SHA.utf8, EXPECTED_HASH.utf8))
    let u2: string = "use json = sond:sha256:"
    bytes_append_str(b, u2)
    bytes_append_cstr(b, EXPECTED_HASH.utf8)
    bytes_push(b, 10)
    h_write_file(dep.utf8, b)
    assert_eq(pkg_verify(), 0)
}

// ── The deps.snd line parsers ───────────────────────────────────────────────────────────────
//
// These take no network and were the biggest hole in this file: two thirds of `pkg_parse_use`
// is `return 0`, and every one of those returns is a line of a deps.snd that must NOT be read
// as a pin. A `use` line accepted when it should have been refused resolves a module to a hash
// nobody wrote down, so the refusals are the part worth pinning, not the happy path.

let USE_OK: string = "use strings = sond:sha256:abc123"
// Where "sond:sha256:" starts in USE_OK: "use strings = " is 14 bytes.
let USE_SCHEME_AT = 14

// A bytes buffer holding the cstr `s` with the byte at `i` replaced by `c`.
fn h_alterado(s: i64, i: i64, c: i64) -> i64 {
    let b = bytes_new()
    let n = strlen(s)
    let mut k = 0
    for k < n {
        if k == i { bytes_push(b, c) } else { bytes_push(b, peek8(s + k)) }
        k = k + 1
    }
    b
}

test "pkg: a well formed use line yields the name and the bare hash" {
    let b = bytes_from_str("use strings = sond:sha256:abc123")
    let no2[1]
    let nl[1]
    let ho[1]
    let hl[1]
    assert_eq(pkg_parse_use(b, 0, bytes_len(b), no2, nl, ho, hl), 1)
    assert_eq(nl[0], 7)                 // "strings"
    assert_eq(bytes_get(b, no2[0]), 115) // 's'
    // The hash comes back WITHOUT the scheme, because that is the name of the cache directory.
    assert_eq(hl[0], 6)
    assert_eq(bytes_get(b, ho[0]), 97)  // 'a'
}

test "pkg: a use line whose scheme prefix is wrong in any single byte is refused" {
    // Twelve separate comparisons in the parser, each one a way of accepting a hash under an
    // algorithm nobody named. Checked byte by byte rather than once, so a missing comparison
    // cannot hide behind the eleven that are there.
    let no2[1]
    let nl[1]
    let ho[1]
    let hl[1]
    for i in 0..12 {
        let malo = h_alterado(USE_OK.utf8, USE_SCHEME_AT + i, 88) // 'X'
        assert_eq(pkg_parse_use(malo, 0, bytes_len(malo), no2, nl, ho, hl), 0)
    }
}

test "pkg: a use line missing any of its parts is refused" {
    let no2[1]
    let nl[1]
    let ho[1]
    let hl[1]
    // A keyword that is not "use", in each of its three bytes.
    for i in 0..3 {
        let malo = h_alterado(USE_OK.utf8, i, 88)
        assert_eq(pkg_parse_use(malo, 0, bytes_len(malo), no2, nl, ho, hl), 0)
    }
    let vacia = bytes_from_str("")
    assert_eq(pkg_parse_use(vacia, 0, bytes_len(vacia), no2, nl, ho, hl), 0)
    let corta = bytes_from_str("us strings = sond:sha256:abc123")
    assert_eq(pkg_parse_use(corta, 0, bytes_len(corta), no2, nl, ho, hl), 0)
    let sin_nombre = bytes_from_str("use = sond:sha256:abc123")
    assert_eq(pkg_parse_use(sin_nombre, 0, bytes_len(sin_nombre), no2, nl, ho, hl), 0)
    let solo_nombre = bytes_from_str("use strings")
    assert_eq(pkg_parse_use(solo_nombre, 0, bytes_len(solo_nombre), no2, nl, ho, hl), 0)
    let sin_igual = bytes_from_str("use strings sond:sha256:abc123")
    assert_eq(pkg_parse_use(sin_igual, 0, bytes_len(sin_igual), no2, nl, ho, hl), 0)
    let prefijo_cortado = bytes_from_str("use strings = sond:sha")
    assert_eq(pkg_parse_use(prefijo_cortado, 0, bytes_len(prefijo_cortado), no2, nl, ho, hl), 0)
    // The scheme with nothing after it: an empty hash names the cache root itself.
    let sin_hash = bytes_from_str("use strings = sond:sha256:")
    assert_eq(pkg_parse_use(sin_hash, 0, bytes_len(sin_hash), no2, nl, ho, hl), 0)
}

test "pkg: a from line gives its value with the quotes off, and refuses what is not one" {
    let vo[1]
    let vl[1]
    let con = bytes_from_str("    from \"github.com/fredyk/sond-strings@1111\"   ")
    assert_eq(pkg_line_is_from(con, 0, bytes_len(con), vo, vl), 1)
    assert_eq(vl[0], 35)
    assert_eq(bytes_get(con, vo[0]), 103) // 'g', the quote is gone
    // Unquoted is accepted too: the quotes are convention in what `sond get` writes, not syntax.
    let sin = bytes_from_str("from github.com/x/y@1")
    assert_eq(pkg_line_is_from(sin, 0, bytes_len(sin), vo, vl), 1)
    assert_eq(vl[0], 16)
    for i in 0..4 {
        let malo = h_alterado("from github.com/x/y@1".utf8, i, 88)
        assert_eq(pkg_line_is_from(malo, 0, bytes_len(malo), vo, vl), 0)
    }
    let vacia = bytes_from_str("")
    assert_eq(pkg_line_is_from(vacia, 0, bytes_len(vacia), vo, vl), 0)
    let otra = bytes_from_str("grants {}")
    assert_eq(pkg_line_is_from(otra, 0, bytes_len(otra), vo, vl), 0)
    let sin_valor = bytes_from_str("from   ")
    assert_eq(pkg_line_is_from(sin_valor, 0, bytes_len(sin_valor), vo, vl), 0)
    // Two quotes and nothing between them is not a source URL.
    let comillas = bytes_from_str("from \"\"")
    assert_eq(pkg_line_is_from(comillas, 0, bytes_len(comillas), vo, vl), 0)
}

test "pkg: a grants line is recognised, and a word that merely looks like one is not" {
    let ok = bytes_from_str("  grants {}")
    assert_eq(pkg_line_is_grants(ok, 0, bytes_len(ok)), 1)
    for i in 0..6 {
        let malo = h_alterado("grants {}".utf8, i, 88)
        assert_eq(pkg_line_is_grants(malo, 0, bytes_len(malo)), 0)
    }
    let vacia = bytes_from_str("")
    assert_eq(pkg_line_is_grants(vacia, 0, bytes_len(vacia)), 0)
    let larga = bytes_from_str("granted {}")
    assert_eq(pkg_line_is_grants(larga, 0, bytes_len(larga)), 0)
}

test "pkg: fields are counted past the runs of spaces, and a missing one says so" {
    let b = bytes_from_str("   use   strings   =  x")
    let o[1]
    let l[1]
    assert_eq(pkg_field(b, 0, bytes_len(b), 0, o, l), 1)
    assert_eq(l[0], 3)
    assert_eq(pkg_field(b, 0, bytes_len(b), 1, o, l), 1)
    assert_eq(l[0], 7)
    assert_eq(pkg_field(b, 0, bytes_len(b), 3, o, l), 1)
    assert_eq(l[0], 1)
    assert_eq(pkg_field(b, 0, bytes_len(b), 4, o, l), 0)
    let blancos = bytes_from_str("      ")
    assert_eq(pkg_field(blancos, 0, bytes_len(blancos), 0, o, l), 0)
}

// ── The pieces a spec is taken apart with ───────────────────────────────────────────────────

// A heap cstr of `n` copies of 'a', to overrun the 128-byte fields of a spec.
fn h_filler(n: i64) -> i64 {
    let p = heap_alloc(n + 1)
    for i in 0..n { poke8(p + i, 97) }
    poke8(p + n, 0)
    p
}

test "pkg: a spec is refused when any of its parts does not fit its 128-byte field" {
    // The buffers a caller hands in are fixed size, and a repo name longer than one of them is
    // exactly what an attacker-supplied spec would be. Refused whole, never copied in part.
    let host[16]
    let owner[16]
    let repo[16]
    let ref[16]
    let name[16]
    let long_s = h_filler(130)
    let tail: string = "@v1"
    let slash: string = "/"
    let short_s: string = "x"
    // host too long
    let e1 = pkg_cat4(long_s, slash.utf8, short_s.utf8, slash.utf8)
    assert_eq(pkg_parse_spec(pkg_cat3(e1, short_s.utf8, tail.utf8), host, owner, repo, ref, name), 0 - 1)
    // owner too long
    let e2 = pkg_cat4(short_s.utf8, slash.utf8, long_s, slash.utf8)
    assert_eq(pkg_parse_spec(pkg_cat3(e2, short_s.utf8, tail.utf8), host, owner, repo, ref, name), 0 - 1)
    // repo too long
    let e3 = pkg_cat4(short_s.utf8, slash.utf8, short_s.utf8, slash.utf8)
    assert_eq(pkg_parse_spec(pkg_cat3(e3, long_s, tail.utf8), host, owner, repo, ref, name), 0 - 1)
    // ref too long
    let at_sign: string = "@"
    let e4 = pkg_cat4(short_s.utf8, slash.utf8, short_s.utf8, at_sign.utf8)
    assert_eq(pkg_parse_spec(pkg_cat2(e4, long_s), host, owner, repo, ref, name), 0 - 1)
}

test "pkg: a spec is refused when it does not name exactly a host, an owner and a repo" {
    let host[16]
    let owner[16]
    let repo[16]
    let ref[16]
    let name[16]
    let uno: string = "repo@v1"
    assert_eq(pkg_parse_spec(uno.utf8, host, owner, repo, ref, name), 0 - 1)
    let cuatro: string = "github.com/a/b/c@v1"
    assert_eq(pkg_parse_spec(cuatro.utf8, host, owner, repo, ref, name), 0 - 1)
    // A leading slash opens an empty segment, which is not a host.
    let vacio: string = "/owner/repo@v1"
    assert_eq(pkg_parse_spec(vacio.utf8, host, owner, repo, ref, name), 0 - 1)
}

test "pkg: the scheme is accepted in either form and does not become part of the host" {
    let host[16]
    let owner[16]
    let repo[16]
    let ref[16]
    let name[16]
    assert_eq(pkg_parse_spec("https://github.com/fredyk/sond-strings@v1".utf8, host, owner, repo, ref, name), 0)
    assert_eq(peek8(host), 103) // 'g' of github.com, not 'h' of https
    assert_eq(pkg_parse_spec("http://github.com/fredyk/sond-strings@v1".utf8, host, owner, repo, ref, name), 0)
    assert_eq(peek8(host), 103)
}

test "pkg: a prefix longer than the buffer it is compared against does not match" {
    // The guard that keeps the "https://" comparison from reading past a two-byte spec.
    let short_s = bytes_from_str("ht")
    assert_eq(pkg_b_startswith(short_s, pkg_https_lit()), 0)
    let ok = bytes_from_str("https://x")
    assert_eq(pkg_b_startswith(ok, pkg_https_lit()), 1)
}

test "pkg: only a name that really ends in .snd is a module file" {
    // What decides whether a file of the repository is fetched at all. The four bytes are
    // checked one at a time, because ".sn" plus anything would otherwise walk in.
    assert_eq(pkg_snd_suffix("a.snd".utf8, 5), 1)
    assert_eq(pkg_snd_suffix(".snd".utf8, 4), 1)
    assert_eq(pkg_snd_suffix("snd".utf8, 3), 0)
    for i in 0..4 {
        let malo = h_alterado("a.snd".utf8, 1 + i, 88)
        assert_eq(pkg_snd_suffix(peek64(malo), 5), 0)
    }
}

test "pkg: a copy that does not fit reports it instead of writing what it can" {
    let out[2] // 16 bytes
    assert_eq(pkg_copy_cstr_out("0123456789abcdef".utf8, 16, out, 16), 0 - 1)
    poke8(out, 111)
    assert_eq(pkg_copy_cstr_out("0123456789abcde".utf8, 15, out, 16), 0)
    assert_eq(peek8(out), 48)
    assert_eq(peek8(out + 15), 0)
}

test "pkg: the url path keeps what RFC 3986 allows verbatim and encodes the rest" {
    // Every class named in the function, one probe each: a digit, an upper and a lower letter,
    // and the four punctuation marks that survive, plus the separator.
    assert_eq(pkg_url_safe(48), 1)   // '0'
    assert_eq(pkg_url_safe(57), 1)   // '9'
    assert_eq(pkg_url_safe(65), 1)   // 'A'
    assert_eq(pkg_url_safe(90), 1)   // 'Z'
    assert_eq(pkg_url_safe(97), 1)   // 'a'
    assert_eq(pkg_url_safe(45), 1)   // '-'
    assert_eq(pkg_url_safe(46), 1)   // '.'
    assert_eq(pkg_url_safe(95), 1)   // '_'
    assert_eq(pkg_url_safe(126), 1)  // '~'
    assert_eq(pkg_url_safe(47), 1)   // '/'
    assert_eq(pkg_url_safe(32), 0)   // a space
    assert_eq(pkg_url_safe(37), 0)   // '%', which must not survive as itself
    assert_eq(pkg_url_safe(195), 0)  // the first byte of 'ñ'
}

test "pkg: asking for a field past the end of the line says there is none" {
    // Not the same path as asking for the field right after the last: this one runs out of line
    // while still counting, and used to be the only way to walk off the end.
    let b = bytes_from_str("use strings")
    let o[1]
    let l[1]
    assert_eq(pkg_field(b, 0, bytes_len(b), 6, o, l), 0)
}

// ── What a hostile or broken API answer must not become ─────────────────────────────────────
//
// Everything above this line assumes the server says something sensible. These do not: the
// recorded seam serves malformed bodies, and what is being pinned is that each one comes back
// as an error instead of as a sha, a path or an empty module. A JSON body is not a promise.

let R_SIN_CUERPO: string = "HTTP/1.1 200 OK\r\nContent-Type: application/json"
let R_NO_JSON: string = "HTTP/1.1 200 OK\r\n\r\nthis is not json at all"
let R_JSON_ARRAY: string = "HTTP/1.1 200 OK\r\n\r\n[1,2,3]"
let R_SIN_SHA: string = "HTTP/1.1 200 OK\r\n\r\n{\"name\":\"v1.4.2\"}"
let R_SHA_NUM: string = "HTTP/1.1 200 OK\r\n\r\n{\"sha\":1111}"
let R_SHA_CORTO: string = "HTTP/1.1 200 OK\r\n\r\n{\"sha\":\"1111\"}"
let R_500: string = "HTTP/1.1 500 Internal Server Error\r\n\r\n{}"
let R_TREE_SIN_TREE: string = "HTTP/1.1 200 OK\r\n\r\n{\"sha\":\"1111222233334444555566667777888899990000\"}"
let R_TREE_NO_ARR: string = "HTTP/1.1 200 OK\r\n\r\n{\"tree\":{\"path\":\"a.snd\"}}"
// One entry of every shape the walk has to step over: not an object, no type, a type that is
// not a string, a type that is not a blob, no path, and a path that is not a string.
let R_TREE_BASURA: string = "HTTP/1.1 200 OK\r\n\r\n{\"truncated\":false,\"tree\":[7,{\"path\":\"a.snd\"},{\"type\":9,\"path\":\"b.snd\"},{\"type\":\"tree\",\"path\":\"sub\"},{\"type\":\"blob\"},{\"type\":\"blob\",\"path\":5}]}"
let R_TREE_DOS: string = "HTTP/1.1 200 OK\r\n\r\n{\"truncated\":false,\"tree\":[{\"type\":\"blob\",\"path\":\"a.snd\"},{\"type\":\"blob\",\"path\":\"b.snd\"}]}"

fn h_owner() -> i64 { let s: string = "fredyk"; s.utf8 }
fn h_repo() -> i64 { let s: string = "sond-strings"; s.utf8 }
fn h_ref() -> i64 { let s: string = "v1.4.2"; s.utf8 }

// Arms the seam with a single recorded answer for the commits endpoint.
fn h_rec_commits(resp: i64) {
    h_rec_clear()
    h_rec_add(H_PATH_COMMITS.utf8, resp)
    pkg_rec_n = h_rec_cnt
}

// Arms the seam with a single recorded answer for the recursive tree of TEST_SHA.
fn h_rec_tree(resp: i64) {
    h_rec_clear()
    h_rec_add(H_TREE_CHANGED.utf8, resp)
    pkg_rec_n = h_rec_cnt
}

test "pkg: a 200 that is not a commit object never becomes a sha" {
    // Each of these would otherwise leave `sha_out` holding whatever was there before, and the
    // caller would go on to fetch a tree under it.
    let sha[8] // 64 bytes
    h_rec_commits(R_SIN_CUERPO.utf8)
    assert_eq(pkg_resolve_sha(h_owner(), h_repo(), h_ref(), sha), 0 - 1)
    h_rec_commits(R_NO_JSON.utf8)
    assert_eq(pkg_resolve_sha(h_owner(), h_repo(), h_ref(), sha), 0 - 1)
    h_rec_commits(R_JSON_ARRAY.utf8)
    assert_eq(pkg_resolve_sha(h_owner(), h_repo(), h_ref(), sha), 0 - 1)
    h_rec_commits(R_SIN_SHA.utf8)
    assert_eq(pkg_resolve_sha(h_owner(), h_repo(), h_ref(), sha), 0 - 1)
    h_rec_commits(R_SHA_NUM.utf8)
    assert_eq(pkg_resolve_sha(h_owner(), h_repo(), h_ref(), sha), 0 - 1)
    // A sha of the wrong length is the one that would still look like a sha further down.
    h_rec_commits(R_SHA_CORTO.utf8)
    assert_eq(pkg_resolve_sha(h_owner(), h_repo(), h_ref(), sha), 0 - 1)
    h_rec_clear()
}

test "pkg: a tree listing that is not a tree is an error, not an empty module" {
    // An empty module is the dangerous reading: `sond get` would write a deps block and a cache
    // entry for a module with no files in it, and every later build would resolve to that.
    let paths[8]
    h_rec_tree(R_500.utf8)
    assert_eq(pkg_fetch_tree(h_owner(), h_repo(), TEST_SHA.utf8, paths, 8), 0 - 6)
    h_rec_tree(R_SIN_CUERPO.utf8)
    assert_eq(pkg_fetch_tree(h_owner(), h_repo(), TEST_SHA.utf8, paths, 8), 0 - 1)
    h_rec_tree(R_NO_JSON.utf8)
    assert_eq(pkg_fetch_tree(h_owner(), h_repo(), TEST_SHA.utf8, paths, 8), 0 - 1)
    h_rec_tree(R_JSON_ARRAY.utf8)
    assert_eq(pkg_fetch_tree(h_owner(), h_repo(), TEST_SHA.utf8, paths, 8), 0 - 1)
    h_rec_tree(R_TREE_SIN_TREE.utf8)
    assert_eq(pkg_fetch_tree(h_owner(), h_repo(), TEST_SHA.utf8, paths, 8), 0 - 1)
    h_rec_tree(R_TREE_NO_ARR.utf8)
    assert_eq(pkg_fetch_tree(h_owner(), h_repo(), TEST_SHA.utf8, paths, 8), 0 - 1)
    h_rec_clear()
}

test "pkg: the entries of a tree that are not .snd blobs are stepped over, not guessed at" {
    let paths[8]
    h_rec_tree(R_TREE_BASURA.utf8)
    // Six entries, not one of them a usable blob path: the walk ends with nothing, and does not
    // read a number as a path along the way.
    assert_eq(pkg_fetch_tree(h_owner(), h_repo(), TEST_SHA.utf8, paths, 8), 0)
    h_rec_clear()
}

test "pkg: a tree with more .snd files than the caller has room for is refused" {
    // Filling the array to its cap and returning it would hand back a module missing files,
    // which hashes to something nobody published.
    let paths[8]
    h_rec_tree(R_TREE_DOS.utf8)
    assert_eq(pkg_fetch_tree(h_owner(), h_repo(), TEST_SHA.utf8, paths, 1), 0 - 6)
    assert_eq(pkg_fetch_tree(h_owner(), h_repo(), TEST_SHA.utf8, paths, 8), 2)
    h_rec_clear()
}

test "pkg: an endpoint nobody recorded is a transport error, not a silent empty answer" {
    // The seam serves a table; a request outside it is what a lost connection looks like from
    // up here, and both must come back negative rather than as zero bytes read.
    let sha[8]
    let paths[8]
    h_rec_commits(R_COMMITS_OK.utf8)
    assert_eq(pkg_fetch_tree(h_owner(), h_repo(), TEST_SHA.utf8, paths, 8), 0 - 1)
    h_rec_clear()
}

// ── deps.snd as it is actually found on disk, and the pin doing its job ──────────────────────

// The same block as h_block with CRLF line endings: a deps.snd edited on Windows, or one that
// went through a tool that rewrote its newlines. Every line parser here trims a trailing CR,
// and nothing was exercising that -- a CR left on the end of a hash makes the cache directory
// name wrong, so the module silently re-downloads and re-pins on every single get.
fn h_block_crlf(name: i64, src: i64, sha: i64, hash: i64) -> i64 {
    let b = bytes_new()
    let u: string = "use "
    bytes_append_str(b, u)
    bytes_append_cstr(b, name)
    let e1: string = " = sond:sha256:"
    bytes_append_str(b, e1)
    bytes_append_cstr(b, hash)
    bytes_push(b, 13)
    bytes_push(b, 10)
    let f1: string = "    from \""
    bytes_append_str(b, f1)
    bytes_append_cstr(b, src)
    bytes_push(b, 64)
    bytes_append_cstr(b, sha)
    bytes_push(b, 34)
    bytes_push(b, 13)
    bytes_push(b, 10)
    let g1: string = "    grants {}"
    bytes_append_str(b, g1)
    bytes_push(b, 13)
    bytes_push(b, 10)
    b
}

fn h_src() -> i64 { let s: string = "github.com/fredyk/sond-strings"; s.utf8 }

test "pkg: a deps.snd with CRLF line endings pins exactly what one with LF pins" {
    let troot: string = "/tmp/sond-pkg-t11"
    let cac: string = "/tmp/sond-pkg-t11/cache"
    let dep: string = "/tmp/sond-pkg-t11/deps.snd"
    h_cfg(troot.utf8, cac.utf8, dep.utf8)
    h_rec_ok()
    let spec: string = "github.com/fredyk/sond-strings@v1.4.2"
    assert_eq(pkg_get(spec.utf8), 0)
    // Same pin, same bytes, CRLF. If the CR rode along into the hash, the cache dir named by
    // it would not exist and this get would download the whole module again.
    h_write_file(dep.utf8, h_block_crlf(pkg_test_modname(), h_src(), TEST_SHA.utf8, EXPECTED_HASH.utf8))
    h_rec_clear()
    h_rec_add(H_PATH_COMMITS.utf8, R_COMMITS_OK.utf8)
    pkg_rec_n = h_rec_cnt
    assert_eq(pkg_get(spec.utf8), 0)
    assert_eq(pkg_rec_calls, 1)
}

test "pkg: a block in a CRLF deps.snd is replaced, not appended to" {
    let troot: string = "/tmp/sond-pkg-t12"
    let cac: string = "/tmp/sond-pkg-t12/cache"
    let dep: string = "/tmp/sond-pkg-t12/deps.snd"
    h_cfg(troot.utf8, cac.utf8, dep.utf8)
    h_write_file(dep.utf8, h_block_crlf(pkg_test_modname(), h_src(), TEST_SHA.utf8, EXPECTED_HASH.utf8))
    h_rec_ok2()
    let spec2: string = "github.com/fredyk/sond-strings@v1.4.3"
    assert_eq(pkg_get(spec2.utf8), 0)
    // One block, pinning the new commit: two would make the resolution ambiguous.
    let dbuf = heap_alloc(4096)
    let dlen = read_file(dep.utf8, dbuf, 4096)
    assert(dlen > 0)
    assert_eq(bytes_eq(bytes_from_raw(dbuf, dlen), h_block(pkg_test_modname(), h_src(), TEST_SHA2.utf8, EXPECTED_HASH.utf8)), 1)
}

test "pkg: content that changed behind a pinned ref is refused, and nothing is written" {
    // The case the whole pin exists for: the cache was cleared, the ref still resolves to the
    // same commit, and what comes down the wire now hashes to something else. Someone moved the
    // bytes under a name that is supposed to be immutable, and a get that quietly re-pinned it
    // would launder that into the build.
    let troot: string = "/tmp/sond-pkg-t13"
    let cac: string = "/tmp/sond-pkg-t13/cache"
    let dep: string = "/tmp/sond-pkg-t13/deps.snd"
    h_cfg(troot.utf8, cac.utf8, dep.utf8)
    h_rec_ok()
    let spec: string = "github.com/fredyk/sond-strings@v1.4.2"
    assert_eq(pkg_get(spec.utf8), 0)
    let dbuf1 = heap_alloc(4096)
    let dlen1 = read_file(dep.utf8, dbuf1, 4096)
    let antes = bytes_from_raw(dbuf1, dlen1)
    // The cache is gone (purged, another machine, a fresh checkout), so the files are fetched
    // again -- and año.snd comes back with a different body.
    pkg_rmtree(pkg_join2(cac.utf8, EXPECTED_HASH.utf8))
    h_rec_clear()
    h_rec_add(H_PATH_COMMITS.utf8, R_COMMITS_OK.utf8)
    h_rec_add(H_TREE_CHANGED.utf8, R_TREE_OK.utf8)
    h_rec_add(H_PATH_RAW_A.utf8, R_RAW_A_CHANGED.utf8)
    h_rec_add(H_PATH_RAW_SUB.utf8, R_RAW_SUB.utf8)
    pkg_rec_n = h_rec_cnt
    assert_eq(pkg_get(spec.utf8), 0 - 5)
    // Neither the cache nor the pin moved.
    assert_eq(pkg_dir_exists(pkg_join2(cac.utf8, EXPECTED_HASH.utf8)), 0)
    let dbuf2 = heap_alloc(4096)
    let dlen2 = read_file(dep.utf8, dbuf2, 4096)
    assert_eq(bytes_eq(antes, bytes_from_raw(dbuf2, dlen2)), 1)
}

test "pkg: verify names a module whose cache dir is not there, origin or no origin" {
    let troot: string = "/tmp/sond-pkg-t14"
    let cac: string = "/tmp/sond-pkg-t14/cache"
    let dep: string = "/tmp/sond-pkg-t14/deps.snd"
    h_cfg(troot.utf8, cac.utf8, dep.utf8)
    // A pin with no `from` line at all, and nothing in the cache under its hash: verify has to
    // report it by name even though it cannot say where it came from.
    let b = bytes_new()
    let u: string = "use huerfano = sond:sha256:"
    bytes_append_str(b, u)
    bytes_append_cstr(b, EXPECTED_HASH.utf8)
    bytes_push(b, 10)
    h_write_file(dep.utf8, b)
    assert_eq(pkg_verify(), 1)
}

test "pkg: verify with no deps.snd is nothing to check, not a failure" {
    let troot: string = "/tmp/sond-pkg-t15"
    let cac: string = "/tmp/sond-pkg-t15/cache"
    let dep: string = "/tmp/sond-pkg-t15/deps.snd"
    h_cfg(troot.utf8, cac.utf8, dep.utf8)
    assert_eq(pkg_verify(), 0)
}

test "pkg: the hash of a directory that is not there is no hash at all" {
    // Not zero files hashed to the empty digest: that digest would be a valid-looking pin.
    let falta: string = "/tmp/sond-pkg-t16/no-existe"
    assert_eq(pkg_dir_hash(falta.utf8), 0)
}

test "pkg: a spec with more segments than the parser holds is refused" {
    // Sixteen slots, and a spec is host/owner/repo. Anything deeper is refused rather than
    // parsed as far as it fits.
    let host[16]
    let owner[16]
    let repo[16]
    let ref[16]
    let name[16]
    let hondo: string = "a/b/c/d/e/f/g/h/i/j/k/l/m/n/o/p/q/r@v1"
    assert_eq(pkg_parse_spec(hondo.utf8, host, owner, repo, ref, name), 0 - 1)
}

test "pkg: a deps.snd that cannot be written stops the get instead of half-doing it" {
    // The pin is what makes the cache meaningful. If it cannot be recorded, the module must not
    // be reported as fetched.
    let troot: string = "/tmp/sond-pkg-t17"
    let cac: string = "/tmp/sond-pkg-t17/cache"
    // A regular file where a directory would have to be: the parents cannot be created and the
    // open cannot succeed, which is what a read-only checkout looks like from in here.
    let tope: string = "/tmp/sond-pkg-t17/tope"
    let dep: string = "/tmp/sond-pkg-t17/tope/deps.snd"
    h_cfg(troot.utf8, cac.utf8, dep.utf8)
    let vacio = bytes_new()
    bytes_push(vacio, 10)
    h_write_file(tope.utf8, vacio)
    h_rec_ok()
    let spec: string = "github.com/fredyk/sond-strings@v1.4.2"
    assert_eq(pkg_get(spec.utf8), 0 - 7)
}
