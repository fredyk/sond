// Tests for lib/any/json.snd

include "any/json.snd"
include "x86_64/linux/testing.snd"

fn parse(s: i64) -> i64 { json_parse(s, strlen(s)) }

test "parses a flat object and reads scalar fields" {
    let __s0_11: string = "{\"port\": 5432, \"name\": \"pgv\", \"ok\": true, \"off\": false, \"z\": null}"
    let o = parse(__s0_11.utf8)
    assert_eq(json_type(o), JSON_OBJ)
    let __s0_14: string = "port"
    assert_eq(json_type(json_get(o, __s0_14.utf8)), JSON_INT)
    let __s1_16: string = "port"
    assert_eq(json_int(json_get(o, __s1_16.utf8)), 5432)
    let __s2_18: string = "name"
    assert_eq(json_type(json_get(o, __s2_18.utf8)), JSON_STR)
    let __s3_20: string = "name"
    let __s4_20: string = "pgv"
    assert_eq(streq(json_str(json_get(o, __s3_20.utf8)), __s4_20.utf8), 1)
    let __s5_23: string = "ok"
    assert_eq(json_bool(json_get(o, __s5_23.utf8)), 1)
    let __s6_25: string = "off"
    assert_eq(json_bool(json_get(o, __s6_25.utf8)), 0)
    let __s7_27: string = "z"
    assert_eq(json_type(json_get(o, __s7_27.utf8)), JSON_NULL)
}

test "a missing key returns -1" {
    let __s1_24: string = "{\"a\": 1}"
    let o = parse(__s1_24.utf8)
    let __s8_34: string = "b"
    assert_eq(json_get(o, __s8_34.utf8), 0 - 1)
}

test "parses an array of integers" {
    let __s2_30: string = "[10, 20, 30]"
    let a = parse(__s2_30.utf8)
    assert_eq(json_type(a), JSON_ARR)
    assert_eq(json_arr_len(a), 3)
    assert_eq(json_int(json_arr_get(a, 1)), 20)
}

test "a negative integer" {
    let __s3_38: string = "{\"n\": -7}"
    let o = parse(__s3_38.utf8)
    let __s9_49: string = "n"
    assert_eq(json_int(json_get(o, __s9_49.utf8)), 0 - 7)
}

test "decodes a backslash-n escape in a string" {
    let __s4_44: string = "{\"s\": \"a\\nb\"}"
    let o = parse(__s4_44.utf8)
    let __s10_56: string = "s"
    let s = json_str(json_get(o, __s10_56.utf8))
    let __s11_58: string = "s"
    assert_eq(json_str_len(json_get(o, __s11_58.utf8)), 3)
    assert_eq(peek8(s + 1), 10)
}

test "nested object and array" {
    let __s5_52: string = "{\"cfg\": {\"dim\": 384}, \"tags\": [\"a\", \"b\"]}"
    let o = parse(__s5_52.utf8)
    let __s12_66: string = "cfg"
    let cfg = json_get(o, __s12_66.utf8)
    let __s13_68: string = "dim"
    assert_eq(json_int(json_get(cfg, __s13_68.utf8)), 384)
    let __s14_70: string = "tags"
    let tags = json_get(o, __s14_70.utf8)
    assert_eq(json_arr_len(tags), 2)
    let __s0_73: string = "b"
    assert_eq(streq(json_str(json_arr_get(tags, 1)), __s0_73.utf8), 1)
}

test "malformed input returns -1" {
    let __s6_62: string = "{\"a\": }"
    assert_eq(parse(__s6_62.utf8), 0 - 1)
}

test "empty object and empty array" {
    let __s7_67: string = "{}"
    assert_eq(json_type(parse(__s7_67.utf8)), JSON_OBJ)
    let __s8_69: string = "[]"
    assert_eq(json_arr_len(parse(__s8_69.utf8)), 0)
}

test "a float keeps its integer part" {
    let __s9_74: string = "{\"x\": 3.14, \"e\": 2e3}"
    let o = parse(__s9_74.utf8)
    let __s15_91: string = "x"
    assert_eq(json_int(json_get(o, __s15_91.utf8)), 3)
}

test "decodes all simple escapes" {
    // "\t\r\\\"/\b\f" -> tab cr backslash quote slash backspace formfeed
    let __s10_81: string = "{\"s\": \"\\t\\r\\\\\\\"\\/\\b\\f\"}"
    let o = parse(__s10_81.utf8)
    let __s16_99: string = "s"
    let s = json_str(json_get(o, __s16_99.utf8))
    assert_eq(peek8(s + 0), 9)     // \t
    assert_eq(peek8(s + 1), 13)    // \r
    assert_eq(peek8(s + 2), 92)    // backslash
    assert_eq(peek8(s + 3), 34)    // quote
    assert_eq(peek8(s + 4), 47)    // slash (unknown escape -> the char itself)
    assert_eq(peek8(s + 5), 8)     // \b
    assert_eq(peek8(s + 6), 12)    // \f
}

test "a truncated literal is an error" {
    let __s11_94: string = "tru"
    assert_eq(parse(__s11_94.utf8), 0 - 1)
    let __s12_96: string = "nul"
    assert_eq(parse(__s12_96.utf8), 0 - 1)
    let __s13_98: string = "fals"
    assert_eq(parse(__s13_98.utf8), 0 - 1)
}

test "empty input is an error" {
    let __s14_103: string = ""
    assert_eq(parse(__s14_103.utf8), 0 - 1)
}

test "an unterminated string is an error" {
    let __s15_108: string = "{\"a\": \"xyz"
    assert_eq(parse(__s15_108.utf8), 0 - 1)
}

test "an unterminated array is an error" {
    let __s16_113: string = "[1, 2"
    assert_eq(parse(__s16_113.utf8), 0 - 1)
}

test "top-level scalars parse" {
    let __s17_118: string = "42"
    assert_eq(json_int(parse(__s17_118.utf8)), 42)
    let __s18_120: string = "true"
    assert_eq(json_bool(parse(__s18_120.utf8)), 1)
    let __s19_122: string = "null"
    assert_eq(json_type(parse(__s19_122.utf8)), JSON_NULL)
    let __s20_124: string = "\"hi\""
    let __s21_124: string = "hi"
    assert_eq(streq(json_str(parse(__s20_124.utf8)), __s21_124.utf8), 1)
}

test "builds and encodes an object, round-trips through the parser" {
    let o = json_new_obj()
    let __lit0: string = "port"
    json_obj_put(o, __lit0.utf8, json_new_int(5432))
    let __lit1: string = "name"
    let __lit2: string = "pgv"
    json_obj_put(o, __lit1.utf8, json_new_str(__lit2.utf8))
    let __lit3: string = "ok"
    json_obj_put(o, __lit3.utf8, json_new_bool(1))
    let tags = json_new_arr()
    let __lit4: string = "a"
    json_arr_push(tags, json_new_str(__lit4.utf8))
    json_arr_push(tags, json_new_int(2))
    let __lit5: string = "tags"
    json_obj_put(o, __lit5.utf8, tags)
    let buf = json_encode(o)
    // parse the encoded bytes back and check the values survived
    let p = json_parse(peek64(buf), bytes_len(buf))
    let __s17_164: string = "port"
    assert_eq(json_int(json_get(p, __s17_164.utf8)), 5432)
    let __s18_166: string = "name"
    let __s19_166: string = "pgv"
    assert_eq(streq(json_str(json_get(p, __s18_166.utf8)), __s19_166.utf8), 1)
    let __s20_169: string = "ok"
    assert_eq(json_bool(json_get(p, __s20_169.utf8)), 1)
    let __s21_171: string = "tags"
    assert_eq(json_arr_len(json_get(p, __s21_171.utf8)), 2)
    let __s22_173: string = "tags"
    let __s23_173: string = "a"
    assert_eq(streq(json_str(json_arr_get(json_get(p, __s22_173.utf8), 0)), __s23_173.utf8), 1)
}

test "encode escapes quotes and control chars" {
    let o = json_new_obj()
    let __lit6: string = "s"
    let __lit7: string = "a\"b"
    json_obj_put(o, __lit6.utf8, json_new_str(__lit7.utf8))
    let buf = json_encode(o)
    let p = json_parse(peek64(buf), bytes_len(buf))
    let __s24_185: string = "s"
    let __s25_185: string = "a\"b"
    assert_eq(streq(json_str(json_get(p, __s24_185.utf8)), __s25_185.utf8), 1)
}

test "encodes null and empties" {
    let buf = json_encode(json_new_null())
    assert_eq(json_type(json_parse(peek64(buf), bytes_len(buf))), JSON_NULL)
    let e = json_encode(json_new_obj())
    assert_eq(json_type(json_parse(peek64(e), bytes_len(e))), JSON_OBJ)
}

// A handle that names no node -- a key that is not there, a document that did not parse -- must
// still be classifiable. `json_type` is the gate every caller goes through to find out whether a
// node is usable, so it is the one accessor that has to answer for ANY handle: a guard written as
// `if json_type(x) != JSON_OBJ { ... }` exists precisely to turn away the bad input, and it cannot
// be the thing that crashes on it.

test "the type of a key that is not in the object is JSON_NONE" {
    let __sn0: string = "{\"other\": 1}"
    let o = parse(__sn0.utf8)
    let __sn1: string = "missing"
    assert_eq(json_type(json_get(o, __sn1.utf8)), JSON_NONE)
}

test "the type of a document that did not parse is JSON_NONE" {
    let __sn2: string = "{not json"
    assert_eq(json_type(parse(__sn2.utf8)), JSON_NONE)
}

test "a key that is absent is not the same as a key whose value is null" {
    let __sn3: string = "{\"z\": null}"
    let o = parse(__sn3.utf8)
    let __sn4: string = "z"
    assert_eq(json_type(json_get(o, __sn4.utf8)), JSON_NULL)
    let __sn5: string = "nope"
    assert_eq(json_type(json_get(o, __sn5.utf8)), JSON_NONE)
}

// ── Bounded and canonical encoding, full string escaping, \uXXXX decoding ──────────────

// 1 if the n bytes at `out` are exactly the bytes of `want` (and want has n bytes).
fn is(out: i64, n: i64, want: string) -> i64 {
    let w = want.utf8
    if strlen(w) != n { return 0 }
    for i in 0..n {
        if peek8(out + i) != peek8(w + i) { return 0 }
    }
    1
}

// Encodes the string of n bytes at p with one of the two escapers into `out`; returns its length.
fn esc(p: i64, n: i64, out: i64, ascii: i64) -> i64 {
    let w = BufWriter { buf: out, cap: 256, len: 0, overflow: 0 }
    if ascii == 1 { json_write_str_ascii(w, p, n) } else { json_write_str(w, p, n) }
    w.len
}

test "json: \\u escapes decode to UTF-8, one to four bytes" {
    let s: string = "\"\\u0041\\u00e9\\u20AC\\ud83d\\ude00\""
    let v = parse(s.utf8)
    assert_eq(json_type(v), JSON_STR)
    assert_eq(json_str_len(v), 10)
    let b = json_str(v)
    assert_eq(peek8(b), 0x41)
    assert_eq(peek8(b + 1), 0xC3)
    assert_eq(peek8(b + 2), 0xA9)
    assert_eq(peek8(b + 3), 0xE2)
    assert_eq(peek8(b + 4), 0x82)
    assert_eq(peek8(b + 5), 0xAC)
    assert_eq(peek8(b + 6), 0xF0)
    assert_eq(peek8(b + 7), 0x9F)
    assert_eq(peek8(b + 8), 0x98)
    assert_eq(peek8(b + 9), 0x80)
}

test "json: \\u0000 is a byte of the string, counted in its length" {
    let s: string = "\"a\\u0000b\""
    let v = parse(s.utf8)
    assert_eq(json_str_len(v), 3)
    assert_eq(peek8(json_str(v) + 1), 0)
    assert_eq(peek8(json_str(v) + 2), 'b')
}

test "json: a lone or broken surrogate and a bad \\u escape are errors" {
    let hi: string = "\"\\ud83d\""
    assert_eq(json_type(parse(hi.utf8)), JSON_NONE)
    let hix: string = "\"\\ud83dx\""
    assert_eq(json_type(parse(hix.utf8)), JSON_NONE)
    let hihi: string = "\"\\ud83d\\ud83d\""
    assert_eq(json_type(parse(hihi.utf8)), JSON_NONE)
    let lo: string = "\"\\ude00\""
    assert_eq(json_type(parse(lo.utf8)), JSON_NONE)
    let bad: string = "\"\\u00g0\""
    assert_eq(json_type(parse(bad.utf8)), JSON_NONE)
    let short: string = "\"\\u12"
    let hin: string = "\"\\ud83d\\n\""
    assert_eq(json_type(parse(hin.utf8)), JSON_NONE)
    assert_eq(json_type(parse(short.utf8)), JSON_NONE)
}

test "json: strings escape the seven short forms and other control bytes as \\u00xx" {
    let src: u8[10]
    src[0] = '"'
    src[1] = '\\'
    src[2] = 8
    src[3] = 9
    src[4] = 10
    src[5] = 12
    src[6] = 13
    src[7] = 1
    src[8] = 0x1f
    src[9] = 0
    let out: u8[256]
    let n = esc(src, 10, out, 0)
    assert_eq(is(out, n, "\"\\\"\\\\\\b\\t\\n\\f\\r\\u0001\\u001f\\u0000\""), 1)
}

test "json: printable ASCII, DEL and UTF-8 are written as they are" {
    let s: string = "a~ é/"
    let src: u8[7]
    for i in 0..6 {
        src[i] = peek8(s.utf8 + i)
    }
    src[6] = 0x7f
    let out: u8[256]
    let n = esc(src, 7, out, 0)
    assert_eq(n, 9)
    assert_eq(out[0], '"')
    for i in 0..7 {
        assert_eq(out[1 + i], src[i])
    }
    assert_eq(out[8], '"')
}

test "json: the 7-bit escaper writes every byte outside printable ASCII as \\u00xx" {
    let src: u8[7]
    src[0] = 'a'
    src[1] = '"'
    src[2] = '\\'
    src[3] = 10
    src[4] = 0xC3
    src[5] = 0x7f
    src[6] = 0x7e
    let out: u8[256]
    let n = esc(src, 7, out, 1)
    assert_eq(is(out, n, "\"a\\\"\\\\\\u000a\\u00c3\\u007f~\""), 1)
}

test "json: RFC 8785 string vector parses and re-encodes to its canonical form" {
    // RFC 8785 section 3.2.2.2: "\u20ac$\u000F\u000aA'\u0042\u0022\u005c\\\"\/"
    let s: string = "\"\\u20ac$\\u000F\\u000aA'\\u0042\\u0022\\u005c\\\\\\\"\\/\""
    let v = parse(s.utf8)
    let out: u8[256]
    let n = json_encode_canonical_into(v, out, 256)
    assert_eq(is(out, n, "\"€$\\u000f\\nA'B\\\"\\\\\\\\\\\"/\""), 1)
}

test "json: bounded encoding keeps insertion order and writes no whitespace" {
    let s: string = "{ \"b\": 1, \"a\": [true, null, \"x\", -7], \"c\": {} }"
    let out: u8[256]
    let n = json_encode_into(parse(s.utf8), out, 256)
    assert_eq(is(out, n, "{\"b\":1,\"a\":[true,null,\"x\",-7],\"c\":{}}"), 1)
}

test "json: bounded encoding into a buffer that is too small is refused" {
    let s: string = "{\"key\": \"value\"}"
    let out: u8[256]
    assert_eq(json_encode_into(parse(s.utf8), out, 14), JSON_ENC_ERR_SPACE)
    assert_eq(json_encode_into(parse(s.utf8), out, 15), 15)
    assert_eq(json_encode_canonical_into(parse(s.utf8), out, 14), JSON_ENC_ERR_SPACE)
}

test "json: a handle that names no node is refused by the encoders" {
    let out: u8[16]
    assert_eq(json_encode_into(0 - 1, out, 16), JSON_ENC_ERR_NODE)
    assert_eq(json_encode_canonical_into(0 - 1, out, 16), JSON_ENC_ERR_NODE)
    let arr = json_new_arr()
    json_arr_push(arr, 0 - 1)
    assert_eq(json_encode_into(arr, out, 16), JSON_ENC_ERR_NODE)
}

test "json: canonical encoding sorts object keys bytewise, at every depth" {
    let s: string = "{\"b\": {\"z\": 1, \"y\": [{\"q\": 1, \"p\": 2}]}, \"aa\": 2, \"é\": 3, \"a\": 4, \"A\": 5, \"\": 6}"
    let out: u8[256]
    let n = json_encode_canonical_into(parse(s.utf8), out, 256)
    assert_eq(is(out, n, "{\"\":6,\"A\":5,\"a\":4,\"aa\":2,\"b\":{\"y\":[{\"p\":2,\"q\":1}],\"z\":1},\"é\":3}"), 1)
}

test "json: canonical encoding orders a key before every key it is a prefix of" {
    let s: string = "{\"ab\": 1, \"a\\u0000\": 2, \"a\": 3}"
    let out: u8[256]
    let n = json_encode_canonical_into(parse(s.utf8), out, 256)
    assert_eq(is(out, n, "{\"a\":3,\"a\\u0000\":2,\"ab\":1}"), 1)
    let t: string = "{\"a\": false, \"ab\": 2}"
    let m = json_encode_canonical_into(parse(t.utf8), out, 256)
    assert_eq(is(out, m, "{\"a\":false,\"ab\":2}"), 1)
}

test "json: canonical encoding refuses an object with a repeated key" {
    let s: string = "{\"a\": 1, \"b\": 2, \"a\": 3}"
    let out: u8[256]
    assert_eq(json_encode_canonical_into(parse(s.utf8), out, 256), JSON_ENC_ERR_DUP_KEY)
    let nested: string = "[{\"x\": {\"k\": 1, \"k\": 1}}]"
    assert_eq(json_encode_canonical_into(parse(nested.utf8), out, 256), JSON_ENC_ERR_DUP_KEY)
    assert_eq(json_encode_into(parse(s.utf8), out, 256), 19)
}

test "json: the growable encoder writes negative integers and the full escapes" {
    let o = json_new_arr()
    json_arr_push(o, json_new_int(0 - 5))
    let s: u8[2]
    s[0] = 1
    s[1] = 0
    json_arr_push(o, json_new_str(s))
    let buf = json_encode(o)
    assert_eq(is(peek64(buf), bytes_len(buf), "[-5,\"\\u0001\"]"), 1)
    assert_eq(bytes_len(json_encode(0 - 1)), 0)
}

test "json: the growable encoder handles output larger than its first buffer" {
    let a = json_new_arr()
    for i in 0..200 {
        json_arr_push(a, json_new_int(1000000 + i))
    }
    let buf = json_encode(a)
    assert_eq(bytes_len(buf), 200 * 7 + 199 + 2)
    let p = json_parse(peek64(buf), bytes_len(buf))
    assert_eq(json_arr_len(p), 200)
    assert_eq(json_int(json_arr_get(p, 199)), 1000199)
}

test "json: every byte 1..127 survives encode then parse" {
    let src: u8[128]
    for i in 0..127 {
        src[i] = i + 1
    }
    src[127] = 0
    let v = json_new_str(src)
    let out: u8[1024]
    let n = json_encode_into(v, out, 1024)
    let back = json_parse(out, n)
    assert_eq(json_str_len(back), 127)
    for i in 0..127 {
        assert_eq(peek8(json_str(back) + i), i + 1)
    }
}

test "json: an object key that is not a string, or a missing colon, is an error" {
    let k: string = "{1: 2}"
    assert_eq(json_type(parse(k.utf8)), JSON_NONE)
    let c: string = "{\"a\" 1}"
    assert_eq(json_type(parse(c.utf8)), JSON_NONE)
    let e: string = "{\"a\": 1 \"b\": 2}"
    assert_eq(json_type(parse(e.utf8)), JSON_NONE)
}
