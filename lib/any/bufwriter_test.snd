//
// Tests for lib/any/bufwriter.snd.
//
// The property that matters is the bound: a writer never stores past its capacity, keeps
// counting nothing it could not store, and raises its overflow flag so the caller can refuse
// the result instead of using a truncated one.

include "any/bufwriter.snd"
include "x86_64/linux/testing.snd"

fn same(a: i64, b: i64, n: i64) -> i64 {
    for i in 0..n {
        if peek8(a + i) != peek8(b + i) { return 0 }
    }
    1
}

test "bufwriter: bytes and string constants are appended and counted" {
    let b: u8[8]
    let w = BufWriter { buf: b, cap: 8, len: 0, overflow: 0 }
    bw_str(w, "ab")
    bw_byte(w, 'c')
    assert_eq(w.len, 3)
    assert_eq(w.overflow, 0)
    let want: string = "abc"
    assert_eq(same(b, want.utf8, 3), 1)
}

test "bufwriter: nothing is written past the capacity and the overflow is recorded" {
    let b: u8[4]
    b[2] = 'z'
    let w = BufWriter { buf: b, cap: 2, len: 0, overflow: 0 }
    bw_str(w, "abc")
    assert_eq(w.len, 2)
    assert_eq(w.overflow, 1)
    assert_eq(b[2], 'z')
}

test "bufwriter: a negative capacity stores nothing" {
    let b: u8[1]
    let w = BufWriter { buf: b, cap: -1, len: 0, overflow: 0 }
    bw_byte(w, 'a')
    assert_eq(w.len, 0)
    assert_eq(w.overflow, 1)
}

test "bufwriter: raw bytes are copied as they are" {
    let src: string = "a\"\\b"
    let b: u8[8]
    let w = BufWriter { buf: b, cap: 8, len: 0, overflow: 0 }
    bw_bytes(w, src.utf8, 4)
    bw_bytes(w, src.utf8, 0)
    assert_eq(w.len, 4)
    assert_eq(same(b, src.utf8, 4), 1)
}

test "bufwriter: decimals for zero, positive, negative and both i64 extremes" {
    let b: u8[80]
    let w = BufWriter { buf: b, cap: 80, len: 0, overflow: 0 }
    bw_dec(w, 0)
    bw_byte(w, ' ')
    bw_dec(w, 1730600000)
    bw_byte(w, ' ')
    bw_dec(w, -42)
    bw_byte(w, ' ')
    bw_dec(w, 9223372036854775807)
    bw_byte(w, ' ')
    bw_dec(w, -9223372036854775807 - 1)
    let want: string = "0 1730600000 -42 9223372036854775807 -9223372036854775808"
    assert_eq(w.len, 57)
    assert_eq(same(b, want.utf8, 57), 1)
}

test "bufwriter: bytes are written as lowercase hex" {
    let src: u8[3]
    src[0] = 0x00
    src[1] = 0xAB
    src[2] = 0x7f
    let b: u8[6]
    let w = BufWriter { buf: b, cap: 6, len: 0, overflow: 0 }
    bw_hex(w, src, 3)
    let want: string = "00ab7f"
    assert_eq(w.len, 6)
    assert_eq(same(b, want.utf8, 6), 1)
}
