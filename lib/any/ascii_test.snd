//
// Tests for lib/any/ascii.snd: each class is checked at both ends of every range it accepts
// and at the byte just outside, where an off-by-one would show.

include "any/ascii.snd"
include "x86_64/linux/testing.snd"

test "ascii: digits are 0-9 only" {
    assert_eq(ascii_is_digit('0'), 1)
    assert_eq(ascii_is_digit('9'), 1)
    assert_eq(ascii_is_digit('/'), 0)
    assert_eq(ascii_is_digit(':'), 0)
}

test "ascii: letters are A-Z and a-z" {
    assert_eq(ascii_is_alpha('A'), 1)
    assert_eq(ascii_is_alpha('Z'), 1)
    assert_eq(ascii_is_alpha('a'), 1)
    assert_eq(ascii_is_alpha('z'), 1)
    assert_eq(ascii_is_alpha('@'), 0)
    assert_eq(ascii_is_alpha('['), 0)
    assert_eq(ascii_is_alpha('`'), 0)
    assert_eq(ascii_is_alpha('{'), 0)
    assert_eq(ascii_is_alpha(0xC3), 0)
}

test "ascii: alphanumerics are letters and digits" {
    assert_eq(ascii_is_alnum('q'), 1)
    assert_eq(ascii_is_alnum('Q'), 1)
    assert_eq(ascii_is_alnum('5'), 1)
    assert_eq(ascii_is_alnum('_'), 0)
    assert_eq(ascii_is_alnum(-1), 0)
}

test "ascii: printable is 0x20 to 0x7e" {
    assert_eq(ascii_is_print(' '), 1)
    assert_eq(ascii_is_print('~'), 1)
    assert_eq(ascii_is_print(0x1f), 0)
    assert_eq(ascii_is_print(0x7f), 0)
    assert_eq(ascii_is_print(0x80), 0)
}
