//
// Test of encoding/base64.snd against the RFC 4648 §10 test vectors and a full-byte
// round trip.

include "any/encoding/base64.snd"
include "x86_64/linux/testing.snd"

let mut b_in[300]
let mut b_out[512]
let mut b_back[300]

// 1 if out[0..strlen(want)] equals the cstr `want`.
fn b_eq(out: i64, want: i64) -> i64 {
    let mut i = 0
    for peek8(want + i) != 0 {
        if peek8(out + i) != peek8(want + i) { return 0 }
        i = i + 1
    }
    1
}

// RFC 4648 §10: ""/"f"/"fo"/"foo"/"foob"/"fooba"/"foobar".
test "base64: RFC 4648 encode vectors (all padding cases)" {
    let __s0_25: string = "foobar"
    assert_eq(b64_encode(__s0_25.utf8, 6, b_out), 8)
    let __s0_27: string = "Zm9vYmFy"
    assert_eq(b_eq(b_out, __s0_27.utf8), 1)           // no padding
    let __s1_28: string = "fooba"
    assert_eq(b64_encode(__s1_28.utf8, 5, b_out), 8)
    let __s1_31: string = "Zm9vYmE="
    assert_eq(b_eq(b_out, __s1_31.utf8), 1)           // one pad
    let __s2_31: string = "foob"
    assert_eq(b64_encode(__s2_31.utf8, 4, b_out), 8)
    let __s2_35: string = "Zm9vYg=="
    assert_eq(b_eq(b_out, __s2_35.utf8), 1)           // two pads
    let __s3_34: string = "foo"
    assert_eq(b64_encode(__s3_34.utf8, 3, b_out), 4)
    let __s3_39: string = "Zm9v"
    assert_eq(b_eq(b_out, __s3_39.utf8), 1)
    let __s4_37: string = "f"
    assert_eq(b64_encode(__s4_37.utf8, 1, b_out), 4)
    let __s4_43: string = "Zg=="
    assert_eq(b_eq(b_out, __s4_43.utf8), 1)
    let __s5_40: string = ""
    assert_eq(b64_encode(__s5_40.utf8, 0, b_out), 0)
}

test "base64: RFC 4648 decode vectors" {
    let __s0_50: string = "Zm9vYmFy"
    assert_eq(b64_decode(__s0_50.utf8, 8, b_out), 6)
    let __s5_51: string = "foobar"
    assert_eq(b_eq(b_out, __s5_51.utf8), 1)
    let __s1_54: string = "Zm9vYmE="
    assert_eq(b64_decode(__s1_54.utf8, 8, b_out), 5)  // one pad -> 5 bytes
    let __s6_54: string = "fooba"
    assert_eq(b_eq(b_out, __s6_54.utf8), 1)
    let __s2_58: string = "Zg=="
    assert_eq(b64_decode(__s2_58.utf8, 4, b_out), 1)      // two pads -> 1 byte
    assert_eq(peek8(b_out), 102)                     // 'f'
}

// A full 0..255 round trip exercises the whole alphabet in both directions.
test "base64: a full-byte round trip is lossless" {
    let mut i = 0
    for i < 256 { poke8(b_in + i, i); i = i + 1 }
    let enc = b64_encode(b_in, 256, b_out)
    let dec = b64_decode(b_out, enc, b_back)
    assert_eq(dec, 256)
    i = 0
    for i < 256 { assert_eq(peek8(b_back + i), i); i = i + 1 }
}

test "base64: a non-alphabet character has value -1" {
    assert_eq(b64_val(33), 0 - 1)                    // '!'
    assert_eq(b64_val(61), 0 - 1)                    // '=' is padding, not a value
}
