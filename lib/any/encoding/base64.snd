//
// lib/any/encoding/base64.snd: standard base64 (RFC 4648), encode and decode. Needed by
// SCRAM-SHA-256 (the SASL messages are base64) and generally useful. Buffers are
// caller-provided in the no-allocator style; encode NUL-terminates its output for
// convenience (the NUL is not counted in the returned length).

let B64_ALPHA = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

// Encodes `n` bytes from `src` into `out`; returns the number of base64 characters.
fn b64_encode(src: i64, n: i64, out: i64) -> i64 {
    let mut i = 0
    let mut o = 0
    for i + 3 <= n {
        let b0 = peek8(src + i)
        let b1 = peek8(src + i + 1)
        let b2 = peek8(src + i + 2)
        poke8(out + o + 0, peek8(B64_ALPHA + (b0 >> 2)))
        poke8(out + o + 1, peek8(B64_ALPHA + (((b0 & 3) << 4) | (b1 >> 4))))
        poke8(out + o + 2, peek8(B64_ALPHA + (((b1 & 15) << 2) | (b2 >> 6))))
        poke8(out + o + 3, peek8(B64_ALPHA + (b2 & 63)))
        i = i + 3
        o = o + 4
    }
    let rem = n - i
    if rem == 1 {
        let b0 = peek8(src + i)
        poke8(out + o + 0, peek8(B64_ALPHA + (b0 >> 2)))
        poke8(out + o + 1, peek8(B64_ALPHA + ((b0 & 3) << 4)))
        poke8(out + o + 2, 61)                       // '='
        poke8(out + o + 3, 61)
        o = o + 4
    }
    if rem == 2 {
        let b0 = peek8(src + i)
        let b1 = peek8(src + i + 1)
        poke8(out + o + 0, peek8(B64_ALPHA + (b0 >> 2)))
        poke8(out + o + 1, peek8(B64_ALPHA + (((b0 & 3) << 4) | (b1 >> 4))))
        poke8(out + o + 2, peek8(B64_ALPHA + ((b1 & 15) << 2)))
        poke8(out + o + 3, 61)
        o = o + 4
    }
    poke8(out + o, 0)
    o
}

// The 6-bit value of a base64 character, or -1 if it is not in the alphabet.
fn b64_val(c: i64) -> i64 {
    if c >= 65 && c <= 90 { return c - 65 }          // A-Z -> 0..25
    if c >= 97 && c <= 122 { return c - 71 }         // a-z -> 26..51
    if c >= 48 && c <= 57 { return c + 4 }           // 0-9 -> 52..61
    if c == 43 { return 62 }                         // '+'
    if c == 47 { return 63 }                         // '/'
    0 - 1
}

// Decodes `n` base64 characters from `src` into `out`; returns the number of bytes.
// Padding '=' is honored; invalid characters decode as their -1 value is not checked
// (callers pass well-formed base64, e.g. SCRAM server messages).
fn b64_decode(src: i64, n: i64, out: i64) -> i64 {
    let mut i = 0
    let mut o = 0
    for i + 4 <= n {
        let c0 = b64_val(peek8(src + i))
        let c1 = b64_val(peek8(src + i + 1))
        let p2 = peek8(src + i + 2)
        let p3 = peek8(src + i + 3)
        poke8(out + o, ((c0 << 2) | (c1 >> 4)) & 0xff)
        o = o + 1
        if p2 != 61 {
            let c2 = b64_val(p2)
            poke8(out + o, (((c1 & 15) << 4) | (c2 >> 2)) & 0xff)
            o = o + 1
            if p3 != 61 {
                let c3 = b64_val(p3)
                poke8(out + o, (((c2 & 3) << 6) | c3) & 0xff)
                o = o + 1
            }
        }
        i = i + 4
    }
    o
}
