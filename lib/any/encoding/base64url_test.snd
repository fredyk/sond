//
// Tests for lib/any/encoding/base64url.snd.
//
// The RFC 4648 section 10 vectors are reproduced here with the optional `=` padding
// removed, because base64url is the unpadded variant: "f" encodes as "Zg", not "Zg==".
// The same section's worked example bytes (0x14 0xFB 0x9C 0x03 0xD9 0x7E) pin the two
// alphabet positions that differ from standard base64: index 62 is '-' and 63 is '_'.
//
// Buffers are byte-addressed, so every write goes through a `u8[]` view: a word store
// into an `i64[]` would place each value on its own eight-byte boundary.

include "any/encoding/base64url.snd"
include "x86_64/linux/testing.snd"

let mut in_buf[64]
let mut out_buf[128]
let mut back_buf[64]

// Copies the `n` bytes at `p` into the byte buffer at `dst`.
fn load(dst: i64, p: i64, n: i64) {
    let d: u8[n] = dst
    let s: u8[n] = p
    for i in 0..n {
        d[i] = s[i]
    }
}

// 1 if the first `n` bytes at `out` equal the `n` bytes at `want`.
fn same(out: i64, want: i64, n: i64) -> i64 {
    let o: u8[n] = out
    let w: u8[n] = want
    for i in 0..n {
        if o[i] != w[i] {
            return 0
        }
    }
    1
}

test "base64url: RFC 4648 section 10 vectors, unpadded" {
    let f: string = "f"
    let fo: string = "fo"
    let foo: string = "foo"
    let foob: string = "foob"
    let fooba: string = "fooba"
    let foobar: string = "foobar"

    load(in_buf, f.utf8, 1)
    assert_eq(b64url_encode(in_buf, 1, out_buf), 2)
    let e_f: string = "Zg"
    assert_eq(same(out_buf, e_f.utf8, 2), 1)

    load(in_buf, fo.utf8, 2)
    assert_eq(b64url_encode(in_buf, 2, out_buf), 3)
    let e_fo: string = "Zm8"
    assert_eq(same(out_buf, e_fo.utf8, 3), 1)

    load(in_buf, foo.utf8, 3)
    assert_eq(b64url_encode(in_buf, 3, out_buf), 4)
    let e_foo: string = "Zm9v"
    assert_eq(same(out_buf, e_foo.utf8, 4), 1)

    load(in_buf, foob.utf8, 4)
    assert_eq(b64url_encode(in_buf, 4, out_buf), 6)
    let e_foob: string = "Zm9vYg"
    assert_eq(same(out_buf, e_foob.utf8, 6), 1)

    load(in_buf, fooba.utf8, 5)
    assert_eq(b64url_encode(in_buf, 5, out_buf), 7)
    let e_fooba: string = "Zm9vYmE"
    assert_eq(same(out_buf, e_fooba.utf8, 7), 1)

    load(in_buf, foobar.utf8, 6)
    assert_eq(b64url_encode(in_buf, 6, out_buf), 8)
    let e_foobar: string = "Zm9vYmFy"
    assert_eq(same(out_buf, e_foobar.utf8, 8), 1)
}

test "base64url: an empty input encodes to an empty string" {
    assert_eq(b64url_encode(in_buf, 0, out_buf), 0)
    assert_eq(out_buf[0], 0)
}

test "base64url: the URL alphabet uses '-' and '_' where base64 uses '+' and '/'" {
    let b: u8[64] = in_buf
    b[0] = 0x14
    b[1] = 0xFB
    b[2] = 0x9C
    b[3] = 0x03
    b[4] = 0xD9
    b[5] = 0x7E
    assert_eq(b64url_encode(in_buf, 6, out_buf), 8)
    let want: string = "FPucA9l-"
    assert_eq(same(out_buf, want.utf8, 8), 1)

    assert_eq(b64url_encode(in_buf, 5, out_buf), 7)
    let want5: string = "FPucA9k"
    assert_eq(same(out_buf, want5.utf8, 7), 1)

    assert_eq(b64url_encode(in_buf, 4, out_buf), 6)
    let want4: string = "FPucAw"
    assert_eq(same(out_buf, want4.utf8, 6), 1)
}

test "base64url: decode of the RFC vectors returns the original bytes" {
    let z: string = "Zm9vYmFy"
    load(in_buf, z.utf8, 8)
    assert_eq(b64url_decode(in_buf, 8, out_buf), 6)
    let foobar: string = "foobar"
    assert_eq(same(out_buf, foobar.utf8, 6), 1)

    let z2: string = "Zm8"
    load(in_buf, z2.utf8, 3)
    assert_eq(b64url_decode(in_buf, 3, out_buf), 2)
    let fo: string = "fo"
    assert_eq(same(out_buf, fo.utf8, 2), 1)

    let z3: string = "Zg"
    load(in_buf, z3.utf8, 2)
    assert_eq(b64url_decode(in_buf, 2, out_buf), 1)
    let f: string = "f"
    assert_eq(same(out_buf, f.utf8, 1), 1)
}

test "base64url: decode maps '-' and '_' back to bytes 0xFB 0xBF" {
    let u: string = "FPucA9l-"
    load(in_buf, u.utf8, 8)
    assert_eq(b64url_decode(in_buf, 8, out_buf), 6)
    let o: u8[6] = out_buf
    assert_eq(o[0], 0x14)
    assert_eq(o[3], 0x03)
    assert_eq(o[5], 0x7E)
}

test "base64url: decode rejects a length that cannot be base64" {
    let one: string = "A"
    load(in_buf, one.utf8, 1)
    assert_eq(b64url_decode(in_buf, 1, out_buf), 0 - 1)
}

test "base64url: decode rejects non-alphabet characters" {
    let bad: string = "Zm9!"
    load(in_buf, bad.utf8, 4)
    assert_eq(b64url_decode(in_buf, 4, out_buf), 0 - 1)
}

test "base64url: the unpadded decoder rejects '=' padding" {
    let pad: string = "Zg=="
    load(in_buf, pad.utf8, 4)
    assert_eq(b64url_decode(in_buf, 4, out_buf), 0 - 1)
}

test "base64url: '_' encodes the low six bits 0x3F" {
    let b: u8[64] = in_buf
    b[0] = 0xFF
    b[1] = 0xFF
    assert_eq(b64url_encode(in_buf, 2, out_buf), 3)
    let want: string = "__8"
    assert_eq(same(out_buf, want.utf8, 3), 1)
    assert_eq(b64url_decode(out_buf, 3, back_buf), 2)
    let back: u8[64] = back_buf
    assert_eq(back[0], 0xFF)
    assert_eq(back[1], 0xFF)
}

test "base64url: decode rejects bad characters in the shortened tail" {
    let two: string = "Z!"
    load(in_buf, two.utf8, 2)
    assert_eq(b64url_decode(in_buf, 2, out_buf), 0 - 1)
    let three: string = "Zm!"
    load(in_buf, three.utf8, 3)
    assert_eq(b64url_decode(in_buf, 3, out_buf), 0 - 1)
}

test "base64url: every byte value survives a round trip" {
    let src: u8[64] = in_buf
    for i in 0..64 {
        src[i] = i
    }
    let enc = b64url_encode(in_buf, 64, out_buf)
    assert_eq(enc, 86)
    let dec = b64url_decode(out_buf, enc, back_buf)
    assert_eq(dec, 64)
    let back: u8[64] = back_buf
    for i in 0..64 {
        assert_eq(back[i], i)
    }
}
