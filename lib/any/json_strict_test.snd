// Tests for lib/any/json_strict.snd: the strict parser over caller buffers and the
// canonical writer.
include "any/json_strict.snd"
include "x86_64/linux/testing.snd"

// Parse the literal s with fresh buffers in the caller's frame; returns the root or a code.
fn parse_lit(j: *JDoc, s: string, t: i64, tcap: i64, d: i64, dcap: i64) -> i64 {
    j_init(j, s.utf8, strlen(s.utf8), t, tcap, d, dcap)
    j_parse(j)
}

fn canon_eq(s: string, want: string) -> i64 {
    let t[512]
    let d: u8[512]
    let j: JDoc
    let root = parse_lit(j, s, t, 512, d, 512)
    if root < 0 { return root }
    let o: u8[512]
    let w = JOut { buf: o, cap: 512, len: 0, bad: 0 }
    j_canon(j, w, root)
    if w.len != strlen(want.utf8) { return 0 }
    if memcmp(o, want.utf8, w.len) == 0 { 1 } else { 0 }
}

test "scalars, arrays and objects parse into nodes" {
    let t[256]
    let d: u8[256]
    let j: JDoc
    let root = parse_lit(j, " {\"a\": [1, -20, true, false, null], \"b\": \"x\"} ", t, 256, d, 256)
    assert(root >= 0)
    assert_eq(j_type(j, root), JT_OBJ)
    assert_eq(j_count(j, root), 2)
    let a = j_get(j, root, "a")
    assert_eq(j_type(j, a), JT_ARR)
    assert_eq(j_count(j, a), 5)
    let first = j_first(j, a)
    assert_eq(j_int(j, first), 1)
    let second = j_next(j, first)
    assert_eq(j_int(j, second), -20)
    assert_eq(j_type(j, j_next(j, second)), JT_BOOL)
    assert_eq(j_int(j, j_next(j, second)), 1)
    let b = j_get(j, root, "b")
    assert_eq(j_type(j, b), JT_STR)
    assert_eq(j_str_is(j, b, "x"), 1)
    assert_eq(j_str_is(j, b, "xy"), 0)
    assert_eq(j_get(j, root, "zz"), -1)
    assert_eq(j_get(j, a, "a"), -1)
}

test "malformed documents are refused" {
    let t[64]
    let d: u8[64]
    let j: JDoc
    assert_eq(parse_lit(j, "{\"a\":1", t, 64, d, 64), J_ERR_SYNTAX)
    assert_eq(parse_lit(j, "{\"a\" 1}", t, 64, d, 64), J_ERR_SYNTAX)
    assert_eq(parse_lit(j, "[1,]", t, 64, d, 64), J_ERR_SYNTAX)
    assert_eq(parse_lit(j, "{\"a\":1,}", t, 64, d, 64), J_ERR_SYNTAX)
    assert_eq(parse_lit(j, "{1:1}", t, 64, d, 64), J_ERR_SYNTAX)
    assert_eq(parse_lit(j, "tru", t, 64, d, 64), J_ERR_SYNTAX)
    assert_eq(parse_lit(j, "nul", t, 64, d, 64), J_ERR_SYNTAX)
    assert_eq(parse_lit(j, "fals", t, 64, d, 64), J_ERR_SYNTAX)
    assert_eq(parse_lit(j, "", t, 64, d, 64), J_ERR_SYNTAX)
    assert_eq(parse_lit(j, "@", t, 64, d, 64), J_ERR_SYNTAX)
    assert_eq(parse_lit(j, "\"abc", t, 64, d, 64), J_ERR_SYNTAX)
    assert_eq(parse_lit(j, "1 2", t, 64, d, 64), J_ERR_TRAILING)
}

test "only plain integers are numbers" {
    let t[64]
    let d: u8[64]
    let j: JDoc
    assert_eq(parse_lit(j, "1.5", t, 64, d, 64), J_ERR_NUMBER)
    assert_eq(parse_lit(j, "1e3", t, 64, d, 64), J_ERR_NUMBER)
    assert_eq(parse_lit(j, "01", t, 64, d, 64), J_ERR_NUMBER)
    assert_eq(parse_lit(j, "-", t, 64, d, 64), J_ERR_NUMBER)
    assert_eq(parse_lit(j, "1234567890123456789", t, 64, d, 64), J_ERR_NUMBER)
    let r = parse_lit(j, "0", t, 64, d, 64)
    assert_eq(j_int(j, r), 0)
    let r2 = parse_lit(j, "-123456789012345678", t, 64, d, 64)
    assert_eq(j_int(j, r2), -123456789012345678)
}

test "a key twice in one object is refused" {
    let t[64]
    let d: u8[64]
    let j: JDoc
    assert_eq(parse_lit(j, "{\"a\":1,\"b\":2,\"a\":3}", t, 64, d, 64), J_ERR_DUPKEY)
    assert(parse_lit(j, "{\"a\":{\"a\":1}}", t, 64, d, 64) >= 0)
}

test "string escapes decode, including unicode and surrogate pairs" {
    let t[64]
    let d: u8[64]
    let j: JDoc
    let r = parse_lit(j, "\"a\\n\\t\\\"\\\\\\/\\b\\f\\r\\u0041\\u00e9\\u20ac\\ud83d\\ude00\"", t, 64, d, 64)
    assert(r >= 0)
    // a \n \t " \ / \b \f \r A (1) e-acute (2) euro (3) emoji (4)
    assert_eq(j_len(j, r), 10 + 2 + 3 + 4)
    assert_eq(js_byte_at(d, 64, 1), 10)
    assert_eq(js_byte_at(d, 64, 9), 'A')
    assert_eq(js_byte_at(d, 64, 10), 0xC3)
    assert_eq(js_byte_at(d, 64, 12), 0xE2)
    assert_eq(js_byte_at(d, 64, 15), 0xF0)
    assert_eq(parse_lit(j, "\"\\x\"", t, 64, d, 64), J_ERR_ESCAPE)
    assert_eq(parse_lit(j, "\"\\u12\"", t, 64, d, 64), J_ERR_ESCAPE)
    assert_eq(parse_lit(j, "\"\\ud83d\"", t, 64, d, 64), J_ERR_ESCAPE)
    assert_eq(parse_lit(j, "\"\\ude00\"", t, 64, d, 64), J_ERR_ESCAPE)
    assert_eq(parse_lit(j, "\"\\ud83d\\u0041\"", t, 64, d, 64), J_ERR_ESCAPE)
    assert_eq(parse_lit(j, "\"\\uzzzz\"", t, 64, d, 64), J_ERR_ESCAPE)
}

test "a raw control byte inside a string is refused" {
    let t[16]
    let d: u8[16]
    let j: JDoc
    let src: u8[4]
    src[0] = '"'
    src[1] = 'a'
    src[2] = 10
    src[3] = '"'
    j_init(j, src, 4, t, 16, d, 16)
    assert_eq(j_parse(j), J_ERR_CONTROL)
}

test "buffers too small and nesting too deep are refused" {
    let t[12]
    let d: u8[2]
    let j: JDoc
    assert_eq(parse_lit(j, "[1,2,3]", t, 12, d, 2), J_ERR_CAP)
    assert_eq(parse_lit(j, "\"abcdef\"", t, 12, d, 2), J_ERR_CAP)
    let t2[4096]
    let d2: u8[64]
    assert_eq(parse_lit(j, "[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[1]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]", t2, 4096, d2, 64), J_ERR_DEPTH)
}

test "the canonical form sorts keys and drops whitespace" {
    assert_eq(canon_eq(" { \"b\" : 1 , \"a\" : [ true , null , \"x\" ] , \"ab\": {}, \"c\": [] } ", "{\"a\":[true,null,\"x\"],\"ab\":{},\"b\":1,\"c\":[]}"), 1)
    assert_eq(canon_eq("{\"z\":{\"y\":false,\"x\":-1}}", "{\"z\":{\"x\":-1,\"y\":false}}"), 1)
}

test "the canonical form escapes only what it must" {
    let t[16]
    let d: u8[16]
    let j: JDoc
    let r = parse_lit(j, "\"\\u0041\\/\\u00e9\"", t, 16, d, 16)
    let o: u8[16]
    let w = JOut { buf: o, cap: 16, len: 0, bad: 0 }
    j_canon(j, w, r)
    assert_eq(w.len, 6)
    assert_eq(js_byte_at(o, 16, 1), 'A')
    assert_eq(js_byte_at(o, 16, 2), '/')
    assert_eq(js_byte_at(o, 16, 3), 0xC3)
    assert_eq(js_byte_at(o, 16, 4), 0xA9)
    assert_eq(canon_eq("\"q\\\"b\\\\n\\n\\t\\r\\b\\f\\u0001\\u001f\"", "\"q\\\"b\\\\n\\n\\t\\r\\b\\f\\u0001\\u001f\""), 1)
}

test "canonical keys compare by their bytes" {
    let t[64]
    let d: u8[64]
    let j: JDoc
    let r = parse_lit(j, "{\"b\":1,\"a\":2,\"aa\":3}", t, 64, d, 64)
    let o: u8[4]
    let w = JOut { buf: o, cap: 4, len: 0, bad: 0 }
    j_canon(j, w, r)
    assert_eq(w.bad, 1)
    assert_eq(j_key_cmp(j, j_key_at(j, r, 0), j_key_at(j, r, 1)), 1)
    assert_eq(j_key_at(j, r, 9), -1)
}

test "an omitted key is left out of the canonical form and stays readable" {
    let t[256]
    let d: u8[256]
    let j: JDoc
    let r = parse_lit(j, "{\"b\":{\"sig\":1,\"x\":2},\"a\":[{\"sig\":3,\"y\":4}],\"sig\":5}", t, 256, d, 256)
    assert_eq(j_omit(j, j_get(j, r, "b"), "sig"), 1)
    assert_eq(j_omit(j, j_first(j, j_get(j, r, "a")), "sig"), 1)
    assert_eq(j_omit(j, r, "nope"), 0)
    assert_eq(j_int(j, j_get(j, j_get(j, r, "b"), "sig")), 1)
    let o: u8[128]
    let w = JOut { buf: o, cap: 128, len: 0, bad: 0 }
    j_canon(j, w, r)
    let want: string = "{\"a\":[{\"y\":4}],\"b\":{\"x\":2},\"sig\":5}"
    assert_eq(w.len, strlen(want.utf8))
    assert_eq(memcmp(o, want.utf8, w.len), 0)
}

test "the bounded writer refuses to write past its capacity" {
    let o: u8[3]
    let w = JOut { buf: o, cap: 3, len: 0, bad: 0 }
    jo_dec(w, -12)
    assert_eq(w.len, 3)
    assert_eq(w.bad, 0)
    jo_lit(w, "x")
    assert_eq(w.bad, 1)
    assert_eq(w.len, 3)
}
