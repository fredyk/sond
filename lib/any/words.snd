//
// lib/any/words.snd: a closed vocabulary written as one space-separated literal
// ("GET POST PUT"), and the question asked of it: is p[0..n) one of its words, and which.
include "strings.snd"

// The bytes p[0..n) equal q[0..n).
priv fn words_same(p: i64, q: i64, n: i64) -> bool {
    let mut same = true
    let mut i = 0
    for i < n && same {
        same = peek8(p + i) == peek8(q + i)
        i = i + 1
    }
    same
}

// The position (from 1) of the word p[0..n) in list, or 0 when it is not one of its words.
// The empty word is never a word of the list.
pub fn word_index(list: string, p: i64, n: i64) -> i64 {
    let l = list.utf8
    let ln = strlen(l)
    let mut found = 0
    let mut idx = 1
    let mut start = 0
    let mut i = 0
    for i <= ln && found == 0 {
        let c = if i < ln { peek8(l + i) } else { ' ' }
        if c == ' ' {
            if n > 0 && i - start == n && words_same(l + start, p, n) { found = idx }
            idx = idx + 1
            start = i + 1
        }
        i = i + 1
    }
    found
}
