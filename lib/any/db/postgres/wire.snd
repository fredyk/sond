//
// lib/any/db/postgres/wire.snd: the PostgreSQL frontend/backend wire protocol v3
// message layer (the byte encoding, no sockets). All integers are network byte order
// (big-endian). The socket-facing client (client.snd) frames I/O with these helpers.
//
// Frontend messages built here: StartupMessage (no type byte, carries the protocol
// version 3.0 and the user/database parameters) and Query ('Q', a Simple Query).
// Backend messages are `type(1) | length(int32, includes itself) | payload`; the two
// accessors read the type byte and the declared length so the client can frame reads.

include "any/strings.snd"

let PG_PROTO_V3 = 196608        // 0x00030000, protocol major 3 minor 0

// Writes `v` as a 4-byte big-endian integer at `buf`.
fn pg_put_u32be(buf: i64, v: i64) {
    poke8(buf + 0, (v >> 24) & 0xff)
    poke8(buf + 1, (v >> 16) & 0xff)
    poke8(buf + 2, (v >> 8) & 0xff)
    poke8(buf + 3, v & 0xff)
}

// Reads the 4-byte big-endian integer at `buf`.
fn pg_get_u32be(buf: i64) -> i64 {
    (peek8(buf + 0) << 24) | (peek8(buf + 1) << 16) | (peek8(buf + 2) << 8) | peek8(buf + 3)
}

// Copies the C string `s` and its terminating NUL into `buf`; returns bytes written.
fn pg_put_cstr(buf: i64, s: i64) -> i64 {
    let n = strlen(s)
    let mut i = 0
    for i < n { poke8(buf + i, peek8(s + i)); i = i + 1 }
    poke8(buf + n, 0)
    n + 1
}

// Builds a StartupMessage in `buf` for `user`/`db` (both C strings). Layout:
//   int32 length | int32 196608 | "user\0"<user>"\0" "database\0"<db>"\0" "\0"
// Returns the total length written (which the length field also carries).
fn pg_startup(buf: i64, user: i64, db: i64) -> i64 {
    pg_put_u32be(buf + 4, PG_PROTO_V3)             // protocol version follows the length field
    let mut p = 8
    p = p + pg_put_cstr(buf + p, "user")
    p = p + pg_put_cstr(buf + p, user)
    p = p + pg_put_cstr(buf + p, "database")
    p = p + pg_put_cstr(buf + p, db)
    poke8(buf + p, 0)                              // empty key terminates the parameter list
    p = p + 1
    pg_put_u32be(buf, p)                           // length covers the whole message
    p
}

// Builds a Simple Query ('Q') for the SQL C string `sql` in `buf`. Layout:
//   'Q' | int32 length | <sql>"\0"   (length excludes the type byte, includes itself)
// Returns the total bytes written (1 + length).
fn pg_query(buf: i64, sql: i64) -> i64 {
    poke8(buf, 81)                                 // 'Q'
    let n = strlen(sql)
    let len = 4 + n + 1                            // length field + sql + NUL
    pg_put_u32be(buf + 1, len)
    let mut i = 0
    for i < n { poke8(buf + 5 + i, peek8(sql + i)); i = i + 1 }
    poke8(buf + 5 + n, 0)
    1 + len
}

// The type byte of a backend message (e.g. 'R','T','D','C','Z','E').
fn pg_msg_type(buf: i64) -> i64 { peek8(buf) }

// The declared length of a backend message: the int32 after the type byte. It counts
// itself, so the payload is (length - 4) bytes and the next message starts at 1+length.
fn pg_msg_len(buf: i64) -> i64 { pg_get_u32be(buf + 1) }

// Writes / reads a 2-byte big-endian integer (int16 counts and column attributes).
fn pg_put_u16be(buf: i64, v: i64) { poke8(buf, (v >> 8) & 0xff); poke8(buf + 1, v & 0xff) }
fn pg_get_u16be(buf: i64) -> i64 { (peek8(buf) << 8) | peek8(buf + 1) }

// Reads a SIGNED 4-byte big-endian integer (a DataRow field length uses -1 for NULL).
fn pg_get_i32be(buf: i64) -> i64 {
    let v = pg_get_u32be(buf)
    if v >= 2147483648 { v - 4294967296 } else { v }
}

// --- Backend message parsers (all operate on one framed message at `buf`) ---

// Authentication ('R'): the int32 auth code in the payload. 0=OK, 3=cleartext,
// 5=MD5 (+4 salt bytes follow), 10=SASL, 11=SASL-continue, 12=SASL-final.
fn pg_auth_type(buf: i64) -> i64 { pg_get_u32be(buf + 5) }

// RowDescription ('T'): the int16 field count.
fn pg_rowdesc_ncols(buf: i64) -> i64 { pg_get_u16be(buf + 5) }

// RowDescription: copy the `col`-th field name (NUL-terminated) into `out`, return its
// length. Each field is a name cstr followed by an 18-byte fixed tail (OIDs, sizes).
fn pg_rowdesc_name(buf: i64, col: i64, out: i64) -> i64 {
    let mut p = buf + 7                             // past type, length, int16 count
    let mut k = 0
    for k < col {
        for peek8(p) != 0 { p = p + 1 }             // skip the name cstr
        p = p + 1 + 18                              // its NUL, then the fixed field tail
        k = k + 1
    }
    let mut i = 0
    for peek8(p + i) != 0 { poke8(out + i, peek8(p + i)); i = i + 1 }
    poke8(out + i, 0)
    i
}

// DataRow ('D'): the int16 field count.
fn pg_datarow_nfields(buf: i64) -> i64 { pg_get_u16be(buf + 5) }

// DataRow: the byte cursor just past the `idx`-th field's int32 length header, i.e. a
// pointer to that field's value bytes (meaningful only when its length is >= 0).
fn pg_datarow_field_ptr(buf: i64, idx: i64) -> i64 {
    let mut p = buf + 7                             // past type, length, int16 count
    let mut k = 0
    for k < idx {
        let flen = pg_get_i32be(p)
        p = p + 4
        if flen > 0 { p = p + flen }
        k = k + 1
    }
    p + 4
}

// DataRow: the `idx`-th field's declared length, or -1 for SQL NULL.
fn pg_datarow_field_len(buf: i64, idx: i64) -> i64 {
    let mut p = buf + 7
    let mut k = 0
    for k < idx {
        let flen = pg_get_i32be(p)
        p = p + 4
        if flen > 0 { p = p + flen }
        k = k + 1
    }
    pg_get_i32be(p)
}

// DataRow: copy the `idx`-th field value (NUL-terminated) into `out`, return its byte
// length, or -1 if the field is SQL NULL (in which case `out` is left untouched).
fn pg_datarow_field(buf: i64, idx: i64, out: i64) -> i64 {
    let flen = pg_datarow_field_len(buf, idx)
    if flen < 0 { return 0 - 1 }
    let p = pg_datarow_field_ptr(buf, idx)
    let mut i = 0
    for i < flen { poke8(out + i, peek8(p + i)); i = i + 1 }
    poke8(out + i, 0)
    flen
}

// CommandComplete ('C'): a pointer to the NUL-terminated command tag ("SELECT 1", etc.).
fn pg_cmdcomplete_tag(buf: i64) -> i64 { buf + 5 }

// ErrorResponse ('E'): a pointer to the NUL-terminated value of the field whose type
// byte is `code` (e.g. 'M' message, 'C' SQLSTATE, 'S' severity), or 0 if absent. Fields
// are `byte type, cstr value` pairs, ended by a 0 type byte.
fn pg_error_field_ptr(buf: i64, code: i64) -> i64 {
    let mut p = buf + 5
    for peek8(p) != 0 {
        let t = peek8(p)
        p = p + 1
        if t == code { return p }
        for peek8(p) != 0 { p = p + 1 }             // skip this field's value cstr
        p = p + 1
    }
    0
}

// ErrorResponse: copy the `code` field's value into `out`, return its length; -1 if absent.
fn pg_error_field(buf: i64, code: i64, out: i64) -> i64 {
    let p = pg_error_field_ptr(buf, code)
    if p == 0 { return 0 - 1 }
    let mut i = 0
    for peek8(p + i) != 0 { poke8(out + i, peek8(p + i)); i = i + 1 }
    poke8(out + i, 0)
    i
}
