// Copyright 2026 Jhon Magdalena Vila and the Sond contributors
//
// Integration test of db/postgres/client.snd over a real 127.0.0.1 loopback socket. The
// PARENT is the client under test (so its coverage is counted); a forked CHILD plays a
// scripted PostgreSQL server. The listening socket is bound before the fork so the
// client can connect into the backlog without racing the child's accept.

include "any/db/postgres/client.snd"
include "any/crypto/ec/ecdsa-sign.snd"
include "x86_64/linux/testing.snd"

// --- scripted-server helpers (run in the child; not counted for coverage) ---

fn srv_send_auth(fd: i64, code: i64) {
    let b[16]
    poke8(b, 82)                                    // 'R'
    pg_put_u32be(b + 1, 8)
    pg_put_u32be(b + 5, code)
    write_buf(fd, b, 9)
}

fn srv_send_ready(fd: i64) {
    let b[8]
    poke8(b, 90)                                    // 'Z'
    pg_put_u32be(b + 1, 5)
    poke8(b + 5, 73)                                // 'I'
    write_buf(fd, b, 6)
}

fn srv_send_cmdcomplete(fd: i64, tag: i64) {
    let b[64]
    poke8(b, 67)                                    // 'C'
    let n = strlen(tag)
    let mut i = 0
    for i < n { poke8(b + 5 + i, tag[i]); i = i + 1 }
    poke8(b + 5 + n, 0)
    pg_put_u32be(b + 1, 4 + n + 1)
    write_buf(fd, b, 1 + 4 + n + 1)
}

fn srv_put_col(b: i64, p: i64, name: i64) -> i64 {
    let n = strlen(name)
    let mut i = 0
    for i < n { poke8(b + p + i, peek8(name + i)); i = i + 1 }
    poke8(b + p + n, 0)
    let mut z = 0
    for z < 18 { poke8(b + p + n + 1 + z, 0); z = z + 1 }   // 18-byte fixed field tail
    p + n + 1 + 18
}

fn srv_send_rowdesc2(fd: i64, c0: i64, c1: i64) {
    let b[128]
    poke8(b, 84)                                    // 'T'
    pg_put_u16be(b + 5, 2)
    let mut p = srv_put_col(b, 7, c0)
    p = srv_put_col(b, p, c1)
    pg_put_u32be(b + 1, p - 1)                       // length excludes the type byte
    write_buf(fd, b, p)
}

fn srv_put_field(b: i64, p: i64, val: i64, vlen: i64) -> i64 {
    if vlen < 0 {
        pg_put_u32be(b + p, 0xffffffff)             // SQL NULL
        return p + 4
    }
    pg_put_u32be(b + p, vlen)
    let mut i = 0
    for i < vlen { poke8(b + p + 4 + i, peek8(val + i)); i = i + 1 }
    p + 4 + vlen
}

fn srv_send_datarow2(fd: i64, a: i64, alen: i64, c: i64, clen: i64) {
    let b[256]
    poke8(b, 68)                                    // 'D'
    pg_put_u16be(b + 5, 2)
    let mut p = srv_put_field(b, 7, a, alen)
    p = srv_put_field(b, p, c, clen)
    pg_put_u32be(b + 1, p - 1)
    write_buf(fd, b, p)
}

// Reads and discards a StartupMessage (length-prefixed, no type byte).
fn srv_drain_startup(fd: i64) {
    let b[512]
    pg_read_exact_fd(fd, b, 4)
    let len = pg_get_u32be(b)
    if len > 4 { pg_read_exact_fd(fd, b + 4, len - 4) }
}

// Reads and discards one typed frontend message (PasswordMessage, Query, ...).
fn srv_drain_msg(fd: i64) {
    let b = heap_alloc(8192)
    pg_read_msg(pg_conn_plain(fd), b, 8192)
}

fn srv_send_error(fd: i64, msg: i64) {
    let b[128]
    poke8(b, 69)                                    // 'E'
    poke8(b + 5, 77)                                // 'M' message field
    let n = strlen(msg)
    let mut i = 0
    for i < n { poke8(b + 6 + i, peek8(msg + i)); i = i + 1 }
    poke8(b + 6 + n, 0)                             // value NUL
    poke8(b + 6 + n + 1, 0)                         // fields terminator
    let e = 6 + n + 2
    pg_put_u32be(b + 1, e - 1)
    write_buf(fd, b, e)
}

// --- scripted SCRAM-SHA-256 server (child): offers SASL, then verifies the client proof and
// answers with a correct ServerSignature, so the happy path exercises the real crypto both
// ways. Uses the same scram-flow primitives the client does (available transitively). ---

// AuthenticationSASL ('R' code 10) offering exactly SCRAM-SHA-256 (a NUL-terminated name,
// then the empty name that ends the mechanism list).
fn srv_send_sasl_offer(fd: i64) {
    let b[64]
    poke8(b, 82)                                    // 'R'
    pg_put_u32be(b + 5, 10)                         // AuthenticationSASL
    let mech_text: string = "SCRAM-SHA-256"
    let mech = mech_text.utf8
    let mut i = 0
    for i < 13 { poke8(b + 9 + i, mech[i]); i = i + 1 }
    poke8(b + 9 + 13, 0)                            // mechanism name NUL
    poke8(b + 9 + 14, 0)                            // empty name ends the list
    pg_put_u32be(b + 1, 23)                         // 4 self + 4 code + 14 mech + 1
    write_buf(fd, b, 24)
}

// AuthenticationSASLContinue/Final ('R' | int32 len | int32 code | data).
fn srv_send_sasl_data(fd: i64, code: i64, data: i64, datalen: i64) {
    let b = heap_alloc(512)
    poke8(b, 82)                                    // 'R'
    pg_put_u32be(b + 5, code)
    let mut i = 0
    for i < datalen { poke8(b + 9 + i, peek8(data + i)); i = i + 1 }
    pg_put_u32be(b + 1, 8 + datalen)               // 4 self + 4 code + data
    write_buf(fd, b, 9 + datalen)
}

// The whole server side of a SCRAM-SHA-256 exchange for password "pencil". Returns 1 if the
// client proof verified (and it answered AuthenticationSASLFinal + Ok + ReadyForQuery), 0 not.
let __q0_147: string = "n,,n=<user>,r=<client nonce>"
let __q1_171: string = "r=<client+server nonce>,s=<salt b64>,i=4096"
let __q2_185: string = "4096"
let __q3_190: string = "c=biws,r=<full nonce>,p=<proof b64>"
fn srv_scram(fd: i64) -> i64 {
    srv_send_sasl_offer(fd)

    // SASLInitialResponse: mechanism cstr, then int32 initial-response length, then the
    // client-first-message __q0_147.utf8.
    let m = heap_alloc(4096)
    if pg_read_msg(pg_conn_plain(fd), m, 4096) <= 0 { return 0 }
    let mut q = 5
    for peek8(m + q) != 0 { q = q + 1 }             // skip the mechanism name
    q = q + 1
    let irlen = pg_get_u32be(m + q)
    q = q + 4
    let cfbare = m + q + 3                           // skip the GS2 header "n,,"
    let cfbarelen = irlen - 3
    let cnonce[128]
    let cnoncelen = scram_attr(cfbare, cfbarelen, 114, cnonce)   // r=

    // salt is the fixed byte pattern 1..16; iteration count 4096.
    let salt[16]
    let mut i = 0
    for i < 16 { poke8(salt + i, i + 1); i = i + 1 }
    let saltb64[32]
    let saltb64len = b64_encode(salt, 16, saltb64)
    let snonce_text: string = "SscramServerNonce01"              // fixed 19-char server nonce
    let snonce = snonce_text.utf8
    let snoncelen = 19

    // server-first = __q1_171.utf8
    let sf[256]
    let mut s = 0
    let __lit0: string = "r="
    poke8(sf + 0, 114); poke8(sf + 1, 61); s = 2    // __lit0.utf8
    s = scram_app(sf, s, cnonce, cnoncelen)
    s = scram_app(sf, s, snonce, snoncelen)
    let __lit1: string = ",s="
    poke8(sf + s, 44); poke8(sf + s + 1, 115); poke8(sf + s + 2, 61); s = s + 3   // __lit1.utf8
    s = scram_app(sf, s, saltb64, saltb64len)
    let __lit2: string = ",i="
    poke8(sf + s, 44); poke8(sf + s + 1, 105); poke8(sf + s + 2, 61); s = s + 3   // __lit2.utf8
    poke8(sf + s, 52); poke8(sf + s + 1, 48); poke8(sf + s + 2, 57); poke8(sf + s + 3, 54)
    s = s + 4                                       // __q2_185.utf8
    let sflen = s
    srv_send_sasl_data(fd, 11, sf, sflen)           // AuthenticationSASLContinue

    // SASLResponse: the client-final __q3_190.utf8. Read it into a
    // SEPARATE buffer: cfbare still points into `m` (the initial response) and the AuthMessage
    // needs it, so reusing `m` here would clobber it.
    let m2 = heap_alloc(4096)
    if pg_read_msg(pg_conn_plain(fd), m2, 4096) <= 0 { return 0 }
    let cflen = pg_get_u32be(m2 + 1) - 4
    let cf = m2 + 5
    let proofb64[64]
    let pb64len = scram_attr(cf, cflen, 112, proofb64)   // p=
    let proof[48]
    b64_decode(proofb64, pb64len, proof)

    // client-final-without-proof, then AuthMessage, then the expected ClientProof.
    let cfwop[256]
    let mut w = 0
    let __lit3: string = "c=b"
    poke8(cfwop + 0, 99); poke8(cfwop + 1, 61); poke8(cfwop + 2, 98)     // __lit3.utf8
    let __lit4: string = "iws"
    poke8(cfwop + 3, 105); poke8(cfwop + 4, 119); poke8(cfwop + 5, 115)  // __lit4.utf8
    let __lit5: string = ",r="
    poke8(cfwop + 6, 44); poke8(cfwop + 7, 114); poke8(cfwop + 8, 61)    // __lit5.utf8
    w = 9
    w = scram_app(cfwop, w, cnonce, cnoncelen)
    w = scram_app(cfwop, w, snonce, snoncelen)
    let cfwoplen = w
    let auth[1024]
    let mut a = 0
    a = scram_app(auth, a, cfbare, cfbarelen)
    poke8(auth + a, 44); a = a + 1
    a = scram_app(auth, a, sf, sflen)
    poke8(auth + a, 44); a = a + 1
    a = scram_app(auth, a, cfwop, cfwoplen)
    let authlen = a

    let salted[32]
    let __lit6: string = "pencil"
    scram_salted_password(__lit6.utf8, 6, salt, 16, 4096, salted)
    let ckey[32]
    scram_client_key(salted, ckey)
    let skey[32]
    scram_stored_key(ckey, skey)
    let csig[32]
    scram_client_signature(skey, auth, authlen, csig)
    let expected[32]
    scram_client_proof(ckey, csig, expected)
    i = 0
    for i < 32 {
        if peek8(expected + i) != peek8(proof + i) { return 0 }
        i = i + 1
    }

    // proof verified: answer with the ServerSignature, then Ok and ReadyForQuery.
    let serverkey[32]
    scram_server_key(salted, serverkey)
    let ssig[32]
    scram_server_signature(serverkey, auth, authlen, ssig)
    let vbuf[64]
    let __lit7: string = "v="
    poke8(vbuf + 0, 118); poke8(vbuf + 1, 61)       // __lit7.utf8
    let vlen = 2 + b64_encode(ssig, 32, vbuf + 2)
    srv_send_sasl_data(fd, 12, vbuf, vlen)          // AuthenticationSASLFinal
    srv_send_auth(fd, 0)                            // AuthenticationOk
    srv_send_ready(fd)
    1
}

// Runs the SCRAM exchange far enough to answer the client-final, but replies with a WRONG
// ServerSignature: the client must reject it (a server that cannot prove it holds the stored
// key is not trusted). Does not verify the client proof; it only needs to reach the reply.
let __q4_290: string = "v="
fn srv_scram_bad_serversig(fd: i64) {
    srv_send_sasl_offer(fd)
    let m = heap_alloc(4096)
    if pg_read_msg(pg_conn_plain(fd), m, 4096) <= 0 { return }
    let mut q = 5
    for peek8(m + q) != 0 { q = q + 1 }
    q = q + 1
    let irlen = pg_get_u32be(m + q)
    q = q + 4
    let cfbare = m + q + 3
    let cnonce[128]
    let cnoncelen = scram_attr(cfbare, irlen - 3, 114, cnonce)
    let salt[16]
    let mut i = 0
    for i < 16 { poke8(salt + i, i + 1); i = i + 1 }
    let saltb64[32]
    let saltb64len = b64_encode(salt, 16, saltb64)
    let sf[256]
    let mut s = 0
    poke8(sf + 0, 114); poke8(sf + 1, 61); s = 2
    s = scram_app(sf, s, cnonce, cnoncelen)
    let __lit8: string = "SscramServerNonce01"
    s = scram_app(sf, s, __lit8.utf8, 19)
    poke8(sf + s, 44); poke8(sf + s + 1, 115); poke8(sf + s + 2, 61); s = s + 3
    s = scram_app(sf, s, saltb64, saltb64len)
    poke8(sf + s, 44); poke8(sf + s + 1, 105); poke8(sf + s + 2, 61); s = s + 3
    poke8(sf + s, 52); poke8(sf + s + 1, 48); poke8(sf + s + 2, 57); poke8(sf + s + 3, 54); s = s + 4
    srv_send_sasl_data(fd, 11, sf, s)
    let m2 = heap_alloc(4096)
    if pg_read_msg(pg_conn_plain(fd), m2, 4096) <= 0 { return }
    // SASLFinal with a bogus __q4_290.utf8 (base64 of 32 zero bytes): a signature the client cannot match.
    let z[32]
    i = 0
    for i < 32 { poke8(z + i, 0); i = i + 1 }
    let vbuf[64]
    poke8(vbuf + 0, 118); poke8(vbuf + 1, 61)
    let vlen = 2 + b64_encode(z, 32, vbuf + 2)
    srv_send_sasl_data(fd, 12, vbuf, vlen)
}

test "pg client: SCRAM-SHA-256 authentication over loopback" {
    let sfd_port[1]
    let sfd = listen_loopback(0, 4, sfd_port)
    assert(sfd >= 0)
    let port = peek64(sfd_port)
    let ip = 0x7f000001

    let pid = syscall(SYS_fork)
    if pid == 0 {
        let afd = accept_within(sfd, 10000)
        if afd < 0 { syscall(SYS_exit, 2) }
        srv_drain_startup(afd)
        let ok = srv_scram(afd)
        close_fd(afd)
        syscall(SYS_exit, 1 - ok)                   // exit 0 on a verified proof
    }

    let __z0_316: string = "127.0.0.1"
    let __z1_316: string = "user"
    let __z2_316: string = "pencil"
    let __z3_316: string = "db"
    let conn = pgx_connect(__z0_316.utf8, port, __z1_316.utf8, __z2_316.utf8, __z3_316.utf8)
    assert_ne(conn, 0)
    assert_eq(pgx_ok(conn), 1)                       // authenticated via SCRAM
    pgx_close(conn)
    close_fd(sfd)
    let st[1]
    syscall(SYS_wait4, pid, st, 0, 0)
    assert_eq((st[0] >> 8) & 255, 0)                 // the server verified the client proof
}

// The server asks for SASL but hangs up before the server-first message: the client's SCRAM
// exchange must fail the connection, not hang or proceed unauthenticated.
test "pg client: SASL offered then hung up fails the connection" {
    let sfd_port[1]
    let sfd = listen_loopback(0, 4, sfd_port)
    assert(sfd >= 0)
    let port = peek64(sfd_port)
    let ip = 0x7f000001

    let pid = syscall(SYS_fork)
    if pid == 0 {
        let afd = accept_within(sfd, 10000)
        if afd < 0 { syscall(SYS_exit, 2) }
        srv_drain_startup(afd)
        srv_send_sasl_offer(afd)                     // ask for SASL, then hang up
        close_fd(afd)
        syscall(SYS_exit, 0)
    }

    let __z4_352: string = "127.0.0.1"
    let __z5_352: string = "user"
    let __z6_352: string = "pencil"
    let __z7_352: string = "db"
    assert_eq(pgx_connect(__z4_352.utf8, port, __z5_352.utf8, __z6_352.utf8, __z7_352.utf8), 0)
    close_fd(sfd)
    let st[1]
    syscall(SYS_wait4, pid, st, 0, 0)
}

// The server completes the exchange but returns a WRONG ServerSignature: the client must not
// trust it, because the server has not proven it holds the stored key.
test "pg client: a bad SCRAM ServerSignature fails the connection" {
    let sfd_port[1]
    let sfd = listen_loopback(0, 4, sfd_port)
    assert(sfd >= 0)
    let port = peek64(sfd_port)
    let ip = 0x7f000001

    let pid = syscall(SYS_fork)
    if pid == 0 {
        let afd = accept_within(sfd, 10000)
        if afd < 0 { syscall(SYS_exit, 2) }
        srv_drain_startup(afd)
        srv_scram_bad_serversig(afd)
        close_fd(afd)
        syscall(SYS_exit, 0)
    }

    let __z8_384: string = "127.0.0.1"
    let __z9_384: string = "user"
    let __z10_384: string = "pencil"
    let __z11_384: string = "db"
    assert_eq(pgx_connect(__z8_384.utf8, port, __z9_384.utf8, __z10_384.utf8, __z11_384.utf8), 0)
    close_fd(sfd)
    let st[1]
    syscall(SYS_wait4, pid, st, 0, 0)
}

let __q5_451: string = "bob"
let __q6_455: string = "SELECT 2"
test "pg client: connect (cleartext), query, and read rows over loopback" {
    let sfd_port[1]
    let sfd = listen_loopback(0, 4, sfd_port)
    assert(sfd >= 0)
    let port = peek64(sfd_port)
    let ip = 0x7f000001

    let pid = syscall(SYS_fork)
    if pid == 0 {
        // CHILD: scripted PostgreSQL server.
        let afd = accept_within(sfd, 10000)
        if afd < 0 { syscall(SYS_exit, 2) }
        srv_drain_startup(afd)
        srv_send_auth(afd, 3)                       // AuthenticationCleartextPassword
        srv_drain_msg(afd)                          // PasswordMessage
        srv_send_auth(afd, 0)                       // AuthenticationOk
        srv_send_ready(afd)                         // ReadyForQuery
        srv_drain_msg(afd)                          // the Query
        let __lit9: string = "id"
        let __lit10: string = "name"
        srv_send_rowdesc2(afd, __lit9.utf8, __lit10.utf8)
        let __lit11: string = "7"
        let __lit12: string = "bob"
        srv_send_datarow2(afd, __lit11.utf8, 1, __lit12.utf8, 3)
        let __lit13: string = "8"
        let __lit14: string = "bob"
        srv_send_datarow2(afd, __lit13.utf8, 1, __lit14.utf8, 0 - 1)   // second col is NULL
        let __lit15: string = "SELECT 2"
        srv_send_cmdcomplete(afd, __lit15.utf8)
        srv_send_ready(afd)
        close_fd(afd)
        syscall(SYS_exit, 0)
    }

    // PARENT: the client under test.
    let __z12_432: string = "127.0.0.1"
    let __z13_432: string = "u"
    let __z14_432: string = "secret"
    let __z15_432: string = "db"
    let conn = pgx_connect(__z12_432.utf8, port, __z13_432.utf8, __z14_432.utf8, __z15_432.utf8)
    assert_ne(conn, 0)
    assert_eq(pgx_ok(conn), 1)

    let __z0_440: string = "SELECT id,name FROM t"
    let r = pgx_query(conn, __z0_440.utf8)
    assert_eq(pgx_res_ok(r), 1)
    assert_eq(pgx_ncols(r), 2)
    assert_eq(pgx_nrows(r), 2)
    assert_eq(peek8(pgx_val(r, 0, 0)), 55)          // '7'
    assert_eq(peek8(pgx_val(r, 0, 1)), 98)          // 'b' of __q5_451.utf8
    assert_eq(peek8(pgx_val(r, 1, 0)), 56)          // '8'
    assert_eq(pgx_val(r, 1, 1), 0)                  // SQL NULL
    assert_eq(peek8(pgx_res_cmd(r)), 83)            // 'S' of __q6_455.utf8

    pgx_close(conn)
    close_fd(sfd)
    let st[1]
    syscall(SYS_wait4, pid, st, 0, 0)
    assert_eq((st[0] >> 8) & 255, 0)
}

// A second server that offers an unsupported auth method (MD5): the client must fail
// the connection cleanly rather than proceed unauthenticated.
test "pg client: an unsupported auth method fails the connection" {
    let sfd_port[1]
    let sfd = listen_loopback(0, 4, sfd_port)
    assert(sfd >= 0)
    let port = peek64(sfd_port)
    let ip = 0x7f000001

    let pid = syscall(SYS_fork)
    if pid == 0 {
        let afd = accept_within(sfd, 10000)
        if afd < 0 { syscall(SYS_exit, 2) }
        srv_drain_startup(afd)
        srv_send_auth(afd, 5)                       // AuthenticationMD5Password (unsupported)
        close_fd(afd)
        syscall(SYS_exit, 0)
    }

    let __z16_479: string = "127.0.0.1"
    let __z17_479: string = "u"
    let __z18_479: string = "secret"
    let __z19_479: string = "db"
    let conn = pgx_connect(__z16_479.utf8, port, __z17_479.utf8, __z18_479.utf8, __z19_479.utf8)
    assert_eq(conn, 0)                              // hard failure, no unauthenticated session

    close_fd(sfd)
    let st[1]
    syscall(SYS_wait4, pid, st, 0, 0)
}

// A refused connection (nothing listening) yields a null handle, no crash.
test "pg client: a refused connection returns a null handle" {
    let __z20_493: string = "127.0.0.1"
    let __z21_493: string = "u"
    let __z22_493: string = ""
    let __z23_493: string = "db"
    assert_eq(pgx_connect(__z20_493.utf8, unused_loopback_port(), __z21_493.utf8, __z22_493.utf8, __z23_493.utf8), 0)
}

// A server that hangs up mid-startup must surface as a failed connect, not a hang.
test "pg client: a server that hangs up during startup fails cleanly" {
    let sfd_port[1]
    let sfd = listen_loopback(0, 4, sfd_port)
    assert(sfd >= 0)
    let port = peek64(sfd_port)
    let ip = 0x7f000001

    let pid = syscall(SYS_fork)
    if pid == 0 {
        let afd = accept_within(sfd, 10000)
        if afd < 0 { syscall(SYS_exit, 2) }
        srv_drain_startup(afd)
        close_fd(afd)                               // hang up before any auth message
        syscall(SYS_exit, 0)
    }

    let __z24_520: string = "127.0.0.1"
    let __z25_520: string = "u"
    let __z26_520: string = "secret"
    let __z27_520: string = "db"
    assert_eq(pgx_connect(__z24_520.utf8, port, __z25_520.utf8, __z26_520.utf8, __z27_520.utf8), 0)
    close_fd(sfd)
    let st[1]
    syscall(SYS_wait4, pid, st, 0, 0)
}

// An ErrorResponse during startup (e.g. bad database) fails the connection.
test "pg client: an ErrorResponse during startup fails the connection" {
    let sfd_port[1]
    let sfd = listen_loopback(0, 4, sfd_port)
    assert(sfd >= 0)
    let port = peek64(sfd_port)
    let ip = 0x7f000001

    let pid = syscall(SYS_fork)
    if pid == 0 {
        let afd = accept_within(sfd, 10000)
        if afd < 0 { syscall(SYS_exit, 2) }
        srv_drain_startup(afd)
        let __lit16: string = "database \"db\" does not exist"
        srv_send_error(afd, __lit16.utf8)
        close_fd(afd)
        syscall(SYS_exit, 0)
    }

    let __z28_552: string = "127.0.0.1"
    let __z29_552: string = "u"
    let __z30_552: string = "secret"
    let __z31_552: string = "db"
    assert_eq(pgx_connect(__z28_552.utf8, port, __z29_552.utf8, __z30_552.utf8, __z31_552.utf8), 0)
    close_fd(sfd)
    let st[1]
    syscall(SYS_wait4, pid, st, 0, 0)
}

// ─── deterministic postgres-over-TLS server (child): a TLS 1.3 server presenting a test
// certificate, then a minimal PostgreSQL exchange (trust auth + one query) inside TLS. It
// covers the TLS transport of the client (pgx_connect_direct / pgx_connect_ssl, pg_send /
// pg_recv_exact over TLS). SCRAM over TLS is proven live; here trust auth keeps the server
// small while still exercising every TLS branch. Cert/key are the self-signed sond.test pair.

let PT_CERT_HEX = ""
let PT_D_HEX = "c57841cdb48148966bf65648b7fb7585e603b7b1e416b5dfee4b53fc1a8d502d"
let mut pt_cert[512]
let mut pt_d[32]
let mut pt_k[32]
let mut pt_sh[512]
let mut pt_tr[20000]
let mut pt_flight[4096]
let mut pt_scratch[4096]
let mut pt_sealed[4096]
let mut pt_content[256]
let mut pt_cakey[32]
let mut pt_caiv[12]
let mut pt_sakey[32]
let mut pt_saiv[12]
let mut pt_cseq[1]
let mut pt_sseq[1]

fn pt_hx(c: i64) -> i64 {
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 97 && c <= 102 { return c - 87 }
    c - 55
}
fn pt_load(hex: i64, dst: i64) -> i64 {
    let mut i = 0
    for peek8(hex + i * 2) != 0 {
        poke8(dst + i, pt_hx(peek8(hex + i * 2)) * 16 + pt_hx(peek8(hex + i * 2 + 1)))
        i = i + 1
    }
    i
}
fn pt_u24(buf: i64, v: i64) { poke8(buf, (v >> 16) & 0xff); poke8(buf + 1, (v >> 8) & 0xff); poke8(buf + 2, v & 0xff) }
fn pt_app(dst: i64, o: i64, src: i64, n: i64) -> i64 {
    let mut i = 0
    let mut q = o
    for i < n { poke8(dst + q, peek8(src + i)); q = q + 1; i = i + 1 }
    q
}
fn pt_der_int(out: i64, val: i64) -> i64 {
    let mut st = 0
    for st < 31 { if peek8(val + st) != 0 { break } st = st + 1 }
    let clen = 32 - st
    let needpad = if (peek8(val + st) & 0x80) != 0 { 1 } else { 0 }
    poke8(out, 2); poke8(out + 1, clen + needpad)
    let mut o = 2
    if needpad == 1 { poke8(out + o, 0); o = o + 1 }
    let mut i = 0
    for i < clen { poke8(out + o, peek8(val + st + i)); o = o + 1; i = i + 1 }
    o
}
fn pt_build_sh(random: i64, spub: i64, out: i64) -> i64 {
    poke8(out, 2)
    let body = out + 4
    let mut o = 0
    hs_put_u16(body + o, 0x0303); o = o + 2
    let mut i = 0
    for i < 32 { poke8(body + o + i, peek8(random + i)); i = i + 1 }
    o = o + 32
    poke8(body + o, 0); o = o + 1
    hs_put_u16(body + o, 0x1303); o = o + 2
    poke8(body + o, 0); o = o + 1
    let extlen_at = o
    o = o + 2
    let ext_start = o
    hs_put_u16(body + o, 43); o = o + 2
    hs_put_u16(body + o, 2); o = o + 2
    hs_put_u16(body + o, 0x0304); o = o + 2
    hs_put_u16(body + o, 51); o = o + 2
    hs_put_u16(body + o, 36); o = o + 2
    hs_put_u16(body + o, 0x001d); o = o + 2
    hs_put_u16(body + o, 32); o = o + 2
    i = 0
    for i < 32 { poke8(body + o + i, peek8(spub + i)); i = i + 1 }
    o = o + 32
    hs_put_u16(body + extlen_at, o - ext_start)
    hs_put_u24(out + 1, o)
    4 + o
}

// TLS 1.3 server handshake on `afd` (client key_share is at ClientHello offset 84; the client
// offers exactly what this stack does). Stores the application keys in the pt_* globals and
// resets the app sequence numbers. Returns 1 on completion.
fn pt_handshake(afd: i64, certlen: i64) -> i64 {
    let crec[2048]
    let crl = tls_read_record(afd, crec, 2048)
    if crl <= 0 { return 0 }
    let cmsg = crec + 5
    let cmsglen = crl - 5
    let cpub = cmsg + 84
    let spriv[32]
    tls_random(spriv, 32)
    let base9[32]
    poke8(base9, 9)
    let mut z = 0
    for z < 31 { poke8(base9 + 1 + z, 0); z = z + 1 }
    let spub[32]
    x25519(spriv, base9, spub)
    let shared[32]
    x25519(spriv, cpub, shared)
    let srand[32]
    tls_random(srand, 32)
    let shlen = pt_build_sh(srand, spub, pt_sh)
    tls_send_plain_handshake(afd, pt_sh, shlen, pt_scratch)
    z = 0
    for z < cmsglen { poke8(pt_tr + z, peek8(cmsg + z)); z = z + 1 }
    z = 0
    for z < shlen { poke8(pt_tr + cmsglen + z, peek8(pt_sh + z)); z = z + 1 }
    let trlen = cmsglen + shlen
    let early[32]
    tls_early_secret(early, 0, early)
    let hs[32]
    tls_derive_handshake_secret(early, shared, 32, hs)
    let s_hs[32]
    tls_server_hs_traffic(hs, pt_tr, trlen, s_hs)
    let skey[32]
    let siv[12]
    tls_traffic_key_iv(s_hs, skey, siv)
    // flight: EE
    let mut fl = 0
    poke8(pt_flight + 0, 8); poke8(pt_flight + 1, 0); poke8(pt_flight + 2, 0)
    poke8(pt_flight + 3, 2); poke8(pt_flight + 4, 0); poke8(pt_flight + 5, 0)
    fl = 6
    let cmstart = fl
    poke8(pt_flight + fl, 11); fl = fl + 4
    let cbody = fl
    poke8(pt_flight + fl, 0); fl = fl + 1
    pt_u24(pt_flight + fl, certlen + 5); fl = fl + 3
    pt_u24(pt_flight + fl, certlen); fl = fl + 3
    fl = pt_app(pt_flight, fl, pt_cert, certlen)
    hs_put_u16(pt_flight + fl, 0); fl = fl + 2
    pt_u24(pt_flight + cmstart + 1, fl - cbody)
    z = 0
    for z < fl { poke8(pt_tr + trlen + z, peek8(pt_flight + z)); z = z + 1 }
    let th[32]
    sha256_hash(pt_tr, trlen + fl, th)
    z = 0
    for z < 64 { poke8(pt_content + z, 0x20); z = z + 1 }
    let lbl_text: string = "TLS 1.3, server CertificateVerify"
    let lbl = lbl_text.utf8
    z = 0
    for z < 33 { poke8(pt_content + 64 + z, lbl[z]); z = z + 1 }
    poke8(pt_content + 97, 0)
    z = 0
    for z < 32 { poke8(pt_content + 98 + z, peek8(th + z)); z = z + 1 }
    let ce[32]
    sha256_hash(pt_content, 130, ce)
    let sr[32]
    let ss[32]
    ecdsa_sign(pt_d, ce, pt_k, sr, ss)
    let der[80]
    let n1 = pt_der_int(der + 2, sr)
    let n2 = pt_der_int(der + 2 + n1, ss)
    poke8(der + 0, 0x30); poke8(der + 1, n1 + n2)
    let derlen = 2 + n1 + n2
    let cvstart = fl
    poke8(pt_flight + fl, 15); fl = fl + 4
    let cvbody = fl
    hs_put_u16(pt_flight + fl, 0x0403); fl = fl + 2
    hs_put_u16(pt_flight + fl, derlen); fl = fl + 2
    fl = pt_app(pt_flight, fl, der, derlen)
    pt_u24(pt_flight + cvstart + 1, fl - cvbody)
    z = 0
    for z < fl { poke8(pt_tr + trlen + z, peek8(pt_flight + z)); z = z + 1 }
    let thcv[32]
    sha256_hash(pt_tr, trlen + fl, thcv)
    let empty[1]
    let sfk[32]
    let __lit17: string = "finished"
    hkdf_expand_label(s_hs, __lit17.utf8, 8, empty, 0, sfk, 32)
    let sfin[32]
    hmac_sha256(sfk, 32, thcv, 32, sfin)
    poke8(pt_flight + fl, 20); poke8(pt_flight + fl + 1, 0); poke8(pt_flight + fl + 2, 0); poke8(pt_flight + fl + 3, 32)
    fl = fl + 4
    fl = pt_app(pt_flight, fl, sfin, 32)
    let sl = tls_seal(skey, siv, 0, 22, pt_flight, fl, pt_sealed)
    write_buf(afd, pt_sealed, sl)
    z = 0
    for z < fl { poke8(pt_tr + trlen + z, peek8(pt_flight + z)); z = z + 1 }
    let master[32]
    tls_derive_master_secret(hs, master)
    let s_ap[32]
    let __lit18: string = "s ap traffic"
    derive_secret(master, __lit18.utf8, 12, pt_tr, trlen + fl, s_ap)
    let c_ap[32]
    let __lit19: string = "c ap traffic"
    derive_secret(master, __lit19.utf8, 12, pt_tr, trlen + fl, c_ap)
    tls_traffic_key_iv(s_ap, pt_sakey, pt_saiv)
    tls_traffic_key_iv(c_ap, pt_cakey, pt_caiv)
    // read the client's CCS then encrypted Finished (client handshake key); we only need to
    // drain them so the socket is positioned at the client's first application record.
    let rb[2048]
    let mut rr = tls_read_record(afd, rb, 2048)
    if peek8(rb) == 20 { rr = tls_read_record(afd, rb, 2048) }
    poke64(pt_cseq, 0)
    poke64(pt_sseq, 0)
    1
}

// Reads one application record from the client, decrypts it (client app key), and returns the
// PostgreSQL plaintext length in `out`. Skips nothing; one record per call.
fn pt_recv(afd: i64, out: i64) -> i64 {
    let rec[4096]
    let rl = tls_read_record(afd, rec, 4096)
    if rl <= 0 { return 0 - 1 }
    let m = tls_open(pt_cakey, pt_caiv, peek64(pt_cseq), rec, rl, out)
    if m < 0 { return 0 - 1 }
    poke64(pt_cseq, peek64(pt_cseq) + 1)
    m & 0xffffffff
}

// Seals `len` bytes of PostgreSQL data (server app key) and writes the record to the client.
fn pt_send(afd: i64, msg: i64, len: i64) {
    let sealed[4096]
    let sl = tls_seal(pt_sakey, pt_saiv, peek64(pt_sseq), 23, msg, len, sealed)
    write_buf(afd, sealed, sl)
    poke64(pt_sseq, peek64(pt_sseq) + 1)
}

// The whole server side over TLS: handshake, then a minimal trust-auth PostgreSQL flow. If
// `sslrequest` is 1, it first consumes the 8-byte SSLRequest and answers 'S' in the clear.
let __q7_815: string = "1"
fn pt_serve(afd: i64, sslrequest: i64) {
    if sslrequest == 1 {
        let sr[8]
        pg_read_exact_fd(afd, sr, 8)                 // SSLRequest (length 8 + code)
        let ss[1]
        poke8(ss, 83)                                // 'S' = SSL supported
        write_buf(afd, ss, 1)
    }
    let certlen = pt_load(PT_CERT_HEX, pt_cert)
    if pt_handshake(afd, certlen) != 1 { return }
    let m = heap_alloc(4096)
    // read the StartupMessage (over TLS), then answer AuthenticationOk + ReadyForQuery (trust)
    if pt_recv(afd, m) < 0 { return }
    let ok[9]
    poke8(ok, 82); pg_put_u32be(ok + 1, 8); pg_put_u32be(ok + 5, 0)   // 'R' AuthenticationOk
    pt_send(afd, ok, 9)
    let rdy[6]
    poke8(rdy, 90); pg_put_u32be(rdy + 1, 5); poke8(rdy + 5, 73)      // 'Z' ReadyForQuery 'I'
    pt_send(afd, rdy, 6)
    // one Simple Query: read it, then reply RowDescription(1 col) + DataRow(__q7_815.utf8) + CmdComplete + Ready
    if pt_recv(afd, m) < 0 { return }
    let rd[64]
    let __lit20: string = "n"
    poke8(rd, 84); pg_put_u16be(rd + 5, 1)                            // 'T' one column __lit20.utf8
    poke8(rd + 7, 110); poke8(rd + 8, 0)
    let mut z = 0
    for z < 18 { poke8(rd + 9 + z, 0); z = z + 1 }
    pg_put_u32be(rd + 1, 27 - 1 + 6)                                  // length excludes type byte
    pt_send(afd, rd, 27 + 6)
    let dr[16]
    let __lit21: string = "1"
    poke8(dr, 68); pg_put_u16be(dr + 5, 1)                            // 'D' one field __lit21.utf8
    pg_put_u32be(dr + 7, 1); poke8(dr + 11, 49)
    pg_put_u32be(dr + 1, 11)                                          // 4 + 2 + 4 + 1 excl type
    pt_send(afd, dr, 12)
    let cc[16]
    let __lit22: string = "SELECT 1"
    poke8(cc, 67)                                                    // 'C' __lit22.utf8
    let tag_text: string = "SELECT 1"
    let tag = tag_text.utf8
    z = 0
    for z < 8 { poke8(cc + 5 + z, tag[z]); z = z + 1 }
    poke8(cc + 13, 0)
    pg_put_u32be(cc + 1, 4 + 8 + 1)
    pt_send(afd, cc, 14)
    pt_send(afd, rdy, 6)
}

test "pg client: direct-TLS connect + SCRAM-transport (trust auth) + query over loopback" {
    let sfd_port[1]
    let sfd = listen_loopback(0, 4, sfd_port)
    assert(sfd >= 0)
    let port = peek64(sfd_port)
    let ip = 0x7f000001
    let mut i = 0
    for i < 32 { poke8(pt_k + i, 0x33 + i); i = i + 1 }   // fixed ecdsa_sign nonce for the child
    pt_load(PT_D_HEX, pt_d)

    let pid = syscall(SYS_fork)
    if pid == 0 {
        let afd = accept_within(sfd, 10000)
        if afd < 0 { syscall(SYS_exit, 2) }
        pt_serve(afd, 0)                                 // direct TLS (no SSLRequest)
        close_fd(afd)
        syscall(SYS_exit, 0)
    }

    let roots[4]
    roots[0] = pt_cert                                   // self-signed leaf is its own anchor
    pt_load(PT_CERT_HEX, pt_cert)
    let __z0_862: string = "127.0.0.1"
    let __z1_862: string = "user"
    let __z2_862: string = "pw"
    let __z3_862: string = "db"
    let __q8_875: string = "sond.test"
    let __q9_875: string = "20270101000000"
    let conn = pgx_connect_direct(__z0_862.utf8, port, __z1_862.utf8, __z2_862.utf8, __z3_862.utf8,
                                  __q8_875.utf8, 9, roots, 1, __q9_875.utf8)
    assert_ne(conn, 0)
    assert_eq(pgx_ok(conn), 1)                           // authenticated inside TLS
    let __z1_866: string = "SELECT 1"
    let r = pgx_query(conn, __z1_866.utf8)
    assert_eq(pgx_res_ok(r), 1)
    assert_eq(pgx_nrows(r), 1)
    assert_eq(peek8(pgx_val(r, 0, 0)), 49)               // '1'
    pgx_close(conn)
    close_fd(sfd)
    let st[1]
    syscall(SYS_wait4, pid, st, 0, 0)
}

test "pg client: SSLRequest-negotiated TLS connect authenticates" {
    let sfd_port[1]
    let sfd = listen_loopback(0, 4, sfd_port)
    assert(sfd >= 0)
    let port = peek64(sfd_port)
    let ip = 0x7f000001
    let mut i = 0
    for i < 32 { poke8(pt_k + i, 0x33 + i); i = i + 1 }
    pt_load(PT_D_HEX, pt_d)

    let pid = syscall(SYS_fork)
    if pid == 0 {
        let afd = accept_within(sfd, 10000)
        if afd < 0 { syscall(SYS_exit, 2) }
        pt_serve(afd, 1)                                 // SSLRequest negotiation, then TLS
        close_fd(afd)
        syscall(SYS_exit, 0)
    }

    let roots[4]
    pt_load(PT_CERT_HEX, pt_cert)
    roots[0] = pt_cert
    let __q10_917: string = "sond.test"
    let __q11_917: string = "20270101000000"
    let __s0_918: string = "127.0.0.1"
    let __s1_918: string = "user"
    let __s2_918: string = "pw"
    let __s3_918: string = "db"
    let conn = pgx_connect_ssl(__s0_918.utf8, port, __s1_918.utf8, __s2_918.utf8, __s3_918.utf8,
                               __q10_917.utf8, 9, roots, 1, __q11_917.utf8)
    assert_ne(conn, 0)
    assert_eq(pgx_ok(conn), 1)
    pgx_close(conn)
    close_fd(sfd)
    let st[1]
    syscall(SYS_wait4, pid, st, 0, 0)
}

test "pg tls: ecdsa_sign pubkey derivation and a zero nonce (server-side helpers)" {
    pt_load(PT_D_HEX, pt_d)
    let qx[32]
    let qy[32]
    ecdsa_pubkey(pt_d, qx, qy)
    assert_eq(peek8(qx + 0) + peek8(qy + 0) >= 0, 1)
    let mut i = 0
    for i < 32 { poke8(pt_k + i, 0); i = i + 1 }
    let sr[32]
    let ss[32]
    assert_eq(ecdsa_sign(pt_d, pt_d, pt_k, sr, ss), 0)   // k=0 -> failure
}

let __q12_964: string = "127.0.0.1"
let __q13_964: string = "u"
let __q14_964: string = "p"
let __q15_964: string = "db"
let __q16_964: string = "sond.test"
let __q17_964: string = "20270101000000"
test "pg client: SSLRequest refused (server answers 'N') fails the connection" {
    let sfd_port[1]
    let sfd = listen_loopback(0, 4, sfd_port)
    assert(sfd >= 0)
    let port = peek64(sfd_port)
    let pid = syscall(SYS_fork)
    if pid == 0 {
        let afd = accept_within(sfd, 10000)
        if afd < 0 { syscall(SYS_exit, 2) }
        let sr[8]
        pg_read_exact_fd(afd, sr, 8)                 // SSLRequest
        let n[1]
        poke8(n, 78)                                 // 'N' = SSL not supported
        write_buf(afd, n, 1)
        close_fd(afd)
        syscall(SYS_exit, 0)
    }
    let roots[4]
    pt_load(PT_CERT_HEX, pt_cert)
    roots[0] = pt_cert
    assert_eq(pgx_connect_ssl(__q12_964.utf8, port, __q13_964.utf8, __q14_964.utf8, __q15_964.utf8, __q16_964.utf8, 9, roots, 1, __q17_964.utf8), 0)
    close_fd(sfd)
    let st[1]
    syscall(SYS_wait4, pid, st, 0, 0)
}

test "pg client: direct-TLS with a mismatched host is rejected" {
    let sfd_port[1]
    let sfd = listen_loopback(0, 4, sfd_port)
    assert(sfd >= 0)
    let port = peek64(sfd_port)
    let mut i = 0
    for i < 32 { poke8(pt_k + i, 0x33 + i); i = i + 1 }
    pt_load(PT_D_HEX, pt_d)
    let pid = syscall(SYS_fork)
    if pid == 0 {
        let afd = accept_within(sfd, 10000)
        if afd < 0 { syscall(SYS_exit, 2) }
        pt_serve(afd, 0)
        close_fd(afd)
        syscall(SYS_exit, 0)
    }
    let roots[4]
    pt_load(PT_CERT_HEX, pt_cert)
    roots[0] = pt_cert
    // the certificate names sond.test, not wrong.host: chain validation fails, connect returns 0
    let __z4_981: string = "127.0.0.1"
    let __z5_981: string = "u"
    let __z6_981: string = "p"
    let __z7_981: string = "db"
    let __z8_981: string = "wrong.host"
    let __z9_981: string = "20270101000000"
    assert_eq(pgx_connect_direct(__z4_981.utf8, port, __z5_981.utf8, __z6_981.utf8, __z7_981.utf8, __z8_981.utf8, 10, roots, 1, __z9_981.utf8), 0)
    close_fd(sfd)
    let st[1]
    syscall(SYS_wait4, pid, st, 0, 0)
}

test "pg client: a TLS server that hangs up after the handshake fails the connection" {
    let sfd_port[1]
    let sfd = listen_loopback(0, 4, sfd_port)
    assert(sfd >= 0)
    let port = peek64(sfd_port)
    let mut i = 0
    for i < 32 { poke8(pt_k + i, 0x33 + i); i = i + 1 }
    pt_load(PT_D_HEX, pt_d)
    let pid = syscall(SYS_fork)
    if pid == 0 {
        let afd = accept_within(sfd, 10000)
        if afd < 0 { syscall(SYS_exit, 2) }
        let certlen = pt_load(PT_CERT_HEX, pt_cert)
        pt_handshake(afd, certlen)                   // complete TLS, then hang up (no postgres)
        close_fd(afd)
        syscall(SYS_exit, 0)
    }
    let roots[4]
    pt_load(PT_CERT_HEX, pt_cert)
    roots[0] = pt_cert
    // TLS + chain succeed, but startup gets EOF: the connection fails and the TLS transport is dropped
    let __z10_1017: string = "127.0.0.1"
    let __z11_1017: string = "u"
    let __z12_1017: string = "p"
    let __z13_1017: string = "db"
    let __z14_1017: string = "sond.test"
    let __z15_1017: string = "20270101000000"
    assert_eq(pgx_connect_direct(__z10_1017.utf8, port, __z11_1017.utf8, __z12_1017.utf8, __z13_1017.utf8, __z14_1017.utf8, 9, roots, 1, __z15_1017.utf8), 0)
    close_fd(sfd)
    let st[1]
    syscall(SYS_wait4, pid, st, 0, 0)
}

let __q18_1067: string = "127.0.0.1"
let __q19_1067: string = "u"
let __q20_1067: string = "p"
let __q21_1067: string = "db"
let __q22_1067: string = "sond.test"
let __q23_1067: string = "20270101000000"
test "pg client: SSLRequest with no reply (server hangs up) fails the connection" {
    let sfd_port[1]
    let sfd = listen_loopback(0, 4, sfd_port)
    assert(sfd >= 0)
    let port = peek64(sfd_port)
    let pid = syscall(SYS_fork)
    if pid == 0 {
        let afd = accept_within(sfd, 10000)
        if afd < 0 { syscall(SYS_exit, 2) }
        let sr[8]
        pg_read_exact_fd(afd, sr, 8)                 // read SSLRequest, then hang up (no 'S'/'N')
        close_fd(afd)
        syscall(SYS_exit, 0)
    }
    let roots[4]
    pt_load(PT_CERT_HEX, pt_cert)
    roots[0] = pt_cert
    assert_eq(pgx_connect_ssl(__q18_1067.utf8, port, __q19_1067.utf8, __q20_1067.utf8, __q21_1067.utf8, __q22_1067.utf8, 9, roots, 1, __q23_1067.utf8), 0)
    close_fd(sfd)
    let st[1]
    syscall(SYS_wait4, pid, st, 0, 0)
}

// The SCRAM nonce must be unpredictable, so a failure to get randomness has to STOP the exchange,
// not be retried forever: a fill loop that retries a syscall without looking at why it failed
// spins a core instead of reporting (a failed syscall returns immediately instead of blocking).
// A null buffer makes the kernel fail it every time.
test "pg_random reports a permanent failure instead of spinning" {
    assert_eq(pg_random(0, 18), 0)
}

let __q24_1092: string = "it wrote"
test "pg_random fills the buffer and reports success" {
    let buf[3]
    let mut i = 0
    for i < 18 { poke8(buf + i, 0); i = i + 1 }
    assert_eq(pg_random(buf, 18), 1)
    // 18 random bytes all zero has probability 2^-144, so this reads as __q24_1092.utf8.
    let mut any = 0
    i = 0
    for i < 18 { any = any | peek8(buf + i); i = i + 1 }
    assert_eq(any != 0, 1)
}
