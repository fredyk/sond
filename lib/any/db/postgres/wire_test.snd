// Test of db/postgres/wire.snd: the PostgreSQL v3 message byte layout. These are pinned
// by construction against the documented frame format (network byte order throughout).

include "any/db/postgres/wire.snd"
include "x86_64/linux/testing.snd"

let mut w_buf[128]
let mut w_msg[128]
let mut w_out[64]

test "pg wire: u32 big-endian round-trips" {
    pg_put_u32be(w_buf, 196608)
    assert_eq(peek8(w_buf + 0), 0x00)
    assert_eq(peek8(w_buf + 1), 0x03)
    assert_eq(peek8(w_buf + 2), 0x00)
    assert_eq(peek8(w_buf + 3), 0x00)
    assert_eq(pg_get_u32be(w_buf), 196608)
}

// StartupMessage for user="me", database="db":
//   int32 len | int32 196608 | "user\0me\0database\0db\0\0"
// payload = 5 + 3 + 9 + 3 + 1 = 21 bytes; total = 8 + 21 = 29.
test "pg wire: StartupMessage layout (protocol 3.0, user/database params)" {
    let __s0_26: string = "me"
    let __s1_26: string = "db"
    let total = pg_startup(w_buf, __s0_26.utf8, __s1_26.utf8)
    assert_eq(total, 29)
    assert_eq(pg_get_u32be(w_buf), 29)             // length field carries the total
    assert_eq(pg_get_u32be(w_buf + 4), 196608)     // protocol version 3.0
    let __f0_32: string = "user"
    assert_eq(peek8(w_buf + 8), 117)               // 'u' of __f0_32.utf8
    let __f0_34: string = "user"
    assert_eq(peek8(w_buf + 12), 0)                // NUL after __f0_34.utf8
    let __f0_36: string = "me"
    assert_eq(peek8(w_buf + 13), 109)              // 'm' of __f0_36.utf8
    let __f0_38: string = "me"
    assert_eq(peek8(w_buf + 15), 0)                // NUL after __f0_38.utf8
    let __f0_40: string = "database"
    assert_eq(peek8(w_buf + 16), 100)              // 'd' of __f0_40.utf8
    let __f0_42: string = "database"
    assert_eq(peek8(w_buf + 24), 0)                // NUL after __f0_42.utf8
    let __f0_44: string = "db"
    assert_eq(peek8(w_buf + 25), 100)              // 'd' of __f0_44.utf8
    let __f0_46: string = "db"
    assert_eq(peek8(w_buf + 27), 0)                // NUL after __f0_46.utf8
    assert_eq(peek8(w_buf + 28), 0)                // empty key ends the parameter list
}

// Query "SELECT 1": 'Q' | int32 13 | "SELECT 1\0"; length excludes the type byte.
test "pg wire: Simple Query layout" {
    let __s0_45: string = "SELECT 1"
    let total = pg_query(w_buf, __s0_45.utf8)
    assert_eq(total, 14)                           // 1 type byte + 13 length
    assert_eq(peek8(w_buf + 0), 81)                // 'Q'
    assert_eq(pg_get_u32be(w_buf + 1), 13)         // 4 + 8 sql + 1 NUL
    assert_eq(peek8(w_buf + 5), 83)                // 'S'
    assert_eq(peek8(w_buf + 13), 0)                // NUL terminator after the SQL
}

// Backend framing: type byte then a self-including int32 length. Build a ReadyForQuery
// ('Z' | int32 5 | 'I') and read its header back.
test "pg wire: backend message header accessors" {
    poke8(w_buf, 90)                               // 'Z'
    pg_put_u32be(w_buf + 1, 5)
    poke8(w_buf + 5, 73)                           // 'I' (idle)
    assert_eq(pg_msg_type(w_buf), 90)
    assert_eq(pg_msg_len(w_buf), 5)
}

test "pg wire: int16 round-trips and int32 sign-extends" {
    pg_put_u16be(w_buf, 513)                        // 0x0201
    assert_eq(peek8(w_buf), 0x02)
    assert_eq(peek8(w_buf + 1), 0x01)
    assert_eq(pg_get_u16be(w_buf), 513)
    pg_put_u32be(w_buf, 0xffffffff)
    assert_eq(pg_get_i32be(w_buf), 0 - 1)          // -1, the NULL marker
}

// Authentication 'R' with code 5 (MD5).
test "pg wire: Authentication code" {
    poke8(w_msg, 82)                               // 'R'
    pg_put_u32be(w_msg + 1, 12)
    pg_put_u32be(w_msg + 5, 5)
    assert_eq(pg_auth_type(w_msg), 5)
}

// RowDescription 'T' with two columns "id" and "name", 18-byte tails (all zero here).
test "pg wire: RowDescription field count and names" {
    poke8(w_msg, 84)                               // 'T'
    pg_put_u16be(w_msg + 5, 2)                      // field count (length field is unused here)
    let mut p = 7
    // "id\0" then 18 zero bytes
    poke8(w_msg + p, 105); poke8(w_msg + p + 1, 100); poke8(w_msg + p + 2, 0)
    p = p + 3
    let mut z = 0
    for z < 18 { poke8(w_msg + p + z, 0); z = z + 1 }
    p = p + 18
    // "name\0" then 18 zero bytes
    poke8(w_msg + p, 110); poke8(w_msg + p + 1, 97); poke8(w_msg + p + 2, 109)
    poke8(w_msg + p + 3, 101); poke8(w_msg + p + 4, 0)
    p = p + 5
    z = 0
    for z < 18 { poke8(w_msg + p + z, 0); z = z + 1 }

    assert_eq(pg_rowdesc_ncols(w_msg), 2)
    assert_eq(pg_rowdesc_name(w_msg, 0, w_out), 2)
    assert_eq(peek8(w_out), 105); assert_eq(peek8(w_out + 1), 100); assert_eq(peek8(w_out + 2), 0)
    assert_eq(pg_rowdesc_name(w_msg, 1, w_out), 4)
    assert_eq(peek8(w_out), 110); assert_eq(peek8(w_out + 3), 101); assert_eq(peek8(w_out + 4), 0)
}

// DataRow 'D' with two fields: "42" and SQL NULL.
test "pg wire: DataRow fields including NULL" {
    poke8(w_msg, 68)                               // 'D'
    pg_put_u16be(w_msg + 5, 2)                      // field count
    pg_put_u32be(w_msg + 7, 2)                      // field 0 length = 2
    let __lit0: string = "42"
    poke8(w_msg + 11, 52); poke8(w_msg + 12, 50)   // __lit0.utf8
    pg_put_u32be(w_msg + 13, 0xffffffff)           // field 1 length = -1 (NULL)

    assert_eq(pg_datarow_nfields(w_msg), 2)
    assert_eq(pg_datarow_field(w_msg, 0, w_out), 2)
    assert_eq(peek8(w_out), 52); assert_eq(peek8(w_out + 1), 50); assert_eq(peek8(w_out + 2), 0)
    assert_eq(pg_datarow_field(w_msg, 1, w_out), 0 - 1)   // NULL
    // the split accessors the result builder uses:
    assert_eq(pg_datarow_field_len(w_msg, 0), 2)
    assert_eq(pg_datarow_field_len(w_msg, 1), 0 - 1)
    assert_eq(peek8(pg_datarow_field_ptr(w_msg, 0)), 52)  // points at '4'
    // field 1's value pointer sits 6 bytes after field 0's (4 len + 2 value), walking the loop
    assert_eq(pg_datarow_field_ptr(w_msg, 1) - pg_datarow_field_ptr(w_msg, 0), 6)
}

// CommandComplete 'C' carries the command tag as a cstr in its payload.
test "pg wire: CommandComplete tag" {
    poke8(w_msg, 67)                               // 'C'
    // tag "SELECT 1\0" at payload
    let tag_text: string = "SELECT 1"
    let tag = tag_text.utf8
    let mut i = 0
    for i < 8 { poke8(w_msg + 5 + i, tag[i]); i = i + 1 }
    poke8(w_msg + 13, 0)
    let t = pg_cmdcomplete_tag(w_msg)
    assert_eq(peek8(t), 83)                        // 'S'
    assert_eq(peek8(t + 7), 49)                    // '1'
    assert_eq(peek8(t + 8), 0)
}

// ErrorResponse 'E': fields 'S' severity, 'M' message, ended by a 0 type byte.
test "pg wire: ErrorResponse field lookup" {
    poke8(w_msg, 69)                               // 'E'
    let mut p = 5
    poke8(w_msg + p, 83)                           // 'S'
    p = p + 1
    poke8(w_msg + p, 69); poke8(w_msg + p + 1, 82); poke8(w_msg + p + 2, 82)
    let __lit1: string = "ERROR\0"
    poke8(w_msg + p + 3, 79); poke8(w_msg + p + 4, 82); poke8(w_msg + p + 5, 0)   // __lit1.utf8
    p = p + 6
    poke8(w_msg + p, 77)                           // 'M'
    p = p + 1
    poke8(w_msg + p, 98); poke8(w_msg + p + 1, 111); poke8(w_msg + p + 2, 111)
    let __lit2: string = "boom\0"
    poke8(w_msg + p + 3, 109); poke8(w_msg + p + 4, 0)   // __lit2.utf8
    p = p + 5
    poke8(w_msg + p, 0)                            // terminator

    let __f0_168: string = "boom"
    assert_eq(pg_error_field(w_msg, 77, w_out), 4) // 'M' -> __f0_168.utf8
    assert_eq(peek8(w_out), 98); assert_eq(peek8(w_out + 3), 109); assert_eq(peek8(w_out + 4), 0)
    assert_eq(pg_error_field(w_msg, 67, w_out), 0 - 1)   // 'C' absent
    assert_eq(peek8(pg_error_field_ptr(w_msg, 77)), 98)  // 'M' value starts at 'b'
    assert_eq(pg_error_field_ptr(w_msg, 67), 0)          // 'C' absent
}

// SASLInitialResponse ('p'): mechanism cstr, then an int32 length and the initial
// response bytes. For mech "SCRAM-SHA-256" (13) and a 2-byte response "xy":
//   'p' | int32 len | "SCRAM-SHA-256\0" | int32 2 | "xy"
//   len = 4(self) + 14(mech cstr) + 4(resp len) + 2 = 24; total = 1 + 24 = 25.
test "pg wire: SASLInitialResponse layout (mechanism + initial response)" {
    let __s0_172: string = "SCRAM-SHA-256"
    let __s1_172: string = "xy"
    let total = pg_sasl_initial(w_buf, __s0_172.utf8, __s1_172.utf8, 2)
    assert_eq(total, 25)
    assert_eq(peek8(w_buf + 0), 112)               // 'p'
    assert_eq(pg_get_u32be(w_buf + 1), 24)         // length carries everything after the type byte
    assert_eq(peek8(w_buf + 5), 83)                // 'S' of the mechanism name
    assert_eq(peek8(w_buf + 18), 0)                // NUL after the 13-char mechanism
    assert_eq(pg_get_u32be(w_buf + 19), 2)         // initial-response length
    assert_eq(peek8(w_buf + 23), 120)              // 'x' of the response
    assert_eq(peek8(w_buf + 24), 121)              // 'y'
}

// SASLResponse ('p'): just the client-final message bytes, no mechanism, no inner length.
//   'p' | int32 len | data ; len = 4(self) + datalen.
test "pg wire: SASLResponse layout (client-final message)" {
    let __s0_188: string = "abc"
    let total = pg_sasl_response(w_buf, __s0_188.utf8, 3)
    assert_eq(total, 8)                            // 1 type + 7 length
    assert_eq(peek8(w_buf + 0), 112)               // 'p'
    assert_eq(pg_get_u32be(w_buf + 1), 7)          // 4 + 3
    assert_eq(peek8(w_buf + 5), 97)                // 'a'
    assert_eq(peek8(w_buf + 7), 99)                // 'c'
}

// SASL data accessors on an Authentication 'R' message whose payload is int32 code + bytes
// (used for SASLContinue/SASLFinal, where the bytes are the server-first / server-final).
//   'R' | int32 len | int32 code | data ; data starts at +9, length = len - 8.
test "pg wire: SASL continue/final data pointer and length" {
    poke8(w_msg, 82)                               // 'R'
    pg_put_u32be(w_msg + 1, 13)                    // 4(self) + 4(code) + 5(data)
    pg_put_u32be(w_msg + 5, 11)                    // AuthenticationSASLContinue
    let __lit3: string = "r="
    poke8(w_msg + 9, 114); poke8(w_msg + 10, 61)   // __lit3.utf8
    let __lit4: string = "foo"
    poke8(w_msg + 11, 102); poke8(w_msg + 12, 111); poke8(w_msg + 13, 111)   // __lit4.utf8
    assert_eq(pg_sasl_data_len(w_msg), 5)          // 13 - 8
    assert_eq(pg_sasl_data_ptr(w_msg) - w_msg, 9)  // past type, length, code
    assert_eq(peek8(pg_sasl_data_ptr(w_msg)), 114) // 'r'
}
