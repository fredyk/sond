    assert_eq(bytes_eq(resp_encode_command(2, items2), bytes_from_cstr(__s17_915.utf8)), 1)

    // redis_expire's "seconds" digits live in a local stack `tmp`; see the
    // rescue note on redis_setex above for why this copy is necessary.
    let items3 = heap_alloc(320)
    let __lit31: string = "k1"
