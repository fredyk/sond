test "sorted set range/score commands" {
    let fd = -1
    let recvdata[64]
    let buf[4]
    poke64(buf + 8, recvdata)
    poke64(buf + 24, 512)

    // The tmp/itoa-based numeric arguments below (score/start/stop/increment/
    // min/max) live in local stack buffers inside client.snd; see the rescue
    // note on redis_setex in the string-commands test above for why the
    // copies below are necessary before re-encoding.
    let items0 = heap_alloc(320)
    redis_zadd(fd, buf, items0, cstr("k1"), 5, cstr("m1"))
    let r02[4]
    let j02 = 0
    let l02 = peek64(items0 + 2 * 16 + 8)
    for j02 < l02 {
        poke8(r02 + j02, peek8(peek64(items0 + 2 * 16) + j02))
        j02 = j02 + 1
    }
    poke64(items0 + 2 * 16, r02)
    assert_eq(bytes_eq(resp_encode_command(4, items0), bytes_from_cstr(cstr("*4\r\n$4\r\nZADD\r\n$2\r\nk1\r\n$1\r\n5\r\n$2\r\nm1\r\n"))), 1)

    let items1 = heap_alloc(320)
    redis_zrange(fd, buf, items1, cstr("k1"), 0, -1)
    let r12[4]
    let j12 = 0
    let l12 = peek64(items1 + 2 * 16 + 8)
    for j12 < l12 {
        poke8(r12 + j12, peek8(peek64(items1 + 2 * 16) + j12))
        j12 = j12 + 1
    }
    poke64(items1 + 2 * 16, r12)
    let r13[4]
    let j13 = 0
    let l13 = peek64(items1 + 3 * 16 + 8)
    for j13 < l13 {
        poke8(r13 + j13, peek8(peek64(items1 + 3 * 16) + j13))
        j13 = j13 + 1
    }
    poke64(items1 + 3 * 16, r13)
    assert_eq(bytes_eq(resp_encode_command(4, items1), bytes_from_cstr(cstr("*4\r\n$6\r\nZRANGE\r\n$2\r\nk1\r\n$1\r\n0\r\n$2\r\n-1\r\n"))), 1)

    let items2 = heap_alloc(320)
    redis_zscore(fd, buf, items2, cstr("k1"), cstr("m1"))
    assert_eq(bytes_eq(resp_encode_command(3, items2), bytes_from_cstr(cstr("*3\r\n$6\r\nZSCORE\r\n$2\r\nk1\r\n$2\r\nm1\r\n"))), 1)

    let items3 = heap_alloc(320)
    redis_zcard(fd, buf, items3, cstr("k1"))
    assert_eq(bytes_eq(resp_encode_command(2, items3), bytes_from_cstr(cstr("*2\r\n$5\r\nZCARD\r\n$2\r\nk1\r\n"))), 1)

    let items4 = heap_alloc(320)
    redis_zrem(fd, buf, items4, cstr("k1"), cstr("m1"))
    assert_eq(bytes_eq(resp_encode_command(3, items4), bytes_from_cstr(cstr("*3\r\n$4\r\nZREM\r\n$2\r\nk1\r\n$2\r\nm1\r\n"))), 1)

    let items5 = heap_alloc(320)
    redis_zrank(fd, buf, items5, cstr("k1"), cstr("m1"))
    assert_eq(bytes_eq(resp_encode_command(3, items5), bytes_from_cstr(cstr("*3\r\n$5\r\nZRANK\r\n$2\r\nk1\r\n$2\r\nm1\r\n"))), 1)

    let items6 = heap_alloc(320)
    redis_zrevrank(fd, buf, items6, cstr("k1"), cstr("m1"))
    assert_eq(bytes_eq(resp_encode_command(3, items6), bytes_from_cstr(cstr("*3\r\n$8\r\nZREVRANK\r\n$2\r\nk1\r\n$2\r\nm1\r\n"))), 1)

    let items7 = heap_alloc(320)
    redis_zincrby(fd, buf, items7, cstr("k1"), 5, cstr("m1"))
    let r72[4]
    let j72 = 0
    let l72 = peek64(items7 + 2 * 16 + 8)
    for j72 < l72 {
        poke8(r72 + j72, peek8(peek64(items7 + 2 * 16) + j72))
        j72 = j72 + 1
    }
    poke64(items7 + 2 * 16, r72)
    assert_eq(bytes_eq(resp_encode_command(4, items7), bytes_from_cstr(cstr("*4\r\n$7\r\nZINCRBY\r\n$2\r\nk1\r\n$1\r\n5\r\n$2\r\nm1\r\n"))), 1)

    let items8 = heap_alloc(320)
    redis_zcount(fd, buf, items8, cstr("k1"), 0, 10)
    let r82[4]
    let j82 = 0
    let l82 = peek64(items8 + 2 * 16 + 8)
    for j82 < l82 {
        poke8(r82 + j82, peek8(peek64(items8 + 2 * 16) + j82))
        j82 = j82 + 1
    }
    poke64(items8 + 2 * 16, r82)
    let r83[4]
    let j83 = 0
    let l83 = peek64(items8 + 3 * 16 + 8)
    for j83 < l83 {
        poke8(r83 + j83, peek8(peek64(items8 + 3 * 16) + j83))
        j83 = j83 + 1
    }
    poke64(items8 + 3 * 16, r83)
    assert_eq(bytes_eq(resp_encode_command(4, items8), bytes_from_cstr(cstr("*4\r\n$6\r\nZCOUNT\r\n$2\r\nk1\r\n$1\r\n0\r\n$2\r\n10\r\n"))), 1)

    let items9 = heap_alloc(320)
    redis_zlexcount(fd, buf, items9, cstr("k1"), cstr("[a"), cstr("[z"))
    assert_eq(bytes_eq(resp_encode_command(4, items9), bytes_from_cstr(cstr("*4\r\n$9\r\nZLEXCOUNT\r\n$2\r\nk1\r\n$2\r\n[a\r\n$2\r\n[z\r\n"))), 1)

    let items10 = heap_alloc(320)
    redis_zremrangebyrank(fd, buf, items10, cstr("k1"), 0, -1)
    let r102[4]
    let j102 = 0
    let l102 = peek64(items10 + 2 * 16 + 8)
    for j102 < l102 {
        poke8(r102 + j102, peek8(peek64(items10 + 2 * 16) + j102))
        j102 = j102 + 1
    }
    poke64(items10 + 2 * 16, r102)
    let r103[4]
    let j103 = 0
    let l103 = peek64(items10 + 3 * 16 + 8)
    for j103 < l103 {
        poke8(r103 + j103, peek8(peek64(items10 + 3 * 16) + j103))
        j103 = j103 + 1
    }
    poke64(items10 + 3 * 16, r103)
    assert_eq(bytes_eq(resp_encode_command(4, items10), bytes_from_cstr(cstr("*4\r\n$15\r\nZREMRANGEBYRANK\r\n$2\r\nk1\r\n$1\r\n0\r\n$2\r\n-1\r\n"))), 1)

    let items11 = heap_alloc(320)
    redis_zremrangebyscore(fd, buf, items11, cstr("k1"), 0, 10)
    let r112[4]
    let j112 = 0
    let l112 = peek64(items11 + 2 * 16 + 8)
    for j112 < l112 {
        poke8(r112 + j112, peek8(peek64(items11 + 2 * 16) + j112))
        j112 = j112 + 1
    }
    poke64(items11 + 2 * 16, r112)
    let r113[4]
    let j113 = 0
    let l113 = peek64(items11 + 3 * 16 + 8)
    for j113 < l113 {
        poke8(r113 + j113, peek8(peek64(items11 + 3 * 16) + j113))
        j113 = j113 + 1
    }
    poke64(items11 + 3 * 16, r113)
    assert_eq(bytes_eq(resp_encode_command(4, items11), bytes_from_cstr(cstr("*4\r\n$16\r\nZREMRANGEBYSCORE\r\n$2\r\nk1\r\n$1\r\n0\r\n$2\r\n10\r\n"))), 1)

    let items12 = heap_alloc(320)
    redis_zremrangebylex(fd, buf, items12, cstr("k1"), cstr("[a"), cstr("[z"))
    assert_eq(bytes_eq(resp_encode_command(4, items12), bytes_from_cstr(cstr("*4\r\n$14\r\nZREMRANGEBYLEX\r\n$2\r\nk1\r\n$2\r\n[a\r\n$2\r\n[z\r\n"))), 1)

    let items13 = heap_alloc(320)
    redis_zrangebyscore(fd, buf, items13, cstr("k1"), 0, 10)
    let r132[4]
    let j132 = 0
    let l132 = peek64(items13 + 2 * 16 + 8)
    for j132 < l132 {
        poke8(r132 + j132, peek8(peek64(items13 + 2 * 16) + j132))
        j132 = j132 + 1
    }
    poke64(items13 + 2 * 16, r132)
    let r133[4]
    let j133 = 0
    let l133 = peek64(items13 + 3 * 16 + 8)
    for j133 < l133 {
        poke8(r133 + j133, peek8(peek64(items13 + 3 * 16) + j133))
        j133 = j133 + 1
    }
    poke64(items13 + 3 * 16, r133)
    assert_eq(bytes_eq(resp_encode_command(4, items13), bytes_from_cstr(cstr("*4\r\n$13\r\nZRANGEBYSCORE\r\n$2\r\nk1\r\n$1\r\n0\r\n$2\r\n10\r\n"))), 1)

    let items14 = heap_alloc(320)
    redis_zrangebylex(fd, buf, items14, cstr("k1"), cstr("[a"), cstr("[z"))
    assert_eq(bytes_eq(resp_encode_command(4, items14), bytes_from_cstr(cstr("*4\r\n$11\r\nZRANGEBYLEX\r\n$2\r\nk1\r\n$2\r\n[a\r\n$2\r\n[z\r\n"))), 1)

    let items15 = heap_alloc(320)
    let zmmembers[2]
    poke64(zmmembers + 0, cstr("ma"))
    poke64(zmmembers + 8, cstr("mb"))
    redis_zmscore(fd, buf, items15, cstr("k1"), 2, zmmembers)
    assert_eq(bytes_eq(resp_encode_command(4, items15), bytes_from_cstr(cstr("*4\r\n$7\r\nZMSCORE\r\n$2\r\nk1\r\n$2\r\nma\r\n$2\r\nmb\r\n"))), 1)
