    assert_eq(bytes_eq(resp_encode_command(2, items11), bytes_from_cstr(__s26_985.utf8)), 1)
}

test "list commands: LPUSH/RPUSH/LPOP/RPOP/LLEN/LRANGE/LINDEX/LSET/LTRIM/LREM" {
    let fd = -1
    let recvdata[64]
    let buf[4]
    poke64(buf + 8, recvdata)
    poke64(buf + 24, 512)

    let items0 = heap_alloc(320)
    let __lit38: string = "k1"
    let __lit39: string = "v1"
    redis_lpush(fd, buf, items0, __lit38.utf8, __lit39.utf8)
    let __s27_1000: string = "*3\r\n$5\r\nLPUSH\r\n$2\r\nk1\r\n$2\r\nv1\r\n"
    assert_eq(bytes_eq(resp_encode_command(3, items0), bytes_from_cstr(__s27_1000.utf8)), 1)

    let items1 = heap_alloc(320)
    let __lit40: string = "k1"
    let __lit41: string = "v1"
    redis_rpush(fd, buf, items1, __lit40.utf8, __lit41.utf8)
    let __s28_1007: string = "*3\r\n$5\r\nRPUSH\r\n$2\r\nk1\r\n$2\r\nv1\r\n"
    assert_eq(bytes_eq(resp_encode_command(3, items1), bytes_from_cstr(__s28_1007.utf8)), 1)

    let items2 = heap_alloc(320)
    let __lit42: string = "k1"
    redis_lpop(fd, buf, items2, __lit42.utf8)
    let __s29_1013: string = "*2\r\n$4\r\nLPOP\r\n$2\r\nk1\r\n"
    assert_eq(bytes_eq(resp_encode_command(2, items2), bytes_from_cstr(__s29_1013.utf8)), 1)

    let items3 = heap_alloc(320)
    let __lit43: string = "k1"
    redis_rpop(fd, buf, items3, __lit43.utf8)
    let __s30_1019: string = "*2\r\n$4\r\nRPOP\r\n$2\r\nk1\r\n"
    assert_eq(bytes_eq(resp_encode_command(2, items3), bytes_from_cstr(__s30_1019.utf8)), 1)

    let items4 = heap_alloc(320)
    let __lit44: string = "k1"
    redis_llen(fd, buf, items4, __lit44.utf8)
    let __s31_1025: string = "*2\r\n$4\r\nLLEN\r\n$2\r\nk1\r\n"
    assert_eq(bytes_eq(resp_encode_command(2, items4), bytes_from_cstr(__s31_1025.utf8)), 1)

    // LRANGE/LINDEX/LSET/LTRIM/LREM's numeric arguments (start/stop/index/
    // count) all live in local stack `tmp` buffers in client.snd; see the
    // rescue note on redis_setex above for why the copy below is necessary.
    let items5 = heap_alloc(320)
    let __lit45: string = "k1"
    redis_lrange(fd, buf, items5, __lit45.utf8, 0, -1)
    let r52[4]
    let j52 = 0
    let l52 = peek64(items5 + 2 * 16 + 8)
    for j52 < l52 {
        poke8(r52 + j52, peek8(peek64(items5 + 2 * 16) + j52))
        j52 = j52 + 1
    }
    poke64(items5 + 2 * 16, r52)
    let r53[4]
    let j53 = 0
    let l53 = peek64(items5 + 3 * 16 + 8)
    for j53 < l53 {
        poke8(r53 + j53, peek8(peek64(items5 + 3 * 16) + j53))
        j53 = j53 + 1
    }
    poke64(items5 + 3 * 16, r53)
    let __s32_1050: string = "*4\r\n$6\r\nLRANGE\r\n$2\r\nk1\r\n$1\r\n0\r\n$2\r\n-1\r\n"
    assert_eq(bytes_eq(resp_encode_command(4, items5), bytes_from_cstr(__s32_1050.utf8)), 1)

    let items6 = heap_alloc(320)
    let __lit46: string = "k1"
    redis_lindex(fd, buf, items6, __lit46.utf8, 2)
    let r62[4]
    let j62 = 0
    let l62 = peek64(items6 + 2 * 16 + 8)
