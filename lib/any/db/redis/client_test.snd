test "sorted set store commands: ZINTERSTORE/ZUNIONSTORE" {
    // Both functions used to overwrite items slot 0 (which
    // add_cmd_arg(items, 0, cstr("ZINTERSTORE"/"ZUNIONSTORE"), 11) had just
    // set) with the destination key via a raw poke64(items, dst_ptr), and
    // never wrote slot 1 at all (the loop jumped straight from slot 1 to slot
    // 2). The command NAME was therefore lost from the wire entirely, and a
    // real Redis server would have seen the destination key where it expects
    // "ZINTERSTORE"/"ZUNIONSTORE", an empty string where it expects the first
    // source key, and the real source keys shifted one slot. Fixed by writing
    // the destination key into slot 1 with add_cmd_arg instead.
    let fd = -1
    let recvdata[64]
    let buf[4]
    poke64(buf + 8, recvdata)
    poke64(buf + 24, 512)

    let items0 = heap_alloc(320)
    let zkeys0[3]
    poke64(zkeys0 + 0, cstr("dst"))
    poke64(zkeys0 + 8, cstr("a"))
    poke64(zkeys0 + 16, cstr("b"))
    redis_zinterstore(fd, buf, items0, 3, zkeys0)
    assert_eq(bytes_eq(resp_encode_command(4, items0), bytes_from_cstr(cstr("*4\r\n$11\r\nZINTERSTORE\r\n$3\r\ndst\r\n$1\r\na\r\n$1\r\nb\r\n"))), 1)

    let items1 = heap_alloc(320)
    let zkeys1[3]
    poke64(zkeys1 + 0, cstr("dst"))
    poke64(zkeys1 + 8, cstr("a"))
    poke64(zkeys1 + 16, cstr("b"))
    redis_zunionstore(fd, buf, items1, 3, zkeys1)
    assert_eq(bytes_eq(resp_encode_command(4, items1), bytes_from_cstr(cstr("*4\r\n$11\r\nZUNIONSTORE\r\n$3\r\ndst\r\n$1\r\na\r\n$1\r\nb\r\n"))), 1)
}

test "server commands: INFO/CONFIG GET/SAVE/BGSAVE/LASTSAVE/SHUTDOWN/DEBUG OBJECT/CLIENT/AUTH/QUIT/TIME/UPTIME/SLAVEOF/WAIT" {
    let fd = -1
    let recvdata[64]
    let buf[4]
    poke64(buf + 8, recvdata)
    poke64(buf + 24, 512)

    let items0 = heap_alloc(320)
    redis_info(fd, buf, items0)
    assert_eq(bytes_eq(resp_encode_command(1, items0), bytes_from_cstr(cstr("*1\r\n$4\r\nINFO\r\n"))), 1)

    let items1 = heap_alloc(320)
    redis_config_get(fd, buf, items1, cstr("mm"))
    assert_eq(bytes_eq(resp_encode_command(3, items1), bytes_from_cstr(cstr("*3\r\n$6\r\nCONFIG\r\n$3\r\nGET\r\n$2\r\nmm\r\n"))), 1)

    let items2 = heap_alloc(320)
    redis_save(fd, buf, items2)
    assert_eq(bytes_eq(resp_encode_command(1, items2), bytes_from_cstr(cstr("*1\r\n$4\r\nSAVE\r\n"))), 1)

    let items3 = heap_alloc(320)
    redis_bgsave(fd, buf, items3)
    assert_eq(bytes_eq(resp_encode_command(1, items3), bytes_from_cstr(cstr("*1\r\n$6\r\nBGSAVE\r\n"))), 1)

    let items4 = heap_alloc(320)
    redis_lastsave(fd, buf, items4)
    assert_eq(bytes_eq(resp_encode_command(1, items4), bytes_from_cstr(cstr("*1\r\n$8\r\nLASTSAVE\r\n"))), 1)

    let items5 = heap_alloc(320)
    redis_shutdown(fd, buf, items5)
    assert_eq(bytes_eq(resp_encode_command(1, items5), bytes_from_cstr(cstr("*1\r\n$8\r\nSHUTDOWN\r\n"))), 1)

    let items6 = heap_alloc(320)
    redis_debug_object(fd, buf, items6, cstr("k1"))
    assert_eq(bytes_eq(resp_encode_command(3, items6), bytes_from_cstr(cstr("*3\r\n$5\r\nDEBUG\r\n$6\r\nOBJECT\r\n$2\r\nk1\r\n"))), 1)

    // redis_monitor used to bypass RESP encoding entirely and send
    // `strlen("MONITOR") + 5` (12) raw bytes starting at the "MONITOR"
    // literal, i.e. 4 bytes past its NUL terminator -- a buffer over-read bug
    // (see the dedicated regression test below, which verifies the actual
    // wire bytes over a real socket). With fd=-1 the syscall fails before
    // touching memory, so this only verifies it does not crash and returns 0.
    let items7 = heap_alloc(320)
    assert_eq(redis_monitor(fd, buf, items7), 0)

    let items8 = heap_alloc(320)
    redis_client_list(fd, buf, items8)
    assert_eq(bytes_eq(resp_encode_command(2, items8), bytes_from_cstr(cstr("*2\r\n$6\r\nCLIENT\r\n$4\r\nLIST\r\n"))), 1)

    let items9 = heap_alloc(320)
    redis_client_kill(fd, buf, items9, cstr("9"))
    assert_eq(bytes_eq(resp_encode_command(4, items9), bytes_from_cstr(cstr("*4\r\n$6\r\nCLIENT\r\n$4\r\nKILL\r\n$2\r\nID\r\n$1\r\n9\r\n"))), 1)

    let items10 = heap_alloc(320)
    redis_auth(fd, buf, items10, cstr("pw"))
    assert_eq(bytes_eq(resp_encode_command(2, items10), bytes_from_cstr(cstr("*2\r\n$4\r\nAUTH\r\n$2\r\npw\r\n"))), 1)

    let items11 = heap_alloc(320)
    redis_quit(fd, buf, items11)
    assert_eq(bytes_eq(resp_encode_command(1, items11), bytes_from_cstr(cstr("*1\r\n$4\r\nQUIT\r\n"))), 1)

    let items12 = heap_alloc(320)
    redis_time(fd, buf, items12)
    assert_eq(bytes_eq(resp_encode_command(1, items12), bytes_from_cstr(cstr("*1\r\n$4\r\nTIME\r\n"))), 1)

    let items13 = heap_alloc(320)
    redis_uptime(fd, buf, items13)
    assert_eq(bytes_eq(resp_encode_command(1, items13), bytes_from_cstr(cstr("*1\r\n$6\r\nUPTIME\r\n"))), 1)

    // redis_slaveof/redis_wait's numeric arguments (port/num_slaves/timeout)
    // live in local stack `tmp` buffers; see the rescue note on redis_setex
    // in the string-commands test above for why the copies below are needed.
    let items14 = heap_alloc(320)
    redis_slaveof(fd, buf, items14, cstr("h1"), 6380)
    let r142[4]
    let j142 = 0
    let l142 = peek64(items14 + 2 * 16 + 8)
    for j142 < l142 {
        poke8(r142 + j142, peek8(peek64(items14 + 2 * 16) + j142))
        j142 = j142 + 1
    }
    poke64(items14 + 2 * 16, r142)
    assert_eq(bytes_eq(resp_encode_command(3, items14), bytes_from_cstr(cstr("*3\r\n$7\r\nSLAVEOF\r\n$2\r\nh1\r\n$4\r\n6380\r\n"))), 1)

    let items15 = heap_alloc(320)
    redis_wait(fd, buf, items15, 1, 100)
    let r151[4]
    let j151 = 0
    let l151 = peek64(items15 + 1 * 16 + 8)
    for j151 < l151 {
        poke8(r151 + j151, peek8(peek64(items15 + 1 * 16) + j151))
        j151 = j151 + 1
    }
    poke64(items15 + 1 * 16, r151)
    let r152[4]
    let j152 = 0
    let l152 = peek64(items15 + 2 * 16 + 8)
    for j152 < l152 {
        poke8(r152 + j152, peek8(peek64(items15 + 2 * 16) + j152))
        j152 = j152 + 1
    }
    poke64(items15 + 2 * 16, r152)
    assert_eq(bytes_eq(resp_encode_command(3, items15), bytes_from_cstr(cstr("*3\r\n$4\r\nWAIT\r\n$1\r\n1\r\n$3\r\n100\r\n"))), 1)
}

test "redis_monitor sends a RESP-encoded command, not a raw over-read" {
    // redis_monitor used to bypass RESP encoding entirely and send
    // `strlen("MONITOR") + 5` (12) raw bytes starting at the "MONITOR"
    // literal -- 4 bytes past its NUL terminator, a buffer over-read whose
    // trailing content depended on whatever the compiler placed next in
    // .rodata. Fixed to RESP-encode the command like every other helper
    // before sending it, so exactly "*1\r\n$7\r\nMONITOR\r\n" (18 bytes) goes
    // out. A UNIX-domain socketpair gives both ends of a real socket inside
    // this single process, so the bytes actually placed on the wire can be
    // read back and compared directly, without needing a forked peer.
    let fds[1]
    let rc = syscall(SYS_socketpair, 1, SOCK_STREAM, 0, fds)  // 1 = AF_UNIX
    assert_eq(rc, 0)
    let fd_a = peek32(fds)
    let fd_b = peek32(fds + 4)

    let recvdata[64]
    let buf[4]
    poke64(buf + 8, recvdata)
    poke64(buf + 24, 512)
    let items = heap_alloc(320)
    redis_monitor(fd_a, buf, items)

    let rbuf[32]
    let n = recvfrom_sock(fd_b, rbuf, 32, 0, 0, 0)
    let want = bytes_from_cstr(cstr("*1\r\n$7\r\nMONITOR\r\n"))
    assert_eq(n, bytes_len(want))
    let mut i = 0
    for i < n {
        assert_eq(peek8(rbuf + i), bytes_get(want, i))
        i = i + 1
    }
    close_fd(fd_a)
    close_fd(fd_b)
}

test "transaction commands: MULTI/EXEC/DISCARD/WATCH/UNWATCH" {
    let fd = -1
    let recvdata[64]
    let buf[4]
    poke64(buf + 8, recvdata)
    poke64(buf + 24, 512)

    let items0 = heap_alloc(320)
    redis_multi(fd, buf, items0)
    assert_eq(bytes_eq(resp_encode_command(1, items0), bytes_from_cstr(cstr("*1\r\n$5\r\nMULTI\r\n"))), 1)

    let items1 = heap_alloc(320)
    redis_exec(fd, buf, items1)
    assert_eq(bytes_eq(resp_encode_command(1, items1), bytes_from_cstr(cstr("*1\r\n$4\r\nEXEC\r\n"))), 1)

    let items2 = heap_alloc(320)
    redis_discard(fd, buf, items2)
    assert_eq(bytes_eq(resp_encode_command(1, items2), bytes_from_cstr(cstr("*1\r\n$7\r\nDISCARD\r\n"))), 1)

    let items3 = heap_alloc(320)
    let watchkeys[2]
    poke64(watchkeys + 0, cstr("a"))
    poke64(watchkeys + 8, cstr("b"))
    redis_watch(fd, buf, items3, 2, watchkeys)
    assert_eq(bytes_eq(resp_encode_command(3, items3), bytes_from_cstr(cstr("*3\r\n$5\r\nWATCH\r\n$1\r\na\r\n$1\r\nb\r\n"))), 1)

    let items4 = heap_alloc(320)
    redis_unwatch(fd, buf, items4)
    assert_eq(bytes_eq(resp_encode_command(1, items4), bytes_from_cstr(cstr("*1\r\n$7\r\nUNWATCH\r\n"))), 1)
}

test "pub/sub commands: SUBSCRIBE/UNSUBSCRIBE/PSUBSCRIBE/PUNSUBSCRIBE/PUBLISH" {
    let fd = -1
    let recvdata[64]
    let buf[4]
    poke64(buf + 8, recvdata)
    poke64(buf + 24, 512)

    let items0 = heap_alloc(320)
    let chans[2]
    poke64(chans + 0, cstr("c1"))
    poke64(chans + 8, cstr("c2"))
    redis_subscribe(fd, buf, items0, 2, chans)
    assert_eq(bytes_eq(resp_encode_command(3, items0), bytes_from_cstr(cstr("*3\r\n$9\r\nSUBSCRIBE\r\n$2\r\nc1\r\n$2\r\nc2\r\n"))), 1)

    let items1 = heap_alloc(320)
    redis_unsubscribe(fd, buf, items1, 2, chans)
    assert_eq(bytes_eq(resp_encode_command(3, items1), bytes_from_cstr(cstr("*3\r\n$11\r\nUNSUBSCRIBE\r\n$2\r\nc1\r\n$2\r\nc2\r\n"))), 1)

    let items2 = heap_alloc(320)
    let patterns[2]
    poke64(patterns + 0, cstr("p1"))
    poke64(patterns + 8, cstr("p2"))
    redis_psubscribe(fd, buf, items2, 2, patterns)
    assert_eq(bytes_eq(resp_encode_command(3, items2), bytes_from_cstr(cstr("*3\r\n$10\r\nPSUBSCRIBE\r\n$2\r\np1\r\n$2\r\np2\r\n"))), 1)

    let items3 = heap_alloc(320)
    redis_punsubscribe(fd, buf, items3, 2, patterns)
    assert_eq(bytes_eq(resp_encode_command(3, items3), bytes_from_cstr(cstr("*3\r\n$12\r\nPUNSUBSCRIBE\r\n$2\r\np1\r\n$2\r\np2\r\n"))), 1)

    let items4 = heap_alloc(320)
    redis_publish(fd, buf, items4, cstr("c1"), cstr("ms"))
    assert_eq(bytes_eq(resp_encode_command(3, items4), bytes_from_cstr(cstr("*3\r\n$7\r\nPUBLISH\r\n$2\r\nc1\r\n$2\r\nms\r\n"))), 1)
}