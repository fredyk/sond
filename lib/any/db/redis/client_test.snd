// Tests for lib/any/db/redis/client.snd: compilation and encoding tests
//   sond test lib/any/db/redis/client_test.snd

include "any/db/redis/resp.snd"
include "any/db/redis/client.snd"
include "x86_64/linux/testing.snd"

// ── enc_int (resp.snd exercise via client import) ─────────────────────────

test "enc_int encodes :42" {
    let b = enc_int(42)
    assert_eq(bytes_len(b), 5)  // :42\r\n  = 1+2+2
    assert_eq(bytes_get(b, 0), 58) // ':'
}

test "enc_int encodes :0" {
    let b = enc_int(0)
    assert_eq(bytes_len(b), 4)  // :0\r\n
}

// ── resp_encode_command ─────────────────────────────────────────────────

test "resp_encode_command builds correct RESP for PING" {
    let cmd[10]
    let __lit0: string = "PING"
    poke64(cmd + 0, __lit0.utf8)
    poke64(cmd + 8, 4)
    let b = resp_encode_command(1, cmd)
    assert_eq(bytes_len(b), 14)  // *1\r\n$4\r\nPING\r\n  = 2+2+2+4+2=12 → 2+2+2+4+2=12
    // *1\r\n  = 4
    // $4\r\n  = 4
    // PING    = 4
    // \r\n    = 2
    // total = 14
    assert_eq(bytes_get(b, 0), 42)  // '*'
    assert_eq(bytes_get(b, 1), 49)  // '1'
}

test "resp_encode_command builds 2-arg command" {
    let items[4]
    let __lit1: string = "MGET"
    poke64(items + 0, __lit1.utf8)
    poke64(items + 8, 4)
    let __lit2: string = "key1"
    poke64(items + 16, __lit2.utf8)
    poke64(items + 24, 4)
    let b = resp_encode_command(2, items)
    // *2\r\n$4\r\nMGET\r\n$4\r\nkey1\r\n  = 4+4+4+4+4+4 = 24
    assert_eq(bytes_len(b), 24)
    assert_eq(bytes_get(b, 0), 42)  // '*'
}

// ── RESP parsing exercise (matching resp.snd contract) ──────────────────

test "resp_parse_bulk nil for $-1" {
    let buf[5]
    poke8(buf + 0, 36)  // '$'
    poke8(buf + 1, 45)  // '-'
    poke8(buf + 2, 49)  // '1'
    poke8(buf + 3, 13)  // CR
    poke8(buf + 4, 10)  // LF
    resp_reset(buf, 5, 0)
    let result = resp_parse_bulk()
    assert_eq(result, -1)  // nil sentinel
}

test "resp_parse_int zero" {
    let buf[4]
    poke8(buf + 0, 58)  // ':'
    poke8(buf + 1, 48)  // '0'
    poke8(buf + 2, 13)  // CR
    poke8(buf + 3, 10)  // LF
    resp_reset(buf, 4, 0)
    let result = resp_parse_int()
    assert_eq(result, 0)
}

// ── bulk string round-trip via decode ──────────────────────────────────

test "resp_decode returns buffer for bulk string" {
    let buf[11]
    poke8(buf + 0, 36)  // '$'
    poke8(buf + 1, 53)  // '5'
    poke8(buf + 2, 13)  // CR
    poke8(buf + 3, 10)  // LF
    poke8(buf + 4, 104) // 'h'
    poke8(buf + 5, 101) // 'e'
    poke8(buf + 6, 108) // 'l'
    poke8(buf + 7, 108) // 'l'
    poke8(buf + 8, 111) // 'o'
    poke8(buf + 9, 13)  // CR
    poke8(buf + 10, 10) // LF
    resp_reset(buf, 11, 0)
    let result = resp_decode()
    // resp_decode for bulk returns buffer handle (not int)
    // verified by resp_test.snd with 100% coverage
    assert_eq(result > 0, 1)  // buffer handle is a positive arena pointer
}

// ── nil and empty encoding ─────────────────────────────────────────────

test "enc_nil encodes $-1" {
    let b = enc_nil()
    assert_eq(bytes_len(b), 5)  // $-1\r\n
}

test "enc_array_nil encodes *-1" {
    let b = enc_array_nil()
    assert_eq(bytes_len(b), 5)  // *-1\r\n
}

test "enc_array_of_strings empty array" {
    let items[6]
    let b = enc_array_of_strings(0, items)
    assert_eq(bytes_len(b), 4)  // *0\r\n
    assert_eq(bytes_get(b, 0), 42)  // '*'
}

// ── resp.snd parser: full branch coverage ────────────────────────────────
// The tests above only exercise resp_decode's bulk-string branch and
// resp_parse_int/resp_parse_bulk called directly. The tests below drive every
// remaining branch of the private parser helpers (__skip_crlf, __read_line,
// __read_int, __skip_value, resp_decode's other type branches).

test "__skip_crlf consumes CR LF when present" {
    let buf[2]
    poke8(buf + 0, 13)  // CR
    poke8(buf + 1, 10)  // LF
    resp_reset(buf, 2, 0)
    assert_eq(__resp_idx, 0)
    __skip_crlf()
    assert_eq(__resp_idx, 2)
}

test "__skip_crlf is a no-op when not positioned at CR" {
    let buf[2]
    poke8(buf + 0, 97)  // 'a'
    poke8(buf + 1, 98)  // 'b'
    resp_reset(buf, 2, 0)
    __skip_crlf()
    assert_eq(__resp_idx, 0)
}

test "__read_line clamps a negative length to zero on truncated input" {
    // A single byte with no CR LF at all: the loop exits via the "buffer
    // exhausted" break after advancing only 1 byte, so idx - start - 2 < 0.
    let buf[1]
    poke8(buf + 0, 97)  // 'a', no CRLF
    resp_reset(buf, 1, 0)
    let out = bytes_new()
    let n = __read_line(out)
    assert_eq(n, 0)
    assert_eq(__resp_idx, 1)
}

test "__read_int parses a standalone negative sign" {
    // ":-5\r\n" with the leading ':' pre-skipped (start=1), matching how
    // resp_decode positions the cursor before delegating to resp_parse_int.
    let buf[5]
    poke8(buf + 0, 58)  // ':'
    poke8(buf + 1, 45)  // '-'
    poke8(buf + 2, 53)  // '5'
    poke8(buf + 3, 13)  // CR
    poke8(buf + 4, 10)  // LF
    resp_reset(buf, 5, 1)
    let result = resp_parse_int()
    assert_eq(result, -5)
}

test "resp_parse_simple returns the first content byte" {
    // "+OK\r\n" with the leading '+' pre-skipped, matching resp_decode's usage.
    let buf[5]
    poke8(buf + 0, 43)  // '+'
    poke8(buf + 1, 79)  // 'O'
    poke8(buf + 2, 75)  // 'K'
    poke8(buf + 3, 13)  // CR
    poke8(buf + 4, 10)  // LF
    resp_reset(buf, 5, 1)
    let result = resp_parse_simple()
    assert_eq(result, 79)  // 'O'
}

test "resp_parse_simple returns 0 for an empty simple string" {
    let buf[3]
    poke8(buf + 0, 43)  // '+'
    poke8(buf + 1, 13)  // CR
    poke8(buf + 2, 10)  // LF
    resp_reset(buf, 3, 1)
    let result = resp_parse_simple()
    assert_eq(result, 0)
}

test "__skip_value advances past a bulk string's trailing CRLF" {
    // resp.snd's __skip_value bulk-string branch used to advance only past
    // the body (`__resp_idx = __resp_idx + n`) without consuming the body's
    // own trailing CRLF the way __read_line does for the length line, so the
    // cursor ended 2 bytes short of the value's true end. Any RESP array that
    // skips a bulk-string element which is not the last item would then
    // misparse everything that follows it, shifted left by 2 bytes. Fixed by
    // calling __skip_crlf() after the bulk body.
    let buf[9]
    poke8(buf + 0, 36)   // '$'
    poke8(buf + 1, 51)   // '3'
    poke8(buf + 2, 13)
    poke8(buf + 3, 10)
    poke8(buf + 4, 102)  // 'f'
    poke8(buf + 5, 111)  // 'o'
    poke8(buf + 6, 111)  // 'o'
    poke8(buf + 7, 13)
    poke8(buf + 8, 10)
    resp_reset(buf, 9, 0)
    __skip_value()
    assert_eq(__resp_idx, 9)
}

test "__skip_value skips a nil bulk string" {
    let buf[5]
    poke8(buf + 0, 36)  // '$'
    poke8(buf + 1, 45)  // '-'
    poke8(buf + 2, 49)  // '1'
    poke8(buf + 3, 13)
    poke8(buf + 4, 10)
    resp_reset(buf, 5, 0)
    __skip_value()
    assert_eq(__resp_idx, 5)
}

test "__skip_value skips a nested array" {
    let buf[8]
    poke8(buf + 0, 42)  // '*'
    poke8(buf + 1, 49)  // '1'
    poke8(buf + 2, 13)
    poke8(buf + 3, 10)
    poke8(buf + 4, 58)  // ':'
    poke8(buf + 5, 53)  // '5'
    poke8(buf + 6, 13)
    poke8(buf + 7, 10)
    resp_reset(buf, 8, 0)
    __skip_value()
    assert_eq(__resp_idx, 8)
}

test "__skip_value skips a nil array" {
    let buf[5]
    poke8(buf + 0, 42)  // '*'
    poke8(buf + 1, 45)  // '-'
    poke8(buf + 2, 49)  // '1'
    poke8(buf + 3, 13)
    poke8(buf + 4, 10)
    resp_reset(buf, 5, 0)
    __skip_value()
    assert_eq(__resp_idx, 5)
}

test "__skip_value only consumes the type byte for an unrecognized type" {
    let buf[1]
    poke8(buf + 0, 90)  // 'Z', not a RESP type marker
    resp_reset(buf, 1, 0)
    __skip_value()
    assert_eq(__resp_idx, 1)
}

test "resp_decode returns -1 on an empty buffer" {
    let buf[1]
    resp_reset(buf, 0, 0)
    assert_eq(resp_decode(), -1)
}

test "resp_decode dispatches a simple string" {
    let buf[7]
    poke8(buf + 0, 43)   // '+'
    poke8(buf + 1, 80)   // 'P'
    poke8(buf + 2, 79)   // 'O'
    poke8(buf + 3, 78)   // 'N'
    poke8(buf + 4, 71)   // 'G'
    poke8(buf + 5, 13)
    poke8(buf + 6, 10)
    resp_reset(buf, 7, 0)
    assert_eq(resp_decode(), 80)  // 'P'
}

test "resp_decode dispatches an empty simple string" {
    // resp_decode's typ==43 branch has its OWN inline "empty vs non-empty"
    // check (it does not delegate to resp_parse_simple), so this exercises a
    // basic block distinct from the "resp_parse_simple returns 0" test above.
    let buf[3]
    poke8(buf + 0, 43)  // '+'
    poke8(buf + 1, 13)
    poke8(buf + 2, 10)
    resp_reset(buf, 3, 0)
    assert_eq(resp_decode(), 0)
}

test "resp_decode dispatches an error" {
    let buf[6]
    poke8(buf + 0, 45)  // '-'
    poke8(buf + 1, 69)  // 'E'
    poke8(buf + 2, 82)  // 'R'
    poke8(buf + 3, 82)  // 'R'
    poke8(buf + 4, 13)
    poke8(buf + 5, 10)
    resp_reset(buf, 6, 0)
    assert_eq(resp_decode(), 69)  // 'E'
}

test "resp_decode dispatches an empty error" {
    // Same duplicated-block reasoning as "resp_decode dispatches an empty
    // simple string" above, for the typ==45 branch instead of typ==43.
    let buf[3]
    poke8(buf + 0, 45)  // '-'
    poke8(buf + 1, 13)
    poke8(buf + 2, 10)
    resp_reset(buf, 3, 0)
    assert_eq(resp_decode(), 0)
}

test "resp_decode dispatches an integer" {
    let buf[6]
    poke8(buf + 0, 58)   // ':'
    poke8(buf + 1, 49)   // '1'
    poke8(buf + 2, 50)   // '2'
    poke8(buf + 3, 51)   // '3'
    poke8(buf + 4, 13)
    poke8(buf + 5, 10)
    resp_reset(buf, 6, 0)
    assert_eq(resp_decode(), 123)
}

test "resp_decode dispatches a nil array" {
    let buf[5]
    poke8(buf + 0, 42)  // '*'
    poke8(buf + 1, 45)  // '-'
    poke8(buf + 2, 49)  // '1'
    poke8(buf + 3, 13)
    poke8(buf + 4, 10)
    resp_reset(buf, 5, 0)
    assert_eq(resp_decode(), -1)
}

test "resp_decode dispatches a 2-element array of integers" {
    let buf[12]
    poke8(buf + 0, 42)   // '*'
    poke8(buf + 1, 50)   // '2'
    poke8(buf + 2, 13)
    poke8(buf + 3, 10)
    poke8(buf + 4, 58)   // ':'
    poke8(buf + 5, 49)   // '1'
    poke8(buf + 6, 13)
    poke8(buf + 7, 10)
    poke8(buf + 8, 58)   // ':'
    poke8(buf + 9, 50)   // '2'
    poke8(buf + 10, 13)
    poke8(buf + 11, 10)
    resp_reset(buf, 12, 0)
    assert_eq(resp_decode(), 2)  // item count
    assert_eq(__resp_idx, 12)   // both items skipped
}

test "resp_decode dispatches an empty (0-element) array" {
    let buf[4]
    poke8(buf + 0, 42)  // '*'
    poke8(buf + 1, 48)  // '0'
    poke8(buf + 2, 13)
    poke8(buf + 3, 10)
    resp_reset(buf, 4, 0)
    assert_eq(resp_decode(), 0)
}

test "resp_decode dispatches a 1-element array containing a bulk string" {
    let buf[12]
    poke8(buf + 0, 42)   // '*'
    poke8(buf + 1, 49)   // '1'
    poke8(buf + 2, 13)
    poke8(buf + 3, 10)
    poke8(buf + 4, 36)   // '$'
    poke8(buf + 5, 50)   // '2'
    poke8(buf + 6, 13)
    poke8(buf + 7, 10)
    poke8(buf + 8, 111)  // 'o'
    poke8(buf + 9, 107)  // 'k'
    poke8(buf + 10, 13)
    poke8(buf + 11, 10)
    resp_reset(buf, 12, 0)
    assert_eq(resp_decode(), 1)
}

test "__skip_value's simple/error/int branch exits on buffer exhaustion" {
    // Same "no CR before the buffer ends" hazard as the __read_line test
    // above, but for __skip_value's own inline scan loop (a separate basic
    // block from __read_line's).
    let buf[2]
    poke8(buf + 0, 43)  // '+'
    poke8(buf + 1, 97)  // 'a', no CR before the buffer ends
    resp_reset(buf, 2, 0)
    __skip_value()
    assert_eq(__resp_idx, 2)
}

test "resp_decode returns -1 for an unrecognized type byte" {
    let buf[1]
    poke8(buf + 0, 88)  // 'X'
    resp_reset(buf, 1, 0)
    assert_eq(resp_decode(), -1)
}

// ── client.snd: connection management, over a real loopback socket ──────
// These fork a tiny local TCP "server" (bind/listen/accept on 127.0.0.1) so the
// success paths of redis_connect/redis_connect_new and the read/parse plumbing
// get exercised against real socket I/O, not just refused-connection failures.

test "ip_from_cstr's overflow guard on an over-long host string" {
    // No '.' or NUL occurs in the first 16 characters, so the loop only ever
    // exits through the `if i > 15 { break }` safety guard, and `result` (never
    // touched by the '.'/NUL branch) stays at its initial 0.
    let __s0_417: string = "11111111111111111111"
    let ip = ip_from_cstr(__s0_417.utf8)
    assert_eq(ip, 0)
}

test "redis_connect returns negative when the peer refuses the connection" {
    // Nothing binds this port anywhere in the suite: loopback refusal is
    // immediate (a local RST), so this cannot hang.
    let __s0_425: string = "127.0.0.1"
    let fd = redis_connect(__s0_425.utf8, 18899)
    assert(fd < 0)
}

test "redis_connect_new returns 0 when the peer refuses the connection" {
    let handle = redis_connect_new(18899)
    assert_eq(handle, 0)
}

test "redis_connect/redis_send_resp/redis_send/redis_read round trip over a real socket" {
    // Builds the wire bytes directly with resp_encode_command and sends them with
    // the low-level primitives, so this exercises the plumbing on its own:
    // connect, send, recv, and the read_response accumulation loop, against a
    // real peer. The higher-level path through redis_command is covered separately.
    let port = 18863
    let srv = sock(AF_INET, SOCK_STREAM, 0)
    assert(srv >= 0)
    set_reuseaddr(srv)
    let sa[2]
    sockaddr_in_build(sa, 0, port)
    assert_eq(bind_sock(srv, sa, 16), 0)
    assert_eq(listen_sock(srv, 1), 0)

    let pid = syscall(SYS_fork)
    if pid == 0 {
        let csa[2]
        let alen[1]
        poke32(alen, 16)
        let cfd = accept_sock(srv, csa, alen)
        let rbuf1[64]
        recvfrom_sock(cfd, rbuf1, 512, 0, 0, 0)
        let reply1_text: string = "+PONG\r\n"
        let reply1 = reply1_text.utf8
        sendto_sock(cfd, reply1, 7, 0, 0, 0)
        let rbuf2[64]
        recvfrom_sock(cfd, rbuf2, 512, 0, 0, 0)
        let reply2_text: string = ":42\r\n"
        let reply2 = reply2_text.utf8
        sendto_sock(cfd, reply2, 5, 0, 0, 0)
        close_fd(cfd)
        close_fd(srv)
        syscall(SYS_exit, 0)
    }
    assert(pid > 0)

    let __s1_471: string = "127.0.0.1"
    let fd = redis_connect(__s1_471.utf8, port)
    assert(fd >= 0)

    let cmd[2]
    let __lit3: string = "PING"
    poke64(cmd + 0, __lit3.utf8)
    poke64(cmd + 8, 4)
    let encoded = resp_encode_command(1, cmd)
    let raw = peek64(encoded)
    let elen = bytes_len(encoded)
    assert_eq(elen, 14)

    // Round 1: redis_send_resp (send + accumulate the reply into a "recv buf").
    let recvdata[64]
    let buf[4]
    poke64(buf + 8, recvdata)
    poke64(buf + 24, 512)
    let n1 = redis_send_resp(fd, buf, raw, elen)
    assert_eq(n1, 7)  // "+PONG\r\n"
    let rp1 = peek64(buf + 8)
    resp_reset(rp1, n1, 0)
    assert_eq(resp_decode(), 80)  // 'P', the simple string's first content byte

    redis_reset(buf)
    assert_eq(peek64(buf + 16), 0)

    // Round 2: the raw redis_send/redis_read primitives directly.
    let sent = redis_send(fd, raw, elen)
    assert_eq(sent, elen)
    let readbuf[64]
    let n2 = redis_read(fd, readbuf, 512)
    assert_eq(n2, 5)  // ":42\r\n"
    resp_reset(readbuf, n2, 0)
    assert_eq(resp_decode(), 42)

    redis_close(fd)
    let st[1]
    syscall(SYS_wait4, pid, st, 0, 0)
}

test "redis_connect_new/redis_fill/redis_parse/redis_connect_close round trip" {
    // redis_fill and redis_parse used to disagree on what handle+16 ("pos")
    // means. redis_fill treats it as the total number of bytes RECEIVED so far
    // (the END of the valid data, used as the write offset for the next recv).
    // redis_parse instead used that same field as __resp_idx, the DECODE START
    // offset, and set __resp_len to the buffer's full capacity rather than the
    // number of valid bytes. So after a successful fill, redis_parse started
    // reading right AFTER the data that was just received (at the first
    // untouched, zero-filled byte of the arena buffer) instead of at its start,
    // and always saw a stray 0 byte there, which matches none of RESP's type
    // markers, so resp_decode's "else" branch fired and returned -1: a reply
    // could never be successfully decoded through this handle-based API. Fixed
    // by having redis_parse start decoding from offset 0 with __resp_len set
    // to the number of bytes actually received.
    let port = 18865
    let srv = sock(AF_INET, SOCK_STREAM, 0)
    assert(srv >= 0)
    set_reuseaddr(srv)
    let sa[2]
    sockaddr_in_build(sa, 0, port)
    assert_eq(bind_sock(srv, sa, 16), 0)
    assert_eq(listen_sock(srv, 1), 0)

    let pid = syscall(SYS_fork)
    if pid == 0 {
        let csa[2]
        let alen[1]
        poke32(alen, 16)
        let cfd = accept_sock(srv, csa, alen)
        let reply_text: string = ":42\r\n"
        let reply = reply_text.utf8
        sendto_sock(cfd, reply, 5, 0, 0, 0)
        close_fd(cfd)
        close_fd(srv)
        syscall(SYS_exit, 0)
    }
    assert(pid > 0)

    let handle = redis_connect_new(port)
    assert(handle != 0)
    // redis_fill's "keep reading" loop waits out the full 5s SO_RCVTIMEO before
    // it accepts that the peer is done (see set_rcvtimeo in redis_connect_new),
    // so this call is slow but bounded.
    redis_fill(handle)
    let val = redis_parse(handle)
    assert_eq(val, 42)
    redis_reset(handle)
    assert_eq(peek64(handle + 16), 0)
    redis_connect_close(handle)

    let st[1]
    syscall(SYS_wait4, pid, st, 0, 0)
}

test "read_response/redis_fill are no-ops when the buffer already has no room" {
    // Drives the `available <= 0` early-return branch of both read_response
    // (private, via redis_send_resp) and redis_fill, with no live peer needed:
    // a buffer whose cap equals its already-filled pos has nothing left to
    // receive into.
    let recvdata[8]
    let buf[4]
    poke64(buf + 8, recvdata)
    poke64(buf + 24, 0)  // cap = 0, so available = cap - pos is never positive
    let n = redis_send_resp(-1, buf, recvdata, 0)
    assert_eq(n, 0)

    let handle = heap_alloc(32)
    poke64(handle, recvdata)
    poke64(handle + 8, -1)  // fd = -1, never dereferenced on this path
    let __lit4: string = "full"
    poke64(handle + 16, 8)  // pos == cap: already __lit4.utf8
    poke64(handle + 24, 8)
    assert_eq(redis_fill(handle), 8)
}

test "read_response's accumulation loop stops as soon as the buffer is full" {
    // Drives read_response's inner-loop `av2 <= 0` break: a recv buf whose
    // capacity exactly matches the reply size fills up on the very first
    // recv, so the loop's second iteration must exit via the "no room left"
    // check rather than a failed/short recv.
    let port = 18867
    let srv = sock(AF_INET, SOCK_STREAM, 0)
    assert(srv >= 0)
    set_reuseaddr(srv)
    let sa[2]
    sockaddr_in_build(sa, 0, port)
    assert_eq(bind_sock(srv, sa, 16), 0)
    assert_eq(listen_sock(srv, 1), 0)

    let pid = syscall(SYS_fork)
    if pid == 0 {
        let csa[2]
        let alen[1]
        poke32(alen, 16)
        let cfd = accept_sock(srv, csa, alen)
        let rbuf[64]
        recvfrom_sock(cfd, rbuf, 512, 0, 0, 0)
        let reply_text: string = "+OK\r\n"
        let reply = reply_text.utf8
        sendto_sock(cfd, reply, 5, 0, 0, 0)
        close_fd(cfd)
        close_fd(srv)
        syscall(SYS_exit, 0)
    }
    assert(pid > 0)

    let __s2_618: string = "127.0.0.1"
    let fd = redis_connect(__s2_618.utf8, port)
    assert(fd >= 0)
    let cmd[2]
    let __lit5: string = "PING"
    poke64(cmd + 0, __lit5.utf8)
    poke64(cmd + 8, 4)
    let encoded = resp_encode_command(1, cmd)
    let raw = peek64(encoded)
    let elen = bytes_len(encoded)

    let recvdata[1]  // exactly 8 bytes of backing storage
    let buf[4]
    poke64(buf + 8, recvdata)
    poke64(buf + 24, 5)  // cap == the reply's exact length
    let n = redis_send_resp(fd, buf, raw, elen)
    assert_eq(n, 5)

    redis_close(fd)
    let st[1]
    syscall(SYS_wait4, pid, st, 0, 0)
}

test "redis_fill returns its unchanged pos when recv fails" {
    // Drives redis_fill's `rn <= 0` branch: a disconnected fd fails the recv
    // immediately, before any bytes have been placed in the buffer.
    let recvdata[8]
    let handle = heap_alloc(32)
    poke64(handle, recvdata)
    poke64(handle + 8, -1)  // fd = -1
    poke64(handle + 16, 0)
    poke64(handle + 24, 64)
    assert_eq(redis_fill(handle), 0)
}

test "redis_fill's accumulation loop stops as soon as the buffer is full" {
    // Same "av2 <= 0" hazard as read_response's own accumulation loop (see
    // the read_response test above): a handle whose cap exactly matches the
    // reply size fills up on the first recv, so the loop must exit via the
    // capacity check rather than a second, failed recv.
    let port = 18868
    let srv = sock(AF_INET, SOCK_STREAM, 0)
    assert(srv >= 0)
    set_reuseaddr(srv)
    let sa[2]
    sockaddr_in_build(sa, 0, port)
    assert_eq(bind_sock(srv, sa, 16), 0)
    assert_eq(listen_sock(srv, 1), 0)

    let pid = syscall(SYS_fork)
    if pid == 0 {
        let csa[2]
        let alen[1]
        poke32(alen, 16)
        let cfd = accept_sock(srv, csa, alen)
        let reply_text: string = "+OK\r\n"
        let reply = reply_text.utf8
        sendto_sock(cfd, reply, 5, 0, 0, 0)
        close_fd(cfd)
        close_fd(srv)
        syscall(SYS_exit, 0)
    }
    assert(pid > 0)

    let __s3_682: string = "127.0.0.1"
    let fd = redis_connect(__s3_682.utf8, port)
    assert(fd >= 0)
    let recvdata[1]
    let handle = heap_alloc(32)
    poke64(handle, recvdata)
    poke64(handle + 8, fd)
    poke64(handle + 16, 0)
    poke64(handle + 24, 5)  // cap == the reply's exact length
    assert_eq(redis_fill(handle), 5)

    redis_close(fd)
    let st[1]
    syscall(SYS_wait4, pid, st, 0, 0)
}

// ── client.snd: convenience command encoders ─────────────────────────────
// Every command below is called with a disconnected fd (-1): sendto/recvfrom
// on a bad fd fail in the kernel before the buffer is even touched (checked
// empirically), so this is memory-safe and drives every basic block in each
// encoder without needing a live peer. After the call, `items` holds exactly
// what the encoder built; re-encoding it with the already-verified
// resp_encode_command and comparing byte for byte against the literal RESP
// wire bytes the protocol mandates is what actually verifies each encoder,
// not just its return value. `items` is freshly heap_alloc'd (zeroed) before
// every call so there is no possibility of a stale slot from a previous
// assertion leaking into the comparison.

test "string commands: PING/GET/SET/SETEX/GETSET/APPEND/STRLEN/INCR*/DECR*" {
    let fd = -1
    let recvdata[64]
    let buf[4]
    poke64(buf + 8, recvdata)
    poke64(buf + 24, 512)

    let items0 = heap_alloc(320)
    redis_ping(fd, buf, items0)
    let __s0_719: string = "*1\r\n$4\r\nPING\r\n"
    assert_eq(bytes_eq(resp_encode_command(1, items0), bytes_from_cstr(__s0_719.utf8)), 1)

    // redis_get/redis_set/redis_setex used to compute the length byte for
    // their own command-name argument as strlen(key) instead of the command
    // name's own (constant) length. A 3-character key does not expose that
    // (see the dedicated regression test below, which uses a key of a
    // different length to pin the fix down).
    let items1 = heap_alloc(320)
    let __lit6: string = "key"
    redis_get(fd, buf, items1, __lit6.utf8)
    let __s1_730: string = "*2\r\n$3\r\nGET\r\n$3\r\nkey\r\n"
    assert_eq(bytes_eq(resp_encode_command(2, items1), bytes_from_cstr(__s1_730.utf8)), 1)

    let items2 = heap_alloc(320)
    let __lit7: string = "key"
    let __lit8: string = "v1"
    redis_set(fd, buf, items2, __lit7.utf8, __lit8.utf8)
    let __s2_737: string = "*3\r\n$3\r\nSET\r\n$3\r\nkey\r\n$2\r\nv1\r\n"
    assert_eq(bytes_eq(resp_encode_command(3, items2), bytes_from_cstr(__s2_737.utf8)), 1)

    // redis_setex builds its EX-seconds digits in a LOCAL stack array (`tmp`)
    // and stores that address into `items`. That is safe in the function's own
    // intended use (redis_command consumes items before returning), but the
    // pointer is dangling the instant redis_setex itself returns: any further
    // function call (even resp_encode_command below) reuses that stack slot
    // and corrupts the digits (confirmed empirically: without this rescue,
    // "60" decoded back as raw bytes 64,0). So the digits are copied into a
    // stable local buffer immediately, using only inline peek/poke (no calls)
    // between the wrapper returning and the rescue completing.
    let items3 = heap_alloc(320)
    let __lit9: string = "key"
    let __lit10: string = "v1"
    redis_setex(fd, buf, items3, __lit9.utf8, __lit10.utf8, 60)
    let r34[4]
    let j34 = 0
    let l34 = peek64(items3 + 4 * 16 + 8)
    for j34 < l34 {
        poke8(r34 + j34, peek8(peek64(items3 + 4 * 16) + j34))
        j34 = j34 + 1
    }
    poke64(items3 + 4 * 16, r34)
    let __s3_761: string = "*5\r\n$3\r\nSET\r\n$3\r\nkey\r\n$2\r\nv1\r\n$2\r\nEX\r\n$2\r\n60\r\n"
    assert_eq(bytes_eq(resp_encode_command(5, items3), bytes_from_cstr(__s3_761.utf8)), 1)

    // Same stack-tmp hazard as redis_setex, for the "seconds" argument (slot 2).
    let items4 = heap_alloc(320)
    let __lit11: string = "k1"
    let __lit12: string = "v1"
    redis_setex2(fd, buf, items4, __lit11.utf8, 30, __lit12.utf8)
    let r42[4]
    let j42 = 0
    let l42 = peek64(items4 + 2 * 16 + 8)
    for j42 < l42 {
        poke8(r42 + j42, peek8(peek64(items4 + 2 * 16) + j42))
        j42 = j42 + 1
    }
    poke64(items4 + 2 * 16, r42)
    let __s4_777: string = "*4\r\n$5\r\nSETEX\r\n$2\r\nk1\r\n$2\r\n30\r\n$2\r\nv1\r\n"
    assert_eq(bytes_eq(resp_encode_command(4, items4), bytes_from_cstr(__s4_777.utf8)), 1)

    // redis_getset used to pass a hardcoded length of 8 for its own command
    // name, but "GETSET" is 6 characters, so it read 2 bytes past the
    // literal's NUL terminator. Fixed to use the real length.
    let items5 = heap_alloc(320)
    let __lit13: string = "k1"
    let __lit14: string = "v1"
    redis_getset(fd, buf, items5, __lit13.utf8, __lit14.utf8)
    let __s5_787: string = "*3\r\n$6\r\nGETSET\r\n$2\r\nk1\r\n$2\r\nv1\r\n"
    assert_eq(bytes_eq(resp_encode_command(3, items5), bytes_from_cstr(__s5_787.utf8)), 1)

    let items6 = heap_alloc(320)
    let __lit15: string = "k1"
    let __lit16: string = "v1"
    redis_append(fd, buf, items6, __lit15.utf8, __lit16.utf8)
    let __s6_794: string = "*3\r\n$6\r\nAPPEND\r\n$2\r\nk1\r\n$2\r\nv1\r\n"
    assert_eq(bytes_eq(resp_encode_command(3, items6), bytes_from_cstr(__s6_794.utf8)), 1)

    let items7 = heap_alloc(320)
    let __lit17: string = "k1"
    redis_strlen(fd, buf, items7, __lit17.utf8)
    let __s7_800: string = "*2\r\n$6\r\nSTRLEN\r\n$2\r\nk1\r\n"
    assert_eq(bytes_eq(resp_encode_command(2, items7), bytes_from_cstr(__s7_800.utf8)), 1)

    let items8 = heap_alloc(320)
    let __lit18: string = "k1"
    redis_incr(fd, buf, items8, __lit18.utf8)
    let __s8_806: string = "*2\r\n$4\r\nINCR\r\n$2\r\nk1\r\n"
    assert_eq(bytes_eq(resp_encode_command(2, items8), bytes_from_cstr(__s8_806.utf8)), 1)

    let items9 = heap_alloc(320)
    let __lit19: string = "k1"
    redis_incrby(fd, buf, items9, __lit19.utf8, 5)
    let r92[4]
    let j92 = 0
    let l92 = peek64(items9 + 2 * 16 + 8)
    for j92 < l92 {
        poke8(r92 + j92, peek8(peek64(items9 + 2 * 16) + j92))
        j92 = j92 + 1
    }
    poke64(items9 + 2 * 16, r92)
    let __s9_820: string = "*3\r\n$6\r\nINCRBY\r\n$2\r\nk1\r\n$1\r\n5\r\n"
    assert_eq(bytes_eq(resp_encode_command(3, items9), bytes_from_cstr(__s9_820.utf8)), 1)

    let items10 = heap_alloc(320)
    let __lit20: string = "k1"
    redis_decr(fd, buf, items10, __lit20.utf8)
    let __s10_826: string = "*2\r\n$4\r\nDECR\r\n$2\r\nk1\r\n"
    assert_eq(bytes_eq(resp_encode_command(2, items10), bytes_from_cstr(__s10_826.utf8)), 1)

    let items11 = heap_alloc(320)
    let __lit21: string = "k1"
    redis_decrby(fd, buf, items11, __lit21.utf8, 3)
    let r112[4]
    let j112 = 0
    let l112 = peek64(items11 + 2 * 16 + 8)
    for j112 < l112 {
        poke8(r112 + j112, peek8(peek64(items11 + 2 * 16) + j112))
        j112 = j112 + 1
    }
    poke64(items11 + 2 * 16, r112)
    let __s11_840: string = "*3\r\n$6\r\nDECRBY\r\n$2\r\nk1\r\n$1\r\n3\r\n"
    assert_eq(bytes_eq(resp_encode_command(3, items11), bytes_from_cstr(__s11_840.utf8)), 1)
}

test "redis_get/redis_set/redis_setex use their own command name's length, not the key's" {
    // redis_get/redis_set/redis_setex used to compute the length of their own
    // command-name argument as strlen(key) instead of the command name's own
    // constant length (e.g. add_cmd_arg(items, 0, "GET", strlen(key))
    // instead of the constant 3). A key whose length differs from the command
    // name's exposes this: pre-fix, a 1-character key made GET's own bulk
    // string read only "G" instead of the full "GET". Fixed by hardcoding
    // each command name's own length.
    let fd = -1
    let recvdata[64]
    let buf[4]
    poke64(buf + 8, recvdata)
    poke64(buf + 24, 512)

    let items0 = heap_alloc(320)
    let __lit22: string = "k"
    redis_get(fd, buf, items0, __lit22.utf8)
    let __s12_861: string = "*2\r\n$3\r\nGET\r\n$1\r\nk\r\n"
    assert_eq(bytes_eq(resp_encode_command(2, items0), bytes_from_cstr(__s12_861.utf8)), 1)

    let items1 = heap_alloc(320)
    let __lit23: string = "k"
    let __lit24: string = "v"
    redis_set(fd, buf, items1, __lit23.utf8, __lit24.utf8)
    let __s13_868: string = "*3\r\n$3\r\nSET\r\n$1\r\nk\r\n$1\r\nv\r\n"
    assert_eq(bytes_eq(resp_encode_command(3, items1), bytes_from_cstr(__s13_868.utf8)), 1)

    // Same stack-tmp hazard as redis_setex in the test above: copy the EX
    // digits into a stable local buffer before calling resp_encode_command.
    let items2 = heap_alloc(320)
    let __lit25: string = "k"
    let __lit26: string = "v"
    redis_setex(fd, buf, items2, __lit25.utf8, __lit26.utf8, 60)
    let r2[4]
    let j2 = 0
    let l2 = peek64(items2 + 4 * 16 + 8)
    for j2 < l2 {
        poke8(r2 + j2, peek8(peek64(items2 + 4 * 16) + j2))
        j2 = j2 + 1
    }
    poke64(items2 + 4 * 16, r2)
    let __s14_885: string = "*5\r\n$3\r\nSET\r\n$1\r\nk\r\n$1\r\nv\r\n$2\r\nEX\r\n$2\r\n60\r\n"
    assert_eq(bytes_eq(resp_encode_command(5, items2), bytes_from_cstr(__s14_885.utf8)), 1)
}

test "keyspace commands: DEL/EXISTS/TTL/EXPIRE/TYPE/RENAME/KEYS/FLUSHDB/DBSIZE/SELECT/ECHO/PING" {
    let fd = -1
