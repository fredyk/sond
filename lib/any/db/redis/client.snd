    add_cmd_arg(items, 1, key, strlen(key))
    redis_command(buf, fd, 2, items)
}

// Send DECRBY key decrement.
pub fn redis_decrby(fd: i64, buf: i64, items: i64, key: i64, amount: i64) -> i64 {
    let tmp[20]
    let slen = itoa(amount, tmp)
    add_cmd_arg(items, 0, "DECRBY", 6)
    add_cmd_arg(items, 1, key, strlen(key))
    add_cmd_arg(items, 2, tmp, slen)
    redis_command(buf, fd, 3, items)
}

// Send DEL key... (variable args).
pub fn redis_del(fd: i64, buf: i64, items: i64, n_keys: i64, keys: i64) -> i64 {
    add_cmd_arg(items, 0, "DEL", 3)
    let mut slot = 1
    let mut i = 0
    for i < n_keys {
        let key_ptr = peek64(keys + i * 8)
        let klen = strlen(key_ptr)
        poke64(items + slot * 16, key_ptr)
        poke64(items + slot * 16 + 8, klen)
        slot = slot + 1
        i = i + 1
    }
    redis_command(buf, fd, 1 + n_keys, items)
}

// Send EXISTS key.
pub fn redis_exists(fd: i64, buf: i64, items: i64, key: i64) -> i64 {
    add_cmd_arg(items, 0, "EXISTS", 6)
    add_cmd_arg(items, 1, key, strlen(key))
    redis_command(buf, fd, 2, items)
}

