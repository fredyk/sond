// Send SDIFF key...
pub fn redis_sdiff(fd: i64, buf: i64, items: i64, n_keys: i64, keys: i64) -> i64 {
    add_cmd_arg(items, 0, "SDIFF", 5)
    let mut slot = 1
    let mut i = 0
    for i < n_keys {
        let kptr = peek64(keys + i * 8)
        let klen = strlen(kptr)
        poke64(items + slot * 16, kptr)
        poke64(items + slot * 16 + 8, klen)
        slot = slot + 1
        i = i + 1
    }
    redis_command(buf, fd, 1 + n_keys, items)
}

