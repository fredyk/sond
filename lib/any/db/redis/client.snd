    add_cmd_arg(items, 0, "SUBSCRIBE", 9)
    let mut slot = 1
    let mut i = 0
    for i < n_channels {
        let chptr = peek64(channels + i * 8)
        let chlen = strlen(chptr)
        poke64(items + slot * 16, chptr)
        poke64(items + slot * 16 + 8, chlen)
        slot = slot + 1
        i = i + 1
    }
    redis_command(buf, fd, 1 + n_channels, items)
}

