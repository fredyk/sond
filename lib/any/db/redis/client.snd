    let cnt_len = itoa(count, cnt_tmp)
    add_cmd_arg(items, 0, "LREM", 4)
    add_cmd_arg(items, 1, key, strlen(key))
    add_cmd_arg(items, 2, cnt_tmp, cnt_len)
