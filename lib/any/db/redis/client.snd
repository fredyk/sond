// Send LRANGE key start stop.
pub fn redis_lrange(fd: i64, buf: i64, items: i64, key: i64, start: i64, stop: i64) -> i64 {
    let start_tmp[20]
    let stop_tmp[20]
    let start_len = itoa(start, start_tmp)
    let stop_len = itoa(stop, stop_tmp)
    add_cmd_arg(items, 0, "LRANGE", 6)
    add_cmd_arg(items, 1, key, strlen(key))
    add_cmd_arg(items, 2, start_tmp, start_len)
    add_cmd_arg(items, 3, stop_tmp, stop_len)
    redis_command(buf, fd, 4, items)
}

// Send LINDEX key index.
pub fn redis_lindex(fd: i64, buf: i64, items: i64, key: i64, index: i64) -> i64 {
    let idx_tmp[20]
    let idx_len = itoa(index, idx_tmp)
    add_cmd_arg(items, 0, "LINDEX", 6)
    add_cmd_arg(items, 1, key, strlen(key))
    add_cmd_arg(items, 2, idx_tmp, idx_len)
    redis_command(buf, fd, 3, items)
}

// Send LSET key index value.
pub fn redis_lset(fd: i64, buf: i64, items: i64, key: i64, index: i64, value: i64) -> i64 {
    let idx_tmp[20]
    let idx_len = itoa(index, idx_tmp)
    add_cmd_arg(items, 0, "LSET", 4)
    add_cmd_arg(items, 1, key, strlen(key))
    add_cmd_arg(items, 2, idx_tmp, idx_len)
    add_cmd_arg(items, 3, value, strlen(value))
    redis_command(buf, fd, 4, items)
}

// Send LTRIM key start stop.
pub fn redis_ltrim(fd: i64, buf: i64, items: i64, key: i64, start: i64, stop: i64) -> i64 {
    let start_tmp[20]
    let stop_tmp[20]
    let start_len = itoa(start, start_tmp)
    let stop_len = itoa(stop, stop_tmp)
    add_cmd_arg(items, 0, "LTRIM", 5)
    add_cmd_arg(items, 1, key, strlen(key))
    add_cmd_arg(items, 2, start_tmp, start_len)
    add_cmd_arg(items, 3, stop_tmp, stop_len)
    redis_command(buf, fd, 4, items)
}

// Send LREM key count value.
pub fn redis_lrem(fd: i64, buf: i64, items: i64, key: i64, count: i64, value: i64) -> i64 {
