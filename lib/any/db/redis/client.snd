    add_cmd_arg(items, 1, "OBJECT", 6)
    add_cmd_arg(items, 2, key, strlen(key))
    redis_command(buf, fd, 3, items)
}

// Send MONITOR (fires and forget, no response expected).
pub fn redis_monitor(fd: i64, buf: i64, items: i64) -> i64 {
    ptr_to_item(items, 0, "MONITOR")
    // MONITOR is a normal RESP command; it must be encoded like every other
    // helper before hitting the wire. Sending raw bytes straight off the
    // "MONITOR" string literal (as this used to do, padded by a hardcoded
    // `+ 5`) read past its NUL terminator into whatever the compiler placed
    // next in .rodata: a buffer over-read, not a protocol detail.
    let encoded = enc_array_of_strings(1, items)
    sendto_sock(fd, peek64(encoded), bytes_len(encoded), 0, 0, 0)
    0
}

