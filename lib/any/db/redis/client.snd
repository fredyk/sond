// Send DEL key... (variable args).
pub fn redis_del(fd: i64, buf: i64, items: i64, n_keys: i64, keys: i64) -> i64 {
    let __lit13: string = "DEL"
    add_cmd_arg(items, 0, __lit13.utf8, 3)
    let mut slot = 1
    let mut i = 0
    for i < n_keys {
        let key_ptr = peek64(keys + i * 8)
        let klen = strlen(key_ptr)
        poke64(items + slot * 16, key_ptr)
        poke64(items + slot * 16 + 8, klen)
        slot = slot + 1
        i = i + 1
    }
    redis_command(buf, fd, 1 + n_keys, items)
}

