        let klen = strlen(kptr)
        poke64(items + slot * 16, kptr)
        poke64(items + slot * 16 + 8, klen)
        slot = slot + 1
        i = i + 1
    }
    redis_command(buf, fd, 1 + n_keys, items)
}

