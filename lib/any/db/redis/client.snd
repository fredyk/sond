}

// Send PUBLISH channel message.
pub fn redis_publish(fd: i64, buf: i64, items: i64, channel: i64, message: i64) -> i64 {
    add_cmd_arg(items, 0, "PUBLISH", 7)
    add_cmd_arg(items, 1, channel, strlen(channel))
    add_cmd_arg(items, 2, message, strlen(message))
    redis_command(buf, fd, 3, items)
}

