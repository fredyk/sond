// Send INCRBY key increment.
pub fn redis_incrby(fd: i64, buf: i64, items: i64, key: i64, amount: i64) -> i64 {
    let tmp[20]
    let slen = itoa(amount, tmp)
    add_cmd_arg(items, 0, "INCRBY", 6)
    add_cmd_arg(items, 1, key, strlen(key))
    add_cmd_arg(items, 2, tmp, slen)
    redis_command(buf, fd, 3, items)
