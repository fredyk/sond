// Send ZINTERSTORE dst key...
pub fn redis_zinterstore(fd: i64, buf: i64, items: i64, n_keys: i64, keys: i64) -> i64 {
    add_cmd_arg(items, 0, "ZINTERSTORE", 11)
    // Command name is slot 0; dst (the first entry of `keys`) goes in slot 1.
    let dst_ptr = peek64(keys + 0)  // first key is actually dst name
    let dst_len = strlen(dst_ptr)
    add_cmd_arg(items, 1, dst_ptr, dst_len)
    let mut slot = 2
    let mut i = 1  // skip first (dst)
    let mut total = n_keys  // n_keys includes dst
    for i < total {
        let kptr = peek64(keys + i * 8)
        let klen = strlen(kptr)
        poke64(items + slot * 16, kptr)
        poke64(items + slot * 16 + 8, klen)
        slot = slot + 1
        i = i + 1
    }
    redis_command(buf, fd, 2 + n_keys - 1, items)
}

// Send ZUNIONSTORE dst key...
pub fn redis_zunionstore(fd: i64, buf: i64, items: i64, n_keys: i64, keys: i64) -> i64 {
    add_cmd_arg(items, 0, "ZUNIONSTORE", 11)
    // Command name is slot 0; dst (the first entry of `keys`) goes in slot 1.
    let dst_ptr = peek64(keys + 0)
    let dst_len = strlen(dst_ptr)
    add_cmd_arg(items, 1, dst_ptr, dst_len)
    let mut slot = 2
    let mut i = 1
    let mut total = n_keys
    for i < total {
        let kptr = peek64(keys + i * 8)
        let klen = strlen(kptr)
        poke64(items + slot * 16, kptr)
        poke64(items + slot * 16 + 8, klen)
        slot = slot + 1
        i = i + 1
    }
    redis_command(buf, fd, 2 + n_keys - 1, items)
}

// Send ZMSCORE key member...
pub fn redis_zmscore(fd: i64, buf: i64, items: i64, key: i64, n_members: i64, members: i64) -> i64 {
    add_cmd_arg(items, 0, "ZMSCORE", 7)
    add_cmd_arg(items, 1, key, strlen(key))
    let mut slot = 2
    let mut i = 0
    for i < n_members {
        let mptr = peek64(members + i * 8)
        let mlen = strlen(mptr)
        poke64(items + slot * 16, mptr)
        poke64(items + slot * 16 + 8, mlen)
        slot = slot + 1
        i = i + 1
    }
    redis_command(buf, fd, 2 + n_members, items)
}

