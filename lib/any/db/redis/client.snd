//  HASH COMMANDS 

// Send HSET key field value.
pub fn redis_hset(fd: i64, buf: i64, items: i64, key: i64, field: i64, value: i64) -> i64 {
    add_cmd_arg(items, 0, "HSET", 4)
    add_cmd_arg(items, 1, key, strlen(key))
    add_cmd_arg(items, 2, field, strlen(field))
    add_cmd_arg(items, 3, value, strlen(value))
    redis_command(buf, fd, 4, items)
}

// Send HGET key field.
pub fn redis_hget(fd: i64, buf: i64, items: i64, key: i64, field: i64) -> i64 {
    add_cmd_arg(items, 0, "HGET", 4)
    add_cmd_arg(items, 1, key, strlen(key))
    add_cmd_arg(items, 2, field, strlen(field))
    redis_command(buf, fd, 3, items)
}

// Send HDEL key field...
pub fn redis_hdel(fd: i64, buf: i64, items: i64, key: i64, n_fields: i64, fields: i64) -> i64 {
    add_cmd_arg(items, 0, "HDEL", 4)
    add_cmd_arg(items, 1, key, strlen(key))
    let mut slot = 2
    let mut i = 0
    for i < n_fields {
        let fptr = peek64(fields + i * 8)
        let flen = strlen(fptr)
        poke64(items + slot * 16, fptr)
        poke64(items + slot * 16 + 8, flen)
        slot = slot + 1
        i = i + 1
    }
    redis_command(buf, fd, 2 + n_fields, items)
}

// Send HGETALL key.
pub fn redis_hgetall(fd: i64, buf: i64, items: i64, key: i64) -> i64 {
    add_cmd_arg(items, 0, "HGETALL", 7)
    add_cmd_arg(items, 1, key, strlen(key))
    redis_command(buf, fd, 2, items)
}

