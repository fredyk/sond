pub fn redis_unsubscribe(fd: i64, buf: i64, items: i64, n_channels: i64, channels: i64) -> i64 {
    add_cmd_arg(items, 0, "UNSUBSCRIBE", 11)
    let mut slot = 1
    let mut i = 0
    for i < n_channels {
        let chptr = peek64(channels + i * 8)
        let chlen = strlen(chptr)
        poke64(items + slot * 16, chptr)
        poke64(items + slot * 16 + 8, chlen)
        slot = slot + 1
        i = i + 1
