// Copyright 2026 Jhon Magdalena Vila and the Sond contributors
//
// lib/any/db/redis/client.snd: Minimal TCP client for Redis using RESP.
//
// API:
//   redis_connect(host, port) -> fd  (returns socket fd on success, -errno on failure)
//   redis_close(fd)
//   redis_send(fd, buf, n)         (send n bytes at buf, returns bytes sent)
//   redis_read(fd, buf, n)         (recv up to n bytes into buf, returns bytes read)
//   redis_command(buf, n, args, n_args) -> resp_buf_len  (build + send command, read RESP)
//   redis_reset(buf)               (reset recv buffer position)
//
// Command helpers (builds RESP array of args and calls redis_command helpers):
//   redis_ping(fd)          → resp value
//   redis_set(fd, key, val) → resp value
//   redis_get(fd, key)      → resp value
//   redis_del(fd, keys, n_keys) → resp value
//   redis_incr(fd, key)     → resp value
//   redis_exists(fd, key)   → resp value
//   redis_ttl(fd, key)      → resp value
//   redis_expire(fd, key, seconds) → resp value

include "x86_64/linux/net.snd"
include "x86_64/linux/io.snd"
include "any/strings.snd"
include "any/db/redis/resp.snd"

//  Connection helpers 

// Parse a NUL-terminated dot-decimal IP "127.0.0.1" into a u32 host-order value.
fn ip_from_cstr(p: i64) -> i64 {
    let mut result = 0
    let mut octet = 0
    let mut i = 0
    for {
        let c = peek8(p + i)
        if c == 0 || c == 46 {  // '.' or NUL
            result = result * 256 + octet
            octet = 0
            if c == 0 { break }
            octet = 0  // ready for next octet
        } else if c >= 48 && c <= 57 {
            octet = octet * 10 + (c - 48)
        }
        i = i + 1
        if i > 15 { break }  // safety: max IPv4 length
    }
    result
}

// Create a TCP socket, connect to host:port, set recv timeout.  Returns fd or < 0 on error.
pub fn redis_connect(host: i64, port: i64) -> i64 {
    let fd = sock(AF_INET, SOCK_STREAM, 0)
    if fd < 0 { return fd }
    let sa[2]  // sockaddr_in needs 16 bytes → pad to 2 i64s (16 bytes)
    let ip = ip_from_cstr(host)
    sockaddr_in_build(sa, ip, port)
    if connect_sock(fd, sa, 16) < 0 {
        close_fd(fd)
        return -1
    }
    set_rcvtimeo(fd, 5)  // 5s timeout on recv
    fd
}

// Close a Redis connection.
pub fn redis_close(fd: i64) {
    close_fd(fd)
}

// Send n bytes at buf to socket fd.  Returns bytes sent (0-errno).
pub fn redis_send(fd: i64, buf: i64, n: i64) -> i64 {
    sendto_sock(fd, buf, n, 0, 0, 0)
}

// Read up to n bytes from socket fd into buf.  Returns bytes read or -errno.
pub fn redis_read(fd: i64, buf: i64, n: i64) -> i64 {
    recvfrom_sock(fd, buf, n, 0, 0, 0)
}

//  High-level: send command + read response 

// Read all available data from socket, appending to buf at pos.
// Returns new position in buf.  Caller ensures buf has capacity.
fn read_response(fd: i64, buf: i64, pos: i64, cap: i64) -> i64 {
    let bufptr = peek64(buf + 8)  // buf_ptr from header
    let capval = peek64(buf + 24) // cap from header
    let have = pos
    let available = capval - have
    if available <= 0 { return have }
    let rn = recvfrom_sock(fd, bufptr + have, available, 0, 0, 0)
    if rn <= 0 { return have }
    let mut new_pos = have + rn
    // Keep reading more data (non-blocking, may come in chunks)
    for {
        let av2 = capval - new_pos
        if av2 <= 0 { break }
        let rn2 = recvfrom_sock(fd, bufptr + new_pos, av2, 0, 0, 0)
        if rn2 <= 0 { break }
        new_pos = new_pos + rn2
    }
    poke64(buf + 16, new_pos)  // update pos in header
    new_pos
}

//  Connection struct (arena-allocated) 
// Layout at handle: [buf_ptr(8), fd(8), pos(8), cap(8)] = 32 bytes

// Create a Redis connection. `buf_cap` is the size of the response buffer.
// Returns a handle to the connection struct (or 0 on failure).
pub fn redis_connect_new(port: i64) -> i64 {
    let handle = heap_alloc(32)  // [buf_ptr, fd, pos, cap]
    let buf_cap = 4096
    let buf_ptr = heap_alloc(buf_cap)
    poke64(handle, buf_ptr)
    poke64(handle + 8, 0)  // fd = 0 (not connected yet)
    poke64(handle + 16, 0) // pos = 0
    poke64(handle + 24, buf_cap)

    let fd = sock(AF_INET, SOCK_STREAM, 0)
    if fd < 0 { return 0 }
    let sa[2]
    let ip = ip_from_cstr("127.0.0.1")
    sockaddr_in_build(sa, ip, port)
    if connect_sock(fd, sa, 16) < 0 { close_fd(fd); return 0 }
    set_rcvtimeo(fd, 5)
    poke64(handle + 8, fd)
    handle
}

// Close a connection.
pub fn redis_connect_close(handle: i64) {
    let fd = peek64(handle + 8)
    close_fd(fd)
}

// Read all available data from socket into the connection buffer.
pub fn redis_fill(handle: i64) -> i64 {
    let fd = peek64(handle + 8)
    let bufptr = peek64(handle)
    let pos = peek64(handle + 16)
    let cap = peek64(handle + 24)
    let available = cap - pos
    if available <= 0 { return pos }
    let rn = recvfrom_sock(fd, bufptr + pos, available, 0, 0, 0)
    if rn <= 0 { return pos }
    let mut new_pos = pos + rn
    for {
        let av2 = cap - new_pos
        if av2 <= 0 { break }
        let rn2 = recvfrom_sock(fd, bufptr + new_pos, av2, 0, 0, 0)
        if rn2 <= 0 { break }
        new_pos = new_pos + rn2
    }
    poke64(handle + 16, new_pos)
    new_pos
}

// Parse and return one RESP value from the connection buffer.
// For simple string: first byte. For integer: the value. For bulk/array: buffer handle.
// For nil: -1. For array: item count.
pub fn redis_parse(handle: i64) -> i64 {
    let bufptr = peek64(handle)
    // handle+16 ("pos") is redis_fill's bookkeeping field: the total number
    // of bytes RECEIVED so far, i.e. the END of the valid data, not a decode
    // start offset. Decoding always starts at 0 and is bounded by that many
    // valid bytes, never by the buffer's full capacity.
    let received = peek64(handle + 16)

    __resp_data = bufptr
    __resp_len = received
    __resp_idx = 0

    let result = resp_decode()

    poke64(handle + 16, __resp_idx)
    result
}

// Reset buffer position to 0 (ready for next request).
pub fn redis_reset(handle: i64) {
    poke64(handle + 16, 0)
}

//  BUILD COMMAND HELPERS 

// Add a command argument to an items array.  items[idx*16] = addr, items[idx*16+8] = len.
fn add_cmd_arg(items: i64, idx: i64, addr: i64, len: i64) {
    poke64(items + idx * 16, addr)
    poke64(items + idx * 16 + 8, len)
}

// Send a pre-encoded RESP command buffer (n bytes) to the server,
// then read all available response data.  Returns response buffer length.
pub fn redis_send_resp(fd: i64, buf: i64, cmd_buf: i64, cmd_len: i64) -> i64 {
    sendto_sock(fd, cmd_buf, cmd_len, 0, 0, 0)
    read_response(fd, buf, 0, peek64(buf + 24))  // read into pos 0, use cap
}

// Send a command built from args (each [addr, len] pair) and read response.
// args is a pointer to [n*2] i64 slots alternating [addr, len].
pub fn redis_command(buf: i64, fd: i64, n_args: i64, args: i64) -> i64 {
    // The encoder builds and returns its own buffer. Allocating an empty one here and
    // throwing the encoder's result away sent a zero-length write for every command.
    let encoded = enc_array_of_strings(n_args, args)
    let elen = bytes_len(encoded)
    sendto_sock(fd, encoded, elen, 0, 0, 0)
    read_response(fd, buf, 0, peek64(buf + 24))
}

//  CONVENIENCE COMMANDS 

// Helper: encode a C-string pointer into a slot in an items array.
fn ptr_to_item(items: i64, idx: i64, ptr: i64) {
    poke64(items + idx * 16, ptr)
    poke64(items + idx * 16 + 8, strlen(ptr))
}

// Send PING command.
pub fn redis_ping(fd: i64, buf: i64, items: i64) -> i64 {
    ptr_to_item(items, 0, "PING")
    redis_command(buf, fd, 1, items)
}

// Send GET key.
pub fn redis_get(fd: i64, buf: i64, items: i64, key: i64) -> i64 {
    add_cmd_arg(items, 0, "GET", 3)
    add_cmd_arg(items, 1, key, strlen(key))
    redis_command(buf, fd, 2, items)
}

// Send SET key value.
pub fn redis_set(fd: i64, buf: i64, items: i64, key: i64, value: i64) -> i64 {
    add_cmd_arg(items, 0, "SET", 3)
    add_cmd_arg(items, 1, key, strlen(key))
    add_cmd_arg(items, 2, value, strlen(value))
    redis_command(buf, fd, 3, items)
}

// Send SET key value EX seconds.
pub fn redis_setex(fd: i64, buf: i64, items: i64, key: i64, value: i64, secs: i64) -> i64 {
    let tmp[20]
    let slen = itoa(secs, tmp)
    add_cmd_arg(items, 0, "SET", 3)
    add_cmd_arg(items, 1, key, strlen(key))
    add_cmd_arg(items, 2, value, strlen(value))
    add_cmd_arg(items, 3, "EX", 2)
    poke64(items + 4 * 16, tmp)
    poke64(items + 4 * 16 + 8, slen)
    redis_command(buf, fd, 5, items)
}

// Send SETEX key seconds value.
pub fn redis_setex2(fd: i64, buf: i64, items: i64, key: i64, secs: i64, value: i64) -> i64 {
    let tmp[20]
    let slen = itoa(secs, tmp)
    add_cmd_arg(items, 0, "SETEX", 5)
    add_cmd_arg(items, 1, key, strlen(key))
    add_cmd_arg(items, 2, tmp, slen)
    add_cmd_arg(items, 3, value, strlen(value))
    redis_command(buf, fd, 4, items)
}

// Send GETSET key value.
pub fn redis_getset(fd: i64, buf: i64, items: i64, key: i64, value: i64) -> i64 {
    add_cmd_arg(items, 0, "GETSET", 6)
    add_cmd_arg(items, 1, key, strlen(key))
    add_cmd_arg(items, 2, value, strlen(value))
