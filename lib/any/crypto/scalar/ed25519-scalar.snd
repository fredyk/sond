// Ed25519 scalar arithmetic modulo the group order L = 2^252 + 27742317777372353535851937790883648493

let L[32] = [0xed, 0xd3, 0xf5, 0x5c, 0x1a, 0x63, 0x12, 0x58, 0xd6, 0x9c, 0xf7, 0xa2, 0xde, 0xf9, 0xde, 0x14, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x10]

fn ge32(a, b) -> i64 {
    let mut i = 31
    for i >= 0 {
        if a[i] != b[i] {
            if a[i] > b[i] {
                return 1
            }
            return 0
        }
        i = i - 1
    }
    return 1
}

fn sub32(a, b) {
    let mut borrow = 0
    let mut i = 0
    for i < 32 {
        let mut diff = a[i] - b[i] - borrow
        if diff < 0 {
            diff = diff + 256
            borrow = 1
        } else {
            borrow = 0
        }
        a[i] = diff
        i = i + 1
    }
}

fn mul64(r, a, b) {
    let mut i = 0
    for i < 64 {
        r[i] = 0
        i = i + 1
    }
    let mut i = 0
    for i < 32 {
        let mut j = 0
        for j < 32 {
            let prod = a[i] * b[j]
            let pos = i + j
            let mut sum = r[pos] + prod
            r[pos] = sum & 0xFF
            let mut carry = sum >> 8
            let mut k = 1
            for {
                if carry == 0 { break }
                sum = r[pos + k] + carry
                r[pos + k] = sum & 0xFF
                carry = sum >> 8
                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }
}

fn sc_reduce(out, inp) {
    let buf[64]
    let mut i = 0
    for i < 64 {
        buf[i] = peek8(inp + i)
        i = i + 1
    }
    let rem[32]
    let mut i = 0
    for i < 32 {
        rem[i] = 0
        i = i + 1
    }
    let mut bit = 511
    for bit >= 0 {
        let mut carry = 0
        let mut j = 0
        for j < 32 {
            let new = (rem[j] << 1) | carry
            carry = rem[j] >> 7
            rem[j] = new & 0xFF
            j = j + 1
        }
        let byte_idx = bit >> 3
        let bit_idx = bit & 7
        let input_bit = (buf[byte_idx] >> bit_idx) & 1
        rem[0] = rem[0] | input_bit
        if ge32(rem, L) != 0 {
            sub32(rem, L)
        }
        bit = bit - 1
    }
    let mut i = 0
    for i < 32 {
        poke8(out + i, rem[i] & 0xFF)
        i = i + 1
    }
}

fn sc_muladd(out, a, b, c) {
    let wa[32]
    let wb[32]
    let wc[32]
    let mut i = 0
    for i < 32 {
        wa[i] = peek8(a + i)
        wb[i] = peek8(b + i)
        wc[i] = peek8(c + i)
        i = i + 1
    }
    let prod[64]
    mul64(prod, wa, wb)
    let mut carry = 0
    let mut i = 0
    for i < 32 {
        let sum = prod[i] + wc[i] + carry
        prod[i] = sum & 0xFF
        carry = sum >> 8
        i = i + 1
    }
    let mut i = 32
    for i < 64 {
        let sum = prod[i] + carry
        prod[i] = sum & 0xFF
        carry = sum >> 8
        i = i + 1
    }
    let rem[32]
    let mut i = 0
    for i < 32 {
        rem[i] = 0
        i = i + 1
    }
    let mut bit = 511
    for bit >= 0 {
        let mut carry2 = 0
        let mut j = 0
        for j < 32 {
            let new = (rem[j] << 1) | carry2
            carry2 = rem[j] >> 7
            rem[j] = new & 0xFF
            j = j + 1
        }
        let byte_idx = bit >> 3
        let bit_idx = bit & 7
        let input_bit = (prod[byte_idx] >> bit_idx) & 1
        rem[0] = rem[0] | input_bit
        if ge32(rem, L) != 0 {
            sub32(rem, L)
        }
        bit = bit - 1
    }
    let mut i = 0
    for i < 32 {
        poke8(out + i, rem[i] & 0xFF)
        i = i + 1
    }
}
