fn cmp32(buf, exp) -> i64 {
    let mut i = 0
    for i < 32 {
        if peek8(buf + i) != exp[i] {
            return 0
        }
        i = i + 1
    }
    return 1
}

fn test_reduce(tnum, inp_arr, exp_arr, buf, out) -> i64 {
    let mut i = 0
    for i < 64 {
        poke8(buf + i, inp_arr[i])
        i = i + 1
    }
    sc_reduce(out, buf)
    let ok = cmp32(out, exp_arr)
    if ok == 0 {
        print("FAIL sc_reduce test")
        print_int(tnum)
    }
    return ok
}

fn test_muladd(tnum, a_arr, b_arr, c_arr, exp_arr, buf, out) -> i64 {
    let mut i = 0
    for i < 32 {
        poke8(buf + i, a_arr[i])
        poke8(buf + 32 + i, b_arr[i])
        poke8(buf + 64 + i, c_arr[i])
        i = i + 1
    }
    sc_muladd(out, buf, buf + 32, buf + 64)
    let ok = cmp32(out, exp_arr)
    if ok == 0 {
        print("FAIL sc_muladd test")
        print_int(tnum)
    }
    return ok
}

