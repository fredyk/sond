// Tests for lib/any/crypto/scalar/ed25519-scalar.snd: arithmetic modulo the group order
// L = 2^252 + 27742317777372353535851937790883648493.
//
// The six vectors the library used to carry inside itself are here, plus the boundaries they
// left out: L itself, L-1, and zero. Every expected value is `x mod L` computed independently.

include "any/crypto/scalar/ed25519-scalar.snd"
include "x86_64/linux/testing.snd"

