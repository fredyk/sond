let EXP_SEQ[32] = [0x7a, 0x3c, 0x62, 0x82, 0xf0, 0x2d, 0x37, 0xa0, 0x50, 0x23, 0xb6, 0x0d, 0x54, 0x28, 0xe6, 0xcc, 0x59, 0x61, 0xd4, 0xc3, 0x12, 0x21, 0x93, 0x7a, 0xda, 0xe0, 0xb5, 0x74, 0xe4, 0xd0, 0x72, 0x05]
let INP_FF[64] = [0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff]
let EXP_FF[32] = [0x00, 0x0f, 0x9c, 0x44, 0xe3, 0x11, 0x06, 0xa4, 0x47, 0x93, 0x85, 0x68, 0xa7, 0x1b, 0x0e, 0xd0, 0x65, 0xbe, 0xf5, 0x17, 0xd2, 0x73, 0xec, 0xce, 0x3d, 0x9a, 0x30, 0x7c, 0x1b, 0x41, 0x99, 0x03]
let INP_2P511[64] = [0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x80]
let EXP_2P511[32] = [0x77, 0xf1, 0xc8, 0xd0, 0x7e, 0x3a, 0x0c, 0xfe, 0x0e, 0x98, 0xbe, 0x05, 0xc3, 0x8a, 0x76, 0xf2, 0x32, 0xdf, 0xfa, 0x0b, 0xe9, 0x39, 0x76, 0xe7, 0x1e, 0x4d, 0x18, 0xbe, 0x8d, 0xa0, 0xcc, 0x09]
let INP_L[64] = [0xed, 0xd3, 0xf5, 0x5c, 0x1a, 0x63, 0x12, 0x58, 0xd6, 0x9c, 0xf7, 0xa2, 0xde, 0xf9, 0xde, 0x14, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x10, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]
let INP_LM1[64] = [0xec, 0xd3, 0xf5, 0x5c, 0x1a, 0x63, 0x12, 0x58, 0xd6, 0x9c, 0xf7, 0xa2, 0xde, 0xf9, 0xde, 0x14, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x10, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]
let ZERO32[32] = [0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]
let LM1[32] = [0xec, 0xd3, 0xf5, 0x5c, 0x1a, 0x63, 0x12, 0x58, 0xd6, 0x9c, 0xf7, 0xa2, 0xde, 0xf9, 0xde, 0x14, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x10]
let LM2[32] = [0xeb, 0xd3, 0xf5, 0x5c, 0x1a, 0x63, 0x12, 0x58, 0xd6, 0x9c, 0xf7, 0xa2, 0xde, 0xf9, 0xde, 0x14, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x10]
let LM3[32] = [0xea, 0xd3, 0xf5, 0x5c, 0x1a, 0x63, 0x12, 0x58, 0xd6, 0x9c, 0xf7, 0xa2, 0xde, 0xf9, 0xde, 0x14, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x10]
let ONE32[32] = [0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]
let TWO32[32] = [0x02, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]
let THREE32[32] = [0x03, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]
let FIVE32[32] = [0x05, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]

let mut buf[16]      // 128 bytes: enough for the 64-byte input and for three 32-byte operands
let mut out[4]       // 32 bytes
let mut wa[32]       // byte-per-word operands for ge32 / sub32
let mut wb[32]

fn load64(dst, src) {
    for i in 0..64 { poke8(dst + i, src[i]) }
}

fn load32(dst, src) {
    for i in 0..32 { poke8(dst + i, src[i]) }
}

fn same32(got, exp) -> i64 {
    for i in 0..32 {
        if peek8(got + i) != exp[i] { return 0 }
    }
    1
}

fn reduces_to(inp, exp) -> i64 {
    load64(buf, inp)
    sc_reduce(out, buf)
    same32(out, exp)
}

fn muladd_is(a, b, c, exp) -> i64 {
    load32(buf, a)
    load32(buf + 32, b)
    load32(buf + 64, c)
    sc_muladd(out, buf, buf + 32, buf + 64)
    same32(out, exp)
}

test "sc_reduce brings a 512-bit number down modulo L" {
    assert_eq(reduces_to(INP_SEQ, EXP_SEQ), 1)
    assert_eq(reduces_to(INP_FF, EXP_FF), 1)
    assert_eq(reduces_to(INP_2P511, EXP_2P511), 1)
}

test "sc_reduce sends L to zero and leaves L-1 alone" {
    // The boundary the three vectors above never touch: one below the order stays put, the
    // order itself is zero. A reduction that stops one subtraction short returns L here.
    assert_eq(reduces_to(INP_L, ZERO32), 1)
    assert_eq(reduces_to(INP_LM1, LM1), 1)
}

test "sc_muladd is a*b + c, and it wraps at L" {
    assert_eq(muladd_is(ONE32, TWO32, THREE32, FIVE32), 1)
    assert_eq(muladd_is(LM1, LM2, LM3, LM1), 1)
    assert_eq(muladd_is(LM1, LM1, LM1, ZERO32), 1)
    // With a zero factor the sum is just c, and with a zero addend just the product.
    assert_eq(muladd_is(ZERO32, LM1, THREE32, THREE32), 1)
    assert_eq(muladd_is(ONE32, ONE32, ZERO32, ONE32), 1)
}

test "ge32 compares from the top byte down" {
    for i in 0..32 { wa[i] = 0; wb[i] = 0 }
    assert_eq(ge32(wa, wb), 1)          // equal counts as greater-or-equal
    wa[0] = 1
    assert_eq(ge32(wa, wb), 1)
    assert_eq(ge32(wb, wa), 0)
    // A big low byte must not outweigh a difference higher up: the loop runs from byte 31 down.
    wa[0] = 0xFF; wa[31] = 0
    wb[0] = 0; wb[31] = 1
    assert_eq(ge32(wa, wb), 0)
    assert_eq(ge32(wb, wa), 1)
}

test "sub32 borrows across every byte it has to" {
    for i in 0..32 { wa[i] = 0; wb[i] = 0 }
    wa[31] = 1                          // 2^248
    wb[0] = 1
    sub32(wa, wb)                       // 2^248 - 1: every byte below the top becomes 0xFF
    assert_eq(wa[31], 0)
    for i in 0..31 { assert_eq(wa[i], 0xFF) }
    // And a subtraction with nothing to borrow leaves the bytes as they were.
    for i in 0..32 { wa[i] = 0; wb[i] = 0 }
    wa[0] = 5; wb[0] = 3
    sub32(wa, wb)
    assert_eq(wa[0], 2)
    for i in 1..32 { assert_eq(wa[i], 0) }
}

test "mul64 spreads a product across the 64 bytes of the result" {
    let mut r[64]
    for i in 0..32 { wa[i] = 0; wb[i] = 0 }
    wa[0] = 0xFF; wb[0] = 0xFF
    mul64(r, wa, wb)
    assert_eq(r[0], 0x01)               // 0xFF * 0xFF = 0xFE01
    assert_eq(r[1], 0xFE)
    for i in 2..64 { assert_eq(r[i], 0) }
    // A carry that has to travel: 2^248 * 2^248 = 2^496, byte 62.
    for i in 0..32 { wa[i] = 0; wb[i] = 0 }
    wa[31] = 1; wb[31] = 1
    mul64(r, wa, wb)
    assert_eq(r[62], 1)
    for i in 0..62 { assert_eq(r[i], 0) }
    assert_eq(r[63], 0)
}
