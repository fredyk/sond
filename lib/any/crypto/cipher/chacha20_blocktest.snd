//
// lib/any/crypto/cipher/chacha20_blocktest.snd: ChaCha20 block test against RFC 8439 §2.3.2.
// Tests using Sond's `test` block model with official test vectors.

include "x86_64/linux/testing.snd"
include "any/crypto/cipher/chacha20.snd"

// Expected keystream for RFC 8439 §2.3.2 (64 bytes = 128 hex chars).
let _exp_keystream: i64
// Expected ciphertext for RFC 8439 §2.4.2 (114 bytes).
let _exp_ct: i64

// Helper: decode hex char '0'-'9','a'-'f','A'-'F' -> i64 value 0..15.
fn hexval(c: i64) -> i64 {
    if c >= 48 && c <= 57 { return c - 48 }       // 0-9
    if c >= 97 && c <= 102 { return c - 87 }      // a-f
    c - 55                                         // A-F
}

// Compare buf[0..n] byte-by-byte with hexstr (2 chars per byte, mod 0xXXXXXXXX).
// Returns same value as eq_hex from the old tests.
fn eq_hex(buf: i64, n: i64, hexstr: i64) -> i64 {
    let mut i = 0
    for i < n {
        let hi = hexval(peek8(hexstr + i * 2))
        let lo = hexval(peek8(hexstr + i * 2 + 1))
        if peek8(buf + i) != (hi * 16 + lo) {
            return 0
        }
        i = i + 1
    }
    1
}

// Run chacha20_block with RFC 8439 §2.3.2 key/nonce/counter and verify output.
fn run_keystream_check() -> i64 {
    _exp_keystream = cstr("10f1e7e4d13b5915500fdd1fa32071c4c7d1f4c733c068030422aa9ac3d46c4ed2826446079faa0914c2d705d98b02a2b5129cd1de164eb9cbd083e8a2503c4e")

    let key[32]
    poke8(key + 0, 0)
    poke8(key + 1, 1)
    poke8(key + 2, 2)
    poke8(key + 3, 3)
    poke8(key + 4, 4)
    poke8(key + 5, 5)
    poke8(key + 6, 6)
    poke8(key + 7, 7)
    poke8(key + 8, 8)
    poke8(key + 9, 9)
    poke8(key + 10, 10)
    poke8(key + 11, 11)
    poke8(key + 12, 12)
    poke8(key + 13, 13)
    poke8(key + 14, 14)
    poke8(key + 15, 15)
    poke8(key + 16, 16)
    poke8(key + 17, 17)
    poke8(key + 18, 18)
    poke8(key + 19, 19)
    poke8(key + 20, 20)
    poke8(key + 21, 21)
    poke8(key + 22, 22)
    poke8(key + 23, 23)
    poke8(key + 24, 24)
    poke8(key + 25, 25)
    poke8(key + 26, 26)
    poke8(key + 27, 27)
    poke8(key + 28, 28)
    poke8(key + 29, 29)
    poke8(key + 30, 30)
    poke8(key + 31, 31)

    let nonce[12]
    poke8(nonce + 0, 0)
    poke8(nonce + 1, 0)
    poke8(nonce + 2, 0)
    poke8(nonce + 3, 9)
    poke8(nonce + 4, 0)
    poke8(nonce + 5, 0)
    poke8(nonce + 6, 0)
    poke8(nonce + 7, 74)   // 0x4a
    poke8(nonce + 8, 0)
    poke8(nonce + 9, 0)
    poke8(nonce + 10, 0)
    poke8(nonce + 11, 0)

    let out[64]
    chacha20_block(key, nonce, 1, out)

    if eq_hex(out, 64, _exp_keystream) != 1 {
        return 1
    }
    0
}

// Encrypt/decrypt roundtrip for RFC 8439 §2.4.2.
fn run_roundtrip_check() -> i64 {
    _exp_ct = cstr("6e2e359a2568f98041ba0728dd0d6981e97e7aec1d4360c20a27afccfd9fae0bf91b65c5524733ab8f593dabcd62b3571639d624e65152ab8f530c359f0861d807ca0dbf500d6a6156a38e088a22b65e52bc514d16ccf806818ce91ab77937365af90bbf74a35be6b40b8eedf2785e42874d")

    let key[32]
    let mut i = 0
    for i < 32 { poke8(key + i, i); i = i + 1 }

    let nonce[12]
    i = 0
    for i < 12 { poke8(nonce + i, 0); i = i + 1 }
    poke8(nonce + 7, 74)   // 0x4a

    let pt = cstr("Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it.")
    let n = 114

    let ct[65]

    chacha20_xor(key, nonce, 1, pt, ct, n)

    if eq_hex(ct, 114, _exp_ct) != 1 {
        return 1
    }

    // Inverse: XOR again must recover plaintext.
    let back[65]
    chacha20_xor(key, nonce, 1, ct, back, n)

    i = 0
    for i < 114 {
        if peek8(back + i) != peek8(pt + i) {
            return 1
        }
        i = i + 1
    }
    0
}

// Test with counter=0 (different from official §2.3.2 which uses counter=1).
fn run_counter_zero_check() -> i64 {
    let exp_keystream = cstr("10f1e7e4d13b5915500fdd1fa32071c4c7d1f4c733c068030422aa9ac3d46c4ed2826446079faa0914c2d705d98b02a2b5129cd1de164eb9cbd083e8a2503c4e")

    let key[32]
    let mut i = 0
    for i < 32 { poke8(key + i, i); i = i + 1 }

    let nonce[12]
    i = 0
    for i < 12 { poke8(nonce + i, 0); i = i + 1 }
    poke8(nonce + 3, 9)
    poke8(nonce + 7, 74)   // 0x4a

    let ks1[64]
    chacha20_block(key, nonce, 1, ks1)
    let ks2[64]
    chacha20_block(key, nonce, 2, ks2)
    let ks3[64]
    chacha20_block(key, nonce, 3, ks3)

    // Each unique counter produces different keystream.
    i = 0
    for i < 64 {
        if peek8(ks1 + i) != peek8(ks2 + i) {
            break
        }
        i = i + 1
    }
    if i >= 64 {
        return 1
    }

    i = 0
    for i < 64 {
        if peek8(ks2 + i) != peek8(ks3 + i) {
            break
        }
        i = i + 1
    }
    if i >= 64 {
        return 1
    }

    // First 16 bytes of keystream at counter=1 should match the official vector.
    if eq_hex(ks1, 16, exp_keystream) != 1 {
        return 1
    }

    0
}

test "rfc8439 §2.3.2, block keystream" {
    assert_eq(run_keystream_check(), 0)
}

test "rfc8439 §2.4.2, encrypt/decrypt roundtrip" {
    assert_eq(run_roundtrip_check(), 0)
}

test "different counters produce different keystream blocks" {
    assert_eq(run_counter_zero_check(), 0)
}