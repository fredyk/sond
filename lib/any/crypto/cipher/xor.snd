//
// lib/any/crypto/cipher/xor.snd: a reusable repeating-key XOR stream cipher.
// Portable (arch: any). Include with: include "any/crypto/cipher/xor.snd".
// xor_crypt XORs `len` bytes at `buf` in place with the `keylen`-byte key at `key`;
// calling it twice with the same key is a round-trip (encrypt then decrypt).
pub fn xor_crypt(buf, len, key, keylen) -> i64 {
    let mut i = 0
    for i < len {
        let k = peek8(key + (i % keylen))
        poke8(buf + i, peek8(buf + i) ^ k)
        i = i + 1
    }
    0
}
