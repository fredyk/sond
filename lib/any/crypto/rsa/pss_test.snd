//
// Test of pss.snd against a real openssl-generated RSA-PSS(SHA-256) signature.

include "any/crypto/rsa/pss.snd"
include "x86_64/linux/testing.snd"

let PSS_N = ""
let PSS_SIG = ""
let PSS_HASH = "1100e3288a110523a217e22b3d35d1f0eafd2556a1cf6d476379f9ffe0890fc4"
let mut p_n[256]
let mut p_sig[256]
let mut p_hash[32]

fn phex(c: i64) -> i64 {
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 97 && c <= 102 { return c - 87 }
    c - 55
}
fn pload(hex: i64, dst: i64, n: i64) {
    let mut i = 0
    for i < n {
        poke8(dst + i, phex(peek8(hex + i * 2)) * 16 + phex(peek8(hex + i * 2 + 1)))
        i = i + 1
    }
}

test "rsa-pss: a real openssl RSA-PSS SHA-256 signature verifies; tampering fails" {
    pload(PSS_N, p_n, 256)
    pload(PSS_SIG, p_sig, 256)
    pload(PSS_HASH, p_hash, 32)
    assert_eq(rsa_pss_sha256_verify(p_n, p_sig, p_hash), 1)
    // a flipped signature byte must fail
    poke8(p_sig + 10, peek8(p_sig + 10) ^ 1)
    assert_eq(rsa_pss_sha256_verify(p_n, p_sig, p_hash), 0)
    // the right signature over a different hash must fail
    pload(PSS_SIG, p_sig, 256)
    poke8(p_hash + 0, peek8(p_hash + 0) ^ 1)
    assert_eq(rsa_pss_sha256_verify(p_n, p_sig, p_hash), 0)
}
