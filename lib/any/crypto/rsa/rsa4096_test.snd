//
// Tests for rsa/rsa4096.snd: the 128-limb bignum primitives in isolation and an
// end-to-end RSA-4096 PKCS#1 v1.5 (SHA-256) signature verification against a real
// vector generated with openssl. Run:
//   sond test lib/any/crypto/rsa/rsa4096_test.snd

include "any/crypto/rsa/rsa4096.snd"
include "x86_64/linux/testing.snd"

// Byte buffers for the 512-byte (4096-bit) modulus, signature and the decoded hash.
let mut t_n[520]
let mut t_sig[520]
let mut t_hash[40]

// Bignum scratch (128 limbs of 32 bits each).
let mut ba[128]
let mut bb[128]
let mut bn[128]
let mut bout[128]

// The numeric value of one hex digit, or -1 if not a hex digit.
fn hexval(c: i64) -> i64 {
    if c >= 48 && c <= 57 { return c - 48 }       // 0-9
    if c >= 97 && c <= 102 { return c - 87 }      // a-f
    if c >= 65 && c <= 70 { return c - 55 }       // A-F
    0 - 1
}

// Decode a NUL-terminated hex string into `out`; returns the number of bytes written.
fn hexdecode(hexstr: i64, out: i64) -> i64 {
    let mut i = 0
    let mut o = 0
    for peek8(hexstr + i) != 0 {
        let hi = hexval(peek8(hexstr + i))
        let lo = hexval(peek8(hexstr + i + 1))
        poke8(out + o, (hi << 4) | lo)
        i = i + 2
        o = o + 1
    }
    o
}

// Zero a 128-limb bignum.
fn bn_zero(a: i64) {
    let mut i = 0
    for i < 128 { a[i] = 0; i = i + 1 }
}

test "hexdecode: parses a byte string" {
    let n = hexdecode("00010aff", t_hash)
    assert_eq(n, 4)
    assert_eq(peek8(t_hash + 0), 0x00)
    assert_eq(peek8(t_hash + 1), 0x01)
    assert_eq(peek8(t_hash + 2), 0x0a)
    assert_eq(peek8(t_hash + 3), 0xff)
}

test "bn_from_bytes / bn_to_bytes: big-endian round trip" {
    // 512 bytes: 0x01 at the most-significant byte, 0xAB at the least-significant.
    let mut i = 0
    for i < 512 { poke8(t_n + i, 0); i = i + 1 }
    poke8(t_n + 0, 0x01)      // most-significant byte
    poke8(t_n + 511, 0xAB)    // least-significant byte
    bn_from_bytes(t_n, ba)
    assert_eq(ba[0], 0xAB)              // least significant limb
    assert_eq(ba[127], 0x01000000)     // most significant limb
    // round trip back to bytes
    bn_to_bytes(ba, t_sig)
    assert_eq(peek8(t_sig + 0), 0x01)
    assert_eq(peek8(t_sig + 511), 0xAB)
    i = 1
    for i < 511 { assert_eq(peek8(t_sig + i), 0); i = i + 1 }
}

test "bn_cmp: orders bignums by magnitude" {
    bn_zero(ba); bn_zero(bb)
    ba[0] = 5; bb[0] = 7
    assert_eq(bn_cmp(ba, bb), 0 - 1)
    assert_eq(bn_cmp(bb, ba), 1)
    assert_eq(bn_cmp(ba, ba), 0)
    // high limb dominates
    bb[0] = 0; bb[5] = 1
    assert_eq(bn_cmp(ba, bb), 0 - 1)
}

test "bn_mulmod: 7 * 6 mod 10 == 2" {
    bn_zero(ba); bn_zero(bb); bn_zero(bn); bn_zero(bout)
    ba[0] = 7; bb[0] = 6; bn[0] = 10
    bn_mulmod(ba, bb, bn, bout)
    assert_eq(bout[0], 2)
    let mut i = 1
    for i < 128 { assert_eq(bout[i], 0); i = i + 1 }
}

test "bn_mulmod: multi-limb (2^40+123)*(2^40+456) mod (2^64+7)" {
    bn_zero(ba); bn_zero(bb); bn_zero(bn); bn_zero(bout)
    ba[0] = 123; ba[1] = 256      // 2^40 + 123
    bb[0] = 456; bb[1] = 256      // 2^40 + 456
    bn[0] = 7; bn[2] = 1          // 2^64 + 7
    bn_mulmod(ba, bb, bn, bout)
    assert_eq(bout[0], 4294564632)
    assert_eq(bout[1], 148223)
    assert_eq(bout[2], 0)
}

test "bn_modexp_65537: 4^65537 mod 1000000007 == 502620676" {
    bn_zero(ba); bn_zero(bn); bn_zero(bout)
    ba[0] = 4; bn[0] = 1000000007
    bn_modexp_65537(ba, bn, bout)
    assert_eq(bout[0], 502620676)
    let mut i = 1
    for i < 128 { assert_eq(bout[i], 0); i = i + 1 }
}

test "bn_modexp_65537: 123456^65537 mod 4294967311 == 227596699" {
    bn_zero(ba); bn_zero(bn); bn_zero(bout)
    ba[0] = 123456
    bn[0] = 15; bn[1] = 1         // 4294967311 = 2^32 + 15
    bn_modexp_65537(ba, bn, bout)
    assert_eq(bout[0], 227596699)
    assert_eq(bout[1], 0)
}

// ── End-to-end: a real RSA-4096 PKCS#1 v1.5 (SHA-256) signature ──
// n, sig and the SHA-256 hash generated with openssl; verify must be 1, and
// flipping a single signature or hash byte must make it 0.

let N_HEX = ""

let SIG_HEX = ""

let HASH_HEX = "84d7529dd62accf7fe71badaefc5ef2ad5df824d7e81df59d1848c9e7402fc06"

test "rsa pkcs1v15 sha256 4096: real vector verifies to 1" {
    assert_eq(hexdecode(N_HEX, t_n), 512)
    assert_eq(hexdecode(SIG_HEX, t_sig), 512)
    assert_eq(hexdecode(HASH_HEX, t_hash), 32)
    assert_eq(rsa_pkcs1v15_sha256_verify_4096(t_n, t_sig, t_hash), 1)
}

test "rsa pkcs1v15 sha256 4096: a tampered signature verifies to 0" {
    hexdecode(N_HEX, t_n)
    hexdecode(SIG_HEX, t_sig)
    hexdecode(HASH_HEX, t_hash)
    // flip one byte of the signature
    poke8(t_sig + 100, peek8(t_sig + 100) ^ 0x01)
    assert_eq(rsa_pkcs1v15_sha256_verify_4096(t_n, t_sig, t_hash), 0)
}

test "rsa pkcs1v15 sha256 4096: a wrong hash verifies to 0" {
    hexdecode(N_HEX, t_n)
    hexdecode(SIG_HEX, t_sig)
    hexdecode(HASH_HEX, t_hash)
    // corrupt the expected hash
    poke8(t_hash + 0, peek8(t_hash + 0) ^ 0x80)
    assert_eq(rsa_pkcs1v15_sha256_verify_4096(t_n, t_sig, t_hash), 0)
}

// A second independent openssl vector (different key and message), so a subtle bignum bug
// cannot pass both.
let N2_HEX = ""
let SIG2_HEX = ""
let HASH2_HEX = "f2348c008d36598eb7686a38abca0f399cfa03cc4c50405ca0ce59e1db6d4d7b"

test "rsa pkcs1v15 sha256 4096: a second independent real vector verifies to 1" {
    assert_eq(hexdecode(N2_HEX, t_n), 512)
    assert_eq(hexdecode(SIG2_HEX, t_sig), 512)
    assert_eq(hexdecode(HASH2_HEX, t_hash), 32)
    assert_eq(rsa_pkcs1v15_sha256_verify_4096(t_n, t_sig, t_hash), 1)
    // the first vector's signature must NOT verify under this key
    hexdecode(SIG_HEX, t_sig)
    assert_eq(rsa_pkcs1v15_sha256_verify_4096(t_n, t_sig, t_hash), 0)
}

// A SHA-384 signature over the SAME key (N_HEX): exercises rsa_pkcs1v15_sha384_verify_4096.
let SIG384_HEX = ""
let HASH384_HEX = "899429f0d3e4c4e4104ad0b63873b286ab550ae4db0f1909e49b0b09de3cb236aefe7abcf55fc595a7627081c026266d"

test "rsa pkcs1v15 sha384 4096: real vector verifies to 1, tampered to 0" {
    assert_eq(hexdecode(N_HEX, t_n), 512)
    assert_eq(hexdecode(SIG384_HEX, t_sig), 512)
    assert_eq(hexdecode(HASH384_HEX, t_hash), 48)
    assert_eq(rsa_pkcs1v15_sha384_verify_4096(t_n, t_sig, t_hash), 1)
    poke8(t_sig + 200, peek8(t_sig + 200) ^ 0x01)
    assert_eq(rsa_pkcs1v15_sha384_verify_4096(t_n, t_sig, t_hash), 0)
    // the SHA-256 signature must NOT verify as SHA-384 (different DigestInfo/hash length)
    hexdecode(SIG_HEX, t_sig)
    hexdecode(HASH_HEX, t_hash)
    assert_eq(rsa_pkcs1v15_sha384_verify_4096(t_n, t_sig, t_hash), 0)
    // a well-formed signature but the wrong expected digest fails at the hash comparison
    hexdecode(SIG384_HEX, t_sig)
    hexdecode(HASH384_HEX, t_hash)
    poke8(t_hash + 47, peek8(t_hash + 47) ^ 0x01)
    assert_eq(rsa_pkcs1v15_sha384_verify_4096(t_n, t_sig, t_hash), 0)
}
