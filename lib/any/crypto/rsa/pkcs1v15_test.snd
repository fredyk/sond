//
// Tests for rsa/pkcs1v15.snd: the bignum primitives in isolation and an end-to-end
// RSA-2048 PKCS#1 v1.5 (SHA-256) signature verification against a real vector
// generated locally with openssl. Run:
//   sond test lib/any/crypto/rsa/pkcs1v15_test.snd

include "any/crypto/rsa/pkcs1v15.snd"
include "x86_64/linux/testing.snd"

// Byte buffers for the 256-byte (2048-bit) modulus, signature and the decoded hash.
let mut t_n[260]
let mut t_sig[260]
let mut t_hash[40]

// Bignum scratch (64 limbs of 32 bits each).
let mut ba[64]
let mut bb[64]
let mut bn[64]
let mut bout[64]

// The 6-bit... value of one hex digit.
fn hexval(c: i64) -> i64 {
    if c >= 48 && c <= 57 { return c - 48 }       // 0-9
    if c >= 97 && c <= 102 { return c - 87 }      // a-f
    if c >= 65 && c <= 70 { return c - 55 }       // A-F
    0 - 1
}

// Decode a NUL-terminated hex string into `out`; returns the number of bytes written.
fn hexdecode(hexstr: i64, out: i64) -> i64 {
    let mut i = 0
    let mut o = 0
    for peek8(hexstr + i) != 0 {
        let hi = hexval(peek8(hexstr + i))
        let lo = hexval(peek8(hexstr + i + 1))
        poke8(out + o, (hi << 4) | lo)
        i = i + 2
        o = o + 1
    }
    o
}

// Zero a 64-limb bignum.
fn rbn_zero(a: i64) {
    let mut i = 0
    for i < 64 { a[i] = 0; i = i + 1 }
}

test "hexdecode: parses a byte string" {
    let n = hexdecode("00010aff", t_hash)
    assert_eq(n, 4)
    assert_eq(peek8(t_hash + 0), 0x00)
    assert_eq(peek8(t_hash + 1), 0x01)
    assert_eq(peek8(t_hash + 2), 0x0a)
    assert_eq(peek8(t_hash + 3), 0xff)
}

test "rbn_from_bytes / rbn_to_bytes: big-endian round trip" {
    // 256 bytes: 0x01 followed by zeros -> value = 2^2040; low limb 0, top limb has 0x01<<24.
    let mut i = 0
    for i < 256 { poke8(t_n + i, 0); i = i + 1 }
    poke8(t_n + 0, 0x01)      // most-significant byte
    poke8(t_n + 255, 0xAB)    // least-significant byte
    rbn_from_bytes(t_n, ba)
    assert_eq(ba[0], 0xAB)              // least significant limb
    assert_eq(ba[63], 0x01000000)      // most significant limb
    // round trip back to bytes
    rbn_to_bytes(ba, t_sig)
    assert_eq(peek8(t_sig + 0), 0x01)
    assert_eq(peek8(t_sig + 255), 0xAB)
    i = 1
    for i < 255 { assert_eq(peek8(t_sig + i), 0); i = i + 1 }
}

test "rbn_cmp: orders bignums by magnitude" {
    rbn_zero(ba); rbn_zero(bb)
    ba[0] = 5; bb[0] = 7
    assert_eq(rbn_cmp(ba, bb), 0 - 1)
    assert_eq(rbn_cmp(bb, ba), 1)
    assert_eq(rbn_cmp(ba, ba), 0)
    // high limb dominates
    bb[0] = 0; bb[5] = 1
    assert_eq(rbn_cmp(ba, bb), 0 - 1)
}

test "rbn_mulmod: 7 * 6 mod 10 == 2" {
    rbn_zero(ba); rbn_zero(bb); rbn_zero(bn); rbn_zero(bout)
    ba[0] = 7; bb[0] = 6; bn[0] = 10
    rbn_mulmod(ba, bb, bn, bout)
    assert_eq(bout[0], 2)
    let mut i = 1
    for i < 64 { assert_eq(bout[i], 0); i = i + 1 }
}

test "rbn_mulmod: multi-limb (2^40+123)*(2^40+456) mod (2^64+7)" {
    rbn_zero(ba); rbn_zero(bb); rbn_zero(bn); rbn_zero(bout)
    ba[0] = 123; ba[1] = 256      // 2^40 + 123
    bb[0] = 456; bb[1] = 256      // 2^40 + 456
    bn[0] = 7; bn[2] = 1          // 2^64 + 7
    rbn_mulmod(ba, bb, bn, bout)
    assert_eq(bout[0], 4294564632)
    assert_eq(bout[1], 148223)
    assert_eq(bout[2], 0)
}

test "rbn_modexp_65537: 4^65537 mod 1000000007 == 502620676" {
    rbn_zero(ba); rbn_zero(bn); rbn_zero(bout)
    ba[0] = 4; bn[0] = 1000000007
    rbn_modexp_65537(ba, bn, bout)
    assert_eq(bout[0], 502620676)
    let mut i = 1
    for i < 64 { assert_eq(bout[i], 0); i = i + 1 }
}

test "rbn_modexp_65537: 123456^65537 mod 4294967311 == 227596699" {
    rbn_zero(ba); rbn_zero(bn); rbn_zero(bout)
    ba[0] = 123456
    bn[0] = 15; bn[1] = 1         // 4294967311 = 2^32 + 15
    rbn_modexp_65537(ba, bn, bout)
    assert_eq(bout[0], 227596699)
    assert_eq(bout[1], 0)
}

// ── End-to-end: a real RSA-2048 PKCS#1 v1.5 (SHA-256) signature ──
// n, sig and the SHA-256 hash generated locally with openssl; verify must be 1,
// and flipping a single signature byte must make it 0.

let N_HEX = ""

let SIG_HEX = ""

let HASH_HEX = "74e307e74ea4f582a9da92e99ef22f583594c084dd53d3b3ca823d9218b4ae85"

test "rsa pkcs1v15 sha256: real vector verifies to 1" {
    assert_eq(hexdecode(N_HEX, t_n), 256)
    assert_eq(hexdecode(SIG_HEX, t_sig), 256)
    assert_eq(hexdecode(HASH_HEX, t_hash), 32)
    assert_eq(rsa_pkcs1v15_sha256_verify(t_n, t_sig, t_hash), 1)
}

test "rsa pkcs1v15 sha256: a tampered signature verifies to 0" {
    hexdecode(N_HEX, t_n)
    hexdecode(SIG_HEX, t_sig)
    hexdecode(HASH_HEX, t_hash)
    // flip one byte of the signature
    poke8(t_sig + 100, peek8(t_sig + 100) ^ 0x01)
    assert_eq(rsa_pkcs1v15_sha256_verify(t_n, t_sig, t_hash), 0)
}

test "rsa pkcs1v15 sha256: a wrong hash verifies to 0" {
    hexdecode(N_HEX, t_n)
    hexdecode(SIG_HEX, t_sig)
    hexdecode(HASH_HEX, t_hash)
    // corrupt the expected hash
    poke8(t_hash + 0, peek8(t_hash + 0) ^ 0x80)
    assert_eq(rsa_pkcs1v15_sha256_verify(t_n, t_sig, t_hash), 0)
}
