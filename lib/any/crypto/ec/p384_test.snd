// Tests for ECDSA P-384 verification and its underlying bignum layer.
// The ECDSA anchor is a real signature generated locally with OpenSSL.

include "any/crypto/ec/p384.snd"
include "x86_64/linux/testing.snd"

// ---- Bignum unit tests -----------------------------------------------------

test "bignum: mulmod of a small product stays exact" {
    let mut a[24]
    bn_set_small(a, 12345)
    let mut b[24]
    bn_set_small(b, 6789)
    let mut got[24]
    bn_mulmod(a, b, P384_P, got)
    let mut want[24]
    bn_set_small(want, 83810205)
    assert_eq(bn_cmp(got, want), 0)
}

test "bignum: (n-1)^2 mod n == 1" {
    let mut one[24]
    bn_set_small(one, 1)
    let mut nm1[24]
    bn_sub_n(P384_N, one, nm1, 24)
    let mut got[24]
    bn_mulmod(nm1, nm1, P384_N, got)
    assert_eq(bn_cmp(got, one), 0)
}

test "bignum: addmod wraps ((p-1)+3) mod p == 2" {
    let mut one[24]
    bn_set_small(one, 1)
    let mut pm1[24]
    bn_sub_n(P384_P, one, pm1, 24)
    let mut three[24]
    bn_set_small(three, 3)
    let mut got[24]
    bn_addmod(pm1, three, P384_P, got)
    let mut want[24]
    bn_set_small(want, 2)
    assert_eq(bn_cmp(got, want), 0)
}

test "bignum: submod borrows (3-5) mod p == p-2" {
    let mut three[24]
    bn_set_small(three, 3)
    let mut five[24]
    bn_set_small(five, 5)
    let mut got[24]
    bn_submod(three, five, P384_P, got)
    let mut two[24]
    bn_set_small(two, 2)
    let mut want[24]
    bn_sub_n(P384_P, two, want, 24)
    assert_eq(bn_cmp(got, want), 0)
}

test "bignum: invmod gives a * a^-1 mod p == 1" {
    let mut a[24]
    bn_set_small(a, 123456789)
    let mut inv[24]
    bn_invmod(a, P384_P, inv)
    let mut got[24]
    bn_mulmod(a, inv, P384_P, got)
    let mut one[24]
    bn_set_small(one, 1)
    assert_eq(bn_cmp(got, one), 0)
}

test "bignum: from_bytes / to_bytes round trip" {
    let mut buf[6]
    let mut i = 0
    for i < 48 { poke8(buf + i, (7 * i + 3) & 0xFF); i = i + 1 }
    let mut v[24]
    bn_from_bytes(v, buf)
    let mut out[6]
    bn_to_bytes(out, v)
    i = 0
    for i < 48 { assert_eq(peek8(out + i), (7 * i + 3) & 0xFF); i = i + 1 }
}

// ---- ECDSA anchor (real OpenSSL-generated P-384 signature) ----------------

let QX_W[48] = [
    153, 77, 168, 24, 230, 53, 164, 11, 21, 84, 50, 142, 81, 84, 116, 14, 122, 248, 147, 56, 61, 225, 94, 175, 160, 61, 101, 164, 215, 81, 89, 81, 56, 178, 153, 227, 144, 113, 81, 137, 188, 129, 240, 245, 149, 207, 212, 55
]
let QY_W[48] = [
    243, 10, 83, 100, 120, 196, 127, 181, 222, 91, 182, 93, 19, 148, 207, 126, 145, 159, 120, 9, 215, 219, 227, 193, 76, 169, 98, 125, 15, 63, 163, 25, 251, 42, 120, 242, 177, 226, 153, 1, 131, 144, 91, 198, 116, 177, 80, 165
]
let E_W[48] = [
    88, 217, 184, 9, 51, 222, 52, 179, 132, 80, 82, 28, 174, 23, 222, 160, 130, 9, 161, 230, 65, 14, 163, 92, 227, 18, 52, 224, 15, 249, 215, 108, 166, 63, 75, 172, 189, 68, 50, 12, 224, 153, 56, 204, 241, 58, 1, 161
]
let R_W[48] = [
    70, 181, 127, 18, 13, 55, 241, 187, 240, 201, 156, 206, 171, 1, 47, 206, 129, 153, 167, 128, 253, 30, 22, 110, 167, 22, 246, 121, 231, 211, 141, 187, 241, 15, 166, 5, 162, 159, 106, 194, 64, 145, 22, 252, 15, 79, 37, 125
]
let S_W[48] = [
    209, 128, 68, 219, 176, 221, 181, 7, 230, 136, 33, 134, 40, 77, 37, 61, 188, 165, 30, 145, 191, 170, 164, 116, 73, 142, 67, 246, 197, 156, 144, 63, 251, 21, 48, 96, 42, 183, 153, 152, 56, 246, 198, 242, 135, 128, 175, 162
]

// Pack a 48-word (one byte per word) source into a 48-byte packed buffer.
fn pack48(dst: i64, src: i64) {
    let mut i = 0
    for i < 48 { poke8(dst + i, src[i]); i = i + 1 }
}

let mut qx_buf[6]
let mut qy_buf[6]
let mut e_buf[6]
let mut r_buf[6]
let mut s_buf[6]

test "ecdsa: the real P-384 signature verifies" {
    pack48(qx_buf, QX_W)
    pack48(qy_buf, QY_W)
    pack48(e_buf, E_W)
    pack48(r_buf, R_W)
    pack48(s_buf, S_W)
    assert_eq(ecdsa_verify_p384(qx_buf, qy_buf, e_buf, r_buf, s_buf), 1)
}

test "ecdsa: a tampered r is rejected" {
    pack48(qx_buf, QX_W)
    pack48(qy_buf, QY_W)
    pack48(e_buf, E_W)
    pack48(r_buf, R_W)
    pack48(s_buf, S_W)
    // Flip one byte of r.
    poke8(r_buf + 5, peek8(r_buf + 5) ^ 1)
    assert_eq(ecdsa_verify_p384(qx_buf, qy_buf, e_buf, r_buf, s_buf), 0)
}

test "ecdsa: a zero s is rejected" {
    pack48(qx_buf, QX_W)
    pack48(qy_buf, QY_W)
    pack48(e_buf, E_W)
    pack48(r_buf, R_W)
    let mut i = 0
    for i < 48 { poke8(s_buf + i, 0); i = i + 1 }
    assert_eq(ecdsa_verify_p384(qx_buf, qy_buf, e_buf, r_buf, s_buf), 0)
}

// Two more independent OpenSSL-generated signatures (different keys and messages), so a
// subtle bug that happened to pass one vector cannot pass all three.
let QX2[48] = [
    94, 79, 189, 89, 156, 26, 128, 210, 92, 150, 10, 86, 183, 220, 129, 202, 111, 181, 110, 221, 169, 38, 96, 87, 65, 63, 43, 81, 33, 21, 30, 48, 25, 90, 151, 175, 34, 207, 224, 161, 114, 36, 109, 31, 248, 120, 166, 156
]
