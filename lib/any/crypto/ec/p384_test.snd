test "ecdsa: a second independent P-384 signature verifies" {
    pack48(qx_buf, QX2)
    pack48(qy_buf, QY2)
    pack48(e_buf, E2)
    pack48(r_buf, R2)
    pack48(s_buf, S2)
    assert_eq(ecdsa_verify_p384(qx_buf, qy_buf, e_buf, r_buf, s_buf), 1)
}

test "ecdsa: a third independent P-384 signature verifies" {
    pack48(qx_buf, QX3)
    pack48(qy_buf, QY3)
    pack48(e_buf, E3)
    pack48(r_buf, R3)
    pack48(s_buf, S3)
    assert_eq(ecdsa_verify_p384(qx_buf, qy_buf, e_buf, r_buf, s_buf), 1)
}
