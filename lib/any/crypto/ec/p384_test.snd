    182, 53, 122, 159, 255, 31, 252, 11, 181, 205, 250, 177, 134, 51, 70, 160, 183, 212, 187, 100, 72, 226, 91, 37, 139, 228, 36, 210, 59, 129, 213, 143, 179, 210, 74, 144, 165, 80, 197, 131, 178, 15, 205, 202, 153, 80, 174, 242
]
let S2[48] = [
    184, 139, 64, 219, 232, 236, 34, 200, 254, 97, 161, 61, 182, 51, 169, 227, 161, 236, 206, 66, 222, 216, 185, 226, 123, 62, 65, 4, 158, 174, 26, 34, 82, 145, 231, 119, 193, 134, 174, 172, 91, 189, 228, 54, 125, 187, 174, 39
]
let QX3[48] = [
    158, 116, 141, 206, 77, 60, 61, 23, 136, 166, 163, 187, 28, 135, 25, 136, 180, 71, 109, 98, 0, 8, 238, 125, 254, 76, 66, 226, 13, 57, 123, 42, 199, 15, 245, 87, 152, 217, 81, 143, 189, 19, 42, 235, 56, 90, 38, 132
]
let QY3[48] = [
    179, 166, 28, 140, 50, 178, 141, 131, 249, 187, 86, 152, 95, 90, 166, 173, 109, 114, 46, 28, 140, 137, 249, 253, 119, 79, 34, 212, 134, 162, 145, 248, 55, 174, 61, 7, 10, 69, 14, 70, 10, 43, 215, 191, 154, 68, 32, 24
]
let E3[48] = [
    159, 55, 247, 51, 2, 83, 217, 206, 147, 132, 61, 121, 210, 5, 243, 128, 210, 188, 89, 230, 71, 146, 38, 165, 22, 72, 210, 170, 163, 237, 147, 202, 213, 134, 72, 221, 67, 137, 90, 94, 110, 235, 168, 151, 120, 157, 180, 108
]
let R3[48] = [
    222, 214, 240, 218, 253, 241, 99, 196, 46, 212, 211, 231, 93, 15, 13, 87, 24, 147, 17, 149, 135, 55, 12, 27, 112, 125, 246, 144, 199, 26, 221, 107, 52, 253, 133, 5, 40, 11, 39, 66, 92, 144, 33, 27, 17, 197, 53, 103
]
let S3[48] = [
    183, 104, 157, 171, 84, 203, 109, 244, 185, 171, 205, 133, 193, 218, 24, 208, 220, 38, 85, 75, 166, 138, 52, 240, 31, 2, 75, 130, 130, 117, 54, 190, 186, 154, 14, 194, 17, 7, 20, 255, 148, 149, 87, 44, 189, 79, 63, 109
