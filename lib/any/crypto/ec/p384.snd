//
// ECDSA signature verification over the NIST P-384 curve.
//
// Design: correctness over speed. Big integers are fixed arrays of 16-bit
// limbs (little-endian) stored one per i64 word. A 384-bit value uses 24
// limbs; a 768-bit product uses 48 limbs. Every limb product is 16x16 = 32
// bits and a full multiply column accumulates at most 24 of them, so nothing
// overflows a signed i64. Modular reduction is plain binary long division
// (shift and conditional subtract), which is simple and exact. Curve points
// use Jacobian coordinates so a scalar multiply needs a single field
// inversion at the very end.

let BN_MASK16 = 0xFFFF

// ---------------------------------------------------------------------------
// Generic fixed-width bignum layer (little-endian 16-bit limbs)
// ---------------------------------------------------------------------------

fn bn_copy_n(dst: i64, src: i64, n: i64) {
    let mut i = 0
    for i < n { dst[i] = src[i]; i = i + 1 }
}

fn bn_zero_n(dst: i64, n: i64) {
    let mut i = 0
    for i < n { dst[i] = 0; i = i + 1 }
}

// 1 if the 24-limb value is zero, else 0.
fn bn_is_zero(a: i64) -> i64 {
    let mut acc = 0
    let mut i = 0
    for i < 24 { acc = acc | a[i]; i = i + 1 }
    if acc == 0 { 1 } else { 0 }
}

// Compare two 24-limb values: 1 if a>b, -1 if a<b, 0 if equal.
fn bn_cmp(a: i64, b: i64) -> i64 {
    let mut i = 23
    for {
        if a[i] > b[i] { return 1 }
        if a[i] < b[i] { return 0 - 1 }
        if i == 0 { break }
        i = i - 1
    }
    0
}

// 1 if a>=b over n limbs, else 0.
fn bn_is_ge_n(a: i64, b: i64, n: i64) -> i64 {
    let mut i = n - 1
    for {
        if a[i] > b[i] { return 1 }
        if a[i] < b[i] { return 0 }
        if i == 0 { break }
        i = i - 1
    }
    1
}

// out = a + b over n limbs; returns the carry out of the top limb.
fn bn_add_n(a: i64, b: i64, out: i64, n: i64) -> i64 {
    let mut carry = 0
    let mut i = 0
    for i < n {
        let v = a[i] + b[i] + carry
        out[i] = v & BN_MASK16
        carry = v >>> 16
        i = i + 1
    }
    carry
}

// out = a - b over n limbs; returns the borrow out of the top limb.
fn bn_sub_n(a: i64, b: i64, out: i64, n: i64) -> i64 {
    let mut borrow = 0
    let mut i = 0
    for i < n {
        let mut v = a[i] - b[i] - borrow
        if v < 0 { v = v + 0x10000; borrow = 1 } else { borrow = 0 }
        out[i] = v
        i = i + 1
    }
    borrow
}

// out (48 limbs) = a (24 limbs) * b (24 limbs), schoolbook.
fn bn_mul(a: i64, b: i64, out: i64) {
    let mut i = 0
    for i < 48 { out[i] = 0; i = i + 1 }
    i = 0
    for i < 24 {
        let mut j = 0
        for j < 24 {
            out[i + j] = out[i + j] + a[i] * b[j]
            j = j + 1
        }
        i = i + 1
    }
    // Single carry-propagation pass over the whole 768-bit accumulator.
    let mut carry = 0
    i = 0
    for i < 48 {
        let v = out[i] + carry
        out[i] = v & BN_MASK16
        carry = v >>> 16
        i = i + 1
    }
}

// out (24 limbs) = dividend (48 limbs) mod m (24 limbs), binary long division.
fn bn_mod(dividend: i64, m: i64, out: i64) {
    let mut rem[25]
    bn_zero_n(rem, 25)
    let mut m25[25]
    bn_copy_n(m25, m, 24)
    m25[24] = 0
    let mut bit = 767
    for {
        // rem <<= 1
        let mut carry = 0
        let mut i = 0
        for i < 25 {
            let v = (rem[i] << 1) | carry
            rem[i] = v & BN_MASK16
            carry = v >>> 16
            i = i + 1
        }
        // bring in bit `bit` of the dividend
        let limb = bit >>> 4
        let bp = bit & 15
        let db = (dividend[limb] >>> bp) & 1
        rem[0] = rem[0] | db
        if bn_is_ge_n(rem, m25, 25) != 0 {
            bn_sub_n(rem, m25, rem, 25)
        }
        if bit == 0 { break }
        bit = bit - 1
    }
    bn_copy_n(out, rem, 24)
}

// out = a * b mod m (all 24-limb; out separate from inputs).
fn bn_mulmod(a: i64, b: i64, m: i64, out: i64) {
    let mut prod[48]
    bn_mul(a, b, prod)
    bn_mod(prod, m, out)
}

// out = a + b mod m; requires a<m and b<m.
fn bn_addmod(a: i64, b: i64, m: i64, out: i64) {
    let mut tmp[25]
    let c = bn_add_n(a, b, tmp, 24)
    tmp[24] = c
    let mut m25[25]
    bn_copy_n(m25, m, 24)
    m25[24] = 0
    if bn_is_ge_n(tmp, m25, 25) != 0 { bn_sub_n(tmp, m25, tmp, 25) }
    bn_copy_n(out, tmp, 24)
}

// out = a - b mod m; requires a<m and b<m.
fn bn_submod(a: i64, b: i64, m: i64, out: i64) {
    let borrow = bn_sub_n(a, b, out, 24)
    if borrow != 0 { bn_add_n(out, m, out, 24) }
}

// out = base^exp mod m; exp is a 24-limb (384-bit) exponent, base<m.
fn bn_modexp(base: i64, exp: i64, m: i64, out: i64) {
    let mut result[24]
    bn_zero_n(result, 24)
    result[0] = 1
    let mut tmp[24]
    let mut bit = 383
    for {
        bn_mulmod(result, result, m, tmp)
        bn_copy_n(result, tmp, 24)
        let limb = bit >>> 4
        let bp = bit & 15
        let eb = (exp[limb] >>> bp) & 1
        if eb != 0 {
            bn_mulmod(result, base, m, tmp)
            bn_copy_n(result, tmp, 24)
        }
        if bit == 0 { break }
        bit = bit - 1
    }
    bn_copy_n(out, result, 24)
}

// out = a^-1 mod m via Fermat (m must be prime): a^(m-2) mod m.
fn bn_invmod(a: i64, m: i64, out: i64) {
    let mut two[24]
    bn_zero_n(two, 24)
    two[0] = 2
    let mut em2[24]
    bn_sub_n(m, two, em2, 24)
    bn_modexp(a, em2, m, out)
}

// out (24 limbs) = big-endian 48-byte integer at `ptr`.
fn bn_from_bytes(out: i64, ptr: i64) {
    let mut i = 0
    for i < 24 {
        let hi = peek8(ptr + 46 - 2 * i)
        let lo = peek8(ptr + 47 - 2 * i)
        out[i] = lo | (hi << 8)
        i = i + 1
    }
}

// Write 24-limb value `a` as a big-endian 48-byte integer at `ptr`.
fn bn_to_bytes(ptr: i64, a: i64) {
    let mut i = 0
    for i < 24 {
        poke8(ptr + 47 - 2 * i, a[i] & 0xFF)
        poke8(ptr + 46 - 2 * i, (a[i] >>> 8) & 0xFF)
        i = i + 1
    }
}

// out (24 limbs) = a small non-negative value that fits in 64 bits.
fn bn_set_small(out: i64, v: i64) {
    bn_zero_n(out, 24)
    out[0] = v & BN_MASK16
    out[1] = (v >>> 16) & BN_MASK16
    out[2] = (v >>> 32) & BN_MASK16
    out[3] = (v >>> 48) & BN_MASK16
}

// ---------------------------------------------------------------------------
// NIST P-384 domain parameters (little-endian 16-bit limbs)
// ---------------------------------------------------------------------------

let P384_P[24] = [
    65535, 65535, 0, 0, 0, 0, 65535, 65535, 65534, 65535, 65535, 65535, 65535, 65535, 65535, 65535, 65535, 65535, 65535, 65535, 65535, 65535, 65535, 65535
]
let P384_N[24] = [
    10611, 52421, 6506, 60652, 42874, 18608, 3506, 22554, 11743, 62519, 19841, 51043, 65535, 65535, 65535, 65535, 65535, 65535, 65535, 65535, 65535, 65535, 65535, 65535
]
let P384_A[24] = [
    65532, 65535, 0, 0, 0, 0, 65535, 65535, 65534, 65535, 65535, 65535, 65535, 65535, 65535, 65535, 65535, 65535, 65535, 65535, 65535, 65535, 65535, 65535
]
let P384_GX[24] = [
    2743, 29302, 24120, 14932, 10604, 48981, 62045, 21762, 10808, 33364, 16864, 23031, 39832, 35751, 15202, 28189, 44404, 62240, 50974, 36529, 1335, 48779, 51746, 43655
]
let P384_GY[24] = [
    3679, 37098, 7548, 31299, 33181, 7550, 45518, 2656, 47296, 46576, 12563, 59866, 5244, 10394, 7613, 63732, 56361, 37522, 39103, 23966, 11375, 38438, 56906, 13847
]

// ---------------------------------------------------------------------------
// Field arithmetic modulo p (thin wrappers over the bignum layer)
// ---------------------------------------------------------------------------

fn fp_mul(r: i64, a: i64, b: i64) { bn_mulmod(a, b, P384_P, r) }
fn fp_sqr(r: i64, a: i64) { bn_mulmod(a, a, P384_P, r) }
fn fp_add(r: i64, a: i64, b: i64) { bn_addmod(a, b, P384_P, r) }
fn fp_sub(r: i64, a: i64, b: i64) { bn_submod(a, b, P384_P, r) }
fn fp_inv(r: i64, a: i64) { bn_invmod(a, P384_P, r) }

// ---------------------------------------------------------------------------
// Jacobian point layout: 72 words = X[24] | Y[24] | Z[24].
// Coordinate addresses are byte offsets (24 words = 192 bytes each).
// The point at infinity is represented by Z = 0.
// ---------------------------------------------------------------------------

fn jac_x(p: i64) -> i64 { p }
fn jac_y(p: i64) -> i64 { p + 192 }
fn jac_z(p: i64) -> i64 { p + 384 }

fn point_copy(dst: i64, src: i64) { bn_copy_n(dst, src, 72) }

fn set_infinity(p: i64) {
    bn_zero_n(jac_x(p), 24)
    bn_zero_n(jac_y(p), 24)
    bn_zero_n(jac_z(p), 24)
    let xp = jac_x(p)
    xp[0] = 1
    let yp = jac_y(p)
    yp[0] = 1
}

// out = 2 * p (Jacobian), general short-Weierstrass doubling with a = -3.
fn point_double(out: i64, p: i64) {
    if bn_is_zero(jac_z(p)) != 0 { set_infinity(out); return }
    let mut ysq[24]
    fp_sqr(ysq, jac_y(p))
    if bn_is_zero(ysq) != 0 { set_infinity(out); return }
    // S = 4 * X * Y^2
    let mut xy[24]
    fp_mul(xy, jac_x(p), ysq)
    let mut S[24]
    fp_add(S, xy, xy)
    fp_add(S, S, S)
    // M = 3 * X^2 + a * Z^4
    let mut xsq[24]
    fp_sqr(xsq, jac_x(p))
    let mut M[24]
    fp_add(M, xsq, xsq)
    fp_add(M, M, xsq)
    let mut zsq[24]
    fp_sqr(zsq, jac_z(p))
    let mut z4[24]
    fp_sqr(z4, zsq)
    let mut az4[24]
    fp_mul(az4, P384_A, z4)
    fp_add(M, M, az4)
    // X3 = M^2 - 2S
    let mut m2[24]
    fp_sqr(m2, M)
    let mut twoS[24]
    fp_add(twoS, S, S)
    let mut X3[24]
    fp_sub(X3, m2, twoS)
    // Y3 = M * (S - X3) - 8 * Y^4
    let mut smx[24]
    fp_sub(smx, S, X3)
    let mut y3a[24]
    fp_mul(y3a, M, smx)
    let mut y4[24]
    fp_sqr(y4, ysq)
    let mut e8[24]
    fp_add(e8, y4, y4)
    fp_add(e8, e8, e8)
    fp_add(e8, e8, e8)
    let mut Y3[24]
    fp_sub(Y3, y3a, e8)
    // Z3 = 2 * Y * Z
    let mut yz[24]
    fp_mul(yz, jac_y(p), jac_z(p))
    let mut Z3[24]
    fp_add(Z3, yz, yz)
    bn_copy_n(jac_x(out), X3, 24)
    bn_copy_n(jac_y(out), Y3, 24)
    bn_copy_n(jac_z(out), Z3, 24)
}

// out = pa + pb (Jacobian), with identity handling.
fn point_add(out: i64, pa: i64, pb: i64) {
    if bn_is_zero(jac_z(pa)) != 0 { point_copy(out, pb); return }
    if bn_is_zero(jac_z(pb)) != 0 { point_copy(out, pa); return }
    let mut z1sq[24]
    fp_sqr(z1sq, jac_z(pa))
    let mut z2sq[24]
    fp_sqr(z2sq, jac_z(pb))
    let mut U1[24]
    fp_mul(U1, jac_x(pa), z2sq)
    let mut U2[24]
    fp_mul(U2, jac_x(pb), z1sq)
    let mut z1cu[24]
    fp_mul(z1cu, z1sq, jac_z(pa))
    let mut z2cu[24]
    fp_mul(z2cu, z2sq, jac_z(pb))
    let mut S1[24]
    fp_mul(S1, jac_y(pa), z2cu)
    let mut S2[24]
    fp_mul(S2, jac_y(pb), z1cu)
    let mut H[24]
    fp_sub(H, U2, U1)
    let mut R[24]
    fp_sub(R, S2, S1)
    if bn_is_zero(H) != 0 {
        if bn_is_zero(R) != 0 { point_double(out, pa); return }
        set_infinity(out)
        return
    }
    let mut Hsq[24]
    fp_sqr(Hsq, H)
    let mut Hcu[24]
    fp_mul(Hcu, Hsq, H)
    let mut U1H2[24]
    fp_mul(U1H2, U1, Hsq)
    let mut Rsq[24]
    fp_sqr(Rsq, R)
    let mut t[24]
    fp_sub(t, Rsq, Hcu)
    let mut twoU1H2[24]
    fp_add(twoU1H2, U1H2, U1H2)
    let mut X3[24]
    fp_sub(X3, t, twoU1H2)
    let mut d[24]
    fp_sub(d, U1H2, X3)
    let mut Rd[24]
    fp_mul(Rd, R, d)
    let mut S1H3[24]
    fp_mul(S1H3, S1, Hcu)
    let mut Y3[24]
    fp_sub(Y3, Rd, S1H3)
    let mut z1z2[24]
    fp_mul(z1z2, jac_z(pa), jac_z(pb))
    let mut Z3[24]
    fp_mul(Z3, H, z1z2)
    bn_copy_n(jac_x(out), X3, 24)
    bn_copy_n(jac_y(out), Y3, 24)
    bn_copy_n(jac_z(out), Z3, 24)
}

// outP (Jacobian) = k * (ax, ay), with k a 24-limb scalar and (ax, ay) affine.
fn scalar_mult_jac(outP: i64, k: i64, ax: i64, ay: i64) {
    let mut Rp[72]
    set_infinity(Rp)
    let mut Qp[72]
    bn_copy_n(jac_x(Qp), ax, 24)
    bn_copy_n(jac_y(Qp), ay, 24)
    let zp = jac_z(Qp)
    bn_zero_n(zp, 24)
    zp[0] = 1
    let mut Tp[72]
    let mut bit = 383
    for {
        point_double(Tp, Rp)
        point_copy(Rp, Tp)
        let limb = bit >>> 4
        let bp = bit & 15
        let kb = (k[limb] >>> bp) & 1
        if kb != 0 {
            point_add(Tp, Rp, Qp)
            point_copy(Rp, Tp)
        }
        if bit == 0 { break }
        bit = bit - 1
    }
    point_copy(outP, Rp)
}

// Convert Jacobian p to affine (outX, outY). Returns 1 if p is infinity.
fn jac_to_affine(outX: i64, outY: i64, p: i64) -> i64 {
    if bn_is_zero(jac_z(p)) != 0 { return 1 }
    let mut zinv[24]
    fp_inv(zinv, jac_z(p))
    let mut zinv2[24]
    fp_sqr(zinv2, zinv)
    let mut zinv3[24]
    fp_mul(zinv3, zinv2, zinv)
    fp_mul(outX, jac_x(p), zinv2)
    fp_mul(outY, jac_y(p), zinv3)
    0
}

// ---------------------------------------------------------------------------
// ECDSA verification
// ---------------------------------------------------------------------------

// Verify an ECDSA P-384 signature. Qxp/Qyp/ep/rp/sp each point to 48 big-endian
// bytes: public key x, public key y, message hash (as an integer), r, and s.
// Returns 1 if the signature is valid, 0 otherwise.
fn ecdsa_verify_p384(Qxp: i64, Qyp: i64, ep: i64, rp: i64, sp: i64) -> i64 {
    let mut Qx[24]
    bn_from_bytes(Qx, Qxp)
    let mut Qy[24]
    bn_from_bytes(Qy, Qyp)
    let mut e[24]
    bn_from_bytes(e, ep)
    let mut r[24]
    bn_from_bytes(r, rp)
    let mut s[24]
    bn_from_bytes(s, sp)
    // r, s must be in [1, n-1]
    if bn_is_zero(r) != 0 { return 0 }
    if bn_is_zero(s) != 0 { return 0 }
    if bn_is_ge_n(r, P384_N, 24) != 0 { return 0 }
    if bn_is_ge_n(s, P384_N, 24) != 0 { return 0 }
    // w = s^-1 mod n
    let mut w[24]
    bn_invmod(s, P384_N, w)
    // u1 = e*w mod n ; u2 = r*w mod n
    let mut u1[24]
    bn_mulmod(e, w, P384_N, u1)
    let mut u2[24]
    bn_mulmod(r, w, P384_N, u2)
    // R = u1*G + u2*Q
    let mut P1[72]
    scalar_mult_jac(P1, u1, P384_GX, P384_GY)
    let mut P2[72]
    scalar_mult_jac(P2, u2, Qx, Qy)
    let mut Rp[72]
    point_add(Rp, P1, P2)
    if bn_is_zero(jac_z(Rp)) != 0 { return 0 }
    let mut Rx[24]
    let mut Ry[24]
    jac_to_affine(Rx, Ry, Rp)
    // x1 = R.x mod n
    let mut dv[48]
    bn_zero_n(dv, 48)
    bn_copy_n(dv, Rx, 24)
    let mut x1[24]
    bn_mod(dv, P384_N, x1)
    if bn_cmp(x1, r) == 0 { return 1 }
    0
}
