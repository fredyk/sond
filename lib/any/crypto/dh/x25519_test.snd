// Tests for x25519.snd against RFC 7748 §5.2 and §6.1 official test vectors.
//   sond test lib/any/crypto/dh/x25519_test.snd

include "any/crypto/dh/x25519.snd"
include "x86_64/linux/testing.snd"

// Compare two 32-byte arrays at addresses a and b.
fn bytes32_eq(a: i64, b: i64) -> i64 {
    let mut i = 0
    for i < 32 { if peek8(a + i) != peek8(b + i) { return 0 }; i = i + 1 }
    1
}

// Module-level tables for test vector input data.
// Each test block populates one of these from its hex values,
// then calls x25519 and compares.

// Scalar vector 1: a546e36bf0527c9d3b16154b82465edd62144c0ac1fc5a18506a2244ba449ac4
let mut tv1_scalar[32]
// u vector 1: e6db6867583030db3594c1a424b15f7c726624ec26b3353b10a903a6d0ab1c4c
let mut tv1_u[32]
// expected output 1: c3da55379de9c6908e94ea4df28d084f32eccf03491c71f754b4075577a28552
let mut tv1_exp[32]

// Scalar vector 2: 4b66e9d4d1b4673c5ad22691957d6af5c11b6421e0ea01d42ca4169e7918ba0d
let mut tv2_scalar[32]
// u vector 2: e5210f12786811d3f4b7959d0538ae2c31dbe7106fc03c3efc4cd549c715a493
let mut tv2_u[32]
// expected output 2: 95cbde9476e8907d7aade45cb4b873f88b595a68799fa152e6f8f7647aac7957
let mut tv2_exp[32]

// Base point u=9: 09 00 00...00
let mut base9[32]

// Expected 1-iteration output: 422c8e7a6227d7bca1350b3e2bb7279f7897b87bb6854b783c60e80311ae3079
let mut iter1_exp[32]

// Alice priv: 77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a
let mut alice_priv[32]
// Alice pub:  8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a
let mut alice_pub[32]
// Bob priv:   5dab087e624a8a4b79e17f8b83800ee66f3bb1292618b6fd1c2f8b27ff88e0eb
let mut bob_priv[32]
// Bob pub:    de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f
let mut bob_pub[32]
// Shared:     4a5d9d5ba4ce2de1728e3bf480350f25e07e21c947d19e3376f09b3c1e161742
let mut shared_exp[32]

// ── RFC 7748 §5.2 Test Vector 1 ──

test "x25519: RFC 7748 §5.2 vector 1" {
    let mut i = 0
    for i < 32 { poke8(tv1_scalar + i, 0); i = i + 1 }
    poke8(tv1_scalar + 0, 0xa5); poke8(tv1_scalar + 1, 0x46); poke8(tv1_scalar + 2, 0xe3); poke8(tv1_scalar + 3, 0x6b)
    poke8(tv1_scalar + 4, 0xf0); poke8(tv1_scalar + 5, 0x52); poke8(tv1_scalar + 6, 0x7c); poke8(tv1_scalar + 7, 0x9d)
    poke8(tv1_scalar + 8, 0x3b); poke8(tv1_scalar + 9, 0x16); poke8(tv1_scalar + 10, 0x15); poke8(tv1_scalar + 11, 0x4b)
    poke8(tv1_scalar + 12, 0x82); poke8(tv1_scalar + 13, 0x46); poke8(tv1_scalar + 14, 0x5e); poke8(tv1_scalar + 15, 0xdd)
    poke8(tv1_scalar + 16, 0x62); poke8(tv1_scalar + 17, 0x14); poke8(tv1_scalar + 18, 0x4c); poke8(tv1_scalar + 19, 0x0a)
    poke8(tv1_scalar + 20, 0xc1); poke8(tv1_scalar + 21, 0xfc); poke8(tv1_scalar + 22, 0x5a); poke8(tv1_scalar + 23, 0x18)
    poke8(tv1_scalar + 24, 0x50); poke8(tv1_scalar + 25, 0x6a); poke8(tv1_scalar + 26, 0x22); poke8(tv1_scalar + 27, 0x44)
    poke8(tv1_scalar + 28, 0xba); poke8(tv1_scalar + 29, 0x44); poke8(tv1_scalar + 30, 0x9a); poke8(tv1_scalar + 31, 0xc4)

    i = 0
    for i < 32 { poke8(tv1_u + i, 0); i = i + 1 }
    poke8(tv1_u + 0, 0xe6); poke8(tv1_u + 1, 0xdb); poke8(tv1_u + 2, 0x68); poke8(tv1_u + 3, 0x67)
    poke8(tv1_u + 4, 0x58); poke8(tv1_u + 5, 0x30); poke8(tv1_u + 6, 0x30); poke8(tv1_u + 7, 0xdb)
    poke8(tv1_u + 8, 0x35); poke8(tv1_u + 9, 0x94); poke8(tv1_u + 10, 0xc1); poke8(tv1_u + 11, 0xa4)
    poke8(tv1_u + 12, 0x24); poke8(tv1_u + 13, 0xb1); poke8(tv1_u + 14, 0x5f); poke8(tv1_u + 15, 0x7c)
    poke8(tv1_u + 16, 0x72); poke8(tv1_u + 17, 0x66); poke8(tv1_u + 18, 0x24); poke8(tv1_u + 19, 0xec)
    poke8(tv1_u + 20, 0x26); poke8(tv1_u + 21, 0xb3); poke8(tv1_u + 22, 0x35); poke8(tv1_u + 23, 0x3b)
    poke8(tv1_u + 24, 0x10); poke8(tv1_u + 25, 0xa9); poke8(tv1_u + 26, 0x03); poke8(tv1_u + 27, 0xa6)
    poke8(tv1_u + 28, 0xd0); poke8(tv1_u + 29, 0xab); poke8(tv1_u + 30, 0x1c); poke8(tv1_u + 31, 0x4c)

    i = 0
    for i < 32 { poke8(tv1_exp + i, 0); i = i + 1 }
    poke8(tv1_exp + 0, 0xc3); poke8(tv1_exp + 1, 0xda); poke8(tv1_exp + 2, 0x55); poke8(tv1_exp + 3, 0x37)
    poke8(tv1_exp + 4, 0x9d); poke8(tv1_exp + 5, 0xe9); poke8(tv1_exp + 6, 0xc6); poke8(tv1_exp + 7, 0x90)
    poke8(tv1_exp + 8, 0x8e); poke8(tv1_exp + 9, 0x94); poke8(tv1_exp + 10, 0xea); poke8(tv1_exp + 11, 0x4d)
    poke8(tv1_exp + 12, 0xf2); poke8(tv1_exp + 13, 0x8d); poke8(tv1_exp + 14, 0x08); poke8(tv1_exp + 15, 0x4f)
    poke8(tv1_exp + 16, 0x32); poke8(tv1_exp + 17, 0xec); poke8(tv1_exp + 18, 0xcf); poke8(tv1_exp + 19, 0x03)
    poke8(tv1_exp + 20, 0x49); poke8(tv1_exp + 21, 0x1c); poke8(tv1_exp + 22, 0x71); poke8(tv1_exp + 23, 0xf7)
    poke8(tv1_exp + 24, 0x54); poke8(tv1_exp + 25, 0xb4); poke8(tv1_exp + 26, 0x07); poke8(tv1_exp + 27, 0x55)
    poke8(tv1_exp + 28, 0x77); poke8(tv1_exp + 29, 0xa2); poke8(tv1_exp + 30, 0x85); poke8(tv1_exp + 31, 0x52)

    let out[32]
    x25519(tv1_scalar, tv1_u, out)
    assert_eq(bytes32_eq(out, tv1_exp), 1)
}

// ── RFC 7748 §5.2 Test Vector 2 ──

test "x25519: RFC 7748 §5.2 vector 2" {
    let mut i = 0
    for i < 32 { poke8(tv2_scalar + i, 0); i = i + 1 }
    poke8(tv2_scalar + 0, 0x4b); poke8(tv2_scalar + 1, 0x66); poke8(tv2_scalar + 2, 0xe9); poke8(tv2_scalar + 3, 0xd4)
    poke8(tv2_scalar + 4, 0xd1); poke8(tv2_scalar + 5, 0xb4); poke8(tv2_scalar + 6, 0x67); poke8(tv2_scalar + 7, 0x3c)
    poke8(tv2_scalar + 8, 0x5a); poke8(tv2_scalar + 9, 0xd2); poke8(tv2_scalar + 10, 0x26); poke8(tv2_scalar + 11, 0x91)
    poke8(tv2_scalar + 12, 0x95); poke8(tv2_scalar + 13, 0x7d); poke8(tv2_scalar + 14, 0x6a); poke8(tv2_scalar + 15, 0xf5)
    poke8(tv2_scalar + 16, 0xc1); poke8(tv2_scalar + 17, 0x1b); poke8(tv2_scalar + 18, 0x64); poke8(tv2_scalar + 19, 0x21)
    poke8(tv2_scalar + 20, 0xe0); poke8(tv2_scalar + 21, 0xea); poke8(tv2_scalar + 22, 0x01); poke8(tv2_scalar + 23, 0xd4)
    poke8(tv2_scalar + 24, 0x2c); poke8(tv2_scalar + 25, 0xa4); poke8(tv2_scalar + 26, 0x16); poke8(tv2_scalar + 27, 0x9e)
    poke8(tv2_scalar + 28, 0x79); poke8(tv2_scalar + 29, 0x18); poke8(tv2_scalar + 30, 0xba); poke8(tv2_scalar + 31, 0x0d)

    i = 0
    for i < 32 { poke8(tv2_u + i, 0); i = i + 1 }
    poke8(tv2_u + 0, 0xe5); poke8(tv2_u + 1, 0x21); poke8(tv2_u + 2, 0x0f); poke8(tv2_u + 3, 0x12)
    poke8(tv2_u + 4, 0x78); poke8(tv2_u + 5, 0x68); poke8(tv2_u + 6, 0x11); poke8(tv2_u + 7, 0xd3)
    poke8(tv2_u + 8, 0xf4); poke8(tv2_u + 9, 0xb7); poke8(tv2_u + 10, 0x95); poke8(tv2_u + 11, 0x9d)
    poke8(tv2_u + 12, 0x05); poke8(tv2_u + 13, 0x38); poke8(tv2_u + 14, 0xae); poke8(tv2_u + 15, 0x2c)
    poke8(tv2_u + 16, 0x31); poke8(tv2_u + 17, 0xdb); poke8(tv2_u + 18, 0xe7); poke8(tv2_u + 19, 0x10)
    poke8(tv2_u + 20, 0x6f); poke8(tv2_u + 21, 0xc0); poke8(tv2_u + 22, 0x3c); poke8(tv2_u + 23, 0x3e)
    poke8(tv2_u + 24, 0xfc); poke8(tv2_u + 25, 0x4c); poke8(tv2_u + 26, 0xd5); poke8(tv2_u + 27, 0x49)
    poke8(tv2_u + 28, 0xc7); poke8(tv2_u + 29, 0x15); poke8(tv2_u + 30, 0xa4); poke8(tv2_u + 31, 0x93)

    i = 0
    for i < 32 { poke8(tv2_exp + i, 0); i = i + 1 }
    poke8(tv2_exp + 0, 0x95); poke8(tv2_exp + 1, 0xcb); poke8(tv2_exp + 2, 0xde); poke8(tv2_exp + 3, 0x94)
    poke8(tv2_exp + 4, 0x76); poke8(tv2_exp + 5, 0xe8); poke8(tv2_exp + 6, 0x90); poke8(tv2_exp + 7, 0x7d)
    poke8(tv2_exp + 8, 0x7a); poke8(tv2_exp + 9, 0xad); poke8(tv2_exp + 10, 0xe4); poke8(tv2_exp + 11, 0x5c)
    poke8(tv2_exp + 12, 0xb4); poke8(tv2_exp + 13, 0xb8); poke8(tv2_exp + 14, 0x73); poke8(tv2_exp + 15, 0xf8)
    poke8(tv2_exp + 16, 0x8b); poke8(tv2_exp + 17, 0x59); poke8(tv2_exp + 18, 0x5a); poke8(tv2_exp + 19, 0x68)
    poke8(tv2_exp + 20, 0x79); poke8(tv2_exp + 21, 0x9f); poke8(tv2_exp + 22, 0xa1); poke8(tv2_exp + 23, 0x52)
    poke8(tv2_exp + 24, 0xe6); poke8(tv2_exp + 25, 0xf8); poke8(tv2_exp + 26, 0xf7); poke8(tv2_exp + 27, 0x64)
    poke8(tv2_exp + 28, 0x7a); poke8(tv2_exp + 29, 0xac); poke8(tv2_exp + 30, 0x79); poke8(tv2_exp + 31, 0x57)

    let out[32]
    x25519(tv2_scalar, tv2_u, out)
    assert_eq(bytes32_eq(out, tv2_exp), 1)
}

// ── RFC 7748 §5.2 Iteration (1 iteration) ──

test "x25519: RFC 7748 §5.2 1 iteration" {
    poke8(base9, 9)
    let mut i = 1
    for i < 32 { poke8(base9 + i, 0); i = i + 1 }

    i = 0
    for i < 32 { poke8(iter1_exp + i, 0); i = i + 1 }
    poke8(iter1_exp + 0, 0x42); poke8(iter1_exp + 1, 0x2c); poke8(iter1_exp + 2, 0x8e); poke8(iter1_exp + 3, 0x7a)
    poke8(iter1_exp + 4, 0x62); poke8(iter1_exp + 5, 0x27); poke8(iter1_exp + 6, 0xd7); poke8(iter1_exp + 7, 0xbc)
    poke8(iter1_exp + 8, 0xa1); poke8(iter1_exp + 9, 0x35); poke8(iter1_exp + 10, 0x0b); poke8(iter1_exp + 11, 0x3e)
    poke8(iter1_exp + 12, 0x2b); poke8(iter1_exp + 13, 0xb7); poke8(iter1_exp + 14, 0x27); poke8(iter1_exp + 15, 0x9f)
    poke8(iter1_exp + 16, 0x78); poke8(iter1_exp + 17, 0x97); poke8(iter1_exp + 18, 0xb8); poke8(iter1_exp + 19, 0x7b)
    poke8(iter1_exp + 20, 0xb6); poke8(iter1_exp + 21, 0x85); poke8(iter1_exp + 22, 0x4b); poke8(iter1_exp + 23, 0x78)
    poke8(iter1_exp + 24, 0x3c); poke8(iter1_exp + 25, 0x60); poke8(iter1_exp + 26, 0xe8); poke8(iter1_exp + 27, 0x03)
    poke8(iter1_exp + 28, 0x11); poke8(iter1_exp + 29, 0xae); poke8(iter1_exp + 30, 0x30); poke8(iter1_exp + 31, 0x79)

    let out[32]
    x25519(base9, base9, out)
    assert_eq(bytes32_eq(out, iter1_exp), 1)
}

// ── RFC 7748 §6.1 ECDH vectors ──

test "x25519: RFC 7748 §6.1 Alice public key" {
    let mut i = 0
    for i < 32 { poke8(alice_priv + i, 0); i = i + 1 }
    poke8(alice_priv + 0, 0x77); poke8(alice_priv + 1, 0x07); poke8(alice_priv + 2, 0x6d); poke8(alice_priv + 3, 0x0a)
    poke8(alice_priv + 4, 0x73); poke8(alice_priv + 5, 0x18); poke8(alice_priv + 6, 0xa5); poke8(alice_priv + 7, 0x7d)
    poke8(alice_priv + 8, 0x3c); poke8(alice_priv + 9, 0x16); poke8(alice_priv + 10, 0xc1); poke8(alice_priv + 11, 0x72)
    poke8(alice_priv + 12, 0x51); poke8(alice_priv + 13, 0xb2); poke8(alice_priv + 14, 0x66); poke8(alice_priv + 15, 0x45)
    poke8(alice_priv + 16, 0xdf); poke8(alice_priv + 17, 0x4c); poke8(alice_priv + 18, 0x2f); poke8(alice_priv + 19, 0x87)
    poke8(alice_priv + 20, 0xeb); poke8(alice_priv + 21, 0xc0); poke8(alice_priv + 22, 0x99); poke8(alice_priv + 23, 0x2a)
    poke8(alice_priv + 24, 0xb1); poke8(alice_priv + 25, 0x77); poke8(alice_priv + 26, 0xfb); poke8(alice_priv + 27, 0xa5)
    poke8(alice_priv + 28, 0x1d); poke8(alice_priv + 29, 0xb9); poke8(alice_priv + 30, 0x2c); poke8(alice_priv + 31, 0x2a)

    i = 0
    for i < 32 { poke8(alice_pub + i, 0); i = i + 1 }
    poke8(alice_pub + 0, 0x85); poke8(alice_pub + 1, 0x20); poke8(alice_pub + 2, 0xf0); poke8(alice_pub + 3, 0x09)
    poke8(alice_pub + 4, 0x89); poke8(alice_pub + 5, 0x30); poke8(alice_pub + 6, 0xa7); poke8(alice_pub + 7, 0x54)
    poke8(alice_pub + 8, 0x74); poke8(alice_pub + 9, 0x8b); poke8(alice_pub + 10, 0x7d); poke8(alice_pub + 11, 0xdc)
    poke8(alice_pub + 12, 0xb4); poke8(alice_pub + 13, 0x3e); poke8(alice_pub + 14, 0xf7); poke8(alice_pub + 15, 0x5a)
    poke8(alice_pub + 16, 0x0d); poke8(alice_pub + 17, 0xbf); poke8(alice_pub + 18, 0x3a); poke8(alice_pub + 19, 0x0d)
    poke8(alice_pub + 20, 0x26); poke8(alice_pub + 21, 0x38); poke8(alice_pub + 22, 0x1a); poke8(alice_pub + 23, 0xf4)
    poke8(alice_pub + 24, 0xeb); poke8(alice_pub + 25, 0xa4); poke8(alice_pub + 26, 0xa9); poke8(alice_pub + 27, 0x8e)
    poke8(alice_pub + 28, 0xaa); poke8(alice_pub + 29, 0x9b); poke8(alice_pub + 30, 0x4e); poke8(alice_pub + 31, 0x6a)

    let out[32]
    let base[32]; poke8(base, 9); i = 1; for i < 32 { poke8(base + i, 0); i = i + 1 }
    x25519(alice_priv, base, out)
    assert_eq(bytes32_eq(out, alice_pub), 1)
}

test "x25519: RFC 7748 §6.1 Bob public key" {
    let mut i = 0
    for i < 32 { poke8(bob_priv + i, 0); i = i + 1 }
    poke8(bob_priv + 0, 0x5d); poke8(bob_priv + 1, 0xab); poke8(bob_priv + 2, 0x08); poke8(bob_priv + 3, 0x7e)
    poke8(bob_priv + 4, 0x62); poke8(bob_priv + 5, 0x4a); poke8(bob_priv + 6, 0x8a); poke8(bob_priv + 7, 0x4b)
    poke8(bob_priv + 8, 0x79); poke8(bob_priv + 9, 0xe1); poke8(bob_priv + 10, 0x7f); poke8(bob_priv + 11, 0x8b)
    poke8(bob_priv + 12, 0x83); poke8(bob_priv + 13, 0x80); poke8(bob_priv + 14, 0x0e); poke8(bob_priv + 15, 0xe6)
    poke8(bob_priv + 16, 0x6f); poke8(bob_priv + 17, 0x3b); poke8(bob_priv + 18, 0xb1); poke8(bob_priv + 19, 0x29)
    poke8(bob_priv + 20, 0x26); poke8(bob_priv + 21, 0x18); poke8(bob_priv + 22, 0xb6); poke8(bob_priv + 23, 0xfd)
    poke8(bob_priv + 24, 0x1c); poke8(bob_priv + 25, 0x2f); poke8(bob_priv + 26, 0x8b); poke8(bob_priv + 27, 0x27)
    poke8(bob_priv + 28, 0xff); poke8(bob_priv + 29, 0x88); poke8(bob_priv + 30, 0xe0); poke8(bob_priv + 31, 0xeb)

    i = 0
    for i < 32 { poke8(bob_pub + i, 0); i = i + 1 }
    poke8(bob_pub + 0, 0xde); poke8(bob_pub + 1, 0x9e); poke8(bob_pub + 2, 0xdb); poke8(bob_pub + 3, 0x7d)
    poke8(bob_pub + 4, 0x7b); poke8(bob_pub + 5, 0x7d); poke8(bob_pub + 6, 0xc1); poke8(bob_pub + 7, 0xb4)
    poke8(bob_pub + 8, 0xd3); poke8(bob_pub + 9, 0x5b); poke8(bob_pub + 10, 0x61); poke8(bob_pub + 11, 0xc2)
    poke8(bob_pub + 12, 0xec); poke8(bob_pub + 13, 0xe4); poke8(bob_pub + 14, 0x35); poke8(bob_pub + 15, 0x37)
    poke8(bob_pub + 16, 0x3f); poke8(bob_pub + 17, 0x83); poke8(bob_pub + 18, 0x43); poke8(bob_pub + 19, 0xc8)
    poke8(bob_pub + 20, 0x5b); poke8(bob_pub + 21, 0x78); poke8(bob_pub + 22, 0x67); poke8(bob_pub + 23, 0x4d)
    poke8(bob_pub + 24, 0xad); poke8(bob_pub + 25, 0xfc); poke8(bob_pub + 26, 0x7e); poke8(bob_pub + 27, 0x14)
    poke8(bob_pub + 28, 0x6f); poke8(bob_pub + 29, 0x88); poke8(bob_pub + 30, 0x2b); poke8(bob_pub + 31, 0x4f)

    let out[32]
    let base[32]; poke8(base, 9); i = 1; for i < 32 { poke8(base + i, 0); i = i + 1 }
    x25519(bob_priv, base, out)
    assert_eq(bytes32_eq(out, bob_pub), 1)
}

test "x25519: RFC 7748 §6.1 shared secret" {
    let mut i = 0
    for i < 32 { poke8(shared_exp + i, 0); i = i + 1 }
    poke8(shared_exp + 0, 0x4a); poke8(shared_exp + 1, 0x5d); poke8(shared_exp + 2, 0x9d); poke8(shared_exp + 3, 0x5b)
    poke8(shared_exp + 4, 0xa4); poke8(shared_exp + 5, 0xce); poke8(shared_exp + 6, 0x2d); poke8(shared_exp + 7, 0xe1)
    poke8(shared_exp + 8, 0x72); poke8(shared_exp + 9, 0x8e); poke8(shared_exp + 10, 0x3b); poke8(shared_exp + 11, 0xf4)
    poke8(shared_exp + 12, 0x80); poke8(shared_exp + 13, 0x35); poke8(shared_exp + 14, 0x0f); poke8(shared_exp + 15, 0x25)
    poke8(shared_exp + 16, 0xe0); poke8(shared_exp + 17, 0x7e); poke8(shared_exp + 18, 0x21); poke8(shared_exp + 19, 0xc9)
    poke8(shared_exp + 20, 0x47); poke8(shared_exp + 21, 0xd1); poke8(shared_exp + 22, 0x9e); poke8(shared_exp + 23, 0x33)
    poke8(shared_exp + 24, 0x76); poke8(shared_exp + 25, 0xf0); poke8(shared_exp + 26, 0x9b); poke8(shared_exp + 27, 0x3c)
    poke8(shared_exp + 28, 0x1e); poke8(shared_exp + 29, 0x16); poke8(shared_exp + 30, 0x17); poke8(shared_exp + 31, 0x42)

    // Each test runs in its own fork, so this test must set alice_priv and bob_pub
    // itself, the writes from the public-key tests happened in other forks.
    poke8(alice_priv + 0, 0x77); poke8(alice_priv + 1, 0x07); poke8(alice_priv + 2, 0x6d); poke8(alice_priv + 3, 0x0a)
    poke8(alice_priv + 4, 0x73); poke8(alice_priv + 5, 0x18); poke8(alice_priv + 6, 0xa5); poke8(alice_priv + 7, 0x7d)
    poke8(alice_priv + 8, 0x3c); poke8(alice_priv + 9, 0x16); poke8(alice_priv + 10, 0xc1); poke8(alice_priv + 11, 0x72)
    poke8(alice_priv + 12, 0x51); poke8(alice_priv + 13, 0xb2); poke8(alice_priv + 14, 0x66); poke8(alice_priv + 15, 0x45)
    poke8(alice_priv + 16, 0xdf); poke8(alice_priv + 17, 0x4c); poke8(alice_priv + 18, 0x2f); poke8(alice_priv + 19, 0x87)
    poke8(alice_priv + 20, 0xeb); poke8(alice_priv + 21, 0xc0); poke8(alice_priv + 22, 0x99); poke8(alice_priv + 23, 0x2a)
    poke8(alice_priv + 24, 0xb1); poke8(alice_priv + 25, 0x77); poke8(alice_priv + 26, 0xfb); poke8(alice_priv + 27, 0xa5)
    poke8(alice_priv + 28, 0x1d); poke8(alice_priv + 29, 0xb9); poke8(alice_priv + 30, 0x2c); poke8(alice_priv + 31, 0x2a)

    poke8(bob_pub + 0, 0xde); poke8(bob_pub + 1, 0x9e); poke8(bob_pub + 2, 0xdb); poke8(bob_pub + 3, 0x7d)
    poke8(bob_pub + 4, 0x7b); poke8(bob_pub + 5, 0x7d); poke8(bob_pub + 6, 0xc1); poke8(bob_pub + 7, 0xb4)
    poke8(bob_pub + 8, 0xd3); poke8(bob_pub + 9, 0x5b); poke8(bob_pub + 10, 0x61); poke8(bob_pub + 11, 0xc2)
    poke8(bob_pub + 12, 0xec); poke8(bob_pub + 13, 0xe4); poke8(bob_pub + 14, 0x35); poke8(bob_pub + 15, 0x37)
    poke8(bob_pub + 16, 0x3f); poke8(bob_pub + 17, 0x83); poke8(bob_pub + 18, 0x43); poke8(bob_pub + 19, 0xc8)
    poke8(bob_pub + 20, 0x5b); poke8(bob_pub + 21, 0x78); poke8(bob_pub + 22, 0x67); poke8(bob_pub + 23, 0x4d)
    poke8(bob_pub + 24, 0xad); poke8(bob_pub + 25, 0xfc); poke8(bob_pub + 26, 0x7e); poke8(bob_pub + 27, 0x14)
    poke8(bob_pub + 28, 0x6f); poke8(bob_pub + 29, 0x88); poke8(bob_pub + 30, 0x2b); poke8(bob_pub + 31, 0x4f)

    let out[32]
    x25519(alice_priv, bob_pub, out)
    assert_eq(bytes32_eq(out, shared_exp), 1)
}

// ── Field operation tests ──

test "x25519: fe_add limbs" {
    let r[32]
    x25_fe_add(r, x25_A_LIMBS, x25_B_LIMBS)
    assert_eq(bytes32_eq(r, x25_ADD_EXP), 1)
}

test "x25519: fe_sub limbs" {
    let r[32]
    x25_fe_sub(r, x25_A_LIMBS, x25_B_LIMBS)
    assert_eq(bytes32_eq(r, x25_SUB_EXP), 1)
}

test "x25519: fe_mul limbs" {
    let r[32]
    x25_fe_mul(r, x25_A_LIMBS, x25_B_LIMBS)
    assert_eq(bytes32_eq(r, x25_MUL_EXP), 1)
}

test "x25519: fe_sq limbs" {
    let r[32]
    x25_fe_sq(r, x25_A_LIMBS)
    assert_eq(bytes32_eq(r, x25_SQ_EXP), 1)
}

test "x25519: fe_invert limbs" {
    let r[32]
    x25_fe_invert(r, x25_A_LIMBS)
    assert_eq(bytes32_eq(r, x25_INV_EXP), 1)
}

// Exercise the not-equal path of the comparison helper (every other test compares
// equal arrays, so without this the `return 0` branch is never covered).
test "x25519: bytes32_eq detects a difference" {
    let a[4]; let b[4]
    let mut i = 0
    for i < 32 { poke8(a + i, i); poke8(b + i, i); i = i + 1 }
    poke8(b + 5, 0x63)
    assert_eq(bytes32_eq(a, b), 0)
}
