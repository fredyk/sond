// X25519 key exchange, RFC 7748 §5 clean library interface

// ── Field representation: 32-byte little-endian limb layout ──

let x25_P0 = 0xED
let x25_P31 = 0x7F
let x25_P38 = 38

fn x25_fe_copy(c: [], a: []) {
    let mut i = 0
    for i < 32 { c[i] = a[i]; i = i + 1 }
}

fn x25_fe_zero(c: []) {
    let mut i = 0
    for i < 32 { c[i] = 0; i = i + 1 }
}

fn x25_fe_one(c: []) {
    c[0] = 1
    let mut i = 1
    for i < 32 { c[i] = 0; i = i + 1 }
}

fn x25_fe_carry(h: []) {
    for {
        let mut carry = 0
        let mut i = 0
        for i < 31 {
            let v = h[i] + carry
            h[i] = v & 0xFF
            carry = v >>> 8
            i = i + 1
        }
        let v = h[31] + carry
        h[31] = v & 0xFF
        let fold = v >>> 8
        if fold == 0 { break }
        h[0] = h[0] + fold * x25_P38
    }
    // Fully reduce to [0, p)
    let mut need_sub = 0
    if h[31] > x25_P31 {
        need_sub = 1
    } else if h[31] == x25_P31 {
        if h[0] >= x25_P0 {
            need_sub = 1
            let mut i = 1
            for i < 31 {
                if h[i] < 0xFF { need_sub = 0; break }
                i = i + 1
            }
        }
    }
    if need_sub != 0 {
        let mut borrow = 0
        let mut i = 0
        for i < 32 {
            let pbyte = if i == 0 { x25_P0 } else if i == 31 { x25_P31 } else { 0xFF }
            let mut v = h[i] - pbyte - borrow
            if v < 0 { v = v + 256; borrow = 1 } else { borrow = 0 }
            h[i] = v
            i = i + 1
        }
    }
}

fn x25_fe_add(c: [], a: [], b: []) {
    let mut i = 0
    for i < 32 { c[i] = a[i] + b[i]; i = i + 1 }
    x25_fe_carry(c)
}

fn x25_fe_sub(c: [], a: [], b: []) {
    let mut borrow = 0
    let mut i = 0
    for i < 32 {
        let mut v = a[i] - b[i] - borrow
        if v < 0 { v = v + 256; borrow = 1 } else { borrow = 0 }
        c[i] = v
        i = i + 1
    }
    if borrow != 0 {
        let mut carry = 0
        let mut i = 0
        for i < 32 {
            let pbyte = if i == 0 { x25_P0 } else if i == 31 { x25_P31 } else { 0xFF }
            let v = c[i] + pbyte + carry
            c[i] = v & 0xFF
            carry = v >>> 8
            i = i + 1
        }
    }
    x25_fe_carry(c)
}

fn x25_fe_mul(c: [], a: [], b: []) {
    let mut prod[64]
    let mut i = 0
    for i < 64 { prod[i] = 0; i = i + 1 }
    i = 0
    for i < 32 {
        let mut j = 0
        for j < 32 {
            prod[i + j] = prod[i + j] + a[i] * b[j]
            j = j + 1
        }
        i = i + 1
    }
    i = 0
    for i < 32 {
        c[i] = prod[i] + x25_P38 * prod[i + 32]
        i = i + 1
    }
    x25_fe_carry(c)
}

fn x25_fe_sq(c: [], a: []) { x25_fe_mul(c, a, a) }

fn x25_fe_invert(z: [], x: []) {
    let mut exp[32]
    exp[0] = 0xEB; exp[1] = 0xFF; exp[2] = 0xFF; exp[3] = 0xFF
    exp[4] = 0xFF; exp[5] = 0xFF; exp[6] = 0xFF; exp[7] = 0xFF
    exp[8] = 0xFF; exp[9] = 0xFF; exp[10] = 0xFF; exp[11] = 0xFF
    exp[12] = 0xFF; exp[13] = 0xFF; exp[14] = 0xFF; exp[15] = 0xFF
    exp[16] = 0xFF; exp[17] = 0xFF; exp[18] = 0xFF; exp[19] = 0xFF
    exp[20] = 0xFF; exp[21] = 0xFF; exp[22] = 0xFF; exp[23] = 0xFF
    exp[24] = 0xFF; exp[25] = 0xFF; exp[26] = 0xFF; exp[27] = 0xFF
    exp[28] = 0xFF; exp[29] = 0xFF; exp[30] = 0xFF; exp[31] = 0x7F

    let mut r[32]
    x25_fe_one(r)
    let mut bit = 254
    for {
        let byte_idx = bit >>> 3
        let bit_idx = bit & 7
        let exp_bit = (exp[byte_idx] >>> bit_idx) & 1
        let mut t[32]
        x25_fe_sq(t, r)
        x25_fe_copy(r, t)
        if exp_bit != 0 {
            x25_fe_mul(t, r, x)
            x25_fe_copy(r, t)
        }
        if bit == 0 { break }
        bit = bit - 1
    }
    x25_fe_copy(z, r)
}

fn x25_cswap(swap: i64, x: [], y: []) {
    let mask = -swap
    let mut i = 0
    for i < 32 {
        let t = mask & (x[i] ^ y[i])
        x[i] = x[i] ^ t
        y[i] = y[i] ^ t
        i = i + 1
    }
}

fn x25_x25519_monty(result: [], scalar: [], u_coord: []) {
    let mut s[32]
    x25_fe_copy(s, scalar)
    s[0] = s[0] & 248
    s[31] = s[31] & 127
    s[31] = s[31] | 64

    let mut x1[32]; x25_fe_copy(x1, u_coord)
    x1[31] = x1[31] & 0x7f   // RFC 7748: mask bit 255 of the u-coordinate before use
    let mut x2[32]; x25_fe_one(x2)
    let mut z2[32]; x25_fe_zero(z2)
    let mut x3[32]; x25_fe_copy(x3, x1)
    let mut z3[32]; x25_fe_one(z3)

    let mut swap = 0
    let a24 = 121665
    let mut a24_arr[32]
    x25_fe_zero(a24_arr)
    a24_arr[0] = a24 & 0xFF
    a24_arr[1] = (a24 >>> 8) & 0xFF
    a24_arr[2] = (a24 >>> 16) & 0xFF

    let mut bit = 254
    for {
        let byte_idx = bit >>> 3
        let bit_idx = bit & 7
        let k_t = (s[byte_idx] >>> bit_idx) & 1

        swap = swap ^ k_t
        x25_cswap(swap, x2, x3)
        x25_cswap(swap, z2, z3)
        swap = k_t

        let mut A[32]; let mut AA[32]; let mut B[32]; let mut BB[32]
        let mut E[32]; let mut C[32]; let mut D[32]
        let mut DA[32]; let mut CB[32]; let mut t0[32]; let mut t1[32]

        x25_fe_add(A, x2, z2)
        x25_fe_sq(AA, A)
        x25_fe_sub(B, x2, z2)
        x25_fe_sq(BB, B)
        x25_fe_sub(E, AA, BB)
        x25_fe_add(C, x3, z3)
        x25_fe_sub(D, x3, z3)
        x25_fe_mul(DA, D, A)
        x25_fe_mul(CB, C, B)

        x25_fe_add(t0, DA, CB)
        x25_fe_sq(x3, t0)

        x25_fe_sub(t0, DA, CB)
        x25_fe_sq(t1, t0)
        x25_fe_mul(z3, x1, t1)

        x25_fe_mul(x2, AA, BB)

        x25_fe_mul(t0, E, a24_arr)
        x25_fe_add(t1, AA, t0)
        x25_fe_mul(z2, E, t1)

        if bit == 0 { break }
        bit = bit - 1
    }

    x25_cswap(swap, x2, x3)
    x25_cswap(swap, z2, z3)

    let mut inv_z2[32]
    x25_fe_invert(inv_z2, z2)
    x25_fe_mul(result, x2, inv_z2)
}

// ── Library boundary: x25519(scalar_ptr, u_ptr, out_ptr) ──

fn x25519(scalar_ptr: i64, u_ptr: i64, out_ptr: i64) {
    // load 32 bytes from scalar_ptr (packed bytes, peek8)
    let mut scalar[32]
    let mut i = 0
    for i < 32 {
        scalar[i] = peek8(scalar_ptr + i)
        i = i + 1
    }

    // load 32 bytes from u_ptr (packed bytes, peek8)
    let mut u[32]
    i = 0
    for i < 32 {
        u[i] = peek8(u_ptr + i)
        i = i + 1
    }

    let mut result[32]
    x25_x25519_monty(result, scalar, u)

    // store 32 bytes to out_ptr (packed bytes, poke8)
    i = 0
    for i < 32 {
        poke8(out_ptr + i, result[i] & 0xFF)
        i = i + 1
    }
}

