// X25519 key exchange: RFC 7748 §5 clean library interface

// ── Field representation: ten limbs, radix 2^25.5 ──
//
// A field element is ten limbs whose weights are 2^ceil(25.5*i), so limb i holds
// 26 bits when i is even and 25 when i is odd, and the ten together span exactly
// 2^255. Spanning 255 and not more is the whole point: a carry out of the top
// limb has weight 2^255, and 2^255 = 19 (mod p), so reduction folds it back with
// a factor of 19. Uniform 26-bit limbs would be simpler to index but span 2^260,
// making the fold 2^5*19 = 608, and 608 * (a product of two 26-bit limbs),
// accumulated ten times, overflows a signed 64-bit word. The half-bit is what
// keeps every intermediate inside i64.
//
// Why not one byte per limb (which is what this file used to do): a schoolbook
// product over 32 limbs is 32*32 = 1024 multiplications per field
// multiplication, against 10*10 = 100 here. A scalar multiplication runs a few
// thousand field multiplications, so the difference is the difference between a
// handshake costing milliseconds and costing tens of milliseconds.
//
// Limbs are kept non-negative throughout -- fe_sub adds a multiple of p rather
// than borrowing -- so every shift below is a logical shift and none of this
// depends on how the language rounds a negative division.

let x25_NLIMBS = 10

// Bit offset of limb i: ceil(25.5*i), written so it stays integer arithmetic.
fn x25_limb_shift(i: i64) -> i64 { (51 * i + 1) / 2 }

// Width of limb i in bits: 26 for even i, 25 for odd i.
fn x25_limb_bits(i: i64) -> i64 { x25_limb_shift(i + 1) - x25_limb_shift(i) }

fn x25_limb_mask(i: i64) -> i64 { (1 << x25_limb_bits(i)) - 1 }

// Limb i of 2p, used by fe_sub to stay non-negative. p = 2^255 - 19, which in
// this layout is "every limb full" minus 19 in the lowest limb.
fn x25_two_p_limb(i: i64) -> i64 {
    if i == 0 {
        return 2 * ((1 << 26) - 19)
    }
    2 * x25_limb_mask(i)
}

fn x25_fe_copy(c: [], a: []) {
    let mut i = 0
    for i < x25_NLIMBS { c[i] = a[i]; i = i + 1 }
}

fn x25_fe_zero(c: []) {
    let mut i = 0
    for i < x25_NLIMBS { c[i] = 0; i = i + 1 }
}

fn x25_fe_one(c: []) {
    c[0] = 1
    let mut i = 1
    for i < x25_NLIMBS { c[i] = 0; i = i + 1 }
}

// Normalize limbs back into range. Repeats because folding the top carry into
// limb 0 can itself produce a carry, but it converges immediately: each pass
// shrinks the leftover by ~2^25, so in practice this runs two or three times.
//
// The limb width is computed inline as 26 - (i & 1) rather than through the
// helpers above. This runs after every field operation -- a few thousand times
// per scalar multiplication, ten limbs each -- so calls here cost more than the
// multiplications in fe_mul do. The helpers stay for the packing routines,
// where clarity matters and the cost does not.
fn x25_fe_carry(h: []) {
    for {
        let mut carry = 0
        let mut i = 0
        for i < x25_NLIMBS {
            let bits = 26 - (i & 1)
            let v = h[i] + carry
            h[i] = v & ((1 << bits) - 1)
            carry = v >>> bits
            i = i + 1
        }
        if carry == 0 { break }
        h[0] = h[0] + carry * 19       // 2^255 = 19 (mod p)
    }
}

fn x25_fe_add(c: [], a: [], b: []) {
    let mut i = 0
    for i < x25_NLIMBS { c[i] = a[i] + b[i]; i = i + 1 }
    x25_fe_carry(c)
}

// c = a - b, computed as a + 2p - b so no limb ever goes negative. 2p - b[i] is
// positive for any carried b, and adding 2p does not change the value mod p.
fn x25_fe_sub(c: [], a: [], b: []) {
    let mut i = 0
    for i < x25_NLIMBS {
        let full = (1 << (26 - (i & 1))) - 1
        let twop = if i == 0 { 2 * (full - 18) } else { 2 * full }
        c[i] = a[i] + twop - b[i]
        i = i + 1
    }
    x25_fe_carry(c)
}

// Schoolbook product, 100 limb multiplications.
//
// Two details carry the reduction. A product of two odd limbs lands at a weight
// one bit below the destination limb's weight (that is the half in radix 25.5),
// so it is doubled. And a product whose index sum reaches ten has weight
// 2^255 times the weight of limb (k-10), so it folds down there scaled by 19.
//
// Bound: a limb is under 2^26, so a product is under 2^52; the fold multiplies
// by 19 and the odd-odd case by 2, giving under 2^57.3; ten of those accumulate
// to under 2^60.6, comfortably inside i64. This is why the inputs must be
// carried before the call -- every operation here leaves its result carried.
// Hoisting the 19-fold and the odd-odd doubling into precomputed arrays was
// measured and made this SLOWER (4716 us against 3637 us per scalar
// multiplication): the extra array and locals cost more here than the
// multiplications they save. Left as the straightforward version on purpose.
fn x25_fe_mul(c: [], a: [], b: []) {
    let mut h[10]
    let mut i = 0
    for i < x25_NLIMBS { h[i] = 0; i = i + 1 }

    i = 0
    for i < x25_NLIMBS {
        let mut j = 0
        for j < x25_NLIMBS {
            let mut t = a[i] * b[j]
            if (i & 1) == 1 && (j & 1) == 1 {
                t = t * 2
            }
            let k = i + j
            if k < x25_NLIMBS {
                h[k] = h[k] + t
            } else {
                h[k - x25_NLIMBS] = h[k - x25_NLIMBS] + 19 * t
            }
            j = j + 1
        }
        i = i + 1
    }

    i = 0
    for i < x25_NLIMBS { c[i] = h[i]; i = i + 1 }
    x25_fe_carry(c)
}

fn x25_fe_sq(c: [], a: []) { x25_fe_mul(c, a, a) }

// c = a * 121665, the curve constant (a-2)/4. A dedicated routine because a
// full field multiplication for a 17-bit constant would be wasteful, and
// 2^26 * 121665 stays well inside i64.
fn x25_fe_mul121665(c: [], a: []) {
    let mut i = 0
    for i < x25_NLIMBS { c[i] = a[i] * 121665; i = i + 1 }
    x25_fe_carry(c)
}

// Reduce to the canonical representative in [0, p).
//
// After carrying, h is below 2^255 but may still be >= p. Adding 19 overflows
// past 2^255 exactly when that is the case, and the overflowing sum, truncated
// to 255 bits, is already h - p.
fn x25_fe_reduce(h: []) {
    x25_fe_carry(h)

    let mut t[10]
    let mut i = 0
    for i < x25_NLIMBS { t[i] = h[i]; i = i + 1 }
    t[0] = t[0] + 19

    let mut carry = 0
    i = 0
    for i < x25_NLIMBS {
        let bits = 26 - (i & 1)
        let v = t[i] + carry
        t[i] = v & ((1 << bits) - 1)
        carry = v >>> bits
        i = i + 1
    }

    if carry != 0 {
        i = 0
        for i < x25_NLIMBS { h[i] = t[i]; i = i + 1 }
    }
}

// ── Packing ──
//
// Limb boundaries do not fall on byte boundaries, so these move one bit at a
// time. That is 255 iterations, run three times per scalar multiplication,
// against the millions of limb operations in the ladder: clarity is worth more
// here than speed.

fn x25_fe_frombytes(h: [], s: []) {
    let mut i = 0
    for i < x25_NLIMBS {
        let base = x25_limb_shift(i)
        let width = x25_limb_bits(i)
        let mut v = 0
        let mut b = 0
        for b < width {
            let pos = base + b
            let bit = (s[pos >>> 3] >>> (pos & 7)) & 1
            v = v | (bit << b)
            b = b + 1
        }
        h[i] = v
        i = i + 1
    }
}

fn x25_fe_tobytes(s: [], h: []) {
    x25_fe_reduce(h)
    let mut i = 0
    for i < 32 { s[i] = 0; i = i + 1 }
    i = 0
    for i < x25_NLIMBS {
        let base = x25_limb_shift(i)
        let width = x25_limb_bits(i)
        let mut b = 0
        for b < width {
            let bit = (h[i] >>> b) & 1
            if bit != 0 {
                let pos = base + b
                s[pos >>> 3] = s[pos >>> 3] | (1 << (pos & 7))
            }
            b = b + 1
        }
        i = i + 1
    }
}

// z = x^(p-2) = x^-1, by square-and-multiply over the bits of p-2.
fn x25_fe_invert(z: [], x: []) {
    // p - 2 = 2^255 - 21, little-endian: 0xEB, then 0xFF ..., then 0x7F.
    let mut exp[32]
    exp[0] = 0xEB
    let mut i = 1
    for i < 31 { exp[i] = 0xFF; i = i + 1 }
    exp[31] = 0x7F

    let mut r[10]
    x25_fe_one(r)
    let mut bit = 254
    for invariant { bit >= 0; bit < 256 } {
        let byte_idx = bit >>> 3
        let bit_idx = bit & 7
        let exp_bit = (exp[byte_idx] >>> bit_idx) & 1
        let mut t[10]
        x25_fe_sq(t, r)
        x25_fe_copy(r, t)
        if exp_bit != 0 {
            x25_fe_mul(t, r, x)
            x25_fe_copy(r, t)
        }
        if bit == 0 { break }
        bit = bit - 1
    }
    x25_fe_copy(z, r)
}

fn x25_cswap(swap: i64, x: [], y: []) {
    let mask = -swap
    let mut i = 0
    for i < x25_NLIMBS {
        let t = mask & (x[i] ^ y[i])
        x[i] = x[i] ^ t
        y[i] = y[i] ^ t
        i = i + 1
    }
}

// Montgomery ladder, RFC 7748 §5. `scalar` is 32 bytes; x1 is the u-coordinate
// as a field element; the result is left in `result` as a field element.
fn x25_x25519_monty(result: [], scalar: [], x1: []) {
    let mut s[32]
    let mut i = 0
    for i < 32 { s[i] = scalar[i]; i = i + 1 }
    s[0] = s[0] & 248
    s[31] = s[31] & 127
    s[31] = s[31] | 64

    let mut x2[10]; x25_fe_one(x2)
    let mut z2[10]; x25_fe_zero(z2)
    let mut x3[10]; x25_fe_copy(x3, x1)
    let mut z3[10]; x25_fe_one(z3)

    let mut swap = 0
    let mut bit = 254
    for invariant { bit >= 0; bit < 256 } {
        let byte_idx = bit >>> 3
        let bit_idx = bit & 7
        let k_t = (s[byte_idx] >>> bit_idx) & 1

        swap = swap ^ k_t
        x25_cswap(swap, x2, x3)
        x25_cswap(swap, z2, z3)
        swap = k_t

        let mut A[10]; let mut AA[10]; let mut B[10]; let mut BB[10]
        let mut E[10]; let mut C[10]; let mut D[10]
        let mut DA[10]; let mut CB[10]; let mut t0[10]; let mut t1[10]

        x25_fe_add(A, x2, z2)
        x25_fe_sq(AA, A)
        x25_fe_sub(B, x2, z2)
        x25_fe_sq(BB, B)
        x25_fe_sub(E, AA, BB)
        x25_fe_add(C, x3, z3)
        x25_fe_sub(D, x3, z3)
        x25_fe_mul(DA, D, A)
        x25_fe_mul(CB, C, B)

        x25_fe_add(t0, DA, CB)
        x25_fe_sq(x3, t0)

        x25_fe_sub(t0, DA, CB)
        x25_fe_sq(t1, t0)
        x25_fe_mul(z3, x1, t1)

        x25_fe_mul(x2, AA, BB)

        x25_fe_mul121665(t0, E)
        x25_fe_add(t1, AA, t0)
        x25_fe_mul(z2, E, t1)

        if bit == 0 { break }
        bit = bit - 1
    }

    x25_cswap(swap, x2, x3)
    x25_cswap(swap, z2, z3)

    let mut inv_z2[10]
    x25_fe_invert(inv_z2, z2)
    x25_fe_mul(result, x2, inv_z2)
}

// ── Library boundary: x25519(scalar_ptr, u_ptr, out_ptr) ──

fn x25519(scalar_ptr: i64, u_ptr: i64, out_ptr: i64) {
    let mut scalar[32]
    let mut i = 0
    for i < 32 {
        scalar[i] = peek8(scalar_ptr + i)
        i = i + 1
    }

    let mut u[32]
    i = 0
    for i < 32 {
        u[i] = peek8(u_ptr + i)
        i = i + 1
    }
    u[31] = u[31] & 0x7f   // RFC 7748: mask bit 255 of the u-coordinate before use

    let mut x1[10]
    x25_fe_frombytes(x1, u)

    let mut result[10]
    x25_x25519_monty(result, scalar, x1)

    let mut out[32]
    x25_fe_tobytes(out, result)

    i = 0
    for i < 32 {
        poke8(out_ptr + i, out[i] & 0xFF)
        i = i + 1
    }
}
