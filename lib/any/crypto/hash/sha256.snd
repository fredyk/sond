// SHA-256 (FIPS 180-4) over arbitrary-length byte buffers, reusable library.

let s256_K[64] = [
0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
]

let EXP_EMPTY[8] = [0xe3b0c442, 0x98fc1c14, 0x9afbf4c8, 0x996fb924,
                    0x27ae41e4, 0x649b934c, 0xa495991b, 0x7852b855]
let EXP_ABC[8] =   [0xba7816bf, 0x8f01cfea, 0x414140de, 0x5dae2223,
                    0xb00361a3, 0x96177a9c, 0xb410ff61, 0xf20015ad]
let EXP_A100[8] =  [0x28165978, 0x88e4a0d3, 0xa36b82b8, 0x3316ab32,
                    0x680eb8f0, 0x0f8cd3b9, 0x04d68124, 0x6d285a0e]

fn rotr(x: i64, n: i64) -> i64 {
    ((x >>> n) | ((x & 0xFFFFFFFF) << (32 - n))) & 0xFFFFFFFF
}

fn s256_ch(x: i64, y: i64, z: i64) -> i64 {
    (x & y) ^ ((x ^ 0xFFFFFFFF) & z)
}

fn s256_maj(x: i64, y: i64, z: i64) -> i64 {
    (x & y) ^ (x & z) ^ (y & z)
}

fn S0(x: i64) -> i64 {
    rotr(x, 2) ^ rotr(x, 13) ^ rotr(x, 22)
}

fn S1(x: i64) -> i64 {
    rotr(x, 6) ^ rotr(x, 11) ^ rotr(x, 25)
}

fn s0(x: i64) -> i64 {
    (rotr(x, 7) ^ rotr(x, 18) ^ (x >>> 3)) & 0xFFFFFFFF
}

fn s1(x: i64) -> i64 {
    (rotr(x, 17) ^ rotr(x, 19) ^ (x >>> 10)) & 0xFFFFFFFF
}

fn sha256_process_block(h: i64, block: i64) {
    let w[64]
    let mut t: i64
    t = 0
    for t < 16 {
        let off = t * 4
        let b0 = peek8(block + off)
        let b1 = peek8(block + off + 1)
        let b2 = peek8(block + off + 2)
        let b3 = peek8(block + off + 3)
        w[t] = (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
        t = t + 1
    }
    t = 16
    for t < 64 {
        let s1_w = s1(w[t - 2])
        let s0_w = s0(w[t - 15])
        w[t] = (s1_w + w[t - 7] + s0_w + w[t - 16]) & 0xFFFFFFFF
        t = t + 1
    }
    let mut a = peek64(h)
    let mut b = peek64(h + 8)
    let mut c = peek64(h + 16)
    let mut d = peek64(h + 24)
    let mut e = peek64(h + 32)
    let mut f = peek64(h + 40)
    let mut g = peek64(h + 48)
    let mut hh = peek64(h + 56)
    t = 0
    for t < 64 {
        let T1 = (hh + S1(e) + s256_ch(e, f, g) + s256_K[t] + w[t]) & 0xFFFFFFFF
        let T2 = (S0(a) + s256_maj(a, b, c)) & 0xFFFFFFFF
        hh = g
        g = f
        f = e
        e = (d + T1) & 0xFFFFFFFF
        d = c
        c = b
        b = a
        a = (T1 + T2) & 0xFFFFFFFF
        t = t + 1
    }
    poke64(h, (peek64(h) + a) & 0xFFFFFFFF)
    poke64(h + 8, (peek64(h + 8) + b) & 0xFFFFFFFF)
    poke64(h + 16, (peek64(h + 16) + c) & 0xFFFFFFFF)
    poke64(h + 24, (peek64(h + 24) + d) & 0xFFFFFFFF)
    poke64(h + 32, (peek64(h + 32) + e) & 0xFFFFFFFF)
    poke64(h + 40, (peek64(h + 40) + f) & 0xFFFFFFFF)
    poke64(h + 48, (peek64(h + 48) + g) & 0xFFFFFFFF)
    poke64(h + 56, (peek64(h + 56) + hh) & 0xFFFFFFFF)
}

fn sha256_hash(msg: i64, len: i64, out: i64) {
    let h[8]
    h[0] = 0x6a09e667
    h[1] = 0xbb67ae85
    h[2] = 0x3c6ef372
    h[3] = 0xa54ff53a
    h[4] = 0x510e527f
    h[5] = 0x9b05688c
    h[6] = 0x1f83d9ab
    h[7] = 0x5be0cd19
    let mut i = 0
    let full = len / 64
    for i < full {
        sha256_process_block(h, msg + i * 64)
        i = i + 1
    }
    let rem = len - full * 64
    let bit_len = len * 8
    let pad[64]
    i = 0
    for i < 64 {
        pad[i] = 0
        i = i + 1
    }
    i = 0
    for i < rem {
        poke8(pad + i, peek8(msg + full * 64 + i))
        i = i + 1
    }
    poke8(pad + rem, 0x80)
    if rem + 1 + 8 > 64 {
        sha256_process_block(h, pad)
        i = 0
        for i < 64 {
            pad[i] = 0
            i = i + 1
        }
        poke8(pad + 56, (bit_len >> 56) & 0xFF)
        poke8(pad + 57, (bit_len >> 48) & 0xFF)
        poke8(pad + 58, (bit_len >> 40) & 0xFF)
        poke8(pad + 59, (bit_len >> 32) & 0xFF)
        poke8(pad + 60, (bit_len >> 24) & 0xFF)
        poke8(pad + 61, (bit_len >> 16) & 0xFF)
        poke8(pad + 62, (bit_len >> 8) & 0xFF)
        poke8(pad + 63, bit_len & 0xFF)
        sha256_process_block(h, pad)
    } else {
        poke8(pad + 56, (bit_len >> 56) & 0xFF)
        poke8(pad + 57, (bit_len >> 48) & 0xFF)
        poke8(pad + 58, (bit_len >> 40) & 0xFF)
        poke8(pad + 59, (bit_len >> 32) & 0xFF)
        poke8(pad + 60, (bit_len >> 24) & 0xFF)
        poke8(pad + 61, (bit_len >> 16) & 0xFF)
        poke8(pad + 62, (bit_len >> 8) & 0xFF)
        poke8(pad + 63, bit_len & 0xFF)
        sha256_process_block(h, pad)
    }
    i = 0
    for i < 8 {
        let hv = h[i]
        poke8(out + i * 4, (hv >> 24) & 0xFF)
        poke8(out + i * 4 + 1, (hv >> 16) & 0xFF)
        poke8(out + i * 4 + 2, (hv >> 8) & 0xFF)
        poke8(out + i * 4 + 3, hv & 0xFF)
        i = i + 1
    }
}

