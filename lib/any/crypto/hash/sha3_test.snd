// lib/any/crypto/hash/sha3_test.snd: SHA-3 / SHAKE tests against NIST FIPS 202 vectors.

include "any/crypto/hash/sha3.snd"
include "x86_64/linux/testing.snd"

// Build a byte buffer from a string literal at compile time.
fn build_buf(str: i64, buf: i64, len: i64) {
    let mut i = 0
    for i < len {
        poke8(buf + i, peek8(str + i))
        i = i + 1
    }
}

fn hex_byte(h: i64) -> i64 {
    if h >= 48 && h <= 57 { return h - 48 }
    if h >= 97 && h <= 102 { return h - 87 }
    h - 55
}

fn buf_eq_hex(buf: i64, len: i64, hexstr: i64) -> i64 {
    let mut i = 0
    for i < len {
        let hi = hex_byte(peek8(hexstr + i * 2))
        let lo = hex_byte(peek8(hexstr + i * 2 + 1))
        if peek8(buf + i) != (hi * 16 + lo) { return 0 }
        i = i + 1
    }
    1
}

// SHA3-256 of "" = a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a
test "sha3_256_empty" {
    let out[32]
    sha3_256_hash(0, 0, out)
    let __s0_38: string = "a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a"
    assert_eq(buf_eq_hex(out, 32, __s0_38.utf8), 1)
}

// SHA3-256 of "abc" = 3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532
test "sha3_256_abc" {
    let msg[3]
    let out[32]
    let __lit0: string = "abc"
    build_buf(__lit0.utf8, msg, 3)
    sha3_256_hash(msg, 3, out)
    let __s1_49: string = "3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532"
    assert_eq(buf_eq_hex(out, 32, __s1_49.utf8), 1)
}

// SHA3-512 of "" = a69f73cca23a9ac5c8b567dc185a756e97c982164fe25859e0d1dcc1475c80a615b2123af1f5f94c11e3e9402c3ac558f500199d95b6d3e301758586281dcd26
test "sha3_512_empty" {
    let out[64]
    sha3_512_hash(0, 0, out)
    let __s2_57: string = "a69f73cca23a9ac5c8b567dc185a756e97c982164fe25859e0d1dcc1475c80a615b2123af1f5f94c11e3e9402c3ac558f500199d95b6d3e301758586281dcd26"
    assert_eq(buf_eq_hex(out, 64, __s2_57.utf8), 1)
}

// SHA3-512 of "abc" = b751850b1a57168a5693cd924b6b096e08f621827444f70d884f5d0240d2712e10e116e9192af3c91a7ec57647e3934057340b4cf408d5a56592f8274eec53f0
test "sha3_512_abc" {
    let msg[3]
    let out[64]
    let __lit1: string = "abc"
    build_buf(__lit1.utf8, msg, 3)
    sha3_512_hash(msg, 3, out)
    let __s3_68: string = "b751850b1a57168a5693cd924b6b096e08f621827444f70d884f5d0240d2712e10e116e9192af3c91a7ec57647e3934057340b4cf408d5a56592f8274eec53f0"
    assert_eq(buf_eq_hex(out, 64, __s3_68.utf8), 1)
}

// SHAKE128 of "" (32 bytes) = 7f9c2ba4e88f827d616045507605853ed73b8093f6efbc88eb1a6eacfa66ef26
test "shake128_empty_32" {
    let out[32]
    shake128(0, 0, out, 32)
    let __s4_76: string = "7f9c2ba4e88f827d616045507605853ed73b8093f6efbc88eb1a6eacfa66ef26"
    assert_eq(buf_eq_hex(out, 32, __s4_76.utf8), 1)
}

// SHAKE256 of "" (32 bytes) = 46b9dd2b0ba88d13233b3feb743eeb243fcd52ea62b81b82b50c27646ed5762f
test "shake256_empty_32" {
    let out[32]
    shake256(0, 0, out, 32)
    let __s5_84: string = "46b9dd2b0ba88d13233b3feb743eeb243fcd52ea62b81b82b50c27646ed5762f"
    assert_eq(buf_eq_hex(out, 32, __s5_84.utf8), 1)
}

// SHAKE256 of "" (64 bytes): full NIST vector
test "shake256_empty_64" {
    let out[64]
    shake256(0, 0, out, 64)
    let __s6_92: string = "46b9dd2b0ba88d13233b3feb743eeb243fcd52ea62b81b82b50c27646ed5762fd75dc4ddd8c0f200cb05019d67b592f6fc821c49479ab48640292eacb3b7c4be"
    assert_eq(buf_eq_hex(out, 64, __s6_92.utf8), 1)
}

// SHA3-256 of 200 bytes of 0x00
test "sha3_256_200_zeroes" {
    let msg[200]
    let out[32]
    let mut i = 0
    for i < 200 {
        poke8(msg + i, 0)
        i = i + 1
    }
    sha3_256_hash(msg, 200, out)
    let __s7_106: string = "2b43036c229ba512995f91fdb46fcd5327a4dc834d86d6e0f58a08053346dc2e"
    assert_eq(buf_eq_hex(out, 32, __s7_106.utf8), 1)
}