//
// lib/any/crypto/hash/sha3.snd: SHA-3 and SHAKE (FIPS 202).
// Keccak-f[1600] permutation + sponge construction.
//
// Public API:
//   sha3_256_hash(msg_ptr, msg_len, out_32)     // out_32 must be 32 bytes
//   sha3_512_hash(msg_ptr, msg_len, out_64)     // out_64 must be 64 bytes
//   shake128(msg_ptr, msg_len, out_ptr, out_len)
//   shake256(msg_ptr, msg_len, out_ptr, out_len)

// ---------------------------------------------------------------------------
// Keccak-f[1600] round constants (RC[24])
// ---------------------------------------------------------------------------

let keccak_RC[24] = [
    0x0000000000000001, 0x0000000000008082, 0x800000000000808A, 0x8000000080008000,
    0x000000000000808B, 0x0000000080000001, 0x8000000080008081, 0x8000000000008009,
    0x000000000000008A, 0x0000000000000088, 0x0000000080008009, 0x000000008000000A,
    0x000000008000808B, 0x800000000000008B, 0x8000000000008089, 0x8000000000008003,
    0x8000000000008002, 0x8000000000000080, 0x000000000000800A, 0x800000008000000A,
    0x8000000080008081, 0x8000000000008080, 0x0000000080000001, 0x8000000080008008
]

// ---------------------------------------------------------------------------
// Keccak-f[1600] permutation
// ---------------------------------------------------------------------------

fn keccak_f(st: i64) {
    // State is 25 × u64 at `st` (C-order: index = x + 5*y).
    // rho offsets per (x,y) in C-order:
    //   (0,0)=0   (1,0)=36  (2,0)=3   (3,0)=41  (4,0)=18
    //   (0,1)=1   (1,1)=44  (2,1)=10  (3,1)=45  (4,1)=2
    //   (0,2)=62  (1,2)=6   (2,2)=43  (3,2)=15  (4,2)=61
    //   (0,3)=28  (1,3)=55  (2,3)=25  (3,3)=21  (4,3)=56
    //   (0,4)=63  (1,4)=9   (2,4)=47  (3,4)=32  (4,4)=50
    //
    // Combined rho+pi mapping (computed from pi(x,y)=(y, 2x+3y mod 5)):
    // new[i'] = rotl(old[i], rho[i]) where i' = y + 5*((2*x+3*y) mod 5)
    // and i = x + 5*y.

    // Copy state into local variables.
    let mut s0  = peek64(st + 0 * 8);  let mut s1  = peek64(st + 1 * 8)
    let mut s2  = peek64(st + 2 * 8);  let mut s3  = peek64(st + 3 * 8)
    let mut s4  = peek64(st + 4 * 8);  let mut s5  = peek64(st + 5 * 8)
    let mut s6  = peek64(st + 6 * 8);  let mut s7  = peek64(st + 7 * 8)
    let mut s8  = peek64(st + 8 * 8);  let mut s9  = peek64(st + 9 * 8)
    let mut s10 = peek64(st + 10 * 8); let mut s11 = peek64(st + 11 * 8)
    let mut s12 = peek64(st + 12 * 8); let mut s13 = peek64(st + 13 * 8)
    let mut s14 = peek64(st + 14 * 8); let mut s15 = peek64(st + 15 * 8)
    let mut s16 = peek64(st + 16 * 8); let mut s17 = peek64(st + 17 * 8)
    let mut s18 = peek64(st + 18 * 8); let mut s19 = peek64(st + 19 * 8)
    let mut s20 = peek64(st + 20 * 8); let mut s21 = peek64(st + 21 * 8)
    let mut s22 = peek64(st + 22 * 8); let mut s23 = peek64(st + 23 * 8)
    let mut s24 = peek64(st + 24 * 8)

    let mut round: i64 = 0

    for round < 24 {
        // --- theta ---
        let mut c0 = s0  ^ s5  ^ s10 ^ s15 ^ s20
        let mut c1 = s1  ^ s6  ^ s11 ^ s16 ^ s21
        let mut c2 = s2  ^ s7  ^ s12 ^ s17 ^ s22
        let mut c3 = s3  ^ s8  ^ s13 ^ s18 ^ s23
        let mut c4 = s4  ^ s9  ^ s14 ^ s19 ^ s24

        let mut d0 = c4 ^ (c1 << 1 | c1 >>> 63)
        let mut d1 = c0 ^ (c2 << 1 | c2 >>> 63)
        let mut d2 = c1 ^ (c3 << 1 | c3 >>> 63)
        let mut d3 = c2 ^ (c4 << 1 | c4 >>> 63)
        let mut d4 = c3 ^ (c0 << 1 | c0 >>> 63)

        // Every lane in column x is XORed with D[x]; x = i mod 5 for lane i.
        s0 = s0 ^ d0
        s1 = s1 ^ d1
        s2 = s2 ^ d2
        s3 = s3 ^ d3
        s4 = s4 ^ d4
        s5 = s5 ^ d0
        s6 = s6 ^ d1
        s7 = s7 ^ d2
        s8 = s8 ^ d3
        s9 = s9 ^ d4
        s10 = s10 ^ d0
        s11 = s11 ^ d1
        s12 = s12 ^ d2
        s13 = s13 ^ d3
        s14 = s14 ^ d4
        s15 = s15 ^ d0
        s16 = s16 ^ d1
        s17 = s17 ^ d2
        s18 = s18 ^ d3
        s19 = s19 ^ d4
        s20 = s20 ^ d0
        s21 = s21 ^ d1
        s22 = s22 ^ d2
        s23 = s23 ^ d3
        s24 = s24 ^ d4

        // --- rho + pi (combined) ---
        let t0  = s0;  let t1  = s1;  let t2  = s2
        let t3  = s3;  let t4  = s4
        let t5  = s5;  let t6  = s6;  let t7  = s7
        let t8  = s8;  let t9  = s9
        let t10 = s10; let t11 = s11; let t12 = s12
        let t13 = s13; let t14 = s14
        let t15 = s15; let t16 = s16; let t17 = s17
        let t18 = s18; let t19 = s19
        let t20 = s20; let t21 = s21; let t22 = s22
        let t23 = s23; let t24 = s24

        // rho is a LEFT rotation by the lane offset (not a shift): rotl64(t, n) =
        // (t << n) | (t >>> (64 - n)). Offset 0 is the identity.
        s0  = t0
        s1  = (t6 << 44) | (t6 >>> 20)
        s2  = (t12 << 43) | (t12 >>> 21)
        s3  = (t18 << 21) | (t18 >>> 43)
        s4  = (t24 << 14) | (t24 >>> 50)
        s5  = (t3 << 28) | (t3 >>> 36)
        s6  = (t9 << 20) | (t9 >>> 44)
        s7  = (t10 << 3) | (t10 >>> 61)
        s8  = (t16 << 45) | (t16 >>> 19)
        s9  = (t22 << 61) | (t22 >>> 3)
        s10 = (t1 << 1) | (t1 >>> 63)
        s11 = (t7 << 6) | (t7 >>> 58)
        s12 = (t13 << 25) | (t13 >>> 39)
        s13 = (t19 << 8) | (t19 >>> 56)
        s14 = (t20 << 18) | (t20 >>> 46)
        s15 = (t4 << 27) | (t4 >>> 37)
        s16 = (t5 << 36) | (t5 >>> 28)
        s17 = (t11 << 10) | (t11 >>> 54)
        s18 = (t17 << 15) | (t17 >>> 49)
        s19 = (t23 << 56) | (t23 >>> 8)
        s20 = (t2 << 62) | (t2 >>> 2)
        s21 = (t8 << 55) | (t8 >>> 9)
        s22 = (t14 << 39) | (t14 >>> 25)
        s23 = (t15 << 41) | (t15 >>> 23)
        s24 = (t21 << 2) | (t21 >>> 62)

        // --- chi ---
        let t0  = s0  ^ ((~s1) & s2)
        let t1  = s1  ^ ((~s2) & s3)
        let t2  = s2  ^ ((~s3) & s4)
        let t3  = s3  ^ ((~s4) & s0)
        let t4  = s4  ^ ((~s0) & s1)
        let t5  = s5  ^ ((~s6) & s7)
        let t6  = s6  ^ ((~s7) & s8)
        let t7  = s7  ^ ((~s8) & s9)
        let t8  = s8  ^ ((~s9) & s5)
        let t9  = s9  ^ ((~s5) & s6)
        let t10 = s10 ^ ((~s11) & s12)
        let t11 = s11 ^ ((~s12) & s13)
        let t12 = s12 ^ ((~s13) & s14)
        let t13 = s13 ^ ((~s14) & s10)
        let t14 = s14 ^ ((~s10) & s11)
        let t15 = s15 ^ ((~s16) & s17)
        let t16 = s16 ^ ((~s17) & s18)
        let t17 = s17 ^ ((~s18) & s19)
        let t18 = s18 ^ ((~s19) & s15)
        let t19 = s19 ^ ((~s15) & s16)
        let t20 = s20 ^ ((~s21) & s22)
        let t21 = s21 ^ ((~s22) & s23)
        let t22 = s22 ^ ((~s23) & s24)
        let t23 = s23 ^ ((~s24) & s20)
        let t24 = s24 ^ ((~s20) & s21)
        s0  = t0;  s1  = t1;  s2  = t2;  s3  = t3;  s4  = t4
        s5  = t5;  s6  = t6;  s7  = t7;  s8  = t8;  s9  = t9
        s10 = t10; s11 = t11; s12 = t12; s13 = t13; s14 = t14
        s15 = t15; s16 = t16; s17 = t17; s18 = t18; s19 = t19
        s20 = t20; s21 = t21; s22 = t22; s23 = t23; s24 = t24

        // --- iota ---
        s0 = s0 ^ keccak_RC[round]

        round = round + 1
    }

    // Write state back to main memory.
    poke64(st + 0 * 8, s0)
    poke64(st + 1 * 8, s1)
    poke64(st + 2 * 8, s2)
    poke64(st + 3 * 8, s3)
    poke64(st + 4 * 8, s4)
    poke64(st + 5 * 8, s5)
    poke64(st + 6 * 8, s6)
    poke64(st + 7 * 8, s7)
    poke64(st + 8 * 8, s8)
    poke64(st + 9 * 8, s9)
    poke64(st + 10 * 8, s10)
    poke64(st + 11 * 8, s11)
    poke64(st + 12 * 8, s12)
    poke64(st + 13 * 8, s13)
    poke64(st + 14 * 8, s14)
    poke64(st + 15 * 8, s15)
    poke64(st + 16 * 8, s16)
    poke64(st + 17 * 8, s17)
    poke64(st + 18 * 8, s18)
    poke64(st + 19 * 8, s19)
    poke64(st + 20 * 8, s20)
    poke64(st + 21 * 8, s21)
    poke64(st + 22 * 8, s22)
    poke64(st + 23 * 8, s23)
    poke64(st + 24 * 8, s24)
}

// ---------------------------------------------------------------------------
// Keccak sponge helpers
// ---------------------------------------------------------------------------

// XOR `n` bytes of `data` into the first `n` bytes of the state (little-endian
// lane layout). This is the sponge's absorb of one rate-sized block.
fn absorb_xor(st: i64, data: i64, n: i64) {
    let mut i: i64 = 0
    for i < n {
        let lane = st + (i / 8) * 8
        let sh = (i % 8) * 8
        poke64(lane, peek64(lane) ^ (peek8(data + i) << sh))
        i = i + 1
    }
}

// The full Keccak sponge: zero the state, absorb `msg` block by block, apply the
// pad10*1 padding with the domain separator (0x06 for SHA-3, 0x1F for SHAKE), then
// squeeze `out_len` bytes. Handles any message length, including 0 and multiples of
// the rate (which get their own padding block).
fn keccak_sponge(rate: i64, domain: i64, msg: i64, msg_len: i64, out: i64, out_len: i64) {
    let st[25]
    let mut i = 0
    for i < 25 { poke64(st + i * 8, 0)  i = i + 1 }

    // Absorb every complete rate-sized block.
    let mut off = 0
    for msg_len - off >= rate {
        absorb_xor(st, msg + off, rate)
        keccak_f(st)
        off = off + rate
    }

    // Final block: the remaining bytes, then pad10*1 (domain byte at the tail of the
    // message, 0x80 at the last byte of the block; they coincide when rem == rate-1).
    let rem = msg_len - off
    let blk[25]
    let mut j = 0
    for j < rate { poke8(blk + j, 0)  j = j + 1 }
    j = 0
    for j < rem { poke8(blk + j, peek8(msg + off + j))  j = j + 1 }
    poke8(blk + rem, domain)
    poke8(blk + rate - 1, peek8(blk + rate - 1) ^ 0x80)
    absorb_xor(st, blk, rate)
    keccak_f(st)

    squeeze_keccak(st, rate, out, out_len)
}

fn squeeze_keccak(st: i64, rate: i64, out: i64, out_len: i64) {
    let mut out_pos: i64 = 0
    let mut remaining = out_len

    for {
        if remaining == 0 { break }
        let to_copy = if remaining < rate { remaining } else { rate }
        let mut i = 0
        for i < to_copy {
            let byte_idx = i % rate
            let lane_idx = byte_idx / 8
            let byte_in_lane = byte_idx % 8
            let word = peek64(st + lane_idx * 8)
            poke8(out + out_pos, (word >>> (byte_in_lane * 8)) & 0xFF)
            i = i + 1
            out_pos = out_pos + 1
        }
        remaining = remaining - to_copy
        if remaining > 0 {
            keccak_f(st)
        }
    }
}

// ---------------------------------------------------------------------------
// Public API
// ---------------------------------------------------------------------------

// SHA3-256: rate 136 bytes (capacity 512 bits), domain 0x06, 32-byte digest.
fn sha3_256_hash(msg: i64, msg_len: i64, out: i64) {
    keccak_sponge(136, 0x06, msg, msg_len, out, 32)
}

// SHA3-512: rate 72 bytes (capacity 1024 bits), domain 0x06, 64-byte digest.
fn sha3_512_hash(msg: i64, msg_len: i64, out: i64) {
    keccak_sponge(72, 0x06, msg, msg_len, out, 64)
}

// SHAKE128: rate 168 bytes (capacity 256 bits), domain 0x1F, arbitrary-length output.
fn shake128(msg: i64, msg_len: i64, out: i64, out_len: i64) {
    keccak_sponge(168, 0x1F, msg, msg_len, out, out_len)
}

// SHAKE256: rate 136 bytes (capacity 512 bits), domain 0x1F, arbitrary-length output.
fn shake256(msg: i64, msg_len: i64, out: i64, out_len: i64) {
    keccak_sponge(136, 0x1F, msg, msg_len, out, out_len)
}