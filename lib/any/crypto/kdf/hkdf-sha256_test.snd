//
// Test of hkdf-sha256.snd against RFC 5869 official vectors (TC1 and TC3).
// Returns 0 if all pass, !=0 if any fail.

include "x86_64/linux/io.snd"
include "any/strings.snd"
include "any/crypto/kdf/hkdf-sha256.snd"

fn puts(s: i64) { write_buf(1, s, strlen(s)) }

fn hexval(c: i64) -> i64 {
    if c >= 48 && c <= 57 { return c - 48 }       // 0-9
    if c >= 97 && c <= 102 { return c - 87 }      // a-f
    c - 55                                        // A-F
}

// 1 if buf[0..n] matches the hex string `hexstr` (2 chars per byte), 0 if not.
fn eq_hex(buf: i64, n: i64, hexstr: i64) -> i64 {
    let mut i = 0
    for i < n {
        let hi = hexval(peek8(hexstr + i * 2))
        let lo = hexval(peek8(hexstr + i * 2 + 1))
        if peek8(buf + i) != (hi * 16 + lo) {
            return 0
        }
        i = i + 1
    }
    1
}

fn main() -> i64 {
    // --- RFC 5869 Test Case 1 ---
    let ikm[22]
    let mut i = 0
    for i < 22 { poke8(ikm + i, 0x0b) i = i + 1 }
    let salt[13]
    i = 0
    for i < 13 { poke8(salt + i, i) i = i + 1 }          // 00..0c
    let info[10]
    i = 0
    for i < 10 { poke8(info + i, 0xf0 + i) i = i + 1 }    // f0..f9

    let prk[32]
    hkdf_extract(salt, 13, ikm, 22, prk)
    if eq_hex(prk, 32, "077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5") == 0 {
        puts("FAIL TC1 PRK\n") return 1
    }
    let okm[42]
    hkdf_expand(prk, info, 10, okm, 42)
    if eq_hex(okm, 42, "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865") == 0 {
        puts("FAIL TC1 OKM\n") return 1
    }

    // --- RFC 5869 Test Case 3 (empty salt and info, L=42) ---
    let prk3[32]
    hkdf_extract(0, 0, ikm, 22, prk3)
    if eq_hex(prk3, 32, "19ef24a32c717b167f33a91d6f648bdf96596776afdb6377ac434c1c293ccb04") == 0 {
        puts("FAIL TC3 PRK\n") return 1
    }
    let okm3[42]
    hkdf_expand(prk3, 0, 0, okm3, 42)
    if eq_hex(okm3, 42, "8da4e775a563c18f715f802a063c5a31b8a11f5c5ee1879ec3454e5f3c738d2d9d201395faa4b61a96c8") == 0 {
        puts("FAIL TC3 OKM\n") return 1
    }

    puts("OK hkdf-sha256 (RFC 5869 TC1+TC3)\n")
    0
}
