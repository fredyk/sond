//
// Poly1305 one-time authenticator (RFC 8439 §2.5), reusable library.
// Exposes poly1305_mac(msg_ptr, len, key_ptr, tag_ptr) writing a 16-byte tag.

// ---------------------------------------------------------------------------
// Internal: load 16 bytes from `src` into 5×i64 limbs at `limbs` (little-endian)
// ---------------------------------------------------------------------------

fn load_key_limbs(limbs: i64, src: i64) {
    let b0 = peek8(src); let b1 = peek8(src + 1); let b2 = peek8(src + 2)
    let b3 = peek8(src + 3); let b4 = peek8(src + 4); let b5 = peek8(src + 5)
    let b6 = peek8(src + 6); let b7 = peek8(src + 7); let b8 = peek8(src + 8)
    let b9 = peek8(src + 9); let b10 = peek8(src + 10); let b11 = peek8(src + 11)
    let b12 = peek8(src + 12); let b13 = peek8(src + 13); let b14 = peek8(src + 14)
    let b15 = peek8(src + 15)
    poke64(limbs, b0 | (b1 << 8) | (b2 << 16) | ((b3 & 3) << 24))
    poke64(limbs + 8, (b3 >> 2) | (b4 << 6) | (b5 << 14) | ((b6 & 15) << 22))
    poke64(limbs + 16, (b6 >> 4) | (b7 << 4) | (b8 << 12) | ((b9 & 63) << 20))
    poke64(limbs + 24, (b9 >> 6) | (b10 << 2) | (b11 << 10) | (b12 << 18))
    poke64(limbs + 32, b13 | (b14 << 8) | (b15 << 16))
}

// ---------------------------------------------------------------------------
// Internal: load a block (padded to 17 bytes with 0x01 then zeros) into limbs
// ---------------------------------------------------------------------------

fn load_block_limbs(limbs: i64, src: i64, n: i64) {
    let mut i = 0
    let b[17]
    for i < n {
        poke8(b + i, peek8(src + i))
        i = i + 1
    }
    poke8(b + n, 0x01)
    i = n + 1
    for i < 17 {
        poke8(b + i, 0)
        i = i + 1
    }
    let b0 = peek8(b); let b1 = peek8(b + 1); let b2 = peek8(b + 2)
    let b3 = peek8(b + 3); let b4 = peek8(b + 4); let b5 = peek8(b + 5)
    let b6 = peek8(b + 6); let b7 = peek8(b + 7); let b8 = peek8(b + 8)
    let b9 = peek8(b + 9); let b10 = peek8(b + 10); let b11 = peek8(b + 11)
    let b12 = peek8(b + 12); let b13 = peek8(b + 13); let b14 = peek8(b + 14)
    let b15 = peek8(b + 15); let b16v = peek8(b + 16)
    poke64(limbs, b0 | (b1 << 8) | (b2 << 16) | ((b3 & 3) << 24))
    poke64(limbs + 8, (b3 >> 2) | (b4 << 6) | (b5 << 14) | ((b6 & 15) << 22))
    poke64(limbs + 16, (b6 >> 4) | (b7 << 4) | (b8 << 12) | ((b9 & 63) << 20))
    poke64(limbs + 24, (b9 >> 6) | (b10 << 2) | (b11 << 10) | (b12 << 18))
    poke64(limbs + 32, b13 | (b14 << 8) | (b15 << 16) | ((b16v & 3) << 24))
}

// ---------------------------------------------------------------------------
// Internal: add two 5-limb values (mod 2^130-5) into a (caller-allocated)
// ---------------------------------------------------------------------------

fn add_limbs(a: i64, b: i64) {
    let mut sum = peek64(a) + peek64(b)
    let mut w0 = sum & 0x3FFFFFF; let mut carry = sum >> 26
    sum = peek64(a + 8) + peek64(b + 8) + carry
    let mut w1 = sum & 0x3FFFFFF; carry = sum >> 26
    sum = peek64(a + 16) + peek64(b + 16) + carry
    let mut w2 = sum & 0x3FFFFFF; carry = sum >> 26
    sum = peek64(a + 24) + peek64(b + 24) + carry
    let mut w3 = sum & 0x3FFFFFF; carry = sum >> 26
    sum = peek64(a + 32) + peek64(b + 32) + carry
    let mut w4 = sum & 0x3FFFFFF; carry = sum >> 26
    w0 = w0 + carry * 5
    carry = w0 >> 26; w0 = w0 & 0x3FFFFFF
    w1 = w1 + carry; carry = w1 >> 26; w1 = w1 & 0x3FFFFFF
    w2 = w2 + carry; carry = w2 >> 26; w2 = w2 & 0x3FFFFFF
    w3 = w3 + carry; carry = w3 >> 26; w3 = w3 & 0x3FFFFFF
    w4 = w4 + carry; w4 = w4 & 0x3FFFFFF
    poke64(a, w0); poke64(a + 8, w1); poke64(a + 16, w2)
    poke64(a + 24, w3); poke64(a + 32, w4)
}

// ---------------------------------------------------------------------------
// Internal: mul_mod_p multiplies two 5-limb numbers mod 2^130-5, result in a
//           tmp must be at least 9 words (72 bytes)
// ---------------------------------------------------------------------------

fn mul_mod_p(a: i64, b: i64, tmp: i64) {
    let a0 = peek64(a); let a1 = peek64(a + 8); let a2 = peek64(a + 16)
    let a3 = peek64(a + 24); let a4 = peek64(a + 32)
    let b0 = peek64(b); let b1 = peek64(b + 8); let b2 = peek64(b + 16)
    let b3 = peek64(b + 24); let b4 = peek64(b + 32)

    poke64(tmp, a0 * b0)
    poke64(tmp + 8, a0 * b1 + a1 * b0)
    poke64(tmp + 16, a0 * b2 + a1 * b1 + a2 * b0)
    poke64(tmp + 24, a0 * b3 + a1 * b2 + a2 * b1 + a3 * b0)
    poke64(tmp + 32, a0 * b4 + a1 * b3 + a2 * b2 + a3 * b1 + a4 * b0)
    poke64(tmp + 40, a1 * b4 + a2 * b3 + a3 * b2 + a4 * b1)
    poke64(tmp + 48, a2 * b4 + a3 * b3 + a4 * b2)
    poke64(tmp + 56, a3 * b4 + a4 * b3)
    poke64(tmp + 64, a4 * b4)

    let t0 = peek64(tmp); let t1 = peek64(tmp + 8); let t2 = peek64(tmp + 16)
    let t3 = peek64(tmp + 24); let t4 = peek64(tmp + 32)
    let t5 = peek64(tmp + 40); let t6 = peek64(tmp + 48)
    let t7 = peek64(tmp + 56); let t8 = peek64(tmp + 64)

    let mut r0 = t0 + 5 * t5; let mut r1 = t1 + 5 * t6
    let mut r2 = t2 + 5 * t7; let mut r3 = t3 + 5 * t8; let mut r4 = t4

    let mut cc = r0 >> 26; r0 = r0 & 0x3FFFFFF
    r1 = r1 + cc; cc = r1 >> 26; r1 = r1 & 0x3FFFFFF
    r2 = r2 + cc; cc = r2 >> 26; r2 = r2 & 0x3FFFFFF
    r3 = r3 + cc; cc = r3 >> 26; r3 = r3 & 0x3FFFFFF
    r4 = r4 + cc; cc = r4 >> 26; r4 = r4 & 0x3FFFFFF
    if cc != 0 {
        r0 = r0 + 5 * cc
        cc = r0 >> 26; r0 = r0 & 0x3FFFFFF
        r1 = r1 + cc; cc = r1 >> 26; r1 = r1 & 0x3FFFFFF
        r2 = r2 + cc; cc = r2 >> 26; r2 = r2 & 0x3FFFFFF
        r3 = r3 + cc; cc = r3 >> 26; r3 = r3 & 0x3FFFFFF
        r4 = r4 + cc; r4 = r4 & 0x3FFFFFF
    }
    poke64(a, r0); poke64(a + 8, r1); poke64(a + 16, r2)
    poke64(a + 24, r3); poke64(a + 32, r4)
}

// ---------------------------------------------------------------------------
// CLIBRARY INTERFACE: poly1305_mac
//   msg_ptr:  pointer to message bytes
//   len:      message length in bytes
//   key_ptr:  pointer to 32-byte key (r || s)
//   tag_ptr:  pointer to 16-byte output buffer for the tag
// ---------------------------------------------------------------------------

fn poly1305_mac(msg_ptr: i64, len: i64, key_ptr: i64, tag_ptr: i64) {
    // Clamp r (first 16 bytes of key) and load r, s as 5-limb values
    let mut r_bytes[16]
    let mut i = 0
    for i < 16 {
        poke8(r_bytes + i, peek8(key_ptr + i))
        i = i + 1
    }
    // Clamp: clear bits that would keep r below the prime-order
    poke8(r_bytes + 3, peek8(r_bytes + 3) & 15)
    poke8(r_bytes + 7, peek8(r_bytes + 7) & 15)
    poke8(r_bytes + 11, peek8(r_bytes + 11) & 15)
    poke8(r_bytes + 15, peek8(r_bytes + 15) & 15)
    poke8(r_bytes + 4, peek8(r_bytes + 4) & 252)
    poke8(r_bytes + 8, peek8(r_bytes + 8) & 252)
    poke8(r_bytes + 12, peek8(r_bytes + 12) & 252)

    let r_limbs[5]
    load_key_limbs(r_limbs, r_bytes)

    let s_limbs[5]
    load_key_limbs(s_limbs, key_ptr + 16)

    // Accumulator = 0
    let acc[5]; poke64(acc, 0); poke64(acc + 8, 0); poke64(acc + 16, 0); poke64(acc + 24, 0); poke64(acc + 32, 0)
    let block[5]
    let tmp[9]
    let mut offset = 0
    for offset < len {
        let mut n = len - offset
        if n > 16 { n = 16 }
        load_block_limbs(block, msg_ptr + offset, n)
        add_limbs(acc, block)
        mul_mod_p(acc, r_limbs, tmp)
        offset = offset + n
    }

    // Add s to accumulator
    add_limbs(acc, s_limbs)

    // Serialize accumulator (little-endian) into tag
    let a0 = peek64(acc); let a1 = peek64(acc + 8); let a2 = peek64(acc + 16)
    let a3 = peek64(acc + 24); let a4 = peek64(acc + 32)
    poke8(tag_ptr, a0 & 0xFF)
    poke8(tag_ptr + 1, (a0 >> 8) & 0xFF)
    poke8(tag_ptr + 2, (a0 >> 16) & 0xFF)
    poke8(tag_ptr + 3, ((a0 >> 24) & 3) | ((a1 << 2) & 0xFF))
    poke8(tag_ptr + 4, (a1 >> 6) & 0xFF)
    poke8(tag_ptr + 5, (a1 >> 14) & 0xFF)
    poke8(tag_ptr + 6, ((a1 >> 22) & 0x0F) | ((a2 << 4) & 0xF0))
    poke8(tag_ptr + 7, (a2 >> 4) & 0xFF)
    poke8(tag_ptr + 8, (a2 >> 12) & 0xFF)
    poke8(tag_ptr + 9, ((a2 >> 20) & 0x3F) | ((a3 << 6) & 0xC0))
    poke8(tag_ptr + 10, (a3 >> 2) & 0xFF)
    poke8(tag_ptr + 11, (a3 >> 10) & 0xFF)
    poke8(tag_ptr + 12, (a3 >> 18) & 0xFF)
    poke8(tag_ptr + 13, a4 & 0xFF)
    poke8(tag_ptr + 14, (a4 >> 8) & 0xFF)
    poke8(tag_ptr + 15, (a4 >> 16) & 0xFF)
}

// ---------------------------------------------------------------------------
// Self-test (RFC 8439 §2.5.2)
// ---------------------------------------------------------------------------

