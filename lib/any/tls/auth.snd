//
// lib/any/tls/auth.snd: server authentication for the TLS 1.3 client. On top of the
// handshake in client.snd, it decrypts the server flight, parses the Certificate, and
// verifies the server CertificateVerify (RFC 8446 4.4.3) with the leaf certificate key,
// so the peer proves it holds that key. Validated end to end against a live public server:
// a program calling tls_handshake_auth(<ip>, 443, <host>, len) returns 1 against
// cloudflare.com. A network-free replay test (a captured flight + its traffic secret) is a
// follow-up; a fully synthetic one needs an ECDSA signer, which is a separate piece.

include "any/tls/client.snd"
include "any/tls/certmsg.snd"
include "any/x509/verify.snd"
include "any/crypto/hash/sha256.snd"

// Walks the decrypted handshake flight in buf[0..n) and returns the byte offset of the
// CertificateVerify message (type 15), or -1 if it is not fully present yet.
fn tls_flight_cv_offset(buf: i64, n: i64) -> i64 {
    let mut p = 0
    for p + 4 <= n {
        let t = peek8(buf + p)
        let mlen = (peek8(buf + p + 1) << 16) | (peek8(buf + p + 2) << 8) | peek8(buf + p + 3)
        if p + 4 + mlen > n { return 0 - 1 }
        if t == 15 { return p }
        p = p + 4 + mlen
    }
    0 - 1
}

// Returns the byte offset of the Certificate message (type 11) in the flight, or -1.
fn tls_flight_cert_offset(buf: i64, n: i64) -> i64 {
    let mut p = 0
    for p + 4 <= n {
        let t = peek8(buf + p)
        let mlen = (peek8(buf + p + 1) << 16) | (peek8(buf + p + 2) << 8) | peek8(buf + p + 3)
        if t == 11 { return p }
        p = p + 4 + mlen
    }
    0 - 1
}

// Full client handshake through server authentication: connects, exchanges hello, derives
// the handshake keys, decrypts the server flight, and VERIFIES the server CertificateVerify
// (RFC 8446 4.4.3) with the leaf certificate's key. Returns 1 if the server proved it holds
// the certificate key (ecdsa_secp256r1_sha256), 0 otherwise. This is the identity check
// that a TLS client must pass before trusting the peer.
fn tls_handshake_auth(host: i64, port: i64, sni: i64, snilen: i64) -> i64 {
    let fd = sock(AF_INET, SOCK_STREAM, 0)
    if fd < 0 { return 0 }
    let sa[2]
    sockaddr_in_build(sa, tls_ipv4(host), port)
    if connect_sock(fd, sa, 16) < 0 { close_fd(fd); return 0 }

    let cpriv[32]
    tls_random(cpriv, 32)
    let base9[32]
    poke8(base9, 9)
    let mut i = 0
    for i < 31 { poke8(base9 + 1 + i, 0); i = i + 1 }
    let cpub[32]
    x25519(cpriv, base9, cpub)
    let random[32]
    tls_random(random, 32)
    let ch = heap_alloc(1024)
    let chlen = tls_build_client_hello(random, cpub, sni, snilen, ch)
    let scratch = heap_alloc(4096)
    tls_send_plain_handshake(fd, ch, chlen, scratch)

    let rec = heap_alloc(20000)
    let rl = tls_read_record(fd, rec, 20000)
    if rl <= 0 { close_fd(fd); return 0 }
    if peek8(rec) != 22 { close_fd(fd); return 0 }
    let shlen = rl - 5
    let spub[32]
    if tls_sh_key_share(rec + 5, spub) != 0x001d { close_fd(fd); return 0 }

    // transcript = ClientHello || ServerHello, saved so later records can reuse `rec`
    let tr = heap_alloc(20000)
    i = 0
    for i < chlen { poke8(tr + i, peek8(ch + i)); i = i + 1 }
    i = 0
    for i < shlen { poke8(tr + chlen + i, peek8(rec + 5 + i)); i = i + 1 }
    let trlen = chlen + shlen

    let ecdhe[32]
    x25519(cpriv, spub, ecdhe)
    let early[32]
    tls_early_secret(early, 0, early)
    let hs[32]
    tls_derive_handshake_secret(early, ecdhe, 32, hs)
    let s_hs[32]
    tls_server_hs_traffic(hs, tr, trlen, s_hs)
    let skey[32]
    let siv[12]
    tls_traffic_key_iv(s_hs, skey, siv)

    // decrypt records into the flight buffer until the CertificateVerify is complete
    let flight = heap_alloc(20000)
    let mut flen = 0
    let mut seq = 0
    let mut cvoff = 0 - 1
    for cvoff < 0 {
        let rl2 = tls_read_record(fd, rec, 20000)
        if rl2 <= 0 { close_fd(fd); return 0 }
        let ct = peek8(rec)
        if ct != 20 {                                   // skip the legacy ChangeCipherSpec
            if ct != 23 { close_fd(fd); return 0 }
            let m = tls_open(skey, siv, seq, rec, rl2, flight + flen)
            if m < 0 { close_fd(fd); return 0 }
            flen = flen + (m & 0xffffffff)
            seq = seq + 1
            cvoff = tls_flight_cv_offset(flight, flen)
        }
    }
    close_fd(fd)

    // leaf certificate public key (P-256 point) from the Certificate message
    let certoff = tls_flight_cert_offset(flight, flen)
    if certoff < 0 { return 0 }
    let entry[2]
    tls_cert_entry(flight + certoff, 0, entry)          // out[0]=DER offset, out[1]=len
    let leaf = flight + certoff + entry[0]
    let spki[1]
    x509_tbs_spki(leaf, 0, spki)
    let key[2]
    x509_spki_key(leaf, spki[0], key)
    let qx[32]
    let qy[32]
    i = 0
    for i < 32 { poke8(qx + i, peek8(leaf + key[0] + 1 + i)); i = i + 1 }
    i = 0
    for i < 32 { poke8(qy + i, peek8(leaf + key[0] + 33 + i)); i = i + 1 }

    // transcript hash through Certificate (everything before CertificateVerify)
    i = 0
    for i < cvoff { poke8(tr + trlen + i, peek8(flight + i)); i = i + 1 }
    let th[32]
    sha256_hash(tr, trlen + cvoff, th)

    // the signed content: 64 * 0x20 || "TLS 1.3, server CertificateVerify" || 0x00 || th
    let content = heap_alloc(256)
    i = 0
    for i < 64 { poke8(content + i, 0x20); i = i + 1 }
    let lbl = "TLS 1.3, server CertificateVerify"
    i = 0
    for i < 33 { poke8(content + 64 + i, peek8(lbl + i)); i = i + 1 }
    poke8(content + 97, 0)
    i = 0
    for i < 32 { poke8(content + 98 + i, peek8(th + i)); i = i + 1 }
    let ce[32]
    sha256_hash(content, 130, ce)

    // CertificateVerify body: scheme(2) | sig(uint16 len | DER SEQUENCE { r, s })
    let cvbody = flight + cvoff + 4
    let scheme = (peek8(cvbody) << 8) | peek8(cvbody + 1)
    if scheme != 0x0403 { return 0 }                    // ecdsa_secp256r1_sha256 only here
    let sigpos = cvoff + 4 + 4                           // past scheme(2) + sig length(2)
    let r[32]
    let s[32]
    let rpos = der_enter(flight, sigpos)
    der_int_to_fixed(flight, rpos, r, 32)
    let t3[3]
    let spos = der_tlv(flight, rpos, t3)
    der_int_to_fixed(flight, spos, s, 32)
    ecdsa_verify(qx, qy, ce, r, s)
}
