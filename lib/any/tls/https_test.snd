// Copyright 2026 Jhon Magdalena Vila and the Sond contributors
//
// Deterministic test of tls_get (https.snd) over loopback: a minimal Sond TLS 1.3 server
// (the child) runs the whole server side, ServerHello, an EncryptedExtensions/Certificate/
// CertificateVerify(signed with ecdsa_sign)/Finished flight, then reads the client Finished
// and GET and serves an HTTP response. The client under test fetches it. This gives the GET
// path CI coverage without a network.

include "any/tls/https.snd"
include "any/crypto/ec/ecdsa-sign.snd"
include "x86_64/linux/testing.snd"

// A self-signed P-256 leaf for "sond.test" (subjectAltName DNS:sond.test, CA:TRUE), valid
// 2026-07-23 .. 2036-07-20. The server presents it and signs CertificateVerify with its key;
// the client validates the chain [leaf] against a trust store holding this same certificate
// (a self-signed leaf is its own trust anchor). D_HEX is the matching private scalar.
let CERT_HEX = ""
let D_HEX = "c57841cdb48148966bf65648b7fb7585e603b7b1e416b5dfee4b53fc1a8d502d"
let mut h_cert[512]
let mut h_d[32]
let mut h_k[32]
let mut h_roots[4]
let mut h_sh[512]
let mut h_tr[20000]
let mut h_flight[4096]
let mut h_scratch[4096]
let mut h_sealed[4096]
let mut h_content[256]
let mut h_resp[20000]

fn hhx(c: i64) -> i64 {
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 97 && c <= 102 { return c - 87 }
    c - 55
}
fn hload(hex: i64, dst: i64) -> i64 {
    let mut i = 0
    for peek8(hex + i * 2) != 0 {
        poke8(dst + i, hhx(peek8(hex + i * 2)) * 16 + hhx(peek8(hex + i * 2 + 1)))
        i = i + 1
    }
    i
}
fn h_u24(buf: i64, v: i64) { poke8(buf, (v >> 16) & 0xff); poke8(buf + 1, (v >> 8) & 0xff); poke8(buf + 2, v & 0xff) }
fn h_app(dst: i64, o: i64, src: i64, n: i64) -> i64 {
    let mut i = 0
    let mut p = o
    for i < n { poke8(dst + p, peek8(src + i)); p = p + 1; i = i + 1 }
    p
}
fn h_der_int(out: i64, val: i64) -> i64 {
    let mut start = 0
    for start < 31 { if peek8(val + start) != 0 { break } start = start + 1 }
    let clen = 32 - start
    let needpad = if (peek8(val + start) & 0x80) != 0 { 1 } else { 0 }
    poke8(out, 2); poke8(out + 1, clen + needpad)
    let mut o = 2
    if needpad == 1 { poke8(out + o, 0); o = o + 1 }
    let mut i = 0
    for i < clen { poke8(out + o, peek8(val + start + i)); o = o + 1; i = i + 1 }
    o
}
fn h_build_sh(random: i64, spub: i64, out: i64) -> i64 {
    poke8(out, 2)
    let body = out + 4
    let mut o = 0
    hs_put_u16(body + o, 0x0303); o = o + 2
    let mut i = 0
    for i < 32 { poke8(body + o + i, peek8(random + i)); i = i + 1 }
    o = o + 32
    poke8(body + o, 0); o = o + 1
    hs_put_u16(body + o, 0x1303); o = o + 2
    poke8(body + o, 0); o = o + 1
    let extlen_at = o
    o = o + 2
    let ext_start = o
    hs_put_u16(body + o, 43); o = o + 2
    hs_put_u16(body + o, 2); o = o + 2
    hs_put_u16(body + o, 0x0304); o = o + 2
    hs_put_u16(body + o, 51); o = o + 2
    hs_put_u16(body + o, 36); o = o + 2
    hs_put_u16(body + o, 0x001d); o = o + 2
    hs_put_u16(body + o, 32); o = o + 2
    i = 0
    for i < 32 { poke8(body + o + i, peek8(spub + i)); i = i + 1 }
    o = o + 32
    hs_put_u16(body + extlen_at, o - ext_start)
    hs_put_u24(out + 1, o)
    4 + o
}

// The whole server side of one TLS 1.3 exchange on `afd`: ServerHello, the signed flight
// (EncryptedExtensions / Certificate / CertificateVerify / Finished), then it reads the client
// Finished and GET and serves an HTTP response. Guards every client read so it exits cleanly if
// the client aborts (e.g. after rejecting the certificate chain) rather than writing to a dead
// socket. Runs in the forked child; not counted for the client's coverage.
fn h_serve(afd: i64, certlen: i64) {
    let crec[2048]
    let crl = tls_read_record(afd, crec, 2048)
    if crl <= 0 { return }
    let cmsg = crec + 5
    let cmsglen = crl - 5
    let cpub = cmsg + 84
    let spriv[32]
    tls_random(spriv, 32)
    let base9[32]
    poke8(base9, 9)
    let mut z = 0
    for z < 31 { poke8(base9 + 1 + z, 0); z = z + 1 }
    let spub[32]
    x25519(spriv, base9, spub)
    let shared[32]
    x25519(spriv, cpub, shared)
    let srand[32]
    tls_random(srand, 32)
    let shlen = h_build_sh(srand, spub, h_sh)
    tls_send_plain_handshake(afd, h_sh, shlen, h_scratch)
    z = 0
    for z < cmsglen { poke8(h_tr + z, peek8(cmsg + z)); z = z + 1 }
    z = 0
    for z < shlen { poke8(h_tr + cmsglen + z, peek8(h_sh + z)); z = z + 1 }
    let trlen = cmsglen + shlen
    let early[32]
    tls_early_secret(early, 0, early)
    let hs[32]
    tls_derive_handshake_secret(early, shared, 32, hs)
    let s_hs[32]
    tls_server_hs_traffic(hs, h_tr, trlen, s_hs)
    let skey[32]
    let siv[12]
    tls_traffic_key_iv(s_hs, skey, siv)

    // build the flight: EE
    let mut fl = 0
    poke8(h_flight + 0, 8); poke8(h_flight + 1, 0); poke8(h_flight + 2, 0)
    poke8(h_flight + 3, 2); poke8(h_flight + 4, 0); poke8(h_flight + 5, 0)
    fl = 6
    // Certificate
    let cmstart = fl
    poke8(h_flight + fl, 11); fl = fl + 4
    let cbody = fl
    poke8(h_flight + fl, 0); fl = fl + 1
    h_u24(h_flight + fl, certlen + 5); fl = fl + 3
    h_u24(h_flight + fl, certlen); fl = fl + 3
    fl = h_app(h_flight, fl, h_cert, certlen)
    hs_put_u16(h_flight + fl, 0); fl = fl + 2
    h_u24(h_flight + cmstart + 1, fl - cbody)
    // CertificateVerify: sign transcript-through-Certificate
    z = 0
    for z < fl { poke8(h_tr + trlen + z, peek8(h_flight + z)); z = z + 1 }
    let th[32]
    sha256_hash(h_tr, trlen + fl, th)
    z = 0
    for z < 64 { poke8(h_content + z, 0x20); z = z + 1 }
    let lbl_text: string = "TLS 1.3, server CertificateVerify"
    let lbl = lbl_text.utf8
    z = 0
    for z < 33 { poke8(h_content + 64 + z, lbl[z]); z = z + 1 }
    poke8(h_content + 97, 0)
    z = 0
    for z < 32 { poke8(h_content + 98 + z, peek8(th + z)); z = z + 1 }
    let ce[32]
    sha256_hash(h_content, 130, ce)
    let sr[32]
    let ss[32]
    ecdsa_sign(h_d, ce, h_k, sr, ss)
    let der[80]
    let n1 = h_der_int(der + 2, sr)
    let n2 = h_der_int(der + 2 + n1, ss)
    poke8(der + 0, 0x30); poke8(der + 1, n1 + n2)
    let derlen = 2 + n1 + n2
    let cvstart = fl
    poke8(h_flight + fl, 15); fl = fl + 4
    let cvbody = fl
    hs_put_u16(h_flight + fl, 0x0403); fl = fl + 2
    hs_put_u16(h_flight + fl, derlen); fl = fl + 2
    fl = h_app(h_flight, fl, der, derlen)
    h_u24(h_flight + cvstart + 1, fl - cvbody)
    // server Finished: HMAC(finished_key, transcript-through-CertVerify)
    z = 0
    for z < fl { poke8(h_tr + trlen + z, peek8(h_flight + z)); z = z + 1 }
    let thcv[32]
    sha256_hash(h_tr, trlen + fl, thcv)
    let empty[1]
    let sfk[32]
    let __lit0: string = "finished"
    hkdf_expand_label(s_hs, __lit0.utf8, 8, empty, 0, sfk, 32)
    let sfin[32]
    hmac_sha256(sfk, 32, thcv, 32, sfin)
    poke8(h_flight + fl, 20); poke8(h_flight + fl + 1, 0); poke8(h_flight + fl + 2, 0); poke8(h_flight + fl + 3, 32)
    fl = fl + 4
    fl = h_app(h_flight, fl, sfin, 32)
    // seal + send the whole flight
    let sl = tls_seal(skey, siv, 0, 22, h_flight, fl, h_sealed)
    write_buf(afd, h_sealed, sl)
    // app keys: transcript = CH || SH || flight (through server Finished)
    z = 0
    for z < fl { poke8(h_tr + trlen + z, peek8(h_flight + z)); z = z + 1 }
    let master[32]
    tls_derive_master_secret(hs, master)
    let s_ap[32]
    let __lit1: string = "s ap traffic"
    derive_secret(master, __lit1.utf8, 12, h_tr, trlen + fl, s_ap)
    let c_ap[32]
    let __lit2: string = "c ap traffic"
    derive_secret(master, __lit2.utf8, 12, h_tr, trlen + fl, c_ap)
    let sakey[32]
    let saiv[12]
    tls_traffic_key_iv(s_ap, sakey, saiv)
    let cakey[32]
    let caiv[12]
    tls_traffic_key_iv(c_ap, cakey, caiv)
    // The client's handshake key, to open and CHECK its Finished. A test server that only reads
    // the client Finished and throws it away tests nothing: the one message the client alone
    // produces would never be verified by anything, here or on the wire, and that is exactly how
    // a broken Finished reaches production looking green.
    let c_hs2[32]
    let __lit3: string = "c hs traffic"
    derive_secret(hs, __lit3.utf8, 12, h_tr, trlen, c_hs2)
    let chkey[32]
    let chiv[12]
    tls_traffic_key_iv(c_hs2, chkey, chiv)

    // read client's CCS, Finished, GET; bail if the client aborted (rejected our certificate)
    let rb[2048]
    let mut rr = tls_read_record(afd, rb, 2048)
    if rr <= 0 { return }
    if peek8(rb) == 20 { rr = tls_read_record(afd, rb, 2048) }   // skip CCS -> client Finished
    if rr <= 0 { return }

    // Verify it, the way a real server does: HMAC of the transcript through OUR Finished, under
    // a key derived from the client handshake traffic secret. A mismatch means we hang up
    // without serving, which is what the real servers did.
    let cfdec[256]
    let cm = tls_open(chkey, chiv, 0, rb, rr, cfdec)
    if cm < 0 { return }
    let cfk2[32]
    let __lit4: string = "finished"
    hkdf_expand_label(c_hs2, __lit4.utf8, 8, cfk2, 0, cfk2, 32)
    let thc[32]
    sha256_hash(h_tr, trlen + fl, thc)
    let want[32]
    hmac_sha256(cfk2, 32, thc, 32, want)
    if peek8(cfdec) != 20 { return }                             // must be a Finished message
    z = 0
    for z < 32 {
        if peek8(cfdec + 4 + z) != peek8(want + z) { return }
        z = z + 1
    }

    rr = tls_read_record(afd, rb, 2048)                          // client GET
    if rr <= 0 { return }
    let gdec[2048]
    tls_open(cakey, caiv, 0, rb, rr, gdec)
    // serve an HTTP response (application_data, server app seq 1, after a NewSessionTicket)
    let http_text: string = "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nhi"
    let http = http_text.utf8
    let hbuf[64]
    z = 0
    for z < 39 { poke8(hbuf + z, http[z]); z = z + 1 }
    let nst[6]
    poke8(nst + 0, 4); poke8(nst + 1, 0); poke8(nst + 2, 0); poke8(nst + 3, 2); poke8(nst + 4, 0); poke8(nst + 5, 0)
    let ns[128]
    let nsl = tls_seal(sakey, saiv, 0, 22, nst, 6, ns)
    write_buf(afd, ns, nsl)
    let hs2[128]
    let hsl = tls_seal(sakey, saiv, 1, 23, hbuf, 39, hs2)
    write_buf(afd, hs2, hsl)
    // a close_notify alert (inner type 21) at the next server sequence, as a real server sends
    let alert[2]
    poke8(alert + 0, 1); poke8(alert + 1, 0)         // warning, close_notify
    let an[64]
    let anl = tls_seal(sakey, saiv, 2, 21, alert, 2, an)
    write_buf(afd, an, anl)
}

test "tls https: a full verified GET against a minimal Sond TLS server returns the response" {
    let certlen = hload(CERT_HEX, h_cert)
    hload(D_HEX, h_d)
    h_roots[0] = h_cert
    let mut i = 0
    for i < 32 { poke8(h_k + i, 0x33 + i); i = i + 1 }

    let port = 55490
    let sfd = sock(AF_INET, SOCK_STREAM, 0)
    set_reuseaddr(sfd)
    let sa[2]
    sockaddr_in_build(sa, 0x7f000001, port)
    bind_sock(sfd, sa, 16)
    listen_sock(sfd, 4)

    let pid = syscall(SYS_fork)
    if pid == 0 {
        let afd = accept_sock(sfd, 0, 0)
        if afd < 0 { syscall(SYS_exit, 2) }
        h_serve(afd, certlen)
        close_fd(afd)
        syscall(SYS_exit, 0)
    }

    // PARENT: the client validates the chain (leaf names sond.test, anchors to h_roots) and GETs.
    let __s0_302: string = "127.0.0.1"
    let __s1_302: string = "sond.test"
    let __s2_302: string = "/"
    let __s3_302: string = "20270101000000"
    let n = tls_get(__s0_302.utf8, port, __s1_302.utf8, 9, __s2_302.utf8, 1, h_resp, 20000, h_roots, 1, __s3_302.utf8)
    assert_eq(n, 39)
    assert_eq(peek8(h_resp + 0), 72)                  // 'H'
    assert_eq(peek8(h_resp + 9), 50)                  // '2' of 200
    close_fd(sfd)
    let st[1]
    syscall(SYS_wait4, pid, st, 0, 0)
}

test "tls https: an untrusted server (certificate names another host) is rejected before the GET" {
    let certlen = hload(CERT_HEX, h_cert)
    hload(D_HEX, h_d)
    h_roots[0] = h_cert
    let mut i = 0
    for i < 32 { poke8(h_k + i, 0x33 + i); i = i + 1 }

    let port = 55495
    let sfd = sock(AF_INET, SOCK_STREAM, 0)
    set_reuseaddr(sfd)
    let sa[2]
    sockaddr_in_build(sa, 0x7f000001, port)
    bind_sock(sfd, sa, 16)
    listen_sock(sfd, 4)

    let pid = syscall(SYS_fork)
    if pid == 0 {
        let afd = accept_sock(sfd, 0, 0)
        if afd < 0 { syscall(SYS_exit, 2) }
        h_serve(afd, certlen)
        close_fd(afd)
        syscall(SYS_exit, 0)
    }

    // the certificate names sond.test, not wrong.host: the client must reject the chain and
    // return an error (-4) without sending the GET.
    let __s4_341: string = "127.0.0.1"
    let __s5_341: string = "wrong.host"
    let __s6_341: string = "/"
    let __s7_341: string = "20270101000000"
    let n = tls_get(__s4_341.utf8, port, __s5_341.utf8, 10, __s6_341.utf8, 1, h_resp, 20000, h_roots, 1, __s7_341.utf8)
    assert(n < 0)
    close_fd(sfd)
    let st[1]
    syscall(SYS_wait4, pid, st, 0, 0)
}

let mut h_eb[128]

test "tls https: a refused connection returns a failure" {
    let __s8_355: string = "127.0.0.1"
    let __s9_355: string = "h"
    let __s10_355: string = "/"
    let __s11_355: string = "20270101000000"
    assert(tls_get(__s8_355.utf8, 55491, __s9_355.utf8, 1, __s10_355.utf8, 1, h_eb, 128, h_roots, 1, __s11_355.utf8) <= 0)
}
test "tls https: a server that hangs up before ServerHello returns a failure" {
    let sfd = sock(AF_INET, SOCK_STREAM, 0)
    set_reuseaddr(sfd)
    let sa[2]
    sockaddr_in_build(sa, 0x7f000001, 55492)
    bind_sock(sfd, sa, 16)
    listen_sock(sfd, 4)
    let pid = syscall(SYS_fork)
    if pid == 0 {
        let a = accept_sock(sfd, 0, 0)
        close_fd(a)
        syscall(SYS_exit, 0)
    }
    let __s12_374: string = "127.0.0.1"
    let __s13_374: string = "h"
    let __s14_374: string = "/"
    let __s15_374: string = "20270101000000"
    assert(tls_get(__s12_374.utf8, 55492, __s13_374.utf8, 1, __s14_374.utf8, 1, h_eb, 128, h_roots, 1, __s15_374.utf8) <= 0)
    close_fd(sfd)
    let st[1]
    syscall(SYS_wait4, pid, st, 0, 0)
}
test "tls https: a non-handshake first record returns a failure" {
    let sfd = sock(AF_INET, SOCK_STREAM, 0)
    set_reuseaddr(sfd)
    let sa[2]
    sockaddr_in_build(sa, 0x7f000001, 55493)
    bind_sock(sfd, sa, 16)
    listen_sock(sfd, 4)
    let pid = syscall(SYS_fork)
    if pid == 0 {
        let a = accept_sock(sfd, 0, 0)
        let cr[2048]
        tls_read_record(a, cr, 2048)
        let al[7]
        poke8(al, 21); poke8(al + 1, 3); poke8(al + 2, 3)
        poke8(al + 3, 0); poke8(al + 4, 2); poke8(al + 5, 2); poke8(al + 6, 40)
        write_buf(a, al, 7)
        close_fd(a)
        syscall(SYS_exit, 0)
    }
    let __s16_402: string = "127.0.0.1"
    let __s17_402: string = "h"
    let __s18_402: string = "/"
    let __s19_402: string = "20270101000000"
    assert(tls_get(__s16_402.utf8, 55493, __s17_402.utf8, 1, __s18_402.utf8, 1, h_eb, 128, h_roots, 1, __s19_402.utf8) <= 0)
    close_fd(sfd)
    let st[1]
    syscall(SYS_wait4, pid, st, 0, 0)
}
test "ecdsa in https context: pubkey derivation and a zero nonce" {
    let qx[32]
    let qy[32]
    ecdsa_pubkey(h_d, qx, qy)
    assert_eq(peek8(qx + 0) + peek8(qy + 0) >= 0, 1)
    let mut i = 0
    for i < 32 { poke8(h_k + i, 0); i = i + 1 }
    let sr[32]
    let ss[32]
    assert_eq(ecdsa_sign(h_d, h_d, h_k, sr, ss), 0)
}

test "tls https: a non-application record in the flight returns a failure" {
    let sfd = sock(AF_INET, SOCK_STREAM, 0)
    set_reuseaddr(sfd)
    let sa[2]
    sockaddr_in_build(sa, 0x7f000001, 55494)
    bind_sock(sfd, sa, 16)
    listen_sock(sfd, 4)
    let pid = syscall(SYS_fork)
    if pid == 0 {
        let a = accept_sock(sfd, 0, 0)
        let cr[2048]
        tls_read_record(a, cr, 2048)
        let sp[32]
        tls_random(sp, 32)
        let b9[32]
        poke8(b9, 9)
        let mut z = 0
        for z < 31 { poke8(b9 + 1 + z, 0); z = z + 1 }
        let spb[32]
        x25519(sp, b9, spb)
        let srnd[32]
        tls_random(srnd, 32)
        let shl = h_build_sh(srnd, spb, h_sh)
        tls_send_plain_handshake(a, h_sh, shl, h_scratch)
        // a plaintext alert (type 21) where the client expects the encrypted flight
        let al[7]
        poke8(al + 0, 21); poke8(al + 1, 3); poke8(al + 2, 3)
        poke8(al + 3, 0); poke8(al + 4, 2); poke8(al + 5, 2); poke8(al + 6, 40)
        write_buf(a, al, 7)
        close_fd(a)
        syscall(SYS_exit, 0)
    }
    let __s20_455: string = "127.0.0.1"
    let __s21_455: string = "sondtest"
    let __s22_455: string = "/"
    let __s23_455: string = "20270101000000"
    assert(tls_get(__s20_455.utf8, 55494, __s21_455.utf8, 8, __s22_455.utf8, 1, h_eb, 128, h_roots, 1, __s23_455.utf8) <= 0)
    close_fd(sfd)
    let st[1]
    syscall(SYS_wait4, pid, st, 0, 0)
}

// The request builder copied each literal with a hand-written length, and two of them were short
// by one: " HTTP/1.1\r\nHost: " is 17 characters and 16 were copied, dropping the space after the
// colon, and "\r\nConnection: close\r\n\r\n" is 23 and 22 were copied, dropping the FINAL newline.
// A request that ends in "\r\n\r" is never terminated, so a server waits for headers that never
// arrive: Google hung until the client gave up, Cloudflare hung up without a word, and a local
// `openssl s_server -www` answered anyway because it replies to the request line alone. Which is
// how this survived: the only server it was ever tested against did not care.
//
// The assertion is on the BYTES, not on the length, so the next literal edited by hand cannot
// pass by being the wrong string of the right size.
let mut hr_buf[64]
let mut hr_want[64]

fn hr_eq(want: i64, got: i64, n: i64) -> i64 {
    let mut i = 0
    for i < n {
        if peek8(want + i) != peek8(got + i) { return 0 }
        i = i + 1
    }
    1
}

test "tls https: the GET request is a complete, terminated HTTP request" {
    let __s0_488: string = "example.com"
    let __s1_488: string = "/a"
    let n = tls_http_req(__s0_488.utf8, 11, __s1_488.utf8, 2, hr_buf)
    let want_text: string = "GET /a HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n"
    let want = want_text.utf8
    // The length is taken FROM the literal, not counted by hand: writing 56 here instead of 57
    // is the very mistake under test, and I made it on the first try.
    for k in 0..want.len { poke8(hr_want + k, want[k]) }
    let i = want.len
    assert_eq(n, i)
    assert_eq(hr_eq(hr_want, hr_buf, i), 1)
    // and it ends with the blank line that terminates the headers
    assert_eq(peek8(hr_buf + n - 4), 13)
    assert_eq(peek8(hr_buf + n - 3), 10)
    assert_eq(peek8(hr_buf + n - 2), 13)
    assert_eq(peek8(hr_buf + n - 1), 10)
}

// `tls_read` returning 0 says "no more data", which is true both when the peer finishes politely
// and when it refuses. Those mean opposite things to a caller: one is a completed response, the
// other is a rejection to report. The session now records the alert it saw, so the two can be
// told apart; the loopback server ends with a close_notify, exactly as a real one does.
test "tls https: a close_notify is distinguishable from a bare end of data" {
    let certlen = hload(CERT_HEX, h_cert)
    hload(D_HEX, h_d)
    h_roots[0] = h_cert
    let mut i = 0
    for i < 32 { poke8(h_k + i, 0x33 + i); i = i + 1 }

    let port = 55499
    let sfd = sock(AF_INET, SOCK_STREAM, 0)
    set_reuseaddr(sfd)
    let sa[2]
    sockaddr_in_build(sa, 0x7f000001, port)
    bind_sock(sfd, sa, 16)
    listen_sock(sfd, 4)

    let pid = syscall(SYS_fork)
    if pid == 0 {
        let afd = accept_sock(sfd, 0, 0)
        if afd < 0 { syscall(SYS_exit, 2) }
        h_serve(afd, certlen)
        close_fd(afd)
        syscall(SYS_exit, 0)
    }

    let __s0_508: string = "127.0.0.1"
    let __s1_508: string = "sond.test"
    let __s2_508: string = "http/1.1"
    let __s3_508: string = "20270101000000"
    let sess = tls_connect(__s0_508.utf8, port, __s1_508.utf8, 9, __s2_508.utf8, 8, h_roots, 1, __s3_508.utf8)
    assert_eq(sess != 0, 1)
    assert_eq(tls_sess_alert(sess), 0 - 1)            // nothing has gone wrong yet
    let req[512]
    let __s2_542: string = "sond.test"
    let __s3_542: string = "/"
    let rq = tls_http_req(__s2_542.utf8, 9, __s3_542.utf8, 1, req)
    tls_write(sess, req, rq)
    let rbuf[4096]
    let mut n = tls_read(sess, rbuf, 20000)
    for n > 0 { n = tls_read(sess, rbuf, 20000) }
    // The read ended at 0, and the session says WHY: the server's close_notify, level 1
    // (warning), description 0. A fatal alert would read level 2 here, and a peer that simply
    // vanished would leave -1.
    assert_eq(tls_sess_alert(sess), 256)
    tls_close(sess)
    close_fd(sfd)
    let st[1]
    syscall(SYS_wait4, pid, st, 0, 0)
}

// ── HTTP/1.1 request builder ─────────────────────────────────────────────────────────────
// Every assertion below compares the BYTES of the request that was built, never its length
// alone: a correct length over the wrong string passes a length check and still puts a
// broken request on the wire, which is the class of bug that once sent a request without
// its final blank line.

let mut r_buf[2048]
let mut r_body[64]

// 1 if buf[0..n] is byte for byte the cstr `want`, INCLUDING its length: a request that
// merely starts with the expected text is not the expected request.
fn r_is(buf: i64, n: i64, want: i64) -> i64 {
    let mut i = 0
    for i < n {
        if peek8(want + i) == 0 { return 0 }        // want ran out first: buf is longer
        if peek8(buf + i) != peek8(want + i) { return 0 }
        i = i + 1
    }
    if peek8(want + n) != 0 { return 0 }            // want is longer than buf
    1
}

test "http request: a GET carries the request line, Host and the terminating blank line" {
    let __s0_582: string = "GET"
    let __s1_582: string = "/alive"
    let __s2_582: string = "example.test"
    let n = tls_req_end(r_buf, tls_req_start(r_buf, __s0_582.utf8, __s1_582.utf8, __s2_582.utf8), 0, 0)
    let __q0_587: string = "GET /alive HTTP/1.1\r\nHost: example.test\r\nConnection: close\r\n\r\n"
    assert_eq(r_is(r_buf, n,
        __q0_587.utf8), 1)
}

test "http request: the header block ends with a blank line, not with one CRLF" {
    let __s3_591: string = "GET"
    let __s4_591: string = "/"
    let __s5_591: string = "h"
    let n = tls_req_end(r_buf, tls_req_start(r_buf, __s3_591.utf8, __s4_591.utf8, __s5_591.utf8), 0, 0)
    assert_eq(peek8(r_buf + n - 4), 13)
    assert_eq(peek8(r_buf + n - 3), 10)
    assert_eq(peek8(r_buf + n - 2), 13)
    assert_eq(peek8(r_buf + n - 1), 10)
}

test "http request: headers are appended in order, each on its own line" {
    let __s6_602: string = "GET"
    let __s7_602: string = "/x"
    let __s8_602: string = "api.test"
    let mut o = tls_req_start(r_buf, __s6_602.utf8, __s7_602.utf8, __s8_602.utf8)
    let __lit5: string = "Accept"
    let __lit6: string = "application/json"
    o = tls_req_header(r_buf, o, __lit5.utf8, __lit6.utf8)
    let __lit7: string = "Authorization"
    let __lit8: string = "Basic dXNlcjpwYXNz"
    o = tls_req_header(r_buf, o, __lit7.utf8, __lit8.utf8)
    let n = tls_req_end(r_buf, o, 0, 0)
    let __q1_615: string = "GET /x HTTP/1.1\r\nHost: api.test\r\nAccept: application/json\r\nAuthorization: Basic dXNlcjpwYXNz\r\nConnection: close\r\n\r\n"
    assert_eq(r_is(r_buf, n,
        __q1_615.utf8), 1)
}

test "http request: a body gets a computed Content-Length, never one the caller supplies" {
    let __s9_618: string = "POST"
    let __s10_618: string = "/set"
    let __s11_618: string = "api.test"
    let __s12_618: string = "{\"a\":1}"
    let n = tls_req_end(r_buf, tls_req_start(r_buf, __s9_618.utf8, __s10_618.utf8, __s11_618.utf8), __s12_618.utf8, 7)
    let __q2_626: string = "POST /set HTTP/1.1\r\nHost: api.test\r\nContent-Length: 7\r\nConnection: close\r\n\r\n{\"a\":1}"
    assert_eq(r_is(r_buf, n,
        __q2_626.utf8), 1)
}

test "http request: Content-Length counts the bytes given, not the text of the body" {
    // 128 bytes of body would be three digits; the length must follow bodylen, not a guess.
    let mut i = 0
    for i < 40 { poke8(r_body + i, 65); i = i + 1 }
    let __s13_631: string = "PUT"
    let __s14_631: string = "/f"
    let __s15_631: string = "h"
    let n = tls_req_end(r_buf, tls_req_start(r_buf, __s13_631.utf8, __s14_631.utf8, __s15_631.utf8), r_body, 40)
    let __q3_639: string = "PUT /f HTTP/1.1\r\nHost: h\r\nContent-Length: 40\r\nConnection: close\r\n\r\nAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
    assert_eq(r_is(r_buf, n,
        __q3_639.utf8), 1)
}

test "http request: the body may hold arbitrary bytes, NUL included" {
    // A PDF upload is binary: a NUL is data, and stopping there would truncate the body.
    poke8(r_body + 0, 37)                            // '%'
    poke8(r_body + 1, 0)                             // NUL in the middle
    poke8(r_body + 2, 80)                            // 'P'
    let __s16_644: string = "PUT"
    let __s17_644: string = "/u"
    let __s18_644: string = "h"
    let start = tls_req_start(r_buf, __s16_644.utf8, __s17_644.utf8, __s18_644.utf8)
    let n = tls_req_end(r_buf, start, r_body, 3)
    assert_eq(peek8(r_buf + n - 3), 37)
    assert_eq(peek8(r_buf + n - 2), 0)
    assert_eq(peek8(r_buf + n - 1), 80)
    // ...and the length announced is the one that was passed, so the peer reads all three.
    let __s0_653: string = "PUT /u HTTP/1.1\r\nHost: h\r\nContent-Length: 3\r\nConnection: close\r\n\r\n"
    assert_eq(r_is(r_buf, n - 3, __s0_653.utf8), 1)
}

test "http request: an empty body carries no Content-Length at all" {
    let __s19_657: string = "GET"
    let __s20_657: string = "/"
    let __s21_657: string = "h"
    let n = tls_req_end(r_buf, tls_req_start(r_buf, __s19_657.utf8, __s20_657.utf8, __s21_657.utf8), r_body, 0)
    let __s1_662: string = "GET / HTTP/1.1\r\nHost: h\r\nConnection: close\r\n\r\n"
    assert_eq(r_is(r_buf, n, __s1_662.utf8), 1)
}

test "http request: a long body announces every digit of its length" {
    let __s22_665: string = "POST"
    let __s23_665: string = "/"
    let __s24_665: string = "h"
    let n = tls_req_end(r_buf, tls_req_start(r_buf, __s22_665.utf8, __s23_665.utf8, __s24_665.utf8), r_body, 1024)
    // Only the header block is checked here; the body bytes come from r_body's 64 bytes.
    let mut i = 0
    let want_text: string = "POST / HTTP/1.1\r\nHost: h\r\nContent-Length: 1024\r\nConnection: close\r\n\r\n"
    let want = want_text.utf8
    for k in 0..want.len {
        assert_eq(peek8(r_buf + k), want[k])
    }
    assert_eq(n, want.len + 1024)
}

test "http request: the decimal writer handles zero and a many-digit value" {
    // Content-Length never asks for zero (an empty body carries no header at all), but the
    // helper is reachable on its own and zero is the case a digit loop silently drops.
    let n0 = tls_put_uint(r_buf, 0, 0)
    assert_eq(n0, 1)
    assert_eq(peek8(r_buf), 48)
    let n1 = tls_put_uint(r_buf, 0, 1048576)
    assert_eq(n1, 7)
    let __s2_689: string = "1048576"
    assert_eq(r_is(r_buf, n1, __s2_689.utf8), 1)
}

let __q4_704: string = "X"
let __q5_704: string = "a\r\nX-Injected: yes"
test "http request: a CRLF in a header value is refused, not smuggled through" {
    // The value of Authorization is computed at run time from a config file, so a stray
    // newline in that file would otherwise decide which headers go out on the wire.
    let __s25_693: string = "GET"
    let __s26_693: string = "/"
    let __s27_693: string = "h"
    let o = tls_req_start(r_buf, __s25_693.utf8, __s26_693.utf8, __s27_693.utf8)
    assert_eq(tls_req_header(r_buf, o, __q4_704.utf8, __q5_704.utf8) < 0, true)
}

let __q6_714: string = "X"
let __q7_714: string = "a\rb"
let __q8_717: string = "X\nY"
let __q9_717: string = "ok"
test "http request: a lone CR is refused too, since some servers split on it" {
    let __s28_701: string = "GET"
    let __s29_701: string = "/"
    let __s30_701: string = "h"
    let o = tls_req_start(r_buf, __s28_701.utf8, __s29_701.utf8, __s30_701.utf8)
    assert_eq(tls_req_header(r_buf, o, __q6_714.utf8, __q7_714.utf8) < 0, true)
    assert_eq(tls_req_header(r_buf, o, __q8_717.utf8, __q9_717.utf8) < 0, true)
}

test "http request: the method and the host are checked too, not only the path" {
    let __s31_710: string = "GET\r\nX: y"
    let __s32_710: string = "/"
    let __s33_710: string = "h"
    assert_eq(tls_req_start(r_buf, __s31_710.utf8, __s32_710.utf8, __s33_710.utf8) < 0, true)
    let __s34_714: string = "GET"
    let __s35_714: string = "/"
    let __s36_714: string = "h\r\nX: y"
    assert_eq(tls_req_start(r_buf, __s34_714.utf8, __s35_714.utf8, __s36_714.utf8) < 0, true)
    let __s37_718: string = "GET"
    let __s38_718: string = "/"
    let __s39_718: string = "h"
    assert_eq(tls_req_start(r_buf, __s37_718.utf8, __s38_718.utf8, __s39_718.utf8) > 0, true)
}

let __q10_745: string = "Accept"
let __q11_745: string = "text/plain"
test "http request: a refusal is refused all the way out, and writes nothing" {
    poke8(r_buf + 0, 90)                             // a sentinel where the request starts
    let __s40_726: string = "GET"
    let __s41_726: string = "/bad\r\n"
    let __s42_726: string = "h"
    assert_eq(tls_req_start(r_buf, __s40_726.utf8, __s41_726.utf8, __s42_726.utf8) < 0, true)
    assert_eq(peek8(r_buf), 90)                      // the buffer was left untouched
    assert_eq(tls_req_end(r_buf, 0 - 1, 0, 0), 0 - 1)
    assert_eq(tls_req_header(r_buf, 0 - 1, __q10_745.utf8, __q11_745.utf8), 0 - 1)
}

test "http request: a negative body length is refused, not turned into no body at all" {
    // A caller computing the length from a file size can land on a negative one; producing a
    // valid-looking request without the body it asked for is the CRLF mistake again, doing
    // something other than what was asked without saying so.
    poke8(r_buf + 0, 90)
    let __s43_740: string = "PUT"
    let __s44_740: string = "/f"
    let __s45_740: string = "h"
    let o = tls_req_start(r_buf, __s43_740.utf8, __s44_740.utf8, __s45_740.utf8)
    assert_eq(tls_req_end(r_buf, o, r_body, 0 - 5), 0 - 1)
}

test "http request: the body is NOT checked, because a body may hold anything" {
    // CRLF is data inside a body; only header lines are structure.
    let __s46_749: string = "POST"
    let __s47_749: string = "/"
    let __s48_749: string = "h"
    let __s49_749: string = "a\r\nb"
    let n = tls_req_end(r_buf, tls_req_start(r_buf, __s46_749.utf8, __s47_749.utf8, __s48_749.utf8), __s49_749.utf8, 4)
    let __s3_757: string = "POST / HTTP/1.1\r\nHost: h\r\nContent-Length: 4\r\nConnection: close\r\n\r\na\r\nb"
    assert_eq(r_is(r_buf, n, __s3_757.utf8), 1)
}

let __q12_774: string = "Wiki"
let __q13_774: string = "pedia"
test "chunked: a body split across chunks is joined back exactly" {
    // __q12_774.utf8 + __q13_774.utf8 in two chunks, then the zero chunk that ends the body.
    let __s0_681: string = "4\r\nWiki\r\n5\r\npedia\r\n0\r\n\r\n"
    let n = tls_put_str(r_buf, 0, __s0_681.utf8)
    let len = tls_dechunk(r_buf, 0, n)
    assert_eq(len, 9)
    let __s4_767: string = "Wikipedia"
    assert_eq(r_is(r_buf, len, __s4_767.utf8), 1)
}

test "chunked: the size is hexadecimal, not decimal" {
    // 0x10 is sixteen bytes; reading it as ten would truncate the body.
    let __s1_690: string = "10\r\n0123456789abcdef\r\n0\r\n\r\n"
    let n = tls_put_str(r_buf, 0, __s1_690.utf8)
    assert_eq(tls_dechunk(r_buf, 0, n), 16)
    let __s5_776: string = "0123456789abcdef"
    assert_eq(r_is(r_buf, 16, __s5_776.utf8), 1)
}

test "chunked: a chunk may carry arbitrary bytes, NUL included" {
    poke8(r_body + 0, 65)
    poke8(r_body + 1, 0)
    poke8(r_body + 2, 66)
    let __s2_700: string = "3\r\n"
    let mut o = tls_put_str(r_buf, 0, __s2_700.utf8)
    o = o + 0
    poke8(r_buf + o, 65)
    poke8(r_buf + o + 1, 0)
    poke8(r_buf + o + 2, 66)
    let __s3_706: string = "\r\n0\r\n\r\n"
    let n = tls_put_str(r_buf, o + 3, __s3_706.utf8)
    assert_eq(tls_dechunk(r_buf, 0, n), 3)
    assert_eq(peek8(r_buf + 0), 65)
    assert_eq(peek8(r_buf + 1), 0)
    assert_eq(peek8(r_buf + 2), 66)
}

test "chunked: chunk extensions after the size are ignored" {
    let __s4_715: string = "4;name=value\r\nWiki\r\n0\r\n\r\n"
    let n = tls_put_str(r_buf, 0, __s4_715.utf8)
    assert_eq(tls_dechunk(r_buf, 0, n), 4)
    let __s6_802: string = "Wiki"
    assert_eq(r_is(r_buf, 4, __s6_802.utf8), 1)
}

test "chunked: decoding starts where the caller says, leaving the headers alone" {
    let __s5_722: string = "HTTP/1.1 200 OK\r\n\r\n"
    let head = tls_put_str(r_buf, 0, __s5_722.utf8)
    let __s6_724: string = "4\r\nWiki\r\n0\r\n\r\n"
    let n = tls_put_str(r_buf, head, __s6_724.utf8)
    let len = tls_dechunk(r_buf, head, n)
    assert_eq(len, 4)
    let __s7_813: string = "HTTP/1.1 200 OK\r\n\r\n"
    assert_eq(r_is(r_buf, head, __s7_813.utf8), 1)   // cabeceras intactas
    assert_eq(peek8(r_buf + head), 87)                           // 'W'
}

test "chunked: a truncated body yields what actually arrived, not past the end" {
    // The peer announced eight bytes and sent four before dying.
    let __s7_734: string = "8\r\nWiki"
    let n = tls_put_str(r_buf, 0, __s7_734.utf8)
    assert_eq(tls_dechunk(r_buf, 0, n), 4)
}

test "chunked: an empty body decodes to nothing" {
    let __s8_740: string = "0\r\n\r\n"
    let n = tls_put_str(r_buf, 0, __s8_740.utf8)
    assert_eq(tls_dechunk(r_buf, 0, n), 0)
}

test "chunked: a chunked body is recognised from the headers, a plain one is not" {
    let __s9_746: string = "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n"
    let h1 = tls_put_str(r_buf, 0, __s9_746.utf8)
    assert_eq(tls_is_chunked(r_buf, h1), 1)
    let __s10_749: string = "HTTP/1.1 200 OK\r\nContent-Length: 4\r\n\r\n"
    let h2 = tls_put_str(r_buf, 0, __s10_749.utf8)
    assert_eq(tls_is_chunked(r_buf, h2), 0)
}

test "chunked: an upper-case hex size is read the same as a lower-case one" {
    let __s11_755: string = "A\r\n0123456789\r\n0\r\n\r\n"
    let n = tls_put_str(r_buf, 0, __s11_755.utf8)
    assert_eq(tls_dechunk(r_buf, 0, n), 10)
    let __s8_844: string = "0123456789"
    assert_eq(r_is(r_buf, 10, __s8_844.utf8), 1)
}

test "chunked: a body with no size line at all decodes to nothing" {
    let __s12_762: string = "\r\nWiki"
    let n = tls_put_str(r_buf, 0, __s12_762.utf8)
    assert_eq(tls_dechunk(r_buf, 0, n), 0)
}

let __q14_870: string = "chunked"
test "chunked: a filename that merely contains the word is NOT a chunked body" {
    // An API delivering a document sends Content-Disposition with a filename, and reading
    // __q14_870.utf8 there would decode a body that was never chunked: tls_dechunk returns 0 on
    // it, so the caller writes an EMPTY file and nothing complains.
    let __m0: string = "HTTP/1.1 200 OK\r\nContent-Disposition: attachment; filename=informe-chunked.pdf\r\nContent-Length: 9\r\n\r\n"
    let h = tls_put_str(r_buf, 0,
        __m0.utf8)
    assert_eq(tls_is_chunked(r_buf, h), 0)
}

test "chunked: the header name is matched without regard to case, anywhere in the block" {
    let __m1: string = "HTTP/1.1 200 OK\r\nServer: x\r\nTrAnSfEr-EnCoDiNg: Chunked\r\nDate: today\r\n\r\n"
    let h = tls_put_str(r_buf, 0,
        __m1.utf8)
    assert_eq(tls_is_chunked(r_buf, h), 1)
}

test "chunked: a list of encodings ending in chunked still counts" {
    let __s13_783: string = "HTTP/1.1 200 OK\r\nTransfer-Encoding: gzip, chunked\r\n\r\n"
    let h = tls_put_str(r_buf, 0, __s13_783.utf8)
    assert_eq(tls_is_chunked(r_buf, h), 1)
}

test "chunked: the search stops at the end of the Transfer-Encoding line" {
    // The word sits in a LATER header, so a search that runs past the end of the line it
    // belongs to would find it and decode a body that is not chunked.
    let __m2: string = "HTTP/1.1 200 OK\r\nTransfer-Encoding: identity\r\nX-Note: chunked\r\n\r\n"
    let h = tls_put_str(r_buf, 0,
        __m2.utf8)
    assert_eq(tls_is_chunked(r_buf, h), 0)
    // ...and the reverse order too: the word before the header must not count either.
    let __m3: string = "HTTP/1.1 200 OK\r\nX-Note: chunked\r\nTransfer-Encoding: identity\r\n\r\n"
    let h2 = tls_put_str(r_buf, 0,
        __m3.utf8)
    assert_eq(tls_is_chunked(r_buf, h2), 0)
}

let __q15_907: string = "chunked"
let __q16_914: string = "chunked"
test "chunked: nothing is read past the end of the header block" {
    // hdrend falls INSIDE the word __q15_907.utf8: what comes after it is the next response in
    // the buffer, not this one's headers, and comparing into it would answer with somebody
    // else's data.
    let __s14_804: string = "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n"
    let full = tls_put_str(r_buf, 0, __s14_804.utf8)
    assert_eq(tls_is_chunked(r_buf, full), 1)
    assert_eq(tls_is_chunked(r_buf, 40), 0)          // corta a mitad de __q16_914.utf8
}

test "chunked: an upper-case hex letter is a digit too" {
    let __s15_811: string = "F\r\n123456789012345\r\n0\r\n\r\n"
    let n = tls_put_str(r_buf, 0, __s15_811.utf8)
    assert_eq(tls_dechunk(r_buf, 0, n), 15)
}
