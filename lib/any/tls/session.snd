//
// lib/any/tls/session.snd: a reusable TLS 1.3 client session. tls_connect completes the
// handshake (through the client Finished and the certificate-chain validation) and returns a
// session handle carrying the application-traffic keys and record sequence numbers; tls_write
// and tls_read then move arbitrary application data, sealing/opening one record at a time.
// This is the streaming counterpart of the single-shot tls_get, and the basis of a TLS tunnel.
//
// A session is a heap block:
//   +0   fd (i64)            +8   client app seq      +16  server app seq
//   +24  client key (32)     +56  client iv (12)
//   +68  server key (32)     +100 server iv (12)

include "any/tls/auth.snd"
include "any/tls/chain.snd"

fn tls_sess_fd(s: i64) -> i64 { peek64(s) }
fn tls_sess_ckey(s: i64) -> i64 { s + 24 }
fn tls_sess_civ(s: i64) -> i64 { s + 56 }
fn tls_sess_skey(s: i64) -> i64 { s + 68 }
fn tls_sess_siv(s: i64) -> i64 { s + 100 }

// The last alert the peer sent on this session, as (level << 8) | description, or -1 if none.
//
// `tls_read` returns 0 both when the data ends and when the peer sends an alert, because from
// the reader's side there is nothing more to read either way. But the two mean opposite things:
// a close_notify is the peer finishing politely, and a fatal alert is the peer REFUSING, and a
// caller that cannot tell them apart reports a network problem when it was rejected. Cost me an
// evening: a peer that was sending an orderly close_notify looked exactly like a hard hang-up.
fn tls_sess_alert(s: i64) -> i64 { peek64(s + 112) }

// Completes a TLS 1.3 handshake to `host`:`port` for server name `sni`, validating the
// certificate chain against `roots` (nroots) at `now14`, and returns a session handle ready
// for tls_write/tls_read. Returns 0 on any failure (connection, handshake, or an untrusted
// chain). The peer receives no application data unless its chain validated.
fn tls_connect(host: i64, port: i64, sni: i64, snilen: i64, alpn: i64, alpnlen: i64, roots: i64, nroots: i64, now14: i64) -> i64 {
    let fd = sock(AF_INET, SOCK_STREAM, 0)
    if fd < 0 { return 0 }
    let sa[2]
    sockaddr_in_build(sa, tls_ipv4(host), port)
    if connect_sock(fd, sa, 16) < 0 { close_fd(fd); return 0 }
    tls_connect_fd(fd, sni, snilen, alpn, alpnlen, roots, nroots, now14)
}

// Like tls_connect, but performs the handshake over an ALREADY-CONNECTED socket `fd` (the
// caller owns the TCP connect). This is what a STARTTLS-style upgrade needs, e.g. a PostgreSQL
// SSLRequest where the plaintext negotiation happens before TLS on the same socket. Returns a
// session handle, or 0 (closing `fd`) on handshake failure or an untrusted chain.
fn tls_connect_fd(fd: i64, sni: i64, snilen: i64, alpn: i64, alpnlen: i64, roots: i64, nroots: i64, now14: i64) -> i64 {
    let cpriv[32]
    if tls_random(cpriv, 32) == 0 { close_fd(fd); return 0 }
    let base9[32]
    poke8(base9, 9)
    let mut i = 0
    for i < 31 { poke8(base9 + 1 + i, 0); i = i + 1 }
    let cpub[32]
    x25519(cpriv, base9, cpub)
    let random[32]
    if tls_random(random, 32) == 0 { close_fd(fd); return 0 }
    let ch = heap_alloc(1024)
    let chlen = tls_build_client_hello(random, cpub, sni, snilen, alpn, alpnlen, ch)
    let scratch = heap_alloc(4096)
    tls_send_plain_handshake(fd, ch, chlen, scratch)

    let rec = heap_alloc(20000)
    let rl = tls_read_record(fd, rec, 20000)
    if rl <= 0 { close_fd(fd); return 0 }
    if peek8(rec) != 22 { close_fd(fd); return 0 }
    let shlen = rl - 5
    let spub[32]
    if tls_sh_key_share(rec + 5, spub) != 0x001d { close_fd(fd); return 0 }

    let tr = heap_alloc(20000)
    i = 0
    for i < chlen { poke8(tr + i, peek8(ch + i)); i = i + 1 }
    i = 0
    for i < shlen { poke8(tr + chlen + i, peek8(rec + 5 + i)); i = i + 1 }
    let trlen = chlen + shlen

    let ecdhe[32]
    x25519(cpriv, spub, ecdhe)
    let early[32]
    tls_early_secret(early, 0, early)
    let hs[32]
    tls_derive_handshake_secret(early, ecdhe, 32, hs)
    let s_hs[32]
    tls_server_hs_traffic(hs, tr, trlen, s_hs)
    let c_hs[32]
    tls_client_hs_traffic(hs, tr, trlen, c_hs)
    let skey[32]
    let siv[12]
    tls_traffic_key_iv(s_hs, skey, siv)
    let ckey[32]
    let civ[12]
    tls_traffic_key_iv(c_hs, ckey, civ)

    // decrypt the server flight until the server Finished (type 20) is present
    let flight = heap_alloc(30000)
    let mut flen = 0
    let mut sseq = 0
    let mut finoff = 0 - 1
    for finoff < 0 {
        let rl2 = tls_read_record(fd, rec, 20000)
        if rl2 <= 0 { close_fd(fd); return 0 }
        let ct = peek8(rec)
        if ct != 20 {
            if ct != 23 { close_fd(fd); return 0 }
            let m = tls_open(skey, siv, sseq, rec, rl2, flight + flen)
            if m < 0 { close_fd(fd); return 0 }
            flen = flen + (m & 0xffffffff)
            sseq = sseq + 1
            finoff = tls_flight_find_msg(flight, flen, 20)
        }
    }
    let finlen = (peek8(flight + finoff + 1) << 16) | (peek8(flight + finoff + 2) << 8) | peek8(flight + finoff + 3)
    let finend = finoff + 4 + finlen

    // verify the server Finished
    i = 0
    for i < finoff { poke8(tr + trlen + i, peek8(flight + i)); i = i + 1 }
    let th_sfin[32]
    sha256_hash(tr, trlen + finoff, th_sfin)
    let sfk[32]
    hkdf_expand_label(s_hs, "finished", 8, sfk, 0, sfk, 32)
    let sfin[32]
    hmac_sha256(sfk, 32, th_sfin, 32, sfin)
    i = 0
    for i < 32 {
        if peek8(sfin + i) != peek8(flight + finoff + 4 + i) { close_fd(fd); return 0 }
        i = i + 1
    }

    // validate the certificate chain to a trusted root before trusting the peer
    if tls_verify_server_chain(flight, flen, roots, nroots, sni, snilen, now14) != 1 {
        close_fd(fd); return 0
    }

    // transcript through the server Finished
    i = 0
    for i < finend { poke8(tr + trlen + i, peek8(flight + i)); i = i + 1 }
    let th_full[32]
    sha256_hash(tr, trlen + finend, th_full)

    // client Finished (client handshake key, sequence 0), after a middlebox ChangeCipherSpec
    let cfk[32]
    hkdf_expand_label(c_hs, "finished", 8, cfk, 0, cfk, 32)
    let cfin[32]
    hmac_sha256(cfk, 32, th_full, 32, cfin)
    let cfmsg[40]
    poke8(cfmsg + 0, 20); poke8(cfmsg + 1, 0); poke8(cfmsg + 2, 0); poke8(cfmsg + 3, 32)
    i = 0
    for i < 32 { poke8(cfmsg + 4 + i, peek8(cfin + i)); i = i + 1 }
    let ccs[6]
    poke8(ccs + 0, 20); poke8(ccs + 1, 3); poke8(ccs + 2, 3)
    poke8(ccs + 3, 0); poke8(ccs + 4, 1); poke8(ccs + 5, 1)
    write_buf(fd, ccs, 6)
    let sealed = heap_alloc(128)
    let sl = tls_seal(ckey, civ, 0, 22, cfmsg, 36, sealed)
    write_buf(fd, sealed, sl)

    // application traffic keys (master secret, transcript through the server Finished)
    let master[32]
    tls_derive_master_secret(hs, master)
    let sess = heap_alloc(128)
    poke64(sess, fd)
    poke64(sess + 8, 0)                             // client app seq
    poke64(sess + 16, 0)                            // server app seq
    poke64(sess + 112, 0 - 1)                       // no alert seen yet
    let c_ap[32]
    derive_secret(master, "c ap traffic", 12, tr, trlen + finend, c_ap)
    let s_ap[32]
    derive_secret(master, "s ap traffic", 12, tr, trlen + finend, s_ap)
    tls_traffic_key_iv(c_ap, tls_sess_ckey(sess), tls_sess_civ(sess))
    tls_traffic_key_iv(s_ap, tls_sess_skey(sess), tls_sess_siv(sess))
    sess
}

// Sends `n` bytes of application data over the session, sealed as one or more TLS records
// (each at most 16384 plaintext bytes) at the client application sequence. Returns n, or a
// negative value if a write failed.
fn tls_write(sess: i64, buf: i64, n: i64) -> i64 {
    let fd = tls_sess_fd(sess)
    let sealed = heap_alloc(16640)
    let mut off = 0
    for off < n {
        let mut chunk = n - off
        if chunk > 16384 { chunk = 16384 }
        let seq = peek64(sess + 8)
        let sl = tls_seal(tls_sess_ckey(sess), tls_sess_civ(sess), seq, 23, buf + off, chunk, sealed)
        if write_buf(fd, sealed, sl) < 0 { return 0 - 1 }
        poke64(sess + 8, seq + 1)
        off = off + chunk
    }
    n
}

// Reads the next chunk of application data into `buf` (up to `cap`), returning its length.
// TLS-level records that are not application data are handled transparently: a
// NewSessionTicket is skipped, and a close_notify (or EOF) returns 0. Returns a negative value
// on a hard read/decrypt error. One TLS record per call.
fn tls_read(sess: i64, buf: i64, cap: i64) -> i64 {
    let fd = tls_sess_fd(sess)
    let rec = heap_alloc(20000)
    for {
        let rl = tls_read_record(fd, rec, 20000)
        if rl <= 0 { return 0 }                     // EOF or read error: connection closed
        if peek8(rec) == 23 {
            let seq = peek64(sess + 16)
            let m = tls_open(tls_sess_skey(sess), tls_sess_siv(sess), seq, rec, rl, buf)
            if m < 0 { return 0 - 1 }
            poke64(sess + 16, seq + 1)
            let typ = m >> 32
            let dl = m & 0xffffffff
            if typ == 21 {
                // Record WHICH alert before reporting the end, so the caller can tell a polite
                // close_notify (level 1, description 0) from a refusal.
                if dl >= 2 { poke64(sess + 112, (peek8(buf) << 8) | peek8(buf + 1)) }
                return 0
            }
            if typ == 23 {
                if dl > cap { return cap }
                return dl
            }
            // any other inner type (22 NewSessionTicket, etc.): skip, read the next record
        }
    }
    0
}

// Closes the session's socket.
fn tls_close(sess: i64) { close_fd(tls_sess_fd(sess)) }
