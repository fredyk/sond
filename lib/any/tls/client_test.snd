//
// Test of tls/client.snd. The client handshake is exercised end to end over a real
// loopback socket against a minimal TLS 1.3 server written here with the same primitives:
// the server completes the x25519 exchange, runs the same key schedule, and seals an
// EncryptedExtensions with the server handshake key. If the client (the parent, under
// test) opens it back to the byte 0x08, then ClientHello, ServerHello parsing, ECDHE, the
// ladder and the record layer all agree. (A separate live probe against a public server
// confirms the same flow on the wire; that one is not in the gate because it needs the
// network.)

include "any/tls/client.snd"
include "x86_64/linux/testing.snd"

let mut srv_sh[512]
let mut srv_tr[2048]
let mut srv_rec[512]

// A minimal ServerHello builder: version, random, empty session id, the chosen cipher, no
// compression, and the supported_versions + key_share extensions the client needs.
fn t_build_sh(random: i64, spub: i64, grp: i64, out: i64) -> i64 {
    poke8(out, 2)                                    // ServerHello
    let body = out + 4
    let mut o = 0
    hs_put_u16(body + o, 0x0303); o = o + 2
    let mut i = 0
    for i < 32 { poke8(body + o + i, peek8(random + i)); i = i + 1 }
    o = o + 32
    poke8(body + o, 0); o = o + 1                    // empty session id
    hs_put_u16(body + o, 0x1303); o = o + 2          // cipher suite
    poke8(body + o, 0); o = o + 1                    // compression null
    let extlen_at = o
    o = o + 2
    let ext_start = o
    hs_put_u16(body + o, 43); o = o + 2              // supported_versions
    hs_put_u16(body + o, 2); o = o + 2
    hs_put_u16(body + o, 0x0304); o = o + 2
    hs_put_u16(body + o, 51); o = o + 2              // key_share
    hs_put_u16(body + o, 36); o = o + 2
    hs_put_u16(body + o, grp); o = o + 2             // named group
    hs_put_u16(body + o, 32); o = o + 2
    i = 0
    for i < 32 { poke8(body + o + i, peek8(spub + i)); i = i + 1 }
    o = o + 32
    hs_put_u16(body + extlen_at, o - ext_start)
    hs_put_u24(out + 1, o)
    4 + o
}

// Accepts, optionally reads the ClientHello, then behaves per `mode`, and exits: mode 0 =
// hang up immediately; 1 = send a non-handshake (alert) record; 2 = send a ServerHello with
// a non-x25519 group; 3 = send a valid ServerHello then hang up (no encrypted flight).
fn t_bad_server(sfd: i64, mode: i64) {
    let afd = accept_sock(sfd, 0, 0)
    if afd < 0 { syscall(SYS_exit, 2) }
    if mode == 0 { close_fd(afd); syscall(SYS_exit, 0) }
    let crec[1024]
    tls_read_record(afd, crec, 1024)
    if mode == 1 {
        let alert[7]
        poke8(alert + 0, 21); poke8(alert + 1, 3); poke8(alert + 2, 3)
        poke8(alert + 3, 0); poke8(alert + 4, 2); poke8(alert + 5, 2); poke8(alert + 6, 40)
        write_buf(afd, alert, 7)
        close_fd(afd); syscall(SYS_exit, 0)
    }
    let srand[32]
    tls_random(srand, 32)
    let spub[32]
    tls_random(spub, 32)
    let grp = 0x001d
    if mode == 2 { poke8(srv_sh + 0, 0) }            // marker unused
    let g = if mode == 2 { 0x0017 } else { 0x001d }
    let shlen = t_build_sh(srand, spub, g, srv_sh)
    tls_send_plain_handshake(afd, srv_sh, shlen, srv_rec)
    if mode == 4 {
        // a well-framed application_data record whose AEAD tag will not check out
        let garbage[64]
        poke8(garbage + 0, 23); poke8(garbage + 1, 3); poke8(garbage + 2, 3)
        poke8(garbage + 3, 0); poke8(garbage + 4, 40)
        let mut gi = 0
        for gi < 40 { poke8(garbage + 5 + gi, 0); gi = gi + 1 }
        write_buf(afd, garbage, 45)
    }
    close_fd(afd)
    syscall(SYS_exit, 0)
}

fn t_listen(port: i64) -> i64 {
    let fd = sock(AF_INET, SOCK_STREAM, 0)
    set_reuseaddr(fd)
    let sa[2]
    sockaddr_in_build(sa, 0x7f000001, port)
    bind_sock(fd, sa, 16)
    listen_sock(fd, 4)
    fd
}

test "tls client: a full handshake probe against a matching Sond server" {
    let port = 55443
    let ip = 0x7f000001
    let sfd = sock(AF_INET, SOCK_STREAM, 0)
    set_reuseaddr(sfd)
    let sa[2]
    sockaddr_in_build(sa, ip, port)
    bind_sock(sfd, sa, 16)
    listen_sock(sfd, 4)

    let pid = syscall(SYS_fork)
    if pid == 0 {
        // CHILD: the minimal server.
        let afd = accept_sock(sfd, 0, 0)
        if afd < 0 { syscall(SYS_exit, 2) }
        // read the ClientHello record; its fragment is the ClientHello message.
        let crec[1024]
        let crl = tls_read_record(afd, crec, 1024)
        if crl <= 0 { syscall(SYS_exit, 3) }
        let cmsg = crec + 5
        let cmsglen = crl - 5
        let cpub = cmsg + 84                          // x25519 key share, at this fixed offset
        // server keypair and shared secret
        let spriv[32]
        tls_random(spriv, 32)
        let base9[32]
        poke8(base9, 9)
        let mut z = 0
        for z < 31 { poke8(base9 + 1 + z, 0); z = z + 1 }
        let spub[32]
        x25519(spriv, base9, spub)
        let shared[32]
        x25519(spriv, cpub, shared)
        // ServerHello
        let srand[32]
        tls_random(srand, 32)
        let shlen = t_build_sh(srand, spub, 0x001d, srv_sh)
        tls_send_plain_handshake(afd, srv_sh, shlen, srv_rec)
        // transcript = ClientHello || ServerHello, server handshake traffic key
        z = 0
        for z < cmsglen { poke8(srv_tr + z, peek8(cmsg + z)); z = z + 1 }
        z = 0
        for z < shlen { poke8(srv_tr + cmsglen + z, peek8(srv_sh + z)); z = z + 1 }
        let trlen = cmsglen + shlen
        let early[32]
        tls_early_secret(early, 0, early)
        let hs[32]
        tls_derive_handshake_secret(early, shared, 32, hs)
        let s_hs[32]
        tls_server_hs_traffic(hs, srv_tr, trlen, s_hs)
        let skey[32]
        let siv[12]
        tls_traffic_key_iv(s_hs, skey, siv)
        // seal a minimal EncryptedExtensions (type 8, empty extensions) as one record
        let ee[6]
        poke8(ee + 0, 8); poke8(ee + 1, 0); poke8(ee + 2, 0)
        poke8(ee + 3, 2); poke8(ee + 4, 0); poke8(ee + 5, 0)
        let sealed[128]
        let sl = tls_seal(skey, siv, 0, 22, ee, 6, sealed)
        // a legacy ChangeCipherSpec before the encrypted flight (the client must skip it)
        let ccs[6]
        poke8(ccs + 0, 20); poke8(ccs + 1, 3); poke8(ccs + 2, 3)
        poke8(ccs + 3, 0); poke8(ccs + 4, 1); poke8(ccs + 5, 1)
        write_buf(afd, ccs, 6)
        write_buf(afd, sealed, sl)
        close_fd(afd)
        syscall(SYS_exit, 0)
    }

    // PARENT: the client under test.
    let ee[4096]
    let n = tls_handshake_probe("127.0.0.1", port, "sond.example", 12, ee)
    assert(n > 0)
    assert_eq(peek8(ee), 8)                           // EncryptedExtensions
    close_fd(sfd)
    let st[1]
    syscall(SYS_wait4, pid, st, 0, 0)
    assert_eq((st[0] >> 8) & 255, 0)
}

let mut ebuf[4096]

test "tls client: a refused connection fails" {
    assert_eq(tls_handshake_probe("127.0.0.1", 55450, "h", 1, ebuf), 0 - 1)
}
test "tls client: a server that hangs up before ServerHello fails" {
    let sfd = t_listen(55451)
    let pid = syscall(SYS_fork)
    if pid == 0 { t_bad_server(sfd, 0) }
    assert_eq(tls_handshake_probe("127.0.0.1", 55451, "h", 1, ebuf), 0 - 1)
    close_fd(sfd); let st[1]; syscall(SYS_wait4, pid, st, 0, 0)
}
test "tls client: a non-handshake first record fails" {
    let sfd = t_listen(55452)
    let pid = syscall(SYS_fork)
    if pid == 0 { t_bad_server(sfd, 1) }
    assert_eq(tls_handshake_probe("127.0.0.1", 55452, "h", 1, ebuf), 0 - 1)
    close_fd(sfd); let st[1]; syscall(SYS_wait4, pid, st, 0, 0)
}
test "tls client: a ServerHello with a non-x25519 group fails" {
    let sfd = t_listen(55453)
    let pid = syscall(SYS_fork)
    if pid == 0 { t_bad_server(sfd, 2) }
    assert_eq(tls_handshake_probe("127.0.0.1", 55453, "h", 1, ebuf), 0 - 1)
    close_fd(sfd); let st[1]; syscall(SYS_wait4, pid, st, 0, 0)
}
test "tls client: a hang-up after a valid ServerHello fails" {
    let sfd = t_listen(55454)
    let pid = syscall(SYS_fork)
    if pid == 0 { t_bad_server(sfd, 3) }
    assert_eq(tls_handshake_probe("127.0.0.1", 55454, "h", 1, ebuf), 0 - 1)
    close_fd(sfd); let st[1]; syscall(SYS_wait4, pid, st, 0, 0)
}

test "tls client: a corrupt encrypted record fails the open" {
    let sfd = t_listen(55455)
    let pid = syscall(SYS_fork)
    if pid == 0 { t_bad_server(sfd, 4) }
    assert_eq(tls_handshake_probe("127.0.0.1", 55455, "h", 1, ebuf), 0 - 1)
    close_fd(sfd); let st[1]; syscall(SYS_wait4, pid, st, 0, 0)
}

// A fill loop that retries a syscall without looking at WHY it failed is a spin waiting to
// happen: getrandom returns short when a signal interrupts it (retry, correct) but it also
// returns errors, and the old loop treated both the same, so a permanent failure (EFAULT on a
// bad buffer) burned a core forever instead of reporting. A null buffer is the cheapest way to
// make the kernel fail it every time: the call must come back, and come back saying no.
test "tls_random reports a permanent failure instead of spinning" {
    assert_eq(tls_random(0, 32), 0)
}

test "tls_random fills the buffer and reports success" {
    let buf[4]
    let mut i = 0
    for i < 32 { poke8(buf + i, 0); i = i + 1 }
    assert_eq(tls_random(buf, 32), 1)
    // 32 random bytes are all zero with probability 2^-256, so this reads as "it wrote".
    let mut any = 0
    i = 0
    for i < 32 { any = any | peek8(buf + i); i = i + 1 }
    assert_eq(any != 0, 1)
}
