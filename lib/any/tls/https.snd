//
// lib/any/tls/https.snd: a TLS 1.3 HTTPS GET on top of the handshake/auth in auth.snd. It
// completes the handshake (server Finished, client Finished, application keys) and performs
// an HTTP/1.1 GET, reading the response. Kept apart from the audited auth path (auth.snd) so
// each has its own scope.

include "any/tls/session.snd"

// A full TLS 1.3 GET on top of a reusable session: connects and validates the certificate
// chain (tls_connect), sends an HTTP/1.1 request for `path`, and reads the response into `out`
// (up to `cap`). Returns the response byte length, or <=0 on failure (<0 including an
// untrusted or unreachable server). The chain is validated against `roots`/`nroots` at `now14`
// with the leaf required to name `sni`; an untrusted server receives no request.
//
// STATUS: proven end to end by a deterministic, network-free test (https_test.snd, a full Sond
// TLS server whose certificate chains to a test root). For a streaming or bidirectional peer
// use the session API directly (tls_connect / tls_write / tls_read); for the audited handshake
// identity check alone use tls_handshake_auth.
fn tls_get(host: i64, port: i64, sni: i64, snilen: i64, path: i64, pathlen: i64, out: i64, cap: i64,
           roots: i64, nroots: i64, now14: i64) -> i64 {
    let __s0_22: string = "http/1.1"
    let sess = tls_connect(host, port, sni, snilen, __s0_22.utf8, 8, roots, nroots, now14)
    if sess == 0 { return 0 - 1 }
    let req = heap_alloc(2048)
    let rq = tls_http_req(sni, snilen, path, pathlen, req)
    if tls_write(sess, req, rq) < 0 { tls_close(sess); return 0 - 1 }

    let mut olen = 0
    let chunk = heap_alloc(20000)
    let mut reads = 0
    for reads < 64 {
        let n = tls_read(sess, chunk, 20000)
        if n <= 0 { break }
        let mut j = 0
        for j < n {
            if olen < cap { poke8(out + olen, peek8(chunk + j)); olen = olen + 1 }
            j = j + 1
        }
        reads = reads + 1
    }
    tls_close(sess)
    olen
}

// Builds a minimal HTTP/1.1 GET request into `buf`: "GET <path> HTTP/1.1\r\nHost: <host>\r\n
// Connection: close\r\n\r\n". Returns the length.
// Copies a NUL-terminated literal into `buf + o` and returns the new offset. Counting a literal
// by hand is how this file shipped a request that was never terminated: two of the three lengths
// were short by one, so the header ended in "\r\n\r" and every strict server waited for a blank
// line that never came. A literal knows where it ends; asking it cannot be off by one.
fn tls_put_str(buf: i64, o: i64, s: i64) -> i64 {
    let mut p = o
    let mut i = 0
    for peek8(s + i) != 0 {
        poke8(buf + p, peek8(s + i))
        p = p + 1
        i = i + 1
    }
    p
}

// One hex digit's value; anything that is not a digit decodes as garbage, which is why the
// caller stops at the CR that ends the size line.
fn tls_hex_digit(c: i64) -> i64 {
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 97 && c <= 102 { return c - 87 }
    if c >= 65 && c <= 70 { return c - 55 }
    0
}

// Decodes a chunked body IN PLACE, starting at `start` and reading up to `n`. A server that
// does not know the length up front sends the body in chunks, each preceded by its size in
// hexadecimal and a CRLF, and a zero-sized chunk ends it. Those size markers are framing, not
// content: kept in the buffer they end up INSIDE the downloaded file, which is how a signed
// PDF stops validating.
//
// Writing starts at `start`, not at the head of the buffer, so response headers the caller
// still needs survive. A body that stops early decodes to what actually arrived rather than
// reading past the end. Returns the decoded length.
fn tls_dechunk(buf: i64, start: i64, n: i64) -> i64 {
    let mut r = start
    let mut w = start
    for r < n {
        let mut size = 0
        let mut digits = 0
        for r < n {
            let c = peek8(buf + r)
            if c == 13 { break }                    // CR ends the size line
            if c == 59 { break }                    // ';' starts a chunk extension
            size = size * 16 + tls_hex_digit(c)
            digits = digits + 1
            r = r + 1
        }
        for r < n {                                 // skip anything up to the LF
            if peek8(buf + r) == 10 { break }
            r = r + 1
        }
        r = r + 1
        if digits == 0 { break }                    // no size at all: nothing more to trust
        if size == 0 { break }                      // the zero chunk closes the body
        let mut i = 0
        for i < size {
            if r + i >= n { break }                 // the peer stopped mid-chunk
            poke8(buf + w + i, peek8(buf + r + i))
            i = i + 1
        }
        w = w + i
        if i < size { break }
        r = r + size + 2                            // the CRLF that closes the chunk
    }
    w - start
}

// `c` folded to lower case, for the comparisons where case carries no meaning: header names
// do not distinguish it, and neither do the transfer codings.
fn tls_lower(c: i64) -> i64 {
    if c >= 65 && c <= 90 { return c + 32 }
    c
}

// 1 if the NUL-terminated `word` sits at `buf + pos`, compared without regard to case and
// without running past `end`.
fn tls_word_at(buf: i64, pos: i64, end: i64, word: i64) -> i64 {
    let mut j = 0
    for peek8(word + j) != 0 {
        if pos + j >= end { return 0 }
        if tls_lower(peek8(buf + pos + j)) != tls_lower(peek8(word + j)) { return 0 }
        j = j + 1
    }
    1
}

// 1 if the response headers ending at `hdrend` announce a chunked body.
//
// The word is looked for in the VALUE of Transfer-Encoding, never anywhere in the block: an
// API delivering a document sends Content-Disposition with a filename, and a file called
// informe-chunked.pdf would otherwise be read as a chunked response. That mistake is not a
// wrong download, it is an EMPTY one — decoding a body that was never chunked yields zero
// bytes, so the caller writes an empty file and nothing reports a thing.
fn tls_is_chunked(buf: i64, hdrend: i64) -> i64 {
    let mut i = 0
    for i < hdrend {
        // A header line starts at the beginning of the block or right after a CRLF; the
        // status line is skipped by the same rule.
        let at_line = if i == 0 { 0 } else { peek8(buf + i - 1) == 10 }
        if at_line == 1 {
            let __lit0: string = "transfer-encoding:"
            if tls_word_at(buf, i, hdrend, __lit0.utf8) == 1 {
                let mut p = i + 18                  // past the colon
                for p < hdrend {                    // ...to the end of THIS line only
                    if peek8(buf + p) == 13 { return 0 }
                    let __lit1: string = "chunked"
                    if tls_word_at(buf, p, hdrend, __lit1.utf8) == 1 { return 1 }
                    p = p + 1
                }
                return 0
            }
        }
        i = i + 1
    }
    0
}

// Writes `v` (>= 0) in decimal at `buf + o` and returns the new offset. Kept local instead of
// pulling in any/strings.snd: this file is included by every HTTPS caller, and the namespace
// is flat, so a dependency taken for one small helper is a name collision waiting to happen.
fn tls_put_uint(buf: i64, o: i64, v: i64) -> i64 {
    if v == 0 {
        poke8(buf + o, 48)
        return o + 1
    }
    let digits[24]
    let mut n = 0
    let mut rest = v
    for rest > 0 {
        poke8(digits + n, 48 + rest % 10)
        rest = rest / 10
        n = n + 1
    }
    let mut p = o
    let mut i = n
    for i > 0 {                                     // the digits came out backwards
        i = i - 1
        poke8(buf + p, peek8(digits + i))
        p = p + 1
    }
    p
}

// 1 if the NUL-terminated string `s` carries no CR (13) and no LF (10). Those two bytes are
// what SEPARATES header lines, so a value holding either can append headers the caller never
// wrote: with a value computed at run time (a credential read from a config file, a path
// taken from user input) that turns someone else's data into our request. Checked, never
// stripped: silently altering the caller's data is worse than refusing it, because the
// caller then believes it sent something it did not.
fn tls_hdr_safe(s: i64) -> i64 {
    let mut i = 0
    for peek8(s + i) != 0 {
        let c = peek8(s + i)
        if c == 13 { return 0 }
        if c == 10 { return 0 }
        i = i + 1
    }
    1
}

// Starts an HTTP/1.1 request in `buf`: the request line and the mandatory Host header,
// leaving the header block OPEN so headers can still be appended. `method`, `path` and `host`
// are NUL-terminated strings, copied to their terminator: a client that has to be told how
// long its own literals are is one typo away from a request nobody answers. Returns the
// offset to carry into tls_req_header / tls_req_end, or -1 WITHOUT writing anything if any
// argument holds a CR or an LF.
fn tls_req_start(buf: i64, method: i64, path: i64, host: i64) -> i64 {
    if tls_hdr_safe(method) == 0 { return 0 - 1 }
    if tls_hdr_safe(path) == 0 { return 0 - 1 }
    if tls_hdr_safe(host) == 0 { return 0 - 1 }
    let mut o = tls_put_str(buf, 0, method)
    let __lit2: string = " "
    o = tls_put_str(buf, o, __lit2.utf8)
    o = tls_put_str(buf, o, path)
    let __lit3: string = " HTTP/1.1\r\nHost: "
    o = tls_put_str(buf, o, __lit3.utf8)
    o = tls_put_str(buf, o, host)
    let __lit4: string = "\r\n"
    tls_put_str(buf, o, __lit4.utf8)
}

// Appends one "Name: value" header line at `o`. Returns the new offset, or -1 without writing
// if `name` or `value` holds a CR or an LF, or if `o` is already a refusal: a rejection has to
// survive to the end of the chain, or the caller sends a request it never composed.
fn tls_req_header(buf: i64, o: i64, name: i64, value: i64) -> i64 {
    if o < 0 { return 0 - 1 }
    if tls_hdr_safe(name) == 0 { return 0 - 1 }
    if tls_hdr_safe(value) == 0 { return 0 - 1 }
    let mut p = tls_put_str(buf, o, name)
    let __lit5: string = ": "
    p = tls_put_str(buf, p, __lit5.utf8)
    p = tls_put_str(buf, p, value)
    let __lit6: string = "\r\n"
    tls_put_str(buf, p, __lit6.utf8)
}

// Closes the header block and appends the body. `bodylen` is the byte count and it is the
// ONLY thing that delimits the body: a NUL inside it is data (a PDF upload is binary), so
// nothing here stops at a terminator. Content-Length is COMPUTED from bodylen and never
// taken from the caller, which is the only way the announced length cannot disagree with
// what is actually sent. The blank line that ends the header block is what makes the
// request complete; without it a server is right to sit and wait. Returns the total length,
// or -1 if `o` is a refusal from an earlier step. The body itself is NOT checked for CR or
// LF: inside a body those are data, and only header lines are structure.
fn tls_req_end(buf: i64, o: i64, body: i64, bodylen: i64) -> i64 {
    if o < 0 { return 0 - 1 }
    // A length that came out negative is a caller's arithmetic gone wrong, typically from a
    // file size. Sending a request that looks correct and carries no body would hide that.
    if bodylen < 0 { return 0 - 1 }
    let mut p = o
    if bodylen > 0 {
        let __lit7: string = "Content-Length: "
        p = tls_put_str(buf, p, __lit7.utf8)
        p = tls_put_uint(buf, p, bodylen)
        let __lit8: string = "\r\n"
        p = tls_put_str(buf, p, __lit8.utf8)
    }
    let __lit9: string = "Connection: close\r\n\r\n"
    p = tls_put_str(buf, p, __lit9.utf8)
    let mut j = 0
    for j < bodylen { poke8(buf + p, peek8(body + j)); p = p + 1; j = j + 1 }
    p
}

fn tls_http_req(hosthdr: i64, hosthdrlen: i64, path: i64, pathlen: i64, buf: i64) -> i64 {
    let __s0_273: string = "GET "
    let mut o = tls_put_str(buf, 0, __s0_273.utf8)
    let mut i = 0
    for i < pathlen { poke8(buf + o, peek8(path + i)); o = o + 1; i = i + 1 }
    let __lit10: string = " HTTP/1.1\r\nHost: "
    o = tls_put_str(buf, o, __lit10.utf8)
    i = 0
    for i < hosthdrlen { poke8(buf + o, peek8(hosthdr + i)); o = o + 1; i = i + 1 }
    // The trailing blank line is what ENDS the header block. Without it the request is
    // incomplete and the server is right to wait.
    let __lit11: string = "\r\nConnection: close\r\n\r\n"
    tls_put_str(buf, o, __lit11.utf8)
}

// ── Reading a response ───────────────────────────────────────────────────────────────────
//
// Everything below works on a response already sitting in a buffer, and takes the length that
// actually ARRIVED rather than trusting what the headers claim. A caller that believed
// Content-Length over the bytes in hand would hand back whatever the buffer happened to hold
// past the end of a truncated body, and it would look like a complete document.

// The offset just past the blank line that ends the header block, or -1 if the block never
// ends inside the `n` bytes received. Every other reader here starts from this: a response
// whose headers are incomplete has no headers to read and no body to point at, and saying so
// once is what keeps each of them from inventing an answer.
fn http_headers_end(buf: i64, n: i64) -> i64 {
    let mut i = 0
    for i + 3 < n {
        if peek8(buf + i) == 13 {
            if peek8(buf + i + 1) == 10 {
                if peek8(buf + i + 2) == 13 {
                    if peek8(buf + i + 3) == 10 { return i + 4 }
                }
            }
        }
        i = i + 1
    }
    0 - 1
}

// The three-digit status code of "HTTP/1.x NNN ...", or -1 if that is not what starts the
// buffer. It is checked rather than assumed: a plaintext error page, a proxy's own reply or a
// truncated read all produce something that is not a status line, and reading three bytes at a
// fixed offset would turn any of them into a number.
fn http_status(buf: i64, n: i64) -> i64 {
    if n < 12 { return 0 - 1 }
    let __p: string = "http/"
    if tls_word_at(buf, 0, n, __p.utf8) == 0 { return 0 - 1 }
    if peek8(buf + 8) != 32 { return 0 - 1 }
    let mut v = 0
    for k in 0..3 {
        let c = peek8(buf + 9 + k)
        if c < 48 { return 0 - 1 }
        if c > 57 { return 0 - 1 }
        v = v * 10 + (c - 48)
    }
    v
}

// A pointer to the value of header `name` (NUL-terminated, matched without regard to case),
// with its length written as a u32 at `lenptr`; 0 if the response does not carry it.
//
// The name is matched only at the start of a line and only up to its colon, so "content-t"
// does not find Content-Type and a name appearing inside another header's VALUE is not
// mistaken for a header of its own. Leading spaces after the colon are skipped and the value
// ends at its own CR: a header is one line.
fn http_header(buf: i64, n: i64, name: i64, lenptr: i64) -> i64 {
    let hdrend = http_headers_end(buf, n)
    if hdrend < 0 { return 0 }
    let mut i = 0
    for i < hdrend {
        let at_line = if i == 0 { 0 } else { peek8(buf + i - 1) == 10 }
        if at_line == 1 {
            if tls_word_at(buf, i, hdrend, name) == 1 {
                let mut p = i
                for peek8(name + (p - i)) != 0 { p = p + 1 }
                // The whole name, and nothing but: what follows must be the colon.
                if peek8(buf + p) == 58 {
                    p = p + 1
                    for p < hdrend {
                        if peek8(buf + p) != 32 { break }
                        p = p + 1
                    }
                    let mut e = p
                    for e < hdrend {
                        if peek8(buf + e) == 13 { break }
                        e = e + 1
                    }
                    poke32(lenptr, e - p)
                    return buf + p
                }
            }
        }
        i = i + 1
    }
    0
}

// The Content-Length the response declares, or -1 if it declares none (or something that is
// not a number). This is what the sender PROMISED, not what arrived; http_body reports the
// second.
fn http_content_length(buf: i64, n: i64) -> i64 {
    let lp[1]
    let __cl: string = "content-length"
    let v = http_header(buf, n, __cl.utf8, lp)
    if v == 0 { return 0 - 1 }
    let len = peek32(lp)
    if len == 0 { return 0 - 1 }
    let mut out = 0
    for k in 0..len {
        let c = peek8(v + k)
        if c < 48 { return 0 - 1 }
        if c > 57 { return 0 - 1 }
        out = out * 10 + (c - 48)
    }
    out
}

// A POINTER to the body, with its length written as a u32 at `lenptr`; 0 if the header block
// never ended. A chunked body is DECODED IN PLACE, so the pointer still marks where the body
// started and the length is the decoded one.
//
// A pointer and not an offset, and 0 and not -1, to match http_header: two readers of the same
// response returning different KINDS of thing is how a caller ends up passing one where the
// other was expected, which the compiler cannot catch when both are i64.
//
// The length is always what arrived: a body cut short reports the bytes actually present, not
// the Content-Length that promised more. The caller can compare the two -- http_content_length
// is right there -- and decide whether a short body is an error; what it must not do is read
// past what was received because a header said so.
fn http_body(buf: i64, n: i64, lenptr: i64) -> i64 {
    let hdrend = http_headers_end(buf, n)
    if hdrend < 0 { return 0 }
    let have = n - hdrend
    if tls_is_chunked(buf, hdrend) == 1 {
        poke32(lenptr, tls_dechunk(buf, hdrend, n))
        return buf + hdrend
    }
    let declared = http_content_length(buf, n)
    if declared >= 0 {
        if declared < have {
            poke32(lenptr, declared)
            return buf + hdrend
        }
    }
    poke32(lenptr, have)
    buf + hdrend
}

// A whole request-response over a single TLS connection: connect to `host`:`port` with server
// name `sni`, send the `reqlen` bytes at `req` verbatim, read the response into `out` (`cap`
// bytes) and return the length of its BODY, leaving the body at the start of `out`. Negative
// on any failure -- connection, handshake, an untrusted chain, or a response that does not fit.
//
// It takes a request the caller has already built, rather than a method and a path, because a
// request with headers is what anybody talking to a real API needs: tls_get can only send a
// bare GET, so every Bearer or Basic authentication ended up back at tls_req_start /
// tls_req_header / tls_req_end plus a hand-written session loop. That builder is right there
// and produces exactly what this takes.
//
// A response larger than `cap` is an ERROR and not a prefix. tls_get keeps what fits and
// returns it, which means a caller cannot tell a complete document from a cut one -- and a
// truncated JSON body does not fail to parse, it parses into something smaller.
fn tls_send(host: i64, port: i64, sni: i64, snilen: i64, req: i64, reqlen: i64,
            out: i64, cap: i64, roots: i64, nroots: i64, now14: i64) -> i64 {
    let __alpn: string = "http/1.1"
    let sess = tls_connect(host, port, sni, snilen, __alpn.utf8, 8, roots, nroots, now14)
    if sess == 0 { return 0 - 1 }
    if tls_write(sess, req, reqlen) < 0 {
        tls_close(sess)
        return 0 - 1
    }
    let mut olen = 0
    let mut reads = 0
    for reads < 64 {
        let n = tls_read(sess, out + olen, cap - olen)
        if n <= 0 { break }
        olen = olen + n
        if olen >= cap {
            tls_close(sess)
            return 0 - 2          // it did not fit: say so instead of handing back a prefix
        }
        reads = reads + 1
    }
    tls_close(sess)
    if olen == 0 { return 0 - 1 }
    let lp[1]
    let body = http_body(out, olen, lp)
    if body == 0 { return 0 - 1 }
    let blen = peek32(lp)
    // The body is moved to the front so the caller gets what it asked for at `out`, without
    // having to be told where inside its own buffer the useful part begins.
    let off = body - out
    for i in 0..blen {
        poke8(out + i, peek8(out + off + i))
    }
    blen
}
