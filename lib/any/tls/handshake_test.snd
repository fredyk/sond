//
// Test of tls/handshake.snd: the ClientHello byte layout (RFC 8446 §4.1.2), pinned at the
// structural checkpoints against a hand-traced offset map.

include "any/tls/handshake.snd"
include "x86_64/linux/testing.snd"

let mut h_random[32]
let mut h_pub[32]
let mut h_out[512]

// With SNI "a.com" (5 bytes) the body is 124 bytes and the whole message is 128.
test "tls handshake: ClientHello layout with the expected extensions" {
    let mut i = 0
    for i < 32 { poke8(h_random + i, 0x11); i = i + 1 }
    i = 0
    for i < 32 { poke8(h_pub + i, 0x22); i = i + 1 }

    let n = tls_build_client_hello(h_random, h_pub, "a.com", 5, h_out)
    assert_eq(n, 143)
    assert_eq(peek8(h_out + 0), 1)                   // HandshakeType.client_hello
    // uint24 body length = 124
    assert_eq((peek8(h_out + 1) << 16) | (peek8(h_out + 2) << 8) | peek8(h_out + 3), 139)
    assert_eq(peek8(h_out + 4), 0x03)                // legacy_version 0x0303
    assert_eq(peek8(h_out + 5), 0x03)
    assert_eq(peek8(h_out + 6), 0x11)                // random copied
    assert_eq(peek8(h_out + 37), 0x11)
    assert_eq(peek8(h_out + 38), 0)                  // empty legacy_session_id
    assert_eq(peek8(h_out + 39), 0)                  // cipher_suites length = 2
    assert_eq(peek8(h_out + 40), 2)
    assert_eq(peek8(h_out + 41), 0x13)               // TLS_CHACHA20_POLY1305_SHA256
    assert_eq(peek8(h_out + 42), 0x03)
    assert_eq(peek8(h_out + 43), 1)                  // 1 compression method
    assert_eq(peek8(h_out + 44), 0)                  // null compression
    // extensions length (uint16) = 81
    assert_eq((peek8(h_out + 45) << 8) | peek8(h_out + 46), 96)
    // first extension is supported_versions (43)
    assert_eq((peek8(h_out + 47) << 8) | peek8(h_out + 48), 43)
    // key_share x25519 public key copied (body offset 78 -> out+82)
    assert_eq(peek8(h_out + 82), 0x22)
    assert_eq(peek8(h_out + 113), 0x22)              // last key byte (82+31)
    // SNI: host length 5 then "a.com" (host at out+123)
    assert_eq((peek8(h_out + 121) << 8) | peek8(h_out + 122), 5)
    assert_eq(peek8(h_out + 123), 97)                // 'a'
    assert_eq(peek8(h_out + 127), 109)               // 'm' (last byte of "a.com")
}
