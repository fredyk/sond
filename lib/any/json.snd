//
// lib/any/json.snd: a small JSON parser (RFC 8259 subset).
//
// Parses one JSON value into a node tree and lets a caller walk it. A node is a
// heap-allocated record [tag, a, b]: for BOOL a is 0/1; for INT a is the value;
// for STR a is a pointer to a NUL-terminated decoded copy and b its length; for
// ARR a is a vec of child nodes; for OBJ a is a vec of entries, each entry a
// record [key_ptr, key_len, value_node] (key NUL-terminated).
//
// Numbers are parsed as i64 (a leading fraction/exponent is not decoded yet, so a
// float truncates; adequate for config and identifiers, extend when needed).
// String escapes \" \\ \/ \b \f \n \r \t are decoded; \uXXXX is not yet.
//
// API: json_parse(data,len) -> root node, or -1 on error. json_type(node).
// json_get(obj,key_cstr) -> value node or -1. json_int/json_bool/json_str/
// json_str_len. json_arr_len/json_arr_get.

include "any/strings.snd"
include "x86_64/linux/heap.snd"
include "x86_64/linux/vec.snd"
include "x86_64/linux/bytes.snd"

let JSON_NULL = 0
let JSON_BOOL = 1
let JSON_INT  = 2
let JSON_STR  = 3
let JSON_ARR  = 4
let JSON_OBJ  = 5

let JSON_EOF = 256           // sentinel returned past the end (no real byte is 256)

// Parser cursor (module-level, set per json_parse call).
let mut __j_data = 0
let mut __j_pos  = 0
let mut __j_len  = 0
let mut __j_err  = 0         // set to 1 on a parse error

fn __node(tag: i64, a: i64, b: i64) -> i64 {
    let n = heap_alloc(32)
    n[0] = tag
    n[1] = a
    n[2] = b
    n
}

fn __peek() -> i64 {
    if __j_pos >= __j_len { JSON_EOF } else { peek8(__j_data + __j_pos) }
}

fn __ws() {
    for {
        let c = __peek()
        if c == 32 || c == 9 || c == 10 || c == 13 { __j_pos = __j_pos + 1 } else { break }
    }
}

// Reads a JSON string (cursor on the opening quote), returns a NUL-terminated
// decoded copy in the heap. On the way it decodes the simple backslash escapes.
fn __string() -> i64 {
    __j_pos = __j_pos + 1                 // skip opening quote
    let out = heap_alloc(__j_len - __j_pos + 2)   // upper bound: no escape grows the string
    let mut w = 0
    for {
        let c = __peek()
        if c == JSON_EOF { __j_err = 1; break }
        if c == 34 { __j_pos = __j_pos + 1; break }     // closing quote
        if c == 92 {                                    // backslash
            __j_pos = __j_pos + 1
            let e = __peek()
            let d = if e == 110 { 10 } else { if e == 116 { 9 } else { if e == 114 { 13 } else { if e == 98 { 8 } else { if e == 102 { 12 } else { e } } } } }
            poke8(out + w, d)
            w = w + 1
            __j_pos = __j_pos + 1
        } else {
            poke8(out + w, c)
            w = w + 1
            __j_pos = __j_pos + 1
        }
    }
    poke8(out + w, 0)                     // NUL-terminate
    __node(JSON_STR, out, w)
}

// Reads a JSON number as an integer (optional leading minus). A fraction or
// exponent is consumed but not decoded (the integer part is kept).
fn __number() -> i64 {
    let mut neg = 0
    if __peek() == 45 { neg = 1; __j_pos = __j_pos + 1 }   // '-'
    let mut v = 0
    for {
        let c = __peek()
        if c >= 48 && c <= 57 { v = v * 10 + (c - 48); __j_pos = __j_pos + 1 } else { break }
    }
    // consume a fractional/exponent tail without decoding it
    for {
        let c = __peek()
        if c == 46 || c == 101 || c == 69 || c == 43 || c == 45 || (c >= 48 && c <= 57) { __j_pos = __j_pos + 1 } else { break }
    }
    if neg == 1 { v = 0 - v }
    __node(JSON_INT, v, 0)
}

// Consumes `word` (a cstr like "true") at the cursor; returns 1 if it matched.
fn __lit(word: i64) -> i64 {
    let n = strlen(word)
    let mut i = 0
    for i < n {
        if __peek() != peek8(word + i) { return 0 }
        __j_pos = __j_pos + 1
        i = i + 1
    }
    1
}

fn __value() -> i64 {
    __ws()
    let c = __peek()
    if c == 123 { return __object() }     // {
    if c == 91 { return __array() }       // [
    if c == 34 { return __string() }      // "
    let __lit0: string = "true"
    if c == 116 { if __lit(__lit0.utf8) == 1 { return __node(JSON_BOOL, 1, 0) } __j_err = 1; return __node(JSON_NULL, 0, 0) }
    let __lit1: string = "false"
    if c == 102 { if __lit(__lit1.utf8) == 1 { return __node(JSON_BOOL, 0, 0) } __j_err = 1; return __node(JSON_NULL, 0, 0) }
    let __lit2: string = "null"
    if c == 110 { if __lit(__lit2.utf8) == 1 { return __node(JSON_NULL, 0, 0) } __j_err = 1; return __node(JSON_NULL, 0, 0) }
    if c == 45 || (c >= 48 && c <= 57) { return __number() }
    __j_err = 1
    __node(JSON_NULL, 0, 0)
}

fn __array() -> i64 {
    __j_pos = __j_pos + 1                 // skip [
    let items = vec_new()
    __ws()
    if __peek() == 93 { __j_pos = __j_pos + 1; return __node(JSON_ARR, items, 0) }  // empty ]
    for {
        vec_push(items, __value())
        __ws()
        let c = __peek()
        if c == 44 { __j_pos = __j_pos + 1 }              // comma -> another item
        else { if c == 93 { __j_pos = __j_pos + 1; break } else { __j_err = 1; break } }
    }
    __node(JSON_ARR, items, 0)
}

fn __object() -> i64 {
    __j_pos = __j_pos + 1                 // skip {
    let entries = vec_new()
    __ws()
    if __peek() == 125 { __j_pos = __j_pos + 1; return __node(JSON_OBJ, entries, 0) }  // empty }
    for {
        __ws()
        if __peek() != 34 { __j_err = 1; break }
        let key = __string()              // STR node
        __ws()
        if __peek() != 58 { __j_err = 1; break }          // ':'
        __j_pos = __j_pos + 1
        let val = __value()
        let entry = heap_alloc(24)
        entry[0] = key[1]                 // key_ptr (the decoded cstr)
        entry[1] = key[2]                 // key_len
        entry[2] = val                    // value node
        vec_push(entries, entry)
        __ws()
        let c = __peek()
        if c == 44 { __j_pos = __j_pos + 1 }
        else { if c == 125 { __j_pos = __j_pos + 1; break } else { __j_err = 1; break } }
    }
    __node(JSON_OBJ, entries, 0)
}

// Parses one JSON value from `data`/`len`. Returns the root node, or -1 on error.
pub fn json_parse(data: i64, len: i64) -> i64 {
    __j_data = data
    __j_pos = 0
    __j_len = len
    __j_err = 0
    let root = __value()
    if __j_err == 1 { 0 - 1 } else { root }
}

pub fn json_type(node: i64) -> i64 { node[0] }
pub fn json_int(node: i64) -> i64 { node[1] }
pub fn json_bool(node: i64) -> i64 { node[1] }
pub fn json_str(node: i64) -> i64 { node[1] }        // NUL-terminated cstr
pub fn json_str_len(node: i64) -> i64 { node[2] }

pub fn json_arr_len(node: i64) -> i64 { vec_len(node[1]) }
pub fn json_arr_get(node: i64, i: i64) -> i64 { vec_get(node[1], i) }

// Looks up `key` (a cstr) in an OBJ node; returns the value node, or -1.
pub fn json_get(obj: i64, key: i64) -> i64 {
    let entries = obj[1]
    let n = vec_len(entries)
    let mut i = 0
    for i < n {
        let entry = vec_get(entries, i)
        if streq(entry[0], key) == 1 { return entry[2] }
        i = i + 1
    }
    0 - 1
}


// ── Builders (construct a value tree, then json_encode it) ──────────
pub fn json_new_null() -> i64 { __node(JSON_NULL, 0, 0) }
pub fn json_new_bool(b: i64) -> i64 { __node(JSON_BOOL, b, 0) }
pub fn json_new_int(n: i64) -> i64 { __node(JSON_INT, n, 0) }
pub fn json_new_str(s: i64) -> i64 { __node(JSON_STR, s, strlen(s)) }
pub fn json_new_obj() -> i64 { __node(JSON_OBJ, vec_new(), 0) }
pub fn json_new_arr() -> i64 { __node(JSON_ARR, vec_new(), 0) }

// Adds key -> value to an object node (key is a cstr the caller keeps alive).
pub fn json_obj_put(obj: i64, key: i64, val: i64) {
    let e = heap_alloc(24)
    e[0] = key
    e[1] = strlen(key)
    e[2] = val
    vec_push(obj[1], e)
}
pub fn json_arr_push(arr: i64, val: i64) { vec_push(arr[1], val) }

// Appends `s` to `b` as a JSON string literal (quoted, escapes applied).
fn __enc_str(s: i64, b: i64) {
    bytes_push(b, 34)                     // opening quote
    let n = strlen(s)
    let mut i = 0
    for i < n {
        let c = peek8(s + i)
        let esc = if c == 34 { 34 } else { if c == 92 { 92 } else { if c == 10 { 110 } else { if c == 13 { 114 } else { if c == 9 { 116 } else { if c == 8 { 98 } else { if c == 12 { 102 } else { 0 } } } } } } }
        if esc == 0 { bytes_push(b, c) } else { bytes_push(b, 92); bytes_push(b, esc) }
        i = i + 1
    }
    bytes_push(b, 34)                     // closing quote
}

fn __encode(node: i64, b: i64) {
    let t = node[0]
    let __lit3: string = "null"
    if t == JSON_NULL { bytes_append_cstr(b, __lit3.utf8); return }
    if t == JSON_BOOL {
        let __lit4: string = "true"
        let __lit5: string = "false"
        if node[1] == 1 { bytes_append_cstr(b, __lit4.utf8) } else { bytes_append_cstr(b, __lit5.utf8) }
        return
    }
    if t == JSON_INT { bytes_append_int(b, node[1]); return }
    if t == JSON_STR { __enc_str(node[1], b); return }
    if t == JSON_ARR {
        bytes_push(b, 91)                 // [
        let items = node[1]
        let n = vec_len(items)
        let mut i = 0
        for i < n {
            if i > 0 { bytes_push(b, 44) }
            __encode(vec_get(items, i), b)
            i = i + 1
        }
        bytes_push(b, 93)                 // ]
        return
    }
    // object
    bytes_push(b, 123)                    // {
    let entries = node[1]
    let m = vec_len(entries)
    let mut j = 0
    for j < m {
        if j > 0 { bytes_push(b, 44) }
        let e = vec_get(entries, j)
        __enc_str(e[0], b)
        bytes_push(b, 58)                 // :
        __encode(e[2], b)
        j = j + 1
    }
    bytes_push(b, 125)                    // }
}

// Encodes a value tree to a fresh byte buffer (data at peek64(buf), len bytes_len(buf)).
pub fn json_encode(node: i64) -> i64 {
    let b = bytes_new()
    __encode(node, b)
    b
}
