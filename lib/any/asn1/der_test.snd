//
// Test of asn1/der.snd against hand-built DER encodings (X.690). The byte layouts are
// deterministic, so the vectors are constructed here rather than borrowed.

include "any/asn1/der.snd"
include "x86_64/linux/testing.snd"

let mut d_buf[512]
let mut d_out[3]
let mut d_oid[16]

// SEQUENCE { INTEGER 0x000102 }  ->  30 05 02 03 00 01 02
test "der: a TLV header, short-form length, and entering a SEQUENCE" {
    poke8(d_buf + 0, 0x30); poke8(d_buf + 1, 0x05)
    poke8(d_buf + 2, 0x02); poke8(d_buf + 3, 0x03)
    poke8(d_buf + 4, 0x00); poke8(d_buf + 5, 0x01); poke8(d_buf + 6, 0x02)

    assert_eq(der_tag(d_buf, 0), DER_SEQUENCE)
    let next = der_tlv(d_buf, 0, d_out)
    assert_eq(d_out[0], 0x30)                        // tag
    assert_eq(d_out[1], 2)                           // content starts at index 2
    assert_eq(d_out[2], 5)                           // content length
    assert_eq(next, 7)                               // whole thing is 7 bytes

    // enter the SEQUENCE, read its INTEGER child
    let child = der_enter(d_buf, 0)
    assert_eq(child, 2)
    let after = der_tlv(d_buf, child, d_out)
    assert_eq(d_out[0], DER_INTEGER)
    assert_eq(d_out[1], 4)                           // integer content at index 4
    assert_eq(d_out[2], 3)                           // 3 content bytes
    assert_eq(peek8(d_buf + d_out[1] + 2), 0x02)     // last content byte
    assert_eq(after, 7)                              // child ends the sequence
}

// Long-form length: OCTET STRING of 200 bytes -> 04 81 C8 <200 bytes>
test "der: long-form length decodes a multi-byte length" {
    poke8(d_buf + 0, 0x04); poke8(d_buf + 1, 0x81); poke8(d_buf + 2, 0xc8)
    let ln[1]
    let cstart = der_read_len(d_buf, 1, ln)
    assert_eq(ln[0], 200)
    assert_eq(cstart, 3)                             // content begins after tag+3 length bytes
    let next = der_tlv(d_buf, 0, d_out)
    assert_eq(d_out[2], 200)
    assert_eq(next, 203)                             // 3 header + 200 content
}

// A two-byte long form (length 0x0140 = 320) -> tag 04 82 01 40
test "der: two-byte long-form length" {
    poke8(d_buf + 0, 0x04); poke8(d_buf + 1, 0x82); poke8(d_buf + 2, 0x01); poke8(d_buf + 3, 0x40)
    let ln[1]
    let cstart = der_read_len(d_buf, 1, ln)
    assert_eq(ln[0], 320)
    assert_eq(cstart, 4)
}

// OID ecPublicKey (1.2.840.10045.2.1) -> 06 07 2A 86 48 CE 3D 02 01
test "der: OID content comparison" {
    poke8(d_buf + 0, 0x06); poke8(d_buf + 1, 0x07)
    poke8(d_buf + 2, 0x2a); poke8(d_buf + 3, 0x86); poke8(d_buf + 4, 0x48)
    poke8(d_buf + 5, 0xce); poke8(d_buf + 6, 0x3d); poke8(d_buf + 7, 0x02); poke8(d_buf + 8, 0x01)
    // the expected OID contents (7 bytes, without the tag/length)
    poke8(d_oid + 0, 0x2a); poke8(d_oid + 1, 0x86); poke8(d_oid + 2, 0x48)
    poke8(d_oid + 3, 0xce); poke8(d_oid + 4, 0x3d); poke8(d_oid + 5, 0x02); poke8(d_oid + 6, 0x01)
    assert_eq(der_oid_eq(d_buf, 0, d_oid, 7), 1)
    // a different length or a flipped byte does not match
    assert_eq(der_oid_eq(d_buf, 0, d_oid, 6), 0)
    poke8(d_oid + 6, 0x02)
    assert_eq(der_oid_eq(d_buf, 0, d_oid, 7), 0)
    // a non-OID tag never matches
    poke8(d_buf + 0, DER_INTEGER)
    assert_eq(der_oid_eq(d_buf, 0, d_oid, 7), 0)
}
