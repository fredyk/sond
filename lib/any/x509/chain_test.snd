//
// Test of x509/chain.snd against the REAL cloudflare.com leaf and its issuer WE1.

include "any/x509/chain.snd"
include "x86_64/linux/testing.snd"

let LEAF_HEX = ""
let WE1_HEX = ""
// GTS Root R4 (Google Trust Services, P-384), the self-signed root that signs WE1. Real cert
// from the system trust store, so the chain leaf <- WE1 <- GTS Root R4 is a genuine one.
let GTSR4_HEX = ""
let mut c_leaf[1100]
let mut c_we1[1100]
let mut c_gtsr4[1100]
let mut c_chain[4]
let mut c_roots[4]
let mut c_host[64]

fn chx(c: i64) -> i64 {
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 97 && c <= 102 { return c - 87 }
    c - 55
}
fn cload(hex: i64, dst: i64) {
    let mut i = 0
    for peek8(hex + i * 2) != 0 {
        poke8(dst + i, chx(peek8(hex + i * 2)) * 16 + chx(peek8(hex + i * 2 + 1)))
        i = i + 1
    }
}
fn cseth(s: i64) -> i64 {
    let mut i = 0
    for peek8(s + i) != 0 { poke8(c_host + i, peek8(s + i)); i = i + 1 }
    i
}

test "x509 chain: accept the real cloudflare leaf under its issuer WE1" {
    cload(LEAF_HEX, c_leaf)
    cload(WE1_HEX, c_we1)
    // signed by WE1, names cloudflare.com, valid on 2026-07-23
    assert_eq(x509_accept_leaf(c_leaf, 0, c_we1, 0, c_host, cseth("cloudflare.com"), "20260723000000"), 1)
    // a host it does not name is rejected
    assert_eq(x509_accept_leaf(c_leaf, 0, c_we1, 0, c_host, cseth("evil.example"), "20260723000000"), 0)
    // outside the validity window is rejected
    assert_eq(x509_accept_leaf(c_leaf, 0, c_we1, 0, c_host, cseth("cloudflare.com"), "20270101000000"), 0)
    // a wrong issuer (the leaf as its own issuer) fails the signature
    assert_eq(x509_accept_leaf(c_leaf, 0, c_leaf, 0, c_host, cseth("cloudflare.com"), "20260723000000"), 0)
}

test "x509 chain: verify the real cloudflare chain up to the GTS Root R4 trust anchor" {
    cload(LEAF_HEX, c_leaf)
    cload(WE1_HEX, c_we1)
    cload(GTSR4_HEX, c_gtsr4)
    c_chain[0] = c_leaf
    c_chain[1] = c_we1
    c_roots[0] = c_gtsr4
    // leaf <- WE1 (ECDSA P-256) <- GTS Root R4 (ECDSA P-384), names cloudflare.com, valid
    // 2026-09-01 (inside every certificate's window).
    assert_eq(x509_verify_chain(c_chain, 2, c_roots, 1, c_host, cseth("cloudflare.com"), "20260901000000"), 1)
    // a host the leaf does not name is rejected
    assert_eq(x509_verify_chain(c_chain, 2, c_roots, 1, c_host, cseth("evil.example"), "20260901000000"), 0)
    // outside the leaf's validity window is rejected
    assert_eq(x509_verify_chain(c_chain, 2, c_roots, 1, c_host, cseth("cloudflare.com"), "20261101000000"), 0)
    // an empty trust store: the top of the chain is anchored to nothing trusted
    assert_eq(x509_verify_chain(c_chain, 2, c_roots, 0, c_host, cseth("cloudflare.com"), "20260901000000"), 0)
    // a trust store that does not include the real root (WE1 is not self-signed) is rejected
    c_roots[0] = c_we1
    assert_eq(x509_verify_chain(c_chain, 2, c_roots, 1, c_host, cseth("cloudflare.com"), "20260901000000"), 0)
    // an empty chain is rejected
    assert_eq(x509_verify_chain(c_chain, 0, c_roots, 1, c_host, cseth("cloudflare.com"), "20260901000000"), 0)
}
