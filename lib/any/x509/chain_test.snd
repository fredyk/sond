//
// Test of x509/chain.snd against the REAL cloudflare.com leaf and its issuer WE1.

include "any/x509/chain.snd"
include "x86_64/linux/testing.snd"

let LEAF_HEX = ""
let WE1_HEX = ""
// GTS Root R4 (Google Trust Services, P-384), the self-signed root that signs WE1. Real cert
// from the system trust store, so the chain leaf <- WE1 <- GTS Root R4 is a genuine one.
let GTSR4_HEX = ""
// A self-signed P-256 certificate for nonca.test with basicConstraints CA:FALSE: an
// end-entity, NOT a CA. Used to check that a non-CA is refused as a trust anchor / issuer.
let NONCA_HEX = ""
// A self-signed CA:TRUE cert whose extendedKeyUsage is clientAuth only (no serverAuth): it
// must be refused as a TLS server leaf even though everything else about it checks out.
let CLIENTONLY_HEX = ""
// nocertsign.test: self-signed CA:TRUE with keyUsage digitalSignature only (NO keyCertSign),
// SAN and EKU serverAuth, so it fails only the keyCertSign requirement as a trust anchor.
let NOCERTSIGN_HEX = ""
// GTS Root R4 CROSS-SIGNED by GlobalSign Root CA. Same subject and same key as the self-signed
// GTS Root R4 above, but issued by an older root, and this is the certificate real servers send
// as the LAST link so that clients whose store predates GTS still build a path. Captured from a
// live Cloudflare-fronted host. GlobalSign Root CA is deliberately NOT in the store here: the
// point is that a client must anchor at WE1 and never look at this certificate at all.
let CROSSR4_HEX = ""
let mut c_crossr4[1400]
let mut c_leaf[1100]
let mut c_we1[1100]
let mut c_gtsr4[1100]
let mut c_nonca[1100]
let mut c_conly[1100]
let mut c_ncs[1100]
let mut c_chain[4]
let mut c_roots[4]
let mut c_host[64]

fn chx(c: i64) -> i64 {
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 97 && c <= 102 { return c - 87 }
    c - 55
}
fn cload(hex: i64, dst: i64) {
    let mut i = 0
    for peek8(hex + i * 2) != 0 {
        poke8(dst + i, chx(peek8(hex + i * 2)) * 16 + chx(peek8(hex + i * 2 + 1)))
        i = i + 1
    }
}
fn cseth(s: i64) -> i64 {
    let mut i = 0
    for peek8(s + i) != 0 { poke8(c_host + i, peek8(s + i)); i = i + 1 }
    i
}

test "x509 chain: accept the real cloudflare leaf under its issuer WE1" {
    cload(LEAF_HEX, c_leaf)
    cload(WE1_HEX, c_we1)
    // signed by WE1, names cloudflare.com, valid on 2026-07-23
    let __s0_61: string = "cloudflare.com"
    let __s1_61: string = "20260723000000"
    assert_eq(x509_accept_leaf(c_leaf, 0, c_we1, 0, c_host, cseth(__s0_61.utf8), __s1_61.utf8), 1)
    // a host it does not name is rejected
    let __s2_65: string = "evil.example"
    let __s3_65: string = "20260723000000"
    assert_eq(x509_accept_leaf(c_leaf, 0, c_we1, 0, c_host, cseth(__s2_65.utf8), __s3_65.utf8), 0)
    // outside the validity window is rejected
    let __s4_69: string = "cloudflare.com"
    let __s5_69: string = "20270101000000"
    assert_eq(x509_accept_leaf(c_leaf, 0, c_we1, 0, c_host, cseth(__s4_69.utf8), __s5_69.utf8), 0)
    // a wrong issuer (the leaf as its own issuer) fails the signature
    let __s6_73: string = "cloudflare.com"
    let __s7_73: string = "20260723000000"
    assert_eq(x509_accept_leaf(c_leaf, 0, c_leaf, 0, c_host, cseth(__s6_73.utf8), __s7_73.utf8), 0)
}

test "x509 chain: verify the real cloudflare chain up to the GTS Root R4 trust anchor" {
    cload(LEAF_HEX, c_leaf)
    cload(WE1_HEX, c_we1)
    cload(GTSR4_HEX, c_gtsr4)
    c_chain[0] = c_leaf
    c_chain[1] = c_we1
    c_roots[0] = c_gtsr4
    // leaf <- WE1 (ECDSA P-256) <- GTS Root R4 (ECDSA P-384), names cloudflare.com, valid
    // 2026-09-01 (inside every certificate's window).
    let __s0_87: string = "cloudflare.com"
    let __s1_87: string = "20260901000000"
    assert_eq(x509_verify_chain(c_chain, 2, c_roots, 1, c_host, cseth(__s0_87.utf8), __s1_87.utf8), 1)
    // a host the leaf does not name is rejected
    let __s2_91: string = "evil.example"
    let __s3_91: string = "20260901000000"
    assert_eq(x509_verify_chain(c_chain, 2, c_roots, 1, c_host, cseth(__s2_91.utf8), __s3_91.utf8), 0)
    // outside the leaf's validity window is rejected
    let __s4_95: string = "cloudflare.com"
    let __s5_95: string = "20261101000000"
    assert_eq(x509_verify_chain(c_chain, 2, c_roots, 1, c_host, cseth(__s4_95.utf8), __s5_95.utf8), 0)
    // an empty trust store: the top of the chain is anchored to nothing trusted
    let __s6_99: string = "cloudflare.com"
    let __s7_99: string = "20260901000000"
    assert_eq(x509_verify_chain(c_chain, 2, c_roots, 0, c_host, cseth(__s6_99.utf8), __s7_99.utf8), 0)
    // Trusting the INTERMEDIATE directly is legitimate and must work: a trust anchor is a name
    // and a key (RFC 5280 6.1.1), not necessarily a self-signed certificate, and putting WE1 in
    // the store is an explicit statement that WE1 is trusted. This assertion used to expect 0,
    // which was not a security property but an accident of requiring the TOP of the chain to be
    // signed by a root: WE1 does not sign itself, so it could never anchor its own leaf.
    c_roots[0] = c_we1
    let __s8_108: string = "cloudflare.com"
    let __s9_108: string = "20260901000000"
    assert_eq(x509_verify_chain(c_chain, 2, c_roots, 1, c_host, cseth(__s8_108.utf8), __s9_108.utf8), 1)
    // But an unrelated CA in the store anchors nothing, which is the property that assertion was
    // reaching for: GTS Root R4 signs WE1, it does not sign the leaf, so a chain of just the leaf
    // has no path to it.
    c_roots[0] = c_gtsr4
    let __s10_115: string = "cloudflare.com"
    let __s11_115: string = "20260901000000"
    assert_eq(x509_verify_chain(c_chain, 1, c_roots, 1, c_host, cseth(__s10_115.utf8), __s11_115.utf8), 0)
    // an empty chain is rejected
    let __s12_119: string = "cloudflare.com"
    let __s13_119: string = "20260901000000"
    assert_eq(x509_verify_chain(c_chain, 0, c_roots, 1, c_host, cseth(__s12_119.utf8), __s13_119.utf8), 0)
}

test "x509 chain: basicConstraints is enforced (issuers and anchors must be CAs)" {
    cload(LEAF_HEX, c_leaf)
    cload(WE1_HEX, c_we1)
    cload(GTSR4_HEX, c_gtsr4)
    cload(NONCA_HEX, c_nonca)
    // the intermediate and root are CAs; the leaf is an end-entity
    assert_eq(x509_is_ca(c_we1, 0), 1)
    assert_eq(x509_is_ca(c_gtsr4, 0), 1)
    assert_eq(x509_is_ca(c_leaf, 0), 0)
    assert_eq(x509_is_ca(c_nonca, 0), 0)
    // a self-signed non-CA certificate names its host and its signature verifies, but it must
    // NOT be accepted as a trust anchor: a non-CA cannot vouch for a chain.
    c_chain[0] = c_nonca
    c_roots[0] = c_nonca
    let __s14_138: string = "nonca.test"
    let __s15_138: string = "20270101000000"
    assert_eq(x509_verify_chain(c_chain, 1, c_roots, 1, c_host, cseth(__s14_138.utf8), __s15_138.utf8), 0)
}

test "x509 chain: a leaf whose EKU lacks serverAuth is rejected" {
    cload(CLIENTONLY_HEX, c_conly)
    // clientonly.test is self-signed, CA:TRUE, names its host and is valid, but its EKU is
    // clientAuth only: it must not be accepted to authenticate a TLS server.
    c_chain[0] = c_conly
    c_roots[0] = c_conly
    let __s16_149: string = "clientonly.test"
    let __s17_149: string = "20270101000000"
    assert_eq(x509_verify_chain(c_chain, 1, c_roots, 1, c_host, cseth(__s16_149.utf8), __s17_149.utf8), 0)
}

test "x509 chain: a CA anchor without keyCertSign is rejected" {
    cload(NOCERTSIGN_HEX, c_ncs)
    // nocertsign.test is self-signed, CA:TRUE, names its host, valid, EKU serverAuth, and its
    // signature verifies, but its keyUsage lacks keyCertSign: it must not anchor a chain.
    c_chain[0] = c_ncs
    c_roots[0] = c_ncs
    let __s18_160: string = "nocertsign.test"
    let __s19_160: string = "20270101000000"
    assert_eq(x509_verify_chain(c_chain, 1, c_roots, 1, c_host, cseth(__s18_160.utf8), __s19_160.utf8), 0)
}

// A server may append certificates ABOVE the trust anchor. Every public CA does it: the last
// link is the anchor cross-signed by an older root, so that a client whose store predates the
// new root can still build a path. A client that insists the TOP of the presented chain be
// signed by a trusted root rejects those servers outright, even though the anchor is sitting
// right there in the middle of the chain and every link below it verifies.
//
// This is not a corner case. It is what three real servers did (Cloudflare-fronted hosts and
// an API sandbox) while every one of them passed the handshake and the identity check, and it
// is the same shape as the AddTrust expiry that broke a large part of the web in 2020: the
// certificate past the anchor was expired, and only the clients that kept reading it failed.
test "x509 chain: a certificate above the trust anchor is ignored" {
    cload(LEAF_HEX, c_leaf)
    cload(WE1_HEX, c_we1)
    cload(GTSR4_HEX, c_gtsr4)
    cload(CROSSR4_HEX, c_crossr4)
    c_chain[0] = c_leaf
    c_chain[1] = c_we1
    c_chain[2] = c_crossr4           // GTS Root R4 as issued by GlobalSign, which we do NOT trust
    c_roots[0] = c_gtsr4             // we trust GTS Root R4 itself, and it signs WE1
    let __s20_184: string = "cloudflare.com"
    let __s21_184: string = "20260901000000"
    assert_eq(x509_verify_chain(c_chain, 3, c_roots, 1, c_host, cseth(__s20_184.utf8), __s21_184.utf8), 1)
    // and the anchor still has to be reached through verified links: break the host and it fails
    let __s22_188: string = "evil.example"
    let __s23_188: string = "20260901000000"
    assert_eq(x509_verify_chain(c_chain, 3, c_roots, 1, c_host, cseth(__s22_188.utf8), __s23_188.utf8), 0)
    // with nothing trusted, three certificates are no better than two
    let __s24_192: string = "cloudflare.com"
    let __s25_192: string = "20260901000000"
    assert_eq(x509_verify_chain(c_chain, 3, c_roots, 0, c_host, cseth(__s24_192.utf8), __s25_192.utf8), 0)
}

// The anchor may also be the LAST certificate presented, which is what a server sends when it
// includes its own self-signed root. Reaching it must still work, and must still be a real
// verification rather than "it is the last one, trust it".
test "x509 chain: the trust anchor may be the last certificate presented" {
    cload(LEAF_HEX, c_leaf)
    cload(WE1_HEX, c_we1)
    cload(GTSR4_HEX, c_gtsr4)
    c_chain[0] = c_leaf
    c_chain[1] = c_we1
    c_chain[2] = c_gtsr4
    c_roots[0] = c_gtsr4
    let __s26_208: string = "cloudflare.com"
    let __s27_208: string = "20260901000000"
    assert_eq(x509_verify_chain(c_chain, 3, c_roots, 1, c_host, cseth(__s26_208.utf8), __s27_208.utf8), 1)
}
