// Copyright 2026 Jhon Magdalena Vila and the Sond contributors
//
// Test of the DER + X.509 walk against a REAL certificate: the cloudflare.com leaf,
// captured over TLS 1.3 and embedded here as hex so the test is self-contained and
// reproducible. This validates the parser on true wire data, not only synthetic DER.

include "any/x509/tbs.snd"
include "x86_64/linux/testing.snd"

let CERT_HEX = ""
let mut cert[1200]
let mut ecoid[7]

fn hx(c: i64) -> i64 {
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 97 && c <= 102 { return c - 87 }
    c - 55
}
fn load_cert() -> i64 {
    let mut i = 0
    for peek8(CERT_HEX + i * 2) != 0 {
        poke8(cert + i, hx(peek8(CERT_HEX + i * 2)) * 16 + hx(peek8(CERT_HEX + i * 2 + 1)))
        i = i + 1
    }
    i
}

test "x509: the real cloudflare.com leaf parses to an ecPublicKey P-256 key" {
    let n = load_cert()
    assert_eq(n, 981)
    // walk to the SubjectPublicKeyInfo
    let spki[1]
    x509_tbs_spki(cert, 0, spki)
    assert_eq(der_tag(cert, spki[0]), DER_SEQUENCE)
    // its algorithm OID is ecPublicKey (1.2.840.10045.2.1)
    let oid[1]
    x509_spki_alg_oid(cert, spki[0], oid)
    poke8(ecoid + 0, 0x2a); poke8(ecoid + 1, 0x86); poke8(ecoid + 2, 0x48); poke8(ecoid + 3, 0xce)
    poke8(ecoid + 4, 0x3d); poke8(ecoid + 5, 0x02); poke8(ecoid + 6, 0x01)
    assert_eq(der_oid_eq(cert, oid[0], ecoid, 7), 1)
    // the public key is an uncompressed P-256 point: 0x04 || X(32) || Y(32) = 65 bytes
    let key[2]
    x509_spki_key(cert, spki[0], key)
    assert_eq(key[1], 65)
    assert_eq(peek8(cert + key[0]), 4)
    // validity has two Time fields
    let val[2]
    x509_validity(cert, 0, val)
    assert_ne(val[0], val[1])
}
