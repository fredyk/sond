// Copyright 2026 Jhon Magdalena Vila and the Sond contributors
//
// lib/any/x509/roots.snd: a small built-in trust store of widely-used, self-signed root
// certificates this stdlib can verify: three ECDSA P-384 roots (ecdsa-with-SHA384) and one
// RSA-4096 root (sha256WithRSAEncryption). A caller decodes them into its own buffers with
// x509_load_default_roots and passes the pointer array to x509_verify_chain /
// tls_verify_server_chain. This is a starter set, not the full Mozilla program. Each root's
// DER is embedded as hex, taken verbatim from the system trust store.

include "any/x509/chain.snd"

// GTS Root R4 (525 bytes)
let X509_ROOT0_HEX = ""
// Amazon Root CA 4 (502 bytes)
let X509_ROOT1_HEX = ""
// DigiCert Global Root G3 (579 bytes)
let X509_ROOT2_HEX = ""
// ISRG Root X1 (Internet Security Research Group / Let's Encrypt), a self-signed
// RSA-4096 root (sha256WithRSAEncryption), so RSA certificate chains can anchor here too.
let X509_ROOT3_HEX = ""
// GTS Root R1 (Google Trust Services), a self-signed RSA-4096 root signed with
// sha384WithRSAEncryption.
let X509_ROOT4_HEX = ""

// The number of built-in root certificates.
fn x509_root_count() -> i64 { 5 }

// The largest built-in root in bytes; a caller sizing per-root storage can use this stride.
fn x509_root_max_len() -> i64 { 1391 }

// The hex string of built-in root `idx`.
fn x509_root_hex(idx: i64) -> i64 {
    if idx == 0 { return X509_ROOT0_HEX }
    if idx == 1 { return X509_ROOT1_HEX }
    if idx == 2 { return X509_ROOT2_HEX }
    if idx == 3 { return X509_ROOT3_HEX }
    X509_ROOT4_HEX
}

// One hex nibble value.
fn x509_root_hx(c: i64) -> i64 {
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 97 && c <= 102 { return c - 87 }
    c - 55
}

// Decodes built-in root `idx` (its DER bytes) into `dst`, returning the byte length.
fn x509_root_der(idx: i64, dst: i64) -> i64 {
    let hex = x509_root_hex(idx)
    let mut i = 0
    for peek8(hex + i * 2) != 0 {
        poke8(dst + i, x509_root_hx(peek8(hex + i * 2)) * 16 + x509_root_hx(peek8(hex + i * 2 + 1)))
        i = i + 1
    }
    i
}

// Decodes every built-in root into `store` (root i at store + i*stride bytes) and sets
// ptrs[i] to it. `stride` must be at least x509_root_max_len(). Returns the root count,
// ready to pass as (ptrs, count) to x509_verify_chain / tls_verify_server_chain.
fn x509_load_default_roots(store: i64, stride: i64, ptrs: i64) -> i64 {
    let n = x509_root_count()
    let mut i = 0
    for i < n {
        let dst = store + i * stride
        x509_root_der(i, dst)
        ptrs[i] = dst
        i = i + 1
    }
    n
}
