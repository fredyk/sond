// SPDX-License-Identifier: Apache-2.0
// Copyright 2026 Jhon Magdalena Vila and the Sond contributors
//
// Test of x509/roots.snd: the built-in ECDSA P-384 trust store. Each embedded root must be a
// self-signed certificate that verifies under its own key (an integrity check on the embedded
// DER and on P-384 verification), and the real cloudflare chain must anchor to the store.

include "any/x509/roots.snd"
include "x86_64/linux/testing.snd"

let LEAF_HEX = ""
let WE1_HEX = ""

// A self-signed CA:TRUE cert with extendedKeyUsage clientAuth only (no serverAuth).
let NOCERTSIGN_HEX = ""
let CLIENTONLY_HEX = ""
let mut r_store[2400]
let mut r_ptrs[8]
let mut r_leaf[1100]
let mut r_we1[1100]
let mut r_conly[1100]
let mut r_ncs[1100]
let mut r_chain[4]
let mut r_host[64]
let mut r_one[900]

fn rhx(c: i64) -> i64 {
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 97 && c <= 102 { return c - 87 }
    c - 55
}
fn rload(hex: i64, dst: i64) {
    let mut i = 0
    for peek8(hex + i * 2) != 0 {
        poke8(dst + i, rhx(peek8(hex + i * 2)) * 16 + rhx(peek8(hex + i * 2 + 1)))
        i = i + 1
    }
}
fn rseth(s: i64) -> i64 {
    let mut i = 0
    for peek8(s + i) != 0 { poke8(r_host + i, peek8(s + i)); i = i + 1 }
    i
}

test "x509 roots: every built-in root is self-signed and verifies under its own key" {
    let n = x509_root_count()
    assert_eq(n, 4)
    let mut i = 0
    for i < n {
        let len = x509_root_der(i, r_one)
        assert_ne(len, 0)
        assert_eq(x509_verify(r_one, 0, r_one, 0), 1)
        i = i + 1
    }
}

test "x509 roots: the real cloudflare chain anchors to the built-in trust store" {
    rload(LEAF_HEX, r_leaf)
    rload(WE1_HEX, r_we1)
    let stride = x509_root_max_len() + 8
    let nr = x509_load_default_roots(r_store, stride, r_ptrs)
    assert_eq(nr, 4)
    r_chain[0] = r_leaf
    r_chain[1] = r_we1
    // GTS Root R4 is one of the built-in roots, so the cloudflare chain is trusted.
    assert_eq(x509_verify_chain(r_chain, 2, r_ptrs, nr, r_host, rseth("cloudflare.com"), "20260901000000"), 1)
    // an unrelated host is still rejected even with a full trust store
    assert_eq(x509_verify_chain(r_chain, 2, r_ptrs, nr, r_host, rseth("evil.example"), "20260901000000"), 0)
}

test "x509 roots: accept_leaf and the chain edge cases against the built-in store" {
    rload(LEAF_HEX, r_leaf)
    rload(WE1_HEX, r_we1)
    let stride = x509_root_max_len() + 8
    let nr = x509_load_default_roots(r_store, stride, r_ptrs)
    r_chain[0] = r_leaf
    r_chain[1] = r_we1
    // single-issuer acceptance: the leaf is signed by WE1, names the host, and is valid
    assert_eq(x509_accept_leaf(r_leaf, 0, r_we1, 0, r_host, rseth("cloudflare.com"), "20260901000000"), 1)
    // an empty chain is rejected
    assert_eq(x509_verify_chain(r_chain, 0, r_ptrs, nr, r_host, rseth("cloudflare.com"), "20260901000000"), 0)
    // an empty trust store is rejected
    assert_eq(x509_verify_chain(r_chain, 2, r_ptrs, 0, r_host, rseth("cloudflare.com"), "20260901000000"), 0)
    // an instant before the leaf was issued is rejected
    assert_eq(x509_verify_chain(r_chain, 2, r_ptrs, nr, r_host, rseth("cloudflare.com"), "20200101000000"), 0)
    // a leaf whose EKU is clientAuth only is rejected (self-anchored, everything else valid)
    rload(CLIENTONLY_HEX, r_conly)
    r_chain[0] = r_conly
    r_ptrs[0] = r_conly
    assert_eq(x509_verify_chain(r_chain, 1, r_ptrs, 1, r_host, rseth("clientonly.test"), "20270101000000"), 0)
    // a CA anchor whose keyUsage lacks keyCertSign is rejected
    rload(NOCERTSIGN_HEX, r_ncs)
    r_chain[0] = r_ncs
    r_ptrs[0] = r_ncs
    assert_eq(x509_verify_chain(r_chain, 1, r_ptrs, 1, r_host, rseth("nocertsign.test"), "20270101000000"), 0)
}
