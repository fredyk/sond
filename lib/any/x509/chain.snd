//
// lib/any/x509/chain.snd: accept a leaf certificate. This ties the three independent
// checks a TLS client must make into one entry point: the leaf's signature verifies under
// a trusted issuer's key, the leaf is for the host we meant to reach, and it is inside its
// validity window. A full path builder (leaf -> intermediates -> a trusted root set) walks
// this per link; here we accept a leaf against a single directly-trusted issuer.

include "any/x509/verify.snd"
include "any/x509/accept.snd"

// 1 if `leaf` (at leafpos) is signed by `issuer` (at issuerpos), names `host`, and is valid
// at the instant `now14` ("YYYYMMDDHHMMSS"); 0 otherwise.
fn x509_accept_leaf(leaf: i64, leafpos: i64, issuer: i64, issuerpos: i64,
                    host: i64, hostlen: i64, now14: i64) -> i64 {
    if x509_verify(leaf, leafpos, issuer, issuerpos) != 1 { return 0 }
    if x509_hostname_matches(leaf, leafpos, host, hostlen) != 1 { return 0 }
    if x509_valid_at(leaf, leafpos, now14) != 1 { return 0 }
    1
}

// Validate a certificate chain against a trust store. `certs` is an array of `count` DER
// pointers, leaf first, each signed by the next (the chain a TLS server presents, leaf +
// intermediates, without the root). `roots` is an array of `nroots` trusted-root DER pointers.
// Each certificate is at offset 0 in its own buffer. Returns 1 if all hold:
//   - the leaf names `host`,
//   - every presented certificate is within its validity window at `now14`,
//   - each certificate is signed by the next one up the chain,
//   - the top certificate is signed by a trusted root that is itself valid at `now14`.
// Otherwise 0. This is signature-and-name path validation; it does not yet check basic
// constraints / key usage / name constraints, which are follow-ups.
fn x509_verify_chain(certs: i64, count: i64, roots: i64, nroots: i64,
                     host: i64, hostlen: i64, now14: i64) -> i64 {
    if count < 1 { return 0 }
    // the leaf must be issued for the host we meant to reach
    if x509_hostname_matches(certs[0], 0, host, hostlen) != 1 { return 0 }
    // every presented certificate must be inside its validity window
    let mut i = 0
    for i < count {
        if x509_valid_at(certs[i], 0, now14) != 1 { return 0 }
        i = i + 1
    }
    // each link must be signed by the next certificate up the chain, and that issuer must be a
    // CA (basicConstraints cA TRUE): a non-CA certificate must never be trusted to sign another.
    i = 0
    for i + 1 < count {
        if x509_is_ca(certs[i + 1], 0) != 1 { return 0 }
        if x509_verify(certs[i], 0, certs[i + 1], 0) != 1 { return 0 }
        i = i + 1
    }
    // the top of the chain must be signed by a trusted root that is a currently-valid CA
    let top = certs[count - 1]
    let mut j = 0
    for j < nroots {
        if x509_is_ca(roots[j], 0) == 1 {
            if x509_valid_at(roots[j], 0, now14) == 1 {
                if x509_verify(top, 0, roots[j], 0) == 1 { return 1 }
            }
        }
        j = j + 1
    }
    0
}
