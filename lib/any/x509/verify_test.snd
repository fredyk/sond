// SPDX-License-Identifier: Apache-2.0
// Copyright 2026 Jhon Magdalena Vila and the Sond contributors
//
// Test of x509/verify.snd against REAL certificate chains, embedded as hex:
//  - ECDSA: the cloudflare.com leaf verified by its issuer WE1 (both P-256, ecdsa-with-SHA256).
//  - RSA:   an openssl-generated leaf verified by its CA (sha256WithRSAEncryption).
// Each valid pair must verify to 1; corrupting the tbsCertificate must drop it to 0.

include "any/x509/verify.snd"
include "x86_64/linux/testing.snd"

let LEAF_HEX = ""
let WE1_HEX = ""
let LEAFRSA_HEX = ""
let CA_HEX = ""

// A P-384 chain generated with openssl: a self-signed P-384 CA and a leaf it signs, both
// ecdsa-with-SHA384. `openssl verify` accepts the chain.
let LEAF384_HEX = ""
let CA384_HEX = ""

// ISRG Root X1 (Let's Encrypt), a self-signed RSA-4096 root, sha256WithRSAEncryption.
let ISRGX1_HEX = ""
let mut b_isrg[1500]
let mut b_leaf[1100]
let mut b_we1[1100]
let mut b_leafrsa[1100]
let mut b_ca[1100]
let mut b_leaf384[700]
let mut b_ca384[700]

fn vhx(c: i64) -> i64 {
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 97 && c <= 102 { return c - 87 }
    c - 55
}
fn vload(hex: i64, dst: i64) -> i64 {
    let mut i = 0
    for peek8(hex + i * 2) != 0 {
        poke8(dst + i, vhx(peek8(hex + i * 2)) * 16 + vhx(peek8(hex + i * 2 + 1)))
        i = i + 1
    }
    i
}
// Flip the last byte of the tbsCertificate (a content byte, keeps the DER structure intact
// but changes SHA-256(tbs)).
fn vtamper(buf: i64) {
    let tbs[2]
    x509_tbs_span(buf, 0, tbs)
    let at = tbs[0] + tbs[1] - 1
    poke8(buf + at, peek8(buf + at) ^ 1)
}

test "x509 verify: the real cloudflare leaf is signed by WE1 (ECDSA P-256)" {
    vload(LEAF_HEX, b_leaf)
    vload(WE1_HEX, b_we1)
    assert_eq(x509_verify(b_leaf, 0, b_we1, 0), 1)
    vtamper(b_leaf)
    assert_eq(x509_verify(b_leaf, 0, b_we1, 0), 0)
}

test "x509 verify: a real RSA leaf is signed by its CA (sha256WithRSA)" {
    vload(LEAFRSA_HEX, b_leafrsa)
    vload(CA_HEX, b_ca)
    assert_eq(x509_verify(b_leafrsa, 0, b_ca, 0), 1)
    vtamper(b_leafrsa)
    assert_eq(x509_verify(b_leafrsa, 0, b_ca, 0), 0)
}

test "x509 verify: a P-384 leaf is signed by its CA (ECDSA P-384, ecdsa-with-SHA384)" {
    vload(LEAF384_HEX, b_leaf384)
    vload(CA384_HEX, b_ca384)
    assert_eq(x509_verify(b_leaf384, 0, b_ca384, 0), 1)
    vtamper(b_leaf384)
    assert_eq(x509_verify(b_leaf384, 0, b_ca384, 0), 0)
}

test "x509 verify: the self-signed P-384 CA verifies under its own key" {
    vload(CA384_HEX, b_ca384)
    assert_eq(x509_verify(b_ca384, 0, b_ca384, 0), 1)
}

test "x509 verify: the self-signed ISRG Root X1 verifies under its own key (RSA-4096)" {
    vload(ISRGX1_HEX, b_isrg)
    assert_eq(x509_verify(b_isrg, 0, b_isrg, 0), 1)
    vtamper(b_isrg)
    assert_eq(x509_verify(b_isrg, 0, b_isrg, 0), 0)
}
