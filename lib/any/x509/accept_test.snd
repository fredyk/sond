// SPDX-License-Identifier: Apache-2.0
// Copyright 2026 Jhon Magdalena Vila and the Sond contributors
//
// Test of x509/accept.snd against the REAL cloudflare.com leaf (embedded as hex): its
// subjectAltName list (exact + wildcard entries) and its UTCTime validity window, plus
// direct time-normalization checks for the UTCTime (>= 50) and GeneralizedTime forms.

include "any/x509/accept.snd"
include "x86_64/linux/testing.snd"

let LEAF_HEX = ""
// WE1 (Google Trust Services intermediate), a CA certificate (basicConstraints cA TRUE).
let WE1_HEX = ""
// A self-signed cert whose extendedKeyUsage is clientAuth ONLY (no serverAuth), for
// clientonly.test: it must not be accepted for TLS server authentication.
let CLIENTONLY_HEX = ""
let mut cert[1100]
let mut we1[1100]
let mut conly[1100]
let mut host[64]
let mut nowbuf[16]
let mut tbuf[32]
let mut t14[14]

fn ahx(c: i64) -> i64 {
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 97 && c <= 102 { return c - 87 }
    c - 55
}
fn aload() {
    let mut i = 0
    for peek8(LEAF_HEX + i * 2) != 0 {
        poke8(cert + i, ahx(peek8(LEAF_HEX + i * 2)) * 16 + ahx(peek8(LEAF_HEX + i * 2 + 1)))
        i = i + 1
    }
}
fn aload_into(hex: i64, dst: i64) {
    let mut i = 0
    for peek8(hex + i * 2) != 0 {
        poke8(dst + i, ahx(peek8(hex + i * 2)) * 16 + ahx(peek8(hex + i * 2 + 1)))
        i = i + 1
    }
}
fn seth(s: i64) -> i64 {
    let mut i = 0
    for peek8(s + i) != 0 { poke8(host + i, peek8(s + i)); i = i + 1 }
    i
}
fn setn(s: i64) {
    let mut i = 0
    for i < 14 { poke8(nowbuf + i, peek8(s + i)); i = i + 1 }
}

test "x509 accept: hostname matching against the real SAN list (exact and wildcard)" {
    aload()
    assert_eq(x509_hostname_matches(cert, 0, host, seth("cloudflare.com")), 1)
    assert_eq(x509_hostname_matches(cert, 0, host, seth("secondary.cloudflare.com")), 1)
    assert_eq(x509_hostname_matches(cert, 0, host, seth("foo.ns.cloudflare.com")), 1)
    assert_eq(x509_hostname_matches(cert, 0, host, seth("a.b.ns.cloudflare.com")), 0)
    assert_eq(x509_hostname_matches(cert, 0, host, seth("www.evil.com")), 0)
    assert_eq(x509_hostname_matches(cert, 0, host, seth("cloudflare.org")), 0)
    assert_eq(x509_hostname_matches(cert, 0, host, seth("localhost")), 0)   // no dot vs a wildcard
}

test "x509 accept: the validity window (notBefore 2026-07-08, notAfter 2026-10-06)" {
    aload()
    setn("20260723000000"); assert_eq(x509_valid_at(cert, 0, nowbuf), 1)
    setn("20260101000000"); assert_eq(x509_valid_at(cert, 0, nowbuf), 0)
    setn("20270101000000"); assert_eq(x509_valid_at(cert, 0, nowbuf), 0)
}

test "x509 accept: time normalization for UTCTime (>=50 is 19xx) and GeneralizedTime" {
    // UTCTime "950101000000Z" -> 19950101000000
    poke8(tbuf + 0, 23); poke8(tbuf + 1, 13)
    let u = "950101000000Z"
    let mut i = 0
    for i < 13 { poke8(tbuf + 2 + i, peek8(u + i)); i = i + 1 }
    x509_time14(tbuf, 0, t14)
    assert_eq(peek8(t14 + 0), 49); assert_eq(peek8(t14 + 1), 57)   // "19"
    assert_eq(peek8(t14 + 2), 57); assert_eq(peek8(t14 + 3), 53)   // "95"
    // GeneralizedTime "20500101000000Z" -> 20500101000000
    poke8(tbuf + 0, 24); poke8(tbuf + 1, 15)
    let g = "20500101000000Z"
    i = 0
    for i < 15 { poke8(tbuf + 2 + i, peek8(g + i)); i = i + 1 }
    x509_time14(tbuf, 0, t14)
    assert_eq(peek8(t14 + 0), 50); assert_eq(peek8(t14 + 3), 48)   // "20" .. "0"
    assert_eq(peek8(t14 + 2), 53)                                   // '5' of 2050
}

test "x509 accept: basicConstraints tells a CA from an end-entity" {
    aload_into(LEAF_HEX, cert)
    aload_into(WE1_HEX, we1)
    // the cloudflare leaf is an end-entity (CA:FALSE); WE1 is a CA (CA:TRUE)
    assert_eq(x509_is_ca(cert, 0), 0)
    assert_eq(x509_is_ca(we1, 0), 1)
}

test "x509 accept: extendedKeyUsage requires serverAuth when present" {
    aload_into(LEAF_HEX, cert)
    aload_into(CLIENTONLY_HEX, conly)
    // the cloudflare leaf lists serverAuth in its EKU; the clientAuth-only cert does not
    assert_eq(x509_eku_serverauth_ok(cert, 0), 1)
    assert_eq(x509_eku_serverauth_ok(conly, 0), 0)
}

test "x509 accept: keyUsage bits (digitalSignature on leaf, keyCertSign on CA, absent is open)" {
    aload_into(LEAF_HEX, cert)
    aload_into(WE1_HEX, we1)
    aload_into(CLIENTONLY_HEX, conly)
    // the leaf allows digitalSignature (0x80) but not keyCertSign (0x04)
    assert_eq(x509_keyusage_allows(cert, 0, 0x80), 1)
    assert_eq(x509_keyusage_allows(cert, 0, 0x04), 0)
    // WE1 (a CA) allows keyCertSign
    assert_eq(x509_keyusage_allows(we1, 0, 0x04), 1)
    // a certificate with no keyUsage extension is unrestricted
    assert_eq(x509_keyusage_allows(conly, 0, 0x04), 1)
}
