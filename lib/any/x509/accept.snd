//
// lib/any/x509/accept.snd: the non-signature half of accepting a certificate, on top of
// the tbsCertificate walk. A verified signature proves the chain; these checks prove the
// certificate is for the host we meant to reach and is currently in its validity window:
//   - x509_hostname_matches: the host is listed in the subjectAltName dNSName entries,
//     honoring a single leading "*." wildcard label (RFC 6125).
//   - x509_valid_at: a caller-supplied "YYYYMMDDHHMMSS" instant is within notBefore/notAfter.
// Time is normalized from UTCTime (2-digit year, 20xx if < 50 per RFC 5280) or
// GeneralizedTime to 14 digits so the comparison is a plain string compare.

include "any/asn1/der.snd"
include "any/x509/tbs.snd"

// Position of the SEQUENCE OF Extension inside tbsCertificate, or -1 if absent. After the
// SubjectPublicKeyInfo come the optional [1]/[2] unique IDs, then the [3] EXPLICIT extensions.
fn x509_extensions(cert: i64, certpos: i64) -> i64 {
    let spki[1]
    x509_tbs_spki(cert, certpos, spki)
    let t[3]
    let mut p = der_tlv(cert, spki[0], t)
    for {
        let tag = der_tag(cert, p)
        if tag == 0x81 || tag == 0x82 { p = der_tlv(cert, p, t) } else { break }
    }
    if der_tag(cert, p) == 0xa3 { return der_enter(cert, p) }
    0 - 1
}

// Finds the subjectAltName extension (OID 2.5.29.17) and writes the GeneralNames content
// span to out[0]=start, out[1]=length. Returns 1 if found, 0 otherwise.
fn x509_san(cert: i64, certpos: i64, out: i64) -> i64 {
    let seq = x509_extensions(cert, certpos)
    if seq < 0 { return 0 }
    let st[3]
    der_tlv(cert, seq, st)
    let endp = st[1] + st[2]
    let mut p = st[1]
    let sanoid[3]
    poke8(sanoid + 0, 0x55); poke8(sanoid + 1, 0x1d); poke8(sanoid + 2, 0x11)
    for p < endp {
        let ext[3]
        let nextext = der_tlv(cert, p, ext)
        let oidpos = ext[1]
        if der_oid_eq(cert, oidpos, sanoid, 3) == 1 {
            let t[3]
            let mut q = der_tlv(cert, oidpos, t)     // after the OID
            if der_tag(cert, q) == 1 { q = der_tlv(cert, q, t) }   // skip optional critical BOOLEAN
            der_tlv(cert, q, t)                       // the extnValue OCTET STRING
            let gt[3]
            der_tlv(cert, t[1], gt)                    // the GeneralNames SEQUENCE inside it
            out[0] = gt[1]
            out[1] = gt[2]
            return 1
        }
        p = nextext
    }
    0
}

// 1 if the pattern at `patpos`/`patlen` matches the host, with a single leading "*." wildcard.
fn x509_dns_match(cert: i64, patpos: i64, patlen: i64, host: i64, hostlen: i64) -> i64 {
    if patlen >= 2 && peek8(cert + patpos) == 42 && peek8(cert + patpos + 1) == 46 {
        // "*.rest": match the host suffix from its first dot against pattern[1..].
        let mut hd = 0
        for hd < hostlen {
            if peek8(host + hd) == 46 { break }
            hd = hd + 1
        }
        if hd >= hostlen { return 0 }
        let hsuf = hostlen - hd
        if hsuf != patlen - 1 { return 0 }
        let mut i = 0
        for i < hsuf {
            if peek8(host + hd + i) != peek8(cert + patpos + 1 + i) { return 0 }
            i = i + 1
        }
        return 1
    }
    if patlen != hostlen { return 0 }
    let mut i = 0
    for i < hostlen {
        if peek8(cert + patpos + i) != peek8(host + i) { return 0 }
        i = i + 1
    }
    1
}

// 1 if `host` matches any subjectAltName dNSName ([2] IMPLICIT) of the certificate.
fn x509_hostname_matches(cert: i64, certpos: i64, host: i64, hostlen: i64) -> i64 {
    let san[2]
    if x509_san(cert, certpos, san) == 0 { return 0 }
    let endp = san[0] + san[1]
    let mut p = san[0]
    for p < endp {
        let t[3]
        let nextn = der_tlv(cert, p, t)
        if t[0] == 0x82 {
            if x509_dns_match(cert, t[1], t[2], host, hostlen) == 1 { return 1 }
        }
        p = nextn
    }
    0
}

// 1 if the certificate is a CA per its basicConstraints extension (OID 2.5.29.19, cA TRUE),
// 0 otherwise (extension absent, or cA absent/FALSE, its default). An issuer in a chain must
// be a CA; a leaf that is not a CA must never be trusted to sign another certificate.
fn x509_is_ca(cert: i64, certpos: i64) -> i64 {
    let seq = x509_extensions(cert, certpos)
    if seq < 0 { return 0 }
    let st[3]
    der_tlv(cert, seq, st)
    let endp = st[1] + st[2]
    let mut p = st[1]
    let bcoid[3]
    poke8(bcoid + 0, 0x55); poke8(bcoid + 1, 0x1d); poke8(bcoid + 2, 0x13)   // 2.5.29.19
    for p < endp {
        let ext[3]
        let nextext = der_tlv(cert, p, ext)
        let oidpos = ext[1]
        if der_oid_eq(cert, oidpos, bcoid, 3) == 1 {
            let t[3]
            let mut q = der_tlv(cert, oidpos, t)      // position after the OID
            if der_tag(cert, q) == 1 { q = der_tlv(cert, q, t) }   // skip optional critical BOOLEAN
            der_tlv(cert, q, t)                        // extnValue OCTET STRING
            let sq[3]
            der_tlv(cert, t[1], sq)                    // the BasicConstraints SEQUENCE inside it
            if sq[2] == 0 { return 0 }                 // empty SEQUENCE: cA defaults to FALSE
            let inner = sq[1]                          // first element (cA BOOLEAN if present)
            if der_tag(cert, inner) == 1 {
                let bt[3]
                der_tlv(cert, inner, bt)
                if peek8(cert + bt[1]) != 0 { return 1 }   // BOOLEAN TRUE (0xFF)
            }
            return 0
        }
        p = nextext
    }
    0
}

// 1 if the certificate may be used for TLS server authentication per its extendedKeyUsage
// (OID 2.5.29.37): if the EKU extension is ABSENT, there is no restriction (RFC 5280), so 1;
// if PRESENT, its OID list must contain serverAuth (1.3.6.1.5.5.7.3.1). A leaf whose EKU is,
// say, clientAuth only must not be trusted to authenticate a server.
fn x509_eku_serverauth_ok(cert: i64, certpos: i64) -> i64 {
    let seq = x509_extensions(cert, certpos)
    if seq < 0 { return 1 }                        // no extensions at all: unrestricted
    let st[3]
    der_tlv(cert, seq, st)
    let endp = st[1] + st[2]
    let mut p = st[1]
    let ekuoid[3]
    poke8(ekuoid + 0, 0x55); poke8(ekuoid + 1, 0x1d); poke8(ekuoid + 2, 0x25)   // 2.5.29.37
    let saoid[8]                                    // serverAuth: 1.3.6.1.5.5.7.3.1
    poke8(saoid + 0, 0x2b); poke8(saoid + 1, 0x06); poke8(saoid + 2, 0x01); poke8(saoid + 3, 0x05)
    poke8(saoid + 4, 0x05); poke8(saoid + 5, 0x07); poke8(saoid + 6, 0x03); poke8(saoid + 7, 0x01)
    for p < endp {
        let ext[3]
        let nextext = der_tlv(cert, p, ext)
        let oidpos = ext[1]
        if der_oid_eq(cert, oidpos, ekuoid, 3) == 1 {
            let t[3]
            let mut q = der_tlv(cert, oidpos, t)    // position after the OID
            if der_tag(cert, q) == 1 { q = der_tlv(cert, q, t) }   // skip optional critical BOOLEAN
            der_tlv(cert, q, t)                      // extnValue OCTET STRING
            let sq[3]
            der_tlv(cert, t[1], sq)                  // the SEQUENCE OF KeyPurposeId (OIDs)
            let listend = sq[1] + sq[2]
            let mut r = sq[1]
            for r < listend {
                let ot[3]
                let nexto = der_tlv(cert, r, ot)
                if der_oid_eq(cert, r, saoid, 8) == 1 { return 1 }   // serverAuth present
                r = nexto
            }
            return 0                                 // EKU present but no serverAuth
        }
        p = nextext
    }
    1                                                // EKU extension absent: unrestricted
}

// 1 if the certificate's keyUsage (OID 2.5.29.15) allows the usage(s) in `mask`, else 0.
// keyUsage is a DER BIT STRING; its first flags byte holds, MSB first, bit 0 digitalSignature
// (0x80) .. bit 5 keyCertSign (0x04) .. bit 6 cRLSign (0x02). Absent keyUsage is unrestricted
// (RFC 5280), so 1; present requires every bit of `mask` to be set.
fn x509_keyusage_allows(cert: i64, certpos: i64, mask: i64) -> i64 {
    let seq = x509_extensions(cert, certpos)
    if seq < 0 { return 1 }                        // no extensions: unrestricted
    let st[3]
    der_tlv(cert, seq, st)
    let endp = st[1] + st[2]
    let mut p = st[1]
    let kuoid[3]
    poke8(kuoid + 0, 0x55); poke8(kuoid + 1, 0x1d); poke8(kuoid + 2, 0x0f)   // 2.5.29.15
    for p < endp {
        let ext[3]
        let nextext = der_tlv(cert, p, ext)
        let oidpos = ext[1]
        if der_oid_eq(cert, oidpos, kuoid, 3) == 1 {
            let t[3]
            let mut q = der_tlv(cert, oidpos, t)    // position after the OID
            if der_tag(cert, q) == 1 { q = der_tlv(cert, q, t) }   // skip optional critical BOOLEAN
            der_tlv(cert, q, t)                      // extnValue OCTET STRING
            let bs[3]
            der_tlv(cert, t[1], bs)                  // the BIT STRING: [unused-bit count][flags...]
            if bs[2] < 2 { return 0 }                // no flags byte: nothing allowed
            let flags = peek8(cert + bs[1] + 1)
            if (flags & mask) == mask { return 1 }
            return 0
        }
        p = nextext
    }
    1                                                // keyUsage absent: unrestricted
}

// Reads a certificate Time (UTCTime or GeneralizedTime) into 14 digits YYYYMMDDHHMMSS.
fn x509_time14(cert: i64, timepos: i64, out14: i64) {
    let t[3]
    der_tlv(cert, timepos, t)
    let cs = t[1]
    if t[0] == 23 {
        let yy = (peek8(cert + cs) - 48) * 10 + (peek8(cert + cs + 1) - 48)
        if yy < 50 { poke8(out14 + 0, 50); poke8(out14 + 1, 48) }   // "20"
        else { poke8(out14 + 0, 49); poke8(out14 + 1, 57) }          // "19"
        let mut i = 0
        for i < 12 { poke8(out14 + 2 + i, peek8(cert + cs + i)); i = i + 1 }
    } else {
        let mut i = 0
        for i < 14 { poke8(out14 + i, peek8(cert + cs + i)); i = i + 1 }
    }
}

// -1/0/1 comparison of two 14-byte digit strings.
fn x509_cmp14(a: i64, b: i64) -> i64 {
    let mut i = 0
    for i < 14 {
        if peek8(a + i) < peek8(b + i) { return 0 - 1 }
        if peek8(a + i) > peek8(b + i) { return 1 }
        i = i + 1
    }
    0
}

// 1 if `now14` ("YYYYMMDDHHMMSS") is within the certificate's validity window.
fn x509_valid_at(cert: i64, certpos: i64, now14: i64) -> i64 {
    let val[2]
    x509_validity(cert, certpos, val)
    let nb[14]
    let na[14]
    x509_time14(cert, val[0], nb)
    x509_time14(cert, val[1], na)
    if x509_cmp14(now14, nb) < 0 { return 0 }
    if x509_cmp14(now14, na) > 0 { return 0 }
    1
}
