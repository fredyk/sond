test "xml_propfind_response full round-trip" {
    let buf = bytes_new()
    let __lit44: string = "/docs/readme.txt"
    let __lit45: string = "readme.txt"
    xml_propfind_response(buf, __lit44.utf8, __lit45.utf8, 256, 0)
    // href
    let __s7_434: string = "href"
    let href = xml_get_tag_content(buf, __s7_434.utf8, 0)
    let __s12_473: string = "/docs/readme.txt"
    assert(buf_eq_cstr(href, __s12_473.utf8))
    // displayname
    let __s8_438: string = "displayname"
    let dn = xml_get_tag_content(buf, __s8_438.utf8, 0)
    let __s13_478: string = "readme.txt"
    assert(buf_eq_cstr(dn, __s13_478.utf8))
}

test "xml_propfind_response collection round-trip" {
    let buf = bytes_new()
    let __lit46: string = "/docs/"
    let __lit47: string = "Documents"
    xml_propfind_response(buf, __lit46.utf8, __lit47.utf8, 0, 1)
    // href
    let __s9_449: string = "href"
    let href = xml_get_tag_content(buf, __s9_449.utf8, 0)
    let __s14_490: string = "/docs/"
    assert(buf_eq_cstr(href, __s14_490.utf8))
    // has collection
    let __s6_478: string = "collection"
    assert(xml_has_tag(buf, __s6_478.utf8, 0) != 0)
    // getcontentlength should be "0" for collections
    let __s10_455: string = "getcontentlength"
    let clen = xml_get_tag_content(buf, __s10_455.utf8, 0)
    assert_ne(bytes_len(clen), 0)  // content-length tag should have content (zero)
}

test "parse second response block separately" {
    let xml_buf = bytes_new()
    build_test_multistatus(xml_buf)
    // Find the second <response> block
    let __s3_483: string = "response"
    let first_resp_end = xml_find_close_tag(xml_buf, __s3_483.utf8, 0)
    let __s16_481: string = "response"
    let second_resp_start = xml_find_open_tag(xml_buf, __s16_481.utf8, first_resp_end + 2)
    assert(second_resp_start >= 0)
    let out = bytes_new()
    let cf_buf: i64 = heap_alloc(8)
    let result = xml_parse_response(xml_buf, second_resp_start, out, cf_buf)
    assert_eq(result, 1)
    let n1 = bytes_index_of(out, 0)
    let href = bytes_slice(out, 0, n1)
    let __s15_516: string = "/docs/readme.txt"
    assert(buf_eq_cstr(href, __s15_516.utf8))
}
