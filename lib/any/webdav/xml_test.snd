test "xml_multistatus wraps responses correctly" {
    let responses = bytes_new()
    let __lit25: string = "/a"
    let __lit26: string = "A"
    xml_propfind_response(responses, __lit25.utf8, __lit26.utf8, 100, 0)
    let wrapped = bytes_new()
    xml_multistatus(wrapped, responses)
    let __s7_291: string = "multistatus"
    assert(xml_find_open_tag(wrapped, __s7_291.utf8, 0) >= 0)
    let __s8_293: string = "response"
    assert(xml_find_open_tag(wrapped, __s8_293.utf8, 0) >= 0)
}

