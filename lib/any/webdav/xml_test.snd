}

test "buf_to_stack: copies bytes to stack array" {
    let src = bytes_new()
    let __lit35: string = "hello"
    bytes_append_cstr(src, __lit35.utf8)
    let dst[32]
    let copied = buf_to_stack(src, dst, 32)
    let __f0_404: string = "hello"
    assert_eq(copied, 5)  // __f0_404.utf8 is 5 chars
    // Verify content
    assert_eq(dst[0], 104)  // 'h'
    assert_eq(dst[1], 101)  // 'e'
    assert_eq(dst[4], 111)  // 'o'
}

test "buf_eq_cstr: empty buffer" {
    let buf = bytes_new()
    let __s8_404: string = ""
    let result = buf_eq_cstr(buf, __s8_404.utf8)
    assert_eq(result, 1)  // empty buffer matches empty cstr
}

test "buf_eq_cstr: buffer longer than the cstr stops at the cstr's NUL" {
    let buf = bytes_new()
    let __lit36: string = "hello world"
    bytes_append_cstr(buf, __lit36.utf8)
    // Only the first 5 bytes are compared; the loop must exit via the cstr's
    // own NUL terminator (cc == 0), not via reaching the buffer's length.
    let __s9_415: string = "hello"
    let result = buf_eq_cstr(buf, __s9_415.utf8)
    assert_eq(result, 1)
}

test "buf_to_stack: truncates to max when the buffer is longer" {
    let src = bytes_new()
    let __lit37: string = "hello world"
    bytes_append_cstr(src, __lit37.utf8)
    let dst[4]
    let copied = buf_to_stack(src, dst, 4)
    assert_eq(copied, 4)
    assert_eq(dst[0], 104)  // 'h'
    assert_eq(dst[3], 108)  // 'l'
}

