// Tests for lib/any/webdav/xml.snd: round-trip build+parse for WebDAV multistatus XML.

include "x86_64/linux/testing.snd"
include "x86_64/linux/bytes.snd"
include "any/webdav/xml.snd"

// ── Helpers ─────────────────────────────────────────────────────────────

// Build a known multistatus XML body in `out` via copy from a local buffer.
fn build_test_multistatus(out: i64) {
    let mut buf = bytes_new()

    // Resource 1: a collection "/docs/"
    let __lit0: string = "/docs/"
    let __lit1: string = "Documents"
    xml_propfind_response(buf, __lit0.utf8, __lit1.utf8, 0, 1)

    // Resource 2: a file "/docs/readme.txt"
    let __lit2: string = "/docs/readme.txt"
    let __lit3: string = "readme.txt"
    xml_propfind_response(buf, __lit2.utf8, __lit3.utf8, 256, 0)

    let n = bytes_len(buf)
    let mut i = 0
    for i < n {
        let c = bytes_get(buf, i)
        bytes_push(out, c)
        i = i + 1
    }
}

// Compare a bytes buffer against a NUL-terminated cstr literal.
fn buf_eq_cstr(buf: i64, c: i64) -> i64 {
    let n = bytes_len(buf)
    let mut i = 0
    let mut ok = 1
    for {
        if i >= n { break }
        let bc = bytes_get(buf, i)
        let cc = peek8(c + i)
        if cc == 0 { break }
        if bc != cc { ok = 0 }
        i = i + 1
    }
    ok
}

// Copy a bytes buffer to stack array `dst` (returns bytes copied).
fn buf_to_stack(src: i64, dst: i64, max: i64) -> i64 {
    let n = bytes_len(src)
    if n > max { n = max }
    let mut i = 0
    for i < n {
        dst[i] = bytes_get(src, i)  // writes 8-byte word
        i = i + 1
    }
    n
}

// ── Tests ───────────────────────────────────────────────────────────────

test "xml_element rounds trip" {
    let buf = bytes_new()
    let __lit4: string = "title"
    let __lit5: string = "Hello World"
    xml_element(buf, __lit4.utf8, __lit5.utf8)
    let __s0_69: string = "title"
    let content = xml_get_tag_content(buf, __s0_69.utf8, 0)
    let __s0_71: string = "Hello World"
    assert(buf_eq_cstr(content, __s0_71.utf8))
}

test "xml_element with empty value" {
    let buf = bytes_new()
    let __lit6: string = "empty"
    let __lit7: string = ""
    xml_element(buf, __lit6.utf8, __lit7.utf8)
    let __s1_79: string = "empty"
    let content = xml_get_tag_content(buf, __s1_79.utf8, 0)
    assert_eq(bytes_len(content), 0)
}

test "xml_elem_self produces self-closing tag" {
    let buf = bytes_new()
    let __lit8: string = "br"
    xml_elem_self(buf, __lit8.utf8)
    let __s0_88: string = "br"
    let found = xml_has_tag(buf, __s0_88.utf8, 0)
    assert_eq(found, 1)
}

test "xml_find_open_tag finds response tag" {
    let buf = bytes_new()
    build_test_multistatus(buf)
    let __s0_95: string = "response"
    let pos = xml_find_open_tag(buf, __s0_95.utf8, 0)
    assert(pos >= 0)
}

test "xml_find_close_tag finds </response>" {
    let buf = bytes_new()
    build_test_multistatus(buf)
    let __s1_103: string = "response"
    let pos = xml_find_open_tag(buf, __s1_103.utf8, 0)
    let __s0_105: string = "response"
    let close_pos = xml_find_close_tag(buf, __s0_105.utf8, pos + 1)
    assert(close_pos > pos)
}

test "xml_find_close_tag returns -1 for nonexistent tag" {
    let __s0_113: string = "<hello/>"
    let buf = bytes_from_cstr(__s0_113.utf8)
    let __s1_112: string = "response"
    assert_eq(xml_find_close_tag(buf, __s1_112.utf8, 0), -1)
}

