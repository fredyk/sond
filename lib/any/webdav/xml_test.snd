test "xml_has_tag: collection present returns 1" {
    let buf = bytes_new()
    bytes_push(buf, 60)
    let __lit13: string = "resourcetype"
    bytes_append_cstr(buf, __lit13.utf8)
    bytes_push(buf, 62)
    let __lit14: string = "collection"
    xml_elem_self(buf, __lit14.utf8)
    bytes_push(buf, 60)
    bytes_push(buf, 47)
    let __lit15: string = "resourcetype"
    bytes_append_cstr(buf, __lit15.utf8)
    bytes_push(buf, 62)
    let __s1_150: string = "collection"
    assert(xml_has_tag(buf, __s1_150.utf8, 0))
}

test "xml_has_tag: collection absent returns 0" {
    let buf = bytes_new()
    let __lit16: string = "resourcetype"
    xml_elem_self(buf, __lit16.utf8)
    let __s2_158: string = "collection"
    let found = xml_has_tag(buf, __s2_158.utf8, 0)
    assert_eq(found, 0)
}

test "xml_extract_hrefs extracts two hrefs" {
    let out = bytes_new()
    let buf = bytes_new()
    build_test_multistatus(buf)
    let count = xml_extract_hrefs(out, 0, buf)
    assert_eq(count, 2)
    // First NUL-delimited field is "/docs/"
    let pos1 = bytes_index_of(out, 0)
    let href1 = bytes_slice(out, 0, pos1)
    let __s2_174: string = "/docs/"
    assert(buf_eq_cstr(href1, __s2_174.utf8))
    // Second href
    let after_nl = pos1 + 2
    let pos2 = bytes_index_of_from(out, 0, after_nl)
    assert(pos2 != -1)
    let href2 = bytes_slice(out, after_nl, pos2)
    let __s3_181: string = "/docs/readme.txt"
    assert(buf_eq_cstr(href2, __s3_181.utf8))
}

test "xml_extract_hrefs base not prepended for absolute hrefs" {
    let out = bytes_new()
    let buf = bytes_new()
    build_test_multistatus(buf)
    let __s0_190: string = "http://base"
    let count = xml_extract_hrefs(out, __s0_190.utf8, buf)
    assert_eq(count, 2)
    // First href starts with '/' (47)
    assert_eq(bytes_get(out, 0), 47)
}

test "xml_extract_hrefs prepends base for relative hrefs" {
    let out = bytes_new()
    let entry = bytes_new()
    let __lit17: string = "relative/path"
    let __lit18: string = "RelFile"
    xml_propfind_response(entry, __lit17.utf8, __lit18.utf8, 42, 0)
    let __s1_203: string = "http://localhost"
    let count = xml_extract_hrefs(out, __s1_203.utf8, entry)
    assert(count >= 1)
    // First href should start with the base URL
    let pos1 = bytes_index_of(out, 0)
    let __f0_208: string = "http://localhost/relative/path"
    assert(pos1 > 17)  // __f0_208.utf8 > 17 chars
    let first_byte = bytes_get(out, 0)
    let __f0_211: string = "http://"
    assert_eq(first_byte, 104)  // 'h' from __f0_211.utf8
    let second_byte = bytes_get(out, 1)
    assert_eq(second_byte, 116)  // 't'
}

