    let buf = bytes_new()
    bytes_push(buf, 10)  // \n
    bytes_push(buf, 32); bytes_push(buf, 32)  // two spaces
    bytes_push(buf, 60)
    let __lit27: string = "displayname"
    bytes_append_cstr(buf, __lit27.utf8)
    bytes_push(buf, 62)
    let __lit28: string = "indented"
    bytes_append_cstr(buf, __lit28.utf8)
    bytes_push(buf, 60)
    bytes_push(buf, 47)
    let __lit29: string = "displayname"
    bytes_append_cstr(buf, __lit29.utf8)
    bytes_push(buf, 62)
    let __s4_303: string = "displayname"
    let content = xml_get_tag_content(buf, __s4_303.utf8, 0)
    let __s5_327: string = "indented"
    assert(buf_eq_cstr(content, __s5_327.utf8))
}

