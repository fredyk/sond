// Tests for lib/any/webdav/xml.snd: round-trip build+parse for WebDAV multistatus XML.

include "x86_64/linux/testing.snd"
include "x86_64/linux/bytes.snd"
include "any/webdav/xml.snd"

// ── Helpers ─────────────────────────────────────────────────────────────

// Build a known multistatus XML body in `out` via copy from a local buffer.
fn build_test_multistatus(out: i64) {
    let mut buf = bytes_new()

    // Resource 1: a collection "/docs/"
    xml_propfind_response(buf, cstr("/docs/"), cstr("Documents"), 0, 1)

    // Resource 2: a file "/docs/readme.txt"
    xml_propfind_response(buf, cstr("/docs/readme.txt"), cstr("readme.txt"), 256, 0)

    let n = bytes_len(buf)
    let mut i = 0
    for i < n {
        let c = bytes_get(buf, i)
        bytes_push(out, c)
        i = i + 1
    }
}

// Compare a bytes buffer against a NUL-terminated cstr literal.
fn buf_eq_cstr(buf: i64, c: i64) -> i64 {
    let n = bytes_len(buf)
    let mut i = 0
    let mut ok = 1
    for {
        if i >= n { break }
        let bc = bytes_get(buf, i)
        let cc = peek8(c + i)
        if cc == 0 { break }
        if bc != cc { ok = 0 }
        i = i + 1
    }
    ok
}

// Copy a bytes buffer to stack array `dst` (returns bytes copied).
fn buf_to_stack(src: i64, dst: i64, max: i64) -> i64 {
    let n = bytes_len(src)
    if n > max { n = max }
    let mut i = 0
    for i < n {
        dst[i] = bytes_get(src, i)  // writes 8-byte word
        i = i + 1
    }
    n
}

// ── Tests ───────────────────────────────────────────────────────────────

test "xml_element rounds trip" {
    let buf = bytes_new()
    xml_element(buf, cstr("title"), cstr("Hello World"))
    let content = xml_get_tag_content(buf, cstr("title"), 0)
    assert(buf_eq_cstr(content, cstr("Hello World")))
}

test "xml_element with empty value" {
    let buf = bytes_new()
    xml_element(buf, cstr("empty"), cstr(""))
    let content = xml_get_tag_content(buf, cstr("empty"), 0)
    assert_eq(bytes_len(content), 0)
}

test "xml_elem_self produces self-closing tag" {
    let buf = bytes_new()
    xml_elem_self(buf, cstr("br"))
    let found = xml_has_tag(buf, cstr("br"), 0)
    assert_eq(found, 1)
}

test "xml_find_open_tag finds response tag" {
    let buf = bytes_new()
    build_test_multistatus(buf)
    let pos = xml_find_open_tag(buf, cstr("response"), 0)
    assert(pos >= 0)
}

test "xml_find_close_tag finds </response>" {
    let buf = bytes_new()
    build_test_multistatus(buf)
    let pos = xml_find_open_tag(buf, cstr("response"), 0)
    let close_pos = xml_find_close_tag(buf, cstr("response"), pos + 1)
    assert(close_pos > pos)
}

test "xml_find_close_tag returns -1 for nonexistent tag" {
    let buf = bytes_from_cstr(cstr("<hello/>"))
    assert_eq(xml_find_close_tag(buf, cstr("response"), 0), -1)
}

test "xml_get_tag_content extracts href value" {
    let buf = bytes_new()
    xml_element(buf, cstr("href"), cstr("/some/path"))
    let content = xml_get_tag_content(buf, cstr("href"), 0)
    assert(buf_eq_cstr(content, cstr("/some/path")))
}

test "xml_get_tag_content returns empty for missing tag" {
    let buf = bytes_new()
    xml_element(buf, cstr("href"), cstr("/test"))
    let content = xml_get_tag_content(buf, cstr("nothere"), 0)
    assert_eq(bytes_len(content), 0)
}

test "xml_has_tag: collection present returns 1" {
    let buf = bytes_new()
    bytes_push(buf, 60)
    bytes_append_cstr(buf, cstr("resourcetype"))
    bytes_push(buf, 62)
    xml_elem_self(buf, cstr("collection"))
    bytes_push(buf, 60)
    bytes_push(buf, 47)
    bytes_append_cstr(buf, cstr("resourcetype"))
    bytes_push(buf, 62)
    assert(xml_has_tag(buf, cstr("collection"), 0))
}

test "xml_has_tag: collection absent returns 0" {
    let buf = bytes_new()
    xml_elem_self(buf, cstr("resourcetype"))
    let found = xml_has_tag(buf, cstr("collection"), 0)
    assert_eq(found, 0)
}

test "xml_extract_hrefs extracts two hrefs" {
    let out = bytes_new()
    let buf = bytes_new()
    build_test_multistatus(buf)
    let count = xml_extract_hrefs(out, 0, buf)
    assert_eq(count, 2)
    // First NUL-delimited field is "/docs/"
    let pos1 = bytes_index_of(out, 0)
    let href1 = bytes_slice(out, 0, pos1)
    assert(buf_eq_cstr(href1, cstr("/docs/")))
    // Second href
    let after_nl = pos1 + 2
    let pos2 = bytes_index_of_from(out, 0, after_nl)
    assert(pos2 != -1)
    let href2 = bytes_slice(out, after_nl, pos2)
    assert(buf_eq_cstr(href2, cstr("/docs/readme.txt")))
}

test "xml_extract_hrefs base not prepended for absolute hrefs" {
    let out = bytes_new()
    let buf = bytes_new()
    build_test_multistatus(buf)
    let count = xml_extract_hrefs(out, cstr("http://base"), buf)
    assert_eq(count, 2)
    // First href starts with '/' (47)
    assert_eq(bytes_get(out, 0), 47)
}

test "xml_extract_hrefs prepends base for relative hrefs" {
    let out = bytes_new()
    let entry = bytes_new()
    xml_propfind_response(entry, cstr("relative/path"), cstr("RelFile"), 42, 0)
    let count = xml_extract_hrefs(out, cstr("http://localhost"), entry)
    assert(count >= 1)
    // First href should start with the base URL
    let pos1 = bytes_index_of(out, 0)
    assert(pos1 > 17)  // "http://localhost/relative/path" > 17 chars
    let first_byte = bytes_get(out, 0)
    assert_eq(first_byte, 104)  // 'h' from "http://"
    let second_byte = bytes_get(out, 1)
    assert_eq(second_byte, 116)  // 't'
}

test "xml_count_responses returns 2" {
    let buf = bytes_new()
    build_test_multistatus(buf)
    assert_eq(xml_count_responses(buf), 2)
}

test "xml_count_responses returns 0 for empty buffer" {
    let buf = bytes_new()
    assert_eq(xml_count_responses(buf), 0)
}

test "xml_propfind_response generates valid structure" {
    let out = bytes_new()
    xml_propfind_response(out, cstr("/file"), cstr("myfile"), 100, 0)
    assert(xml_find_open_tag(out, cstr("response"), 0) >= 0)
    assert(xml_find_open_tag(out, cstr("href"), 0) >= 0)
    assert(xml_find_close_tag(out, cstr("response"), 0) >= 0)
    assert(xml_find_open_tag(out, cstr("propstat"), 0) >= 0)
}

test "xml_propfind_response collection has <collection/>" {
    let out = bytes_new()
    xml_propfind_response(out, cstr("/dir"), cstr("mydir"), 0, 1)
    assert(xml_has_tag(out, cstr("collection"), 0) != 0)
}

test "xml_propfind_response file does NOT have <collection/>" {
    let out = bytes_new()
    xml_propfind_response(out, cstr("/file"), cstr("myfile"), 256, 0)
    assert_eq(xml_has_tag(out, cstr("collection"), 0), 0)
}

test "xml_parse_response extracts href from multistatus" {
    let xml_buf = bytes_new()
    build_test_multistatus(xml_buf)
    let out = bytes_new()
    let cf_buf: i64 = heap_alloc(8)
    let result = xml_parse_response(xml_buf, 0, out, cf_buf)
    assert_eq(result, 1)
    let n1 = bytes_index_of(out, 0)
    let href = bytes_slice(out, 0, n1)
    assert(buf_eq_cstr(href, cstr("/docs/")))
}

test "xml_parse_response extracts collection flag" {
    let xml_buf = bytes_new()
    build_test_multistatus(xml_buf)
    let out = bytes_new()
    let cf_buf: i64 = heap_alloc(8)
    xml_parse_response(xml_buf, 0, out, cf_buf)
    // Flags are stored at position cf_buf, check via peek64
    let cf_val = peek64(cf_buf)
    assert_eq(cf_val, 1)  // collection
}

test "xml_build_propfind_body builds valid XML" {
    let body = xml_build_propfind_body(cstr("/test"))
    assert(bytes_len(body) > 0)
}

test "xml_build_propfind_body contains propfind tag" {
    let body = xml_build_propfind_body(cstr("/test"))
    assert(xml_find_open_tag(body, cstr("propfind"), 0) >= 0)
}

test "xml_build_propfind_body contains DAV namespace" {
    let body = xml_build_propfind_body(cstr("/test"))
    assert(xml_find_open_tag(body, cstr("propfind"), 0) >= 0)
}

test "xml_multistatus wraps responses correctly" {
    let responses = bytes_new()
    xml_propfind_response(responses, cstr("/a"), cstr("A"), 100, 0)
    let wrapped = bytes_new()
    xml_multistatus(wrapped, responses)
    assert(xml_find_open_tag(wrapped, cstr("multistatus"), 0) >= 0)
    assert(xml_find_open_tag(wrapped, cstr("response"), 0) >= 0)
}

test "xml_get_tag_content handles whitespace/indentation" {
    let buf = bytes_new()
    bytes_push(buf, 10)  // \n
    bytes_push(buf, 32); bytes_push(buf, 32)  // two spaces
    bytes_push(buf, 60)
    bytes_append_cstr(buf, cstr("displayname"))
    bytes_push(buf, 62)
    bytes_append_cstr(buf, cstr("indented"))
    bytes_push(buf, 60)
    bytes_push(buf, 47)
    bytes_append_cstr(buf, cstr("displayname"))
    bytes_push(buf, 62)
    let content = xml_get_tag_content(buf, cstr("displayname"), 0)
    assert(buf_eq_cstr(content, cstr("indented")))
}

// Additional coverage tests for helper functions
test "buf_eq_cstr: matches simple string" {
    let buf = bytes_new()
    bytes_append_cstr(buf, cstr("hello"))
    assert(buf_eq_cstr(buf, cstr("hello")) != 0)
}

test "buf_eq_cstr: different strings" {
    let buf = bytes_new()
    bytes_append_cstr(buf, cstr("hello"))
    let result = buf_eq_cstr(buf, cstr("world"))
    assert_eq(result, 0)
}

test "xml_extract_hrefs: single href in buffer" {
    let buf = bytes_new()
    bytes_push(buf, 60)
    bytes_append_cstr(buf, cstr("href"))
    bytes_push(buf, 62)
    bytes_append_cstr(buf, cstr("/path/to/file"))
    bytes_push(buf, 60)
    bytes_push(buf, 47)
    bytes_append_cstr(buf, cstr("href"))
    bytes_push(buf, 62)
    let out = bytes_new()
    let count = xml_extract_hrefs(out, 0, buf)
    assert_eq(count, 1)
    let pos = bytes_index_of(out, 0)
    assert(pos > 0)
    let href = bytes_slice(out, 0, pos)
    assert(bytes_len(href) > 0)
}

test "xml_build_propfind_body: has all expected elements" {
    let body = xml_build_propfind_body(cstr("/test"))
    assert(xml_find_open_tag(body, cstr("propfind"), 0) >= 0)
    assert(xml_find_open_tag(body, cstr("prop"), 0) >= 0)
    assert(xml_find_open_tag(body, cstr("displayname"), 0) >= 0)
    assert(xml_find_open_tag(body, cstr("resourcetype"), 0) >= 0)
    assert(xml_find_open_tag(body, cstr("getcontentlength"), 0) >= 0)
    assert(xml_find_open_tag(body, cstr("getlastmodified"), 0) >= 0)
    assert(xml_find_open_tag(body, cstr("lockdiscovery"), 0) >= 0)
}

test "buf_to_stack: copies bytes to stack array" {
    let src = bytes_new()
    bytes_append_cstr(src, cstr("hello"))
    let dst[32]
    let copied = buf_to_stack(src, dst, 32)
    assert_eq(copied, 5)  // "hello" is 5 chars
    // Verify content
    assert_eq(dst[0], 104)  // 'h'
    assert_eq(dst[1], 101)  // 'e'
    assert_eq(dst[4], 111)  // 'o'
}

test "buf_eq_cstr: empty buffer" {
    let buf = bytes_new()
    let result = buf_eq_cstr(buf, cstr(""))
    assert_eq(result, 1)  // empty buffer matches empty cstr
}

test "buf_eq_cstr: buffer longer than the cstr stops at the cstr's NUL" {
    let buf = bytes_new()
    bytes_append_cstr(buf, cstr("hello world"))
    // Only the first 5 bytes are compared; the loop must exit via the cstr's
    // own NUL terminator (cc == 0), not via reaching the buffer's length.
    let result = buf_eq_cstr(buf, cstr("hello"))
    assert_eq(result, 1)
}

test "buf_to_stack: truncates to max when the buffer is longer" {
    let src = bytes_new()
    bytes_append_cstr(src, cstr("hello world"))
    let dst[4]
    let copied = buf_to_stack(src, dst, 4)
    assert_eq(copied, 4)
    assert_eq(dst[0], 104)  // 'h'
    assert_eq(dst[3], 108)  // 'l'
}

test "xml_propfind_response: default href" {
    // Test with "/" as href (common case)
    let buf = bytes_new()
    xml_propfind_response(buf, cstr("/"), cstr("root"), 0, 1)
    let href = xml_get_tag_content(buf, cstr("href"), 0)
    assert(buf_eq_cstr(href, cstr("/")))
    assert(xml_has_tag(buf, cstr("collection"), 0) != 0)
}

test "xml_element: nested tags" {
    let buf = bytes_new()
    bytes_push(buf, 60)
    bytes_append_cstr(buf, cstr("prop"))
    bytes_push(buf, 62)
    xml_element(buf, cstr("displayname"), cstr("testname"))
    bytes_push(buf, 60)
    bytes_push(buf, 47)
    bytes_append_cstr(buf, cstr("prop"))
    bytes_push(buf, 62)
    let content = xml_get_tag_content(buf, cstr("displayname"), 0)
    assert(buf_eq_cstr(content, cstr("testname")))
}

test "xml_propfind_response full round-trip" {
    let buf = bytes_new()
    xml_propfind_response(buf, cstr("/docs/readme.txt"), cstr("readme.txt"), 256, 0)
    // href
    let href = xml_get_tag_content(buf, cstr("href"), 0)
    assert(buf_eq_cstr(href, cstr("/docs/readme.txt")))
    // displayname
    let dn = xml_get_tag_content(buf, cstr("displayname"), 0)
    assert(buf_eq_cstr(dn, cstr("readme.txt")))
}

test "xml_propfind_response collection round-trip" {
    let buf = bytes_new()
    xml_propfind_response(buf, cstr("/docs/"), cstr("Documents"), 0, 1)
    // href
    let href = xml_get_tag_content(buf, cstr("href"), 0)
    assert(buf_eq_cstr(href, cstr("/docs/")))
    // has collection
    assert(xml_has_tag(buf, cstr("collection"), 0) != 0)
    // getcontentlength should be "0" for collections
    let clen = xml_get_tag_content(buf, cstr("getcontentlength"), 0)
    assert_ne(bytes_len(clen), 0)  // content-length tag should have content (zero)
}

test "parse second response block separately" {
    let xml_buf = bytes_new()
    build_test_multistatus(xml_buf)
    // Find the second <response> block
    let first_resp_end = xml_find_close_tag(xml_buf, cstr("response"), 0)
    let second_resp_start = xml_find_open_tag(xml_buf, cstr("response"), first_resp_end + 2)
    assert(second_resp_start >= 0)
    let out = bytes_new()
    let cf_buf: i64 = heap_alloc(8)
    let result = xml_parse_response(xml_buf, second_resp_start, out, cf_buf)
    assert_eq(result, 1)
    let n1 = bytes_index_of(out, 0)
    let href = bytes_slice(out, 0, n1)
    assert(buf_eq_cstr(href, cstr("/docs/readme.txt")))
}
