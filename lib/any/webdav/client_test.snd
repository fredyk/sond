// Tests for lib/any/webdav/client.snd -- status parsing, content-length extraction,
// body splitting, and HTTP request building.

include "x86_64/linux/testing.snd"
include "x86_64/linux/bytes.snd"
include "any/webdav/client.snd"

// Compare a bytes buffer against a NUL-terminated cstr literal.
fn buf_eq_cstr(buf: i64, c: i64) -> i64 {
    let n = bytes_len(buf)
    let mut i = 0
    let mut ok = 1
    for {
        if i >= n { break }
        let bc = bytes_get(buf, i)
        let cc = peek8(c + i)
        if cc == 0 { break }
        if bc != cc { ok = 0 }
        i = i + 1
    }
    ok
}

// Compare two bytes buffers for equality.
fn buf_eq_buf(buf1: i64, buf2: i64) -> i64 {
    let n1 = bytes_len(buf1)
    let n2 = bytes_len(buf2)
    if n1 != n2 { return 0 }
    let mut i = 0
    let mut ok = 1
    for i < n1 invariant { i <= n1 } {
        if bytes_get(buf1, i) != bytes_get(buf2, i) { ok = 0 }
        i = i + 1
    }
    ok
}

// Build a mock HTTP response (headers-only) -- the body is empty after \r\n.
// The response always ends with a second \r\n, so we get headers\r\n\r\n.
// dav_response_body looks for \r\n\r\n and extracts the body after it.
fn mk_resp(status_buf: i64, headers_buf: i64) -> i64 {
    let r = bytes_new()
    bytes_append(r, status_buf)
    bytes_append_cstr(r, cstr("\r\n"))
    bytes_append(r, headers_buf)
    bytes_append_cstr(r, cstr("\r\n"))
    r
}

// Build a mock HTTP response with body.
fn mk_resp_body(status_buf: i64, headers_buf: i64, body_buf: i64) -> i64 {
    let r = bytes_new()
    bytes_append(r, status_buf)
    bytes_append_cstr(r, cstr("\r\n"))
    bytes_append(r, headers_buf)
    bytes_append_cstr(r, cstr("\r\n"))
    if bytes_len(body_buf) > 0 { bytes_append(r, body_buf) }
    r
}

// Make a GET-style request buffer.
fn mk_req_get(path_buf: i64) -> i64 {
    let r = bytes_new()
    bytes_append_cstr(r, cstr("GET "))
    bytes_append(r, path_buf)
    bytes_append_cstr(r, cstr(" HTTP/1.1\r\nHost: 127.0.0.1:80\r\nConnection: close\r\n\r\n"))
    r
}

// Make a PUT-style request buffer with body.
fn mk_req_put(path_buf: i64, body_buf: i64) -> i64 {
    let r = bytes_new()
    bytes_append_cstr(r, cstr("PUT "))
    bytes_append(r, path_buf)
    bytes_append_cstr(r, cstr(" HTTP/1.1\r\nHost: 127.0.0.1:80\r\nContent-Type: text/xml; charset=utf-8\r\nContent-Length: "))
    bytes_append_int(r, bytes_len(body_buf))
    bytes_append_cstr(r, cstr("\r\n\r\n"))
    bytes_append(r, body_buf)
    r
}

// Make a PROPFIND request buffer.
fn mk_req_propfind() -> i64 {
    let hdr = bytes_new()
    bytes_append_cstr(hdr, cstr("Depth: 0\r\n"))
    let body = xml_build_propfind_body(cstr("/"))
    bytes_append_cstr(hdr, cstr("\r\n"))
    let r = bytes_new()
    bytes_append_cstr(r, cstr("PROPFIND / HTTP/1.1\r\nHost: 127.0.0.1:80\r\nContent-Type: text/xml; charset=utf-8\r\n"))
    bytes_append(r, hdr)
    bytes_append_cstr(r, cstr("Content-Length: "))
    bytes_append_int(r, bytes_len(body))
    bytes_append_cstr(r, cstr("\r\n\r\n"))
    bytes_append(r, body)
    r
}

// Check byte at position in a request buffer.
fn check_req_at(buf: i64, pos: i64, want: i64) -> i64 {
    if pos >= bytes_len(buf) { return 0 }
    let actual = bytes_get(buf, pos)
    if actual == want { 1 } else { 0 }
}

// ── Real-socket round-trip helpers ───────────────────────────────────────
// Everything above only checks the SHAPE of a request built by hand; it never actually
// calls dav_connect/dav_build_request/dav_drain_response or any of the public dav_get/
// dav_put/... wrappers, which is why they used to sit at 0% coverage. The helpers below
// drive the real functions over an actual loopback TCP connection, so a real socket gets
// connected, a real request gets written and read back by a real (mock) peer, and a real
// response gets parsed. Top-level fns in a *_test.snd file are outside the coverage scope
// (see resolve_includes_scoped), so these don't inflate the number themselves.

// Bind and listen on 127.0.0.1:port. Returns the listening fd.
fn mock_listen(port: i64) -> i64 {
    let fd = sock(AF_INET, SOCK_STREAM, 0)
    set_reuseaddr(fd)
    let sa[2]
    sockaddr_in_build(sa, 0x7f000001, port)
    bind_sock(fd, sa, 16)
    listen_sock(fd, 1)
    fd
}

// Forks a one-shot mock server: accepts exactly one connection on `listen_fd`, copies
// whatever the client sent into `captured_wfd` (a pipe write end, so the parent can
// inspect the exact request bytes after the round-trip), then writes `resp_buf` (a bytes
// handle) verbatim and closes the connection -- closing is what lets dav_drain_response's
// read loop see EOF and return. Returns the child's pid; the caller must reap it.
//
// `captured_wfd` is a pipe write end created before fork(), so BOTH processes inherit a
// copy of it. Only the child ever writes to it, but the PARENT's copy also keeps the pipe
// open from the reader's point of view: unless the parent closes its own copy too, its
// later read on the read end blocks forever waiting for an EOF that never comes (the
// classic pipe/fork self-deadlock). So this closes captured_wfd in BOTH branches.
fn mock_serve_once(listen_fd: i64, resp_buf: i64, captured_wfd: i64) -> i64 {
    let pid = syscall(SYS_fork)
    if pid == 0 {
        let conn_fd = accept_sock(listen_fd, 0, 0)
        let drain[512]
        let n = read_buf(conn_fd, drain, 4096)
        if n > 0 {
            write_buf(captured_wfd, drain, n)
        }
        close_fd(captured_wfd)
        write_buf(conn_fd, peek64(resp_buf), bytes_len(resp_buf))
        close_fd(conn_fd)
        close_fd(listen_fd)
        syscall(SYS_exit, 0)
    }
    close_fd(captured_wfd)
    pid
}

fn reap_child(pid: i64) {
    let st[1]
    syscall(SYS_wait4, pid, st, 0, 0)
}

// Reads whatever a mock_serve_once child captured (up to 4096 bytes) from the pipe's read
// end into a fresh bytes buffer, and closes the read end.
fn read_captured(caprfd: i64) -> i64 {
    let cbuf[512]
    let n = read_buf(caprfd, cbuf, 4096)
    close_fd(caprfd)
    if n <= 0 { return bytes_new() }
    bytes_from_raw(cbuf, n)
}

