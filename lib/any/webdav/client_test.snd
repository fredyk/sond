test "dav_response_status: 200 OK" {
    let buf = bytes_new()
    bytes_append_cstr(buf, cstr("HTTP/1.1 200 OK\r\n"))
    assert_eq(dav_response_status(buf), 200)
}

test "dav_response_status: 207 Multi-Status" {
    let buf = bytes_new()
    bytes_append_cstr(buf, cstr("HTTP/1.1 207 Multi-Status\r\n"))
    assert_eq(dav_response_status(buf), 207)
}

test "dav_response_status: 404" {
    let buf = bytes_new()
    bytes_append_cstr(buf, cstr("HTTP/1.1 404 Not Found\r\n"))
    assert_eq(dav_response_status(buf), 404)
}

test "dav_response_status: 500" {
    let buf = bytes_new()
    bytes_append_cstr(buf, cstr("HTTP/1.1 500 Internal Server Error\r\n"))
    assert_eq(dav_response_status(buf), 500)
}

