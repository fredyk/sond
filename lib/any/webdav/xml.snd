//
// lib/any/webdav/xml.snd: minimal XML builder and parser for WebDAV multistatus bodies.
// Only the elements used by PROPFIND 207 are covered:
//   multistatus, response, href, propstat, prop, resourcetype (collection),
//   getcontentlength, getlastmodified, displayname, lockdiscovery, lockinfo.
//
// Design: all values are byte buffers (i64 handles).  The DAV: namespace is
// implicit.  Multi-result parsers write into a delimited output buffer; the
// caller splits on NUL bytes.

include "x86_64/linux/bytes.snd"
include "any/strings.snd"

// ── XML tag builders ────────────────────────────────────────────────────

// Append <name>value</name> to buf.  Returns buf.
pub fn xml_element(buf: i64, name: i64, value: i64) {
    bytes_push(buf, 60)                           // <
    bytes_append_cstr(buf, name)
    bytes_push(buf, 62)                           // >
    bytes_append_cstr(buf, value)
    bytes_push(buf, 60)                           // <
    bytes_push(buf, 47)                           // /
    bytes_append_cstr(buf, name)
    bytes_push(buf, 62)                           // >
}

// <name/> self-closing tag.
pub fn xml_elem_self(buf: i64, name: i64) {
    bytes_push(buf, 60)                           // <
    bytes_append_cstr(buf, name)
    bytes_push(buf, 47)                           // /
    bytes_push(buf, 62)                           // >
}

// ── WebDAV multistatus element builders ─────────────────────────────────

