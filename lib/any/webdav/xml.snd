// ── XML parsers ─────────────────────────────────────────────────────────

// Compare the first `n` bytes of src (at from) against a NUL-terminated cstr.
fn bytes_prefix_eq(src: i64, from: i64, cstr_ref: i64, n: i64) -> i64 {
    let mut i = 0
    for i < n {
        if bytes_get(src, from + i) != peek8(cstr_ref + i) { return 0 }
        i = i + 1
    }
    1
}

// Find an opening tag <name> in buf starting at `from`, matching tag_text chars.
// Skips whitespace after the name to find '>'.
fn xml_find_open_tag(buf: i64, tag_text: i64, from: i64) -> i64 {
    let mut i = from
    let n = bytes_len(buf)
    for {
        if i >= n { return -1 }
        if bytes_get(buf, i) == 60 {  // '<'
            let mut j = 0
            for {
                let tc = peek8(tag_text + j)
                if tc == 0 { break }
                if bytes_get(buf, i + 1 + j) != tc { break }
                j = j + 1
            }
            if peek8(tag_text + j) == 0 {  // all chars matched
                let __f0_137: string = "<res"
                let __f1_137: string = "response"
                // Verify next byte is NOT a letter (prevents __f0_137.utf8 matching __f1_137.utf8)
                let next_at = i + 1 + j
                let next_c = if next_at < n { bytes_get(buf, next_at) } else { 0 }
                let in_name = if next_c >= 97 && next_c <= 122 { 1 } else { 0 }  // a-z
                let in_name2 = if next_c >= 65 && next_c <= 90 { 1 } else { 0 }  // A-Z
                let in_name3 = if next_c >= 48 && next_c <= 57 { 1 } else { 0 }  // 0-9
                if in_name == 0 && in_name2 == 0 && in_name3 == 0 {
                    // Skip everything until we find '>' (handles attributes like xmlns="...")
                    let mut k = next_at
                    for {
                        if k >= n { break }
                        if bytes_get(buf, k) == 62 { return i }  // '>'
                        k = k + 1
                    }
                }
            }
        }
        i = i + 1
    }
}

// Find closing tag </name> starting at `from`.
fn xml_find_close_tag(buf: i64, tag_text: i64, from: i64) -> i64 {
    let mut i = from
    let n = bytes_len(buf)
    for {
        if i >= n { return -1 }
        if i + 1 < n && bytes_get(buf, i) == 60 && bytes_get(buf, i + 1) == 47 {  // '</'
            let mut j = 0
            for {
                let tc = peek8(tag_text + j)
                if tc == 0 { break }
                if bytes_get(buf, i + 2 + j) != tc { break }
                j = j + 1
            }
            if peek8(tag_text + j) == 0 {
                let gt_pos = i + 2 + j
                if gt_pos < n && bytes_get(buf, gt_pos) == 62 { return i }
            }
        }
        i = i + 1
    }
}

// Find self-closing tag <name/> starting at `from`.
fn xml_find_selfc_tag(buf: i64, tag_text: i64, from: i64) -> i64 {
    let mut i = from
    let n = bytes_len(buf)
    for {
        if i >= n { return -1 }
        if bytes_get(buf, i) == 60 {  // '<'
            let mut j = 0
            for {
                let tc = peek8(tag_text + j)
                if tc == 0 { break }
                if bytes_get(buf, i + 1 + j) != tc { break }
                j = j + 1
            }
            if peek8(tag_text + j) == 0 {  // name matched
                let slash_pos = i + 1 + j
                let gt_pos = i + 2 + j
                if slash_pos < n && gt_pos < n && bytes_get(buf, slash_pos) == 47 && bytes_get(buf, gt_pos) == 62 { return i }
            }
        }
        i = i + 1
    }
}

pub fn xml_get_tag_content(buf: i64, tag: i64, from: i64) -> i64 {
    let open_pos = xml_find_open_tag(buf, tag, from)
    if open_pos == -1 { return bytes_new() }
    // Find '>' after the tag name (skipping whitespace/attributes)
    let mut gt_pos = open_pos + 1
    for {
        if gt_pos >= bytes_len(buf) { return bytes_new() }
        if bytes_get(buf, gt_pos) == 62 { break }  // '>'
        gt_pos = gt_pos + 1
    }
    let content_start = gt_pos + 1
    let close_pos = xml_find_close_tag(buf, tag, content_start)
    if close_pos == -1 { return bytes_new() }
    if close_pos > content_start { return bytes_slice(buf, content_start, close_pos) }
    bytes_new()
}

pub fn xml_has_tag(buf: i64, tag: i64, from: i64) -> i64 {
    let pos = xml_find_selfc_tag(buf, tag, from)
    if pos >= 0 { 1 } else { 0 }
}

pub fn xml_extract_hrefs(out: i64, base: i64, buf: i64) -> i64 {
    let mut count = 0
    let mut search_from = 0
    for {
        let __s0_231: string = "href"
        let href_content = xml_get_tag_content(buf, __s0_231.utf8, search_from)
        if bytes_len(href_content) == 0 { break }
        let fb = if bytes_len(href_content) > 0 { bytes_get(href_content, 0) } else { -1 }
        // Prepend base if href doesn't start with '/'
        let mut prepend_base = 0
        if fb != 47 {
            prepend_base = 1
        }
        if prepend_base != 0 && bytes_len(base) > 0 {
            let combined = bytes_new()
            bytes_append_cstr(combined, base)
            bytes_append(combined, href_content)
            bytes_append(out, combined)
        } else {
            bytes_append(out, href_content)
        }
        bytes_push(out, 0); bytes_push(out, 10)
        count = count + 1
        let __lit24: string = "response"
        search_from = xml_find_open_tag(buf, __lit24.utf8, search_from + 1)
        if search_from == -1 { break }
    }
    count
}

pub fn xml_count_responses(buf: i64) -> i64 {
    let mut count = 0
    let mut from = 0
    for {
        let __s0_261: string = "response"
        let pos = xml_find_open_tag(buf, __s0_261.utf8, from)
        if pos == -1 { break }
        count = count + 1
        from = pos + 1
    }
    count
}

