// SPDX-License-Identifier: Apache-2.0
// Copyright 2026 Jhon Magdalena Vila and the Sond contributors
//
// Tests for lib/any/webdav/server.snd -- file tree operations and request handling.
//
// Note on style: this file defines NO top-level helper `fn`, only `test` blocks. A test
// file with its own free functions would shift the coverage scope to those helpers instead
// of the included library (see resolve_includes_scoped), so every check here is written
// inline, using the library's own primitives (bytes_eq, bytes_slice, bytes_index_of, ...)
// as the comparison tools. That also gives those primitives real exercise.
//
// The `dav_handle`/`server_*` tests drive the handler over a real pipe (write end plays the
// socket fd, read end plays the client) and check the exact bytes sent back against RFC 4918:
// status line, DAV compliance header, and (for PROPFIND) the 207 Multi-Status body shape
// (href/displayname/resourcetype/getcontentlength per response element).

include "x86_64/linux/testing.snd"
include "x86_64/linux/bytes.snd"
include "any/webdav/server.snd"

// ── dav_file_tree low-level tests ──────────────────────────────────────────

test "dav_init_file_tree: creates empty tree" {
    dav_init_file_tree()
    let tree = dav_file_tree
    let len = bytes_len(tree)
    assert_eq(len, 0)
}

test "dav_add_entry: adds entry to tree" {
    dav_init_file_tree()
    let name = bytes_from_cstr("testfile")
    dav_add_entry(name, 42, 0)
    let len = bytes_len(dav_file_tree)
    assert(len > 0)
}

test "dav_add_entry: collection entry" {
    dav_init_file_tree()
    let name = bytes_from_cstr("mydir")
    dav_add_entry(name, 0, 1)
    let len = bytes_len(dav_file_tree)
    assert(len > 0)
}

test "dav_add_entry: multiple entries" {
    dav_init_file_tree()
    let name1 = bytes_from_cstr("file1")
    dav_add_entry(name1, 100, 0)
    let name2 = bytes_from_cstr("file2")
    dav_add_entry(name2, 200, 0)
    let name3 = bytes_from_cstr("dir")
    dav_add_entry(name3, 0, 1)
    let len = bytes_len(dav_file_tree)
    assert(len > 10)  // at least 3 entries
}

test "dav_read_entry: reads first entry" {
    dav_init_file_tree()
    let name = bytes_from_cstr("hello")
    dav_add_entry(name, 55, 0)
    let out = bytes_new()
    let next_off = dav_read_entry(0, out)
    assert(next_off > 0)
    let len = bytes_len(out)
    assert_eq(len, 5)  // "hello" = 5 bytes
}

test "dav_read_entry: reads second entry" {
    dav_init_file_tree()
    let name1 = bytes_from_cstr("first")
    dav_add_entry(name1, 10, 0)
    let name2 = bytes_from_cstr("second")
    dav_add_entry(name2, 20, 1)
    // Read first entry
    let out1 = bytes_new()
    let off1 = dav_read_entry(0, out1)
    assert(off1 > 0)
    // Read second entry
    let out2 = bytes_new()
    let off2 = dav_read_entry(off1, out2)
    assert(off2 > 0)
    let len2 = bytes_len(out2)
    assert_eq(len2, 6)  // "second" = 6 bytes
}

test "dav_read_entry: returns -1 at end" {
    dav_init_file_tree()
    let name = bytes_from_cstr("only")
    dav_add_entry(name, 1, 0)
    let out = bytes_new()
    let off1 = dav_read_entry(0, out)
    assert(off1 > 0)
    let off2 = dav_read_entry(off1, out)
    assert_eq(off2, -1)
}

test "dav_read_entry: empty tree" {
    dav_init_file_tree()
    let out = bytes_new()
    let off = dav_read_entry(0, out)
    assert_eq(off, -1)
}

test "dav_read_entry: long name" {
    dav_init_file_tree()
    let name = bytes_from_cstr("averylongfilenamethatislongerthanusual")
    dav_add_entry(name, 999, 0)
    let out = bytes_new()
    let off = dav_read_entry(0, out)
    assert(off > 0)
    let len = bytes_len(out)
    assert_eq(len, 38)  // "averylongfilenamethatislongerthanusual" = 38
}

test "dav_read_entry: size 0" {
    dav_init_file_tree()
    let name = bytes_from_cstr("empty")
    dav_add_entry(name, 0, 1)
    let out = bytes_new()
    let off = dav_read_entry(0, out)
    assert(off > 0)
    assert_eq(bytes_len(out), 5)  // "empty"
}

test "dav_read_entry: three entries" {
    dav_init_file_tree()
    let n1 = bytes_from_cstr("a")
    dav_add_entry(n1, 1, 0)
    let n2 = bytes_from_cstr("b")
    dav_add_entry(n2, 2, 0)
    let n3 = bytes_from_cstr("c")
    dav_add_entry(n3, 3, 0)
    let o1 = bytes_new()
    let o2 = bytes_new()
    let o3 = bytes_new()
    let off1 = dav_read_entry(0, o1)
    assert(off1 > 0)
    let off2 = dav_read_entry(off1, o2)
    assert(off2 > 0)
    let off3 = dav_read_entry(off2, o3)
    assert(off3 > 0)
    assert_eq(bytes_len(o1), 1)  // a
    assert_eq(bytes_len(o2), 1)  // b
    assert_eq(bytes_len(o3), 1)  // c
}

// ── dav_read_entry: malformed tree defensive branches ─────────────────────
// dav_file_tree is a plain module global, so a corrupted/truncated buffer is a real
// scenario (a crash mid-write, a bad manual poke) and dav_read_entry must fail safe
// (-1) instead of reading out of bounds.

test "dav_read_entry: name never NUL-terminated returns -1" {
    dav_init_file_tree()
    bytes_push(dav_file_tree, 97)  // 'a', buffer ends before any NUL
    let out = bytes_new()
    let off = dav_read_entry(0, out)
    assert_eq(off, -1)
}

test "dav_read_entry: buffer truncated right after the name returns -1" {
    dav_init_file_tree()
    bytes_push(dav_file_tree, 97)  // 'a'
    bytes_push(dav_file_tree, 0)   // NUL ends the name; nothing else follows
    let out = bytes_new()
    let off = dav_read_entry(0, out)
    assert_eq(off, -1)
}

test "dav_read_entry: missing terminating NUL returns -1" {
    dav_init_file_tree()
    bytes_push(dav_file_tree, 97)  // 'a'
    bytes_push(dav_file_tree, 0)   // NUL ends the name
    bytes_push(dav_file_tree, 48)  // size "001"
    bytes_push(dav_file_tree, 48)
    bytes_push(dav_file_tree, 49)
    bytes_push(dav_file_tree, 48)  // is_col digit '0'
    bytes_push(dav_file_tree, 88)  // 'X' where the terminating NUL is expected
    let out = bytes_new()
    let off = dav_read_entry(0, out)
    assert_eq(off, -1)
}

test "dav_read_entry: missing is_col digit still advances past the entry" {
    dav_init_file_tree()
    bytes_push(dav_file_tree, 98)  // 'b'
    bytes_push(dav_file_tree, 0)   // NUL ends the name
    bytes_push(dav_file_tree, 48)  // size "002"
    bytes_push(dav_file_tree, 48)
    bytes_push(dav_file_tree, 50)
    bytes_push(dav_file_tree, 0)   // no is_col digit: the terminating NUL right away
    let out = bytes_new()
    let off = dav_read_entry(0, out)
    assert_eq(off, 6)
    assert_eq(bytes_len(out), 1)  // "b"
}

// ── method_starts_with ─────────────────────────────────────────────────────

test "method_starts_with: OPTIONS match" {
    let buf = bytes_from_cstr("OPTIONS")
    assert_eq(method_starts_with(buf, "OPTIONS"), 1)
}

test "method_starts_with: PROPFIND match" {
    let buf = bytes_from_cstr("PROPFIND")
    assert_eq(method_starts_with(buf, "PROPFIND"), 1)
}

test "method_starts_with: no match" {
    let buf = bytes_from_cstr("GET")
    assert_eq(method_starts_with(buf, "POST"), 0)
}

test "method_starts_with: partial match" {
    let buf = bytes_from_cstr("PROPFIND")
    assert_eq(method_starts_with(buf, "PROP"), 1)
}

test "method_starts_with: short buffer no match" {
    let buf = bytes_from_cstr("G")
    assert_eq(method_starts_with(buf, "GET"), 0)
}

// ── dav_add_entry: encoding details ────────────────────────────────────────

test "dav_add_entry: verify size encoding" {
    dav_init_file_tree()
    let name = bytes_from_cstr("bigfile")
    dav_add_entry(name, 999, 0)
    let len = bytes_len(dav_file_tree)
    assert(len > 10)
}

test "dav_add_entry: verify collection flag" {
    dav_init_file_tree()
    let name = bytes_from_cstr("directory")
    dav_add_entry(name, 0, 1)
    let len = bytes_len(dav_file_tree)
    assert(len > 0)
}

test "dav_read_entry: size 999" {
    dav_init_file_tree()
    let name = bytes_from_cstr("big")
    dav_add_entry(name, 999, 0)
    let out = bytes_new()
    let off = dav_read_entry(0, out)
    assert(off > 0)
    // Read next entry (should be -1 since only one entry)
    let off2 = dav_read_entry(off, out)
    assert_eq(off2, -1)
}

test "dav_read_entry: entry after multiple adds" {
    dav_init_file_tree()
    let name1 = bytes_from_cstr("x")
    dav_add_entry(name1, 50, 0)
    let name2 = bytes_from_cstr("y")
    dav_add_entry(name2, 75, 1)
    let out1 = bytes_new()
    let out2 = bytes_new()
    let off1 = dav_read_entry(0, out1)
    assert_eq(bytes_len(out1), 1)  // x
    let off2 = dav_read_entry(off1, out2)
    assert_eq(bytes_len(out2), 1)  // y
    let off3 = dav_read_entry(off2, out2)
    assert_eq(off3, -1)
}

// ── bytes.snd primitives, used directly as the assertion tools below ──────

test "bytes_eq: equal buffers" {
    let a = bytes_from_cstr("webdav")
    let b = bytes_from_cstr("webdav")
    assert_eq(bytes_eq(a, b), 1)
}

test "bytes_eq: different length" {
    let a = bytes_from_cstr("webdav")
    let b = bytes_from_cstr("web")
    assert_eq(bytes_eq(a, b), 0)
}

test "bytes_eq: same length different content" {
    let a = bytes_from_cstr("PROPFIND")
    let b = bytes_from_cstr("PROPFINE")
    assert_eq(bytes_eq(a, b), 0)
}

test "bytes_index_of: found and not found" {
    let a = bytes_from_cstr("HTTP/1.1 200 OK")
    assert_eq(bytes_index_of(a, 32), 8)   // first space
    assert_eq(bytes_index_of(a, 63), -1)  // '?' not present
}

test "bytes_index_of_from: skips earlier occurrences" {
    let a = bytes_from_cstr("a,b,c")
    assert_eq(bytes_index_of_from(a, 44, 0), 1)
    assert_eq(bytes_index_of_from(a, 44, 2), 3)
    assert_eq(bytes_index_of_from(a, 44, 4), -1)
}

test "bytes_slice: middle range and empty range" {
    let a = bytes_from_cstr("multistatus")
    let mid = bytes_slice(a, 5, 11)
    assert_eq(bytes_eq(mid, bytes_from_cstr("status")), 1)
    let empty = bytes_slice(a, 3, 3)
    assert_eq(bytes_len(empty), 0)
}

test "bytes_append_int: zero and multi-digit" {
    let b0 = bytes_new()
    bytes_append_int(b0, 0)
    assert_eq(bytes_eq(b0, bytes_from_cstr("0")), 1)
    let b1 = bytes_new()
    bytes_append_int(b1, 1234)
    assert_eq(bytes_eq(b1, bytes_from_cstr("1234")), 1)
}

test "bytes_from_raw: copies exactly n bytes from a raw pointer" {
    let src = "raw-bytes"
    let b = bytes_from_raw(src, 3)
    assert_eq(bytes_len(b), 3)
    assert_eq(bytes_eq(b, bytes_from_cstr("raw")), 1)
}

// ── OPTIONS: RFC 4918 §9.1 class 1/2 compliance header ─────────────────────

test "dav_handle: OPTIONS announces DAV 1,2 with an empty 200 body" {
    let fds[1]
    syscall(SYS_pipe, fds)
    let rfd = peek32(fds + 0)
    let wfd = peek32(fds + 4)
    let req = bytes_from_cstr("OPTIONS / HTTP/1.1\r\nHost: 127.0.0.1\r\n\r\n")
    dav_handle(wfd, req)
    close_fd(wfd)
    let buf[512]
    let n = read_buf(rfd, buf, 4096)
    close_fd(rfd)
    let resp = bytes_from_raw(buf, n)
    let want = bytes_from_cstr("HTTP/1.1 200 OK\r\nDAV: 1,2\r\nContent-Length: 0\r\nConnection: keep-alive\r\n\r\n")
    assert_eq(bytes_eq(resp, want), 1)
}

// ── PROPFIND: 207 Multi-Status body shape ───────────────────────────────────

test "dav_handle: PROPFIND on an empty tree returns an empty 207 multistatus" {
    dav_init_file_tree()
    let fds[1]
    syscall(SYS_pipe, fds)
    let rfd = peek32(fds + 0)
    let wfd = peek32(fds + 4)
    let req = bytes_from_cstr("PROPFIND / HTTP/1.1\r\nHost: 127.0.0.1\r\nDepth: 1\r\n\r\n")
    dav_handle(wfd, req)
    close_fd(wfd)
    let buf[512]
    let n = read_buf(rfd, buf, 4096)
    close_fd(rfd)
    let resp = bytes_from_raw(buf, n)
    let status_line = bytes_slice(resp, 0, 25)
    assert_eq(bytes_eq(status_line, bytes_from_cstr("HTTP/1.1 207 Multi-Status")), 1)
    assert(xml_find_open_tag(resp, "multistatus", 0) >= 0)
    assert_eq(xml_count_responses(resp), 0)
}

test "dav_handle: PROPFIND on a non-empty tree returns 207 with a response element" {
    dav_init_file_tree()
    let fname = bytes_from_cstr("report.txt")
    dav_add_entry(fname, 123, 0)
    let dname = bytes_from_cstr("archive")
    dav_add_entry(dname, 0, 1)

    let fds[1]
    syscall(SYS_pipe, fds)
    let rfd = peek32(fds + 0)
    let wfd = peek32(fds + 4)
    let req = bytes_from_cstr("PROPFIND / HTTP/1.1\r\nHost: 127.0.0.1\r\nDepth: 1\r\n\r\n")
    dav_handle(wfd, req)
    close_fd(wfd)
    let buf[512]
    let n = read_buf(rfd, buf, 4096)
    close_fd(rfd)
    let resp = bytes_from_raw(buf, n)

    let status_line = bytes_slice(resp, 0, 25)
    assert_eq(bytes_eq(status_line, bytes_from_cstr("HTTP/1.1 207 Multi-Status")), 1)
    assert(xml_find_open_tag(resp, "multistatus", 0) >= 0)
    assert(xml_count_responses(resp) >= 1)
}

// server_build_multistatus used to advance its per-entry cursor by `off + dn_i` right
// after reading a name, which lands ON the entry's NUL terminator instead of past it.
// That desyncs the walk over dav_file_tree for every entry after the first: the size and
// collection-flag digits of entry N get re-read as the START of a garbage "name" for a
// phantom entry, so a 2-entry tree produced 3 <response> elements with corrupted
// href/displayname text. This test pins the CORRECT byte-for-byte shape: exactly one
// <response> per real entry, with the exact href, displayname, size and collection flag
// that were written via dav_add_entry.
test "dav_handle: PROPFIND on a two-entry tree returns exactly one response per entry with correct fields" {
    dav_init_file_tree()
    let fname = bytes_from_cstr("report.txt")
    dav_add_entry(fname, 123, 0)
    let dname = bytes_from_cstr("archive")
    dav_add_entry(dname, 0, 1)

    let fds[1]
    syscall(SYS_pipe, fds)
    let rfd = peek32(fds + 0)
    let wfd = peek32(fds + 4)
    let req = bytes_from_cstr("PROPFIND / HTTP/1.1\r\nHost: 127.0.0.1\r\nDepth: 1\r\n\r\n")
    dav_handle(wfd, req)
    close_fd(wfd)
    let buf[512]
    let n = read_buf(rfd, buf, 4096)
    close_fd(rfd)
    let resp = bytes_from_raw(buf, n)

    // Exactly one <response> per real entry: no phantom third entry from the desync.
    assert_eq(xml_count_responses(resp), 2)

    let pos1 = xml_find_open_tag(resp, "response", 0)
    assert(pos1 >= 0)
    let href1 = xml_get_tag_content(resp, "href", pos1)
    assert_eq(bytes_eq(href1, bytes_from_cstr("/report.txt")), 1)
    let dn1 = xml_get_tag_content(resp, "displayname", pos1)
    assert_eq(bytes_eq(dn1, bytes_from_cstr("report.txt")), 1)
    let cl1 = xml_get_tag_content(resp, "getcontentlength", pos1)
    assert_eq(bytes_eq(cl1, bytes_from_cstr("123")), 1)

    let pos2 = xml_find_open_tag(resp, "response", pos1 + 1)
    assert(pos2 >= 0)
    // report.txt is not a collection: no <collection/> tag before the second response.
    let coll_pos1 = xml_find_open_tag(resp, "collection", pos1)
    let has_coll1 = if coll_pos1 >= 0 && coll_pos1 < pos2 { 1 } else { 0 }
    assert_eq(has_coll1, 0)
    let href2 = xml_get_tag_content(resp, "href", pos2)
    assert_eq(bytes_eq(href2, bytes_from_cstr("/archive")), 1)
    let dn2 = xml_get_tag_content(resp, "displayname", pos2)
    assert_eq(bytes_eq(dn2, bytes_from_cstr("archive")), 1)
    // archive IS a collection: it must carry the <collection/> tag.
    assert_eq(xml_has_tag(resp, "collection", pos2), 1)

    // No third response left over after the second real entry.
    let pos3 = xml_find_open_tag(resp, "response", pos2 + 1)
    assert_eq(pos3, -1)
}

// ── MKCOL / DELETE ──────────────────────────────────────────────────────────

test "dav_handle: MKCOL creates a collection, 201" {
    let fds[1]
    syscall(SYS_pipe, fds)
    let rfd = peek32(fds + 0)
    let wfd = peek32(fds + 4)
    let req = bytes_from_cstr("MKCOL /newdir HTTP/1.1\r\nHost: 127.0.0.1\r\n\r\n")
    dav_handle(wfd, req)
    close_fd(wfd)
    let buf[512]
    let n = read_buf(rfd, buf, 4096)
    close_fd(rfd)
    let resp = bytes_from_raw(buf, n)
    assert_eq(bytes_eq(resp, bytes_from_cstr("HTTP/1.1 201 Created\r\nContent-Length: 0\r\n\r\n")), 1)
}

test "dav_handle: DELETE removes a resource, 204" {
    let fds[1]
    syscall(SYS_pipe, fds)
    let rfd = peek32(fds + 0)
    let wfd = peek32(fds + 4)
    let req = bytes_from_cstr("DELETE /report.txt HTTP/1.1\r\nHost: 127.0.0.1\r\n\r\n")
    dav_handle(wfd, req)
    close_fd(wfd)
    let buf[512]
    let n = read_buf(rfd, buf, 4096)
    close_fd(rfd)
    let resp = bytes_from_raw(buf, n)
    assert_eq(bytes_eq(resp, bytes_from_cstr("HTTP/1.1 204 No Content\r\nContent-Length: 0\r\n\r\n")), 1)
}

// ── PUT ──────────────────────────────────────────────────────────────────

test "dav_handle: PUT with a body and Content-Length returns 201" {
    let fds[1]
    syscall(SYS_pipe, fds)
    let rfd = peek32(fds + 0)
    let wfd = peek32(fds + 4)
    let req = bytes_from_cstr("PUT /newfile.txt HTTP/1.1\r\nHost: 127.0.0.1\r\nContent-Length: 11\r\n\r\nhello world")
    dav_handle(wfd, req)
    close_fd(wfd)
    let buf[512]
    let n = read_buf(rfd, buf, 4096)
    close_fd(rfd)
    let resp = bytes_from_raw(buf, n)
    assert_eq(bytes_eq(resp, bytes_from_cstr("HTTP/1.1 201 Created\r\nContent-Length: 0\r\n\r\n")), 1)
}

test "dav_handle: PUT with no Content-Length header still returns 201" {
    let fds[1]
    syscall(SYS_pipe, fds)
    let rfd = peek32(fds + 0)
    let wfd = peek32(fds + 4)
    let req = bytes_from_cstr("PUT /empty.txt HTTP/1.1\r\nHost: 127.0.0.1\r\n\r\n")
    dav_handle(wfd, req)
    close_fd(wfd)
    let buf[512]
    let n = read_buf(rfd, buf, 4096)
    close_fd(rfd)
    let resp = bytes_from_raw(buf, n)
    assert_eq(bytes_eq(resp, bytes_from_cstr("HTTP/1.1 201 Created\r\nContent-Length: 0\r\n\r\n")), 1)
}

test "dav_handle: PUT with a Content-Length over 2048 still drains and returns 201" {
    let fds[1]
    syscall(SYS_pipe, fds)
    let rfd = peek32(fds + 0)
    let wfd = peek32(fds + 4)
    let req = bytes_from_cstr("PUT /big.bin HTTP/1.1\r\nHost: 127.0.0.1\r\nContent-Length: 5000\r\n\r\n")
    dav_handle(wfd, req)
    close_fd(wfd)
    let buf[512]
    let n = read_buf(rfd, buf, 4096)
    close_fd(rfd)
    let resp = bytes_from_raw(buf, n)
    assert_eq(bytes_eq(resp, bytes_from_cstr("HTTP/1.1 201 Created\r\nContent-Length: 0\r\n\r\n")), 1)
}

// ── GET (no real file serving in this stub) and unrecognized methods ──────

test "dav_handle: GET returns 404 Not Found" {
    let fds[1]
    syscall(SYS_pipe, fds)
    let rfd = peek32(fds + 0)
    let wfd = peek32(fds + 4)
    let req = bytes_from_cstr("GET /report.txt HTTP/1.1\r\nHost: 127.0.0.1\r\n\r\n")
    dav_handle(wfd, req)
    close_fd(wfd)
    let buf[512]
    let n = read_buf(rfd, buf, 4096)
    close_fd(rfd)
    let resp = bytes_from_raw(buf, n)
    assert_eq(bytes_eq(resp, bytes_from_cstr("HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\n\r\n")), 1)
}

test "dav_handle: an unimplemented method returns 501 Not Implemented" {
    let fds[1]
    syscall(SYS_pipe, fds)
    let rfd = peek32(fds + 0)
    let wfd = peek32(fds + 4)
    let req = bytes_from_cstr("PATCH /report.txt HTTP/1.1\r\nHost: 127.0.0.1\r\n\r\n")
    dav_handle(wfd, req)
    close_fd(wfd)
    let buf[512]
    let n = read_buf(rfd, buf, 4096)
    close_fd(rfd)
    let resp = bytes_from_raw(buf, n)
    assert_eq(bytes_eq(resp, bytes_from_cstr("HTTP/1.1 501 Not Implemented\r\nContent-Length: 0\r\n\r\n")), 1)
}

// ── server_get_put: only reachable directly, dav_handle never calls it ────
// (dav_handle dispatches PUT itself and GET via server_send_status; server_get_put
// is a separate combined handler kept for callers that want one entry point).

test "server_get_put: PUT branch responds 201 Created" {
    let fds[1]
    syscall(SYS_pipe, fds)
    let rfd = peek32(fds + 0)
    let wfd = peek32(fds + 4)
    server_get_put(wfd, 1)
    close_fd(wfd)
    let buf[512]
    let n = read_buf(rfd, buf, 4096)
    close_fd(rfd)
    let resp = bytes_from_raw(buf, n)
    assert_eq(bytes_eq(resp, bytes_from_cstr("HTTP/1.1 201 Created\r\nContent-Length: 0\r\n\r\n")), 1)
}

test "server_get_put: GET branch responds 404 Not Found" {
    let fds[1]
    syscall(SYS_pipe, fds)
    let rfd = peek32(fds + 0)
    let wfd = peek32(fds + 4)
    server_get_put(wfd, 0)
    close_fd(wfd)
    let buf[512]
    let n = read_buf(rfd, buf, 4096)
    close_fd(rfd)
    let resp = bytes_from_raw(buf, n)
    assert_eq(bytes_eq(resp, bytes_from_cstr("HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\n\r\n")), 1)
}

// ── server_send_status, called directly with an arbitrary status ──────────

test "server_send_status: writes an exact bodyless status response" {
    let fds[1]
    syscall(SYS_pipe, fds)
    let rfd = peek32(fds + 0)
    let wfd = peek32(fds + 4)
    server_send_status(wfd, "403 Forbidden")
    close_fd(wfd)
    let buf[512]
    let n = read_buf(rfd, buf, 4096)
    close_fd(rfd)
    let resp = bytes_from_raw(buf, n)
    assert_eq(bytes_eq(resp, bytes_from_cstr("HTTP/1.1 403 Forbidden\r\nContent-Length: 0\r\n\r\n")), 1)
}
