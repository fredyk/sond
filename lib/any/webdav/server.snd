//
// lib/any/webdav/server.snd: WebDAV server handler on top of http-server.snd.
// In-memory file tree supporting OPTIONS, PROPFIND, GET, PUT, MKCOL, DELETE.
//
// Usage: in your accept loop:
//   include "x86_64/linux/http-server.snd"
//   include "any/webdav/server.snd"
//   ...
//     let reqn = read_buf(afd, reqbuf, 8192)
//     if reqn > 0 { dav_handle(afd, bytes_from_raw(reqbuf, reqn)) }
//     http_finish(afd)

include "x86_64/linux/io.snd"
include "x86_64/linux/http-server.snd"
include "any/webdav/xml.snd"
include "any/strings.snd"

// ── In-memory file tree ─────────────────────────────────────────────────

// dav_file_tree: bytes handle holding NUL-separated entries.
// Format: name[0]\x00size1\x00size2\x00size3\x00is_col\x00...\x00
pub let mut dav_file_tree: i64 = 0

// Initialize an empty file tree. Call once at startup.
pub fn dav_init_file_tree() {
    dav_file_tree = bytes_new()
}

// Add an entry to the virtual file tree.
pub fn dav_add_entry(name: i64, size: i64, is_col: i64) {
    let mut i = 0
    let n = bytes_len(name)
    for i < n invariant { i <= n } {
        bytes_push(dav_file_tree, bytes_get(name, i))
        i = i + 1
    }
    bytes_push(dav_file_tree, 0)
    let s100 = size / 100
    let s10 = (size % 100) / 10
    let s1 = size % 10
    bytes_push(dav_file_tree, 48 + (s100 % 10))
    bytes_push(dav_file_tree, 48 + (s10 % 10))
    bytes_push(dav_file_tree, 48 + (s1 % 10))
    let ic = if is_col != 0 { 1 } else { 0 }
    bytes_push(dav_file_tree, 48 + ic)
    bytes_push(dav_file_tree, 0)
}

// Read one entry from dav_file_tree at `off` position.
// Writes displayname to `out` (first bytes, up to NUL) and returns the next offset.
// Returns -1 if no more entries.
fn dav_read_entry(off: i64, out: i64) -> i64 {
    let n = bytes_len(dav_file_tree)
    if off >= n { return -1 }
    // Read name until NUL
    let mut cur = off
    for {
        if cur >= n { return -1 }
        let c = bytes_get(dav_file_tree, cur)
        if c == 0 { break }  // found NUL, stop reading name
        bytes_push(out, c)
        cur = cur + 1
    }
    // cur now points at NUL after name
    cur = cur + 1  // skip NUL

    // Read 3-digit size (if available)
    let mut i = 0
    for i < 3 {
        if cur + i >= n { break }
        let c = bytes_get(dav_file_tree, cur + i)
        if c < 48 || c > 57 { break }
        i = i + 1
    }
    cur = cur + i  // skip size digits

    // Read is_col (one digit, then NUL)
    if cur >= n { return -1 }
    if bytes_get(dav_file_tree, cur) != 0 {
        cur = cur + 1  // skip is_col digit
    }
    if cur >= n { return -1 }
    if bytes_get(dav_file_tree, cur) != 0 { return -1 }  // expected NUL
    cur = cur + 1  // skip NUL
    cur
}

// ── HTTP helpers ─────────────────────────────────────────────────────────

// Send a bodyless HTTP status.
fn server_send_status(afd: i64, status: i64) {
    let body = bytes_new()
    let resp = http_response(status, body)
    write_buf(afd, peek64(resp), bytes_len(resp))
}

// ── Method matching helper ───────────────────────────────────────────────

// Check if method buffer starts with the given cstr prefix.
fn method_starts_with(buf: i64, prefix: i64) -> i64 {
    let buf_n = bytes_len(buf)
    let pre_n = strlen(prefix)
    if buf_n < pre_n { return 0 }
    let mut i = 0
    for i < pre_n invariant { i <= pre_n } {
        if bytes_get(buf, i) != peek8(prefix + i) { return 0 }
        i = i + 1
    }
    1
}

// ── OPTIONS handler ─────────────────────────────────────────────────────

// Send OPTIONS response with DAV: 1,2.
fn server_options(afd: i64) {
    let h = bytes_new()
    bytes_append_cstr(h, cstr("HTTP/1.1 200 OK\r\nDAV: 1,2\r\nContent-Length: 0\r\nConnection: keep-alive\r\n\r\n"))
    write_buf(afd, peek64(h), bytes_len(h))
}

// ── PROPFIND handler ────────────────────────────────────────────────────

// Build a 207 Multistatus response body for all entries.
fn server_build_multistatus(entries_buf: i64) {
    let mut off = 0
    let n = bytes_len(dav_file_tree)
    for {
        if off >= n { break }
        let mut dn_buf[256]
        let mut dn_i = 0
        for dn_i < 256 invariant { dn_i <= 256 } {
            if off + dn_i >= n { break }
            let c = bytes_get(dav_file_tree, off + dn_i)
            if c == 0 { break }
            dn_buf[dn_i] = c
            dn_i = dn_i + 1
        }
        if dn_i == 0 { break }

        // Skip NUL
        let skip = off + dn_i
        // Read size (3 chars)
        let sz_i = skip
        let mut sz_len = 0
        for {
            if sz_i + sz_len >= n { break }
            let d = bytes_get(dav_file_tree, sz_i + sz_len)
            if d < 48 || d > 57 { break }
            sz_len = sz_len + 1
            if sz_len >= 3 { break }
        }

        // Read is_col (1 char)
        let is_col_off = sz_i + sz_len
        let ic_raw = 0
        let is_coll = if is_col_off < n && bytes_get(dav_file_tree, is_col_off) == 49 { 1 } else { 0 }

        let next_off = is_col_off + 2  // skip is_col + NUL
        if next_off > n { break }
        off = next_off

        // Build response XML
        let href_buf = bytes_new()
        bytes_append_cstr(href_buf, cstr("/"))
        let mut hi = 0
        for hi < 255 invariant { hi <= 255 } {
            if hi >= dn_i { break }
            let dc = dn_buf[hi]
            if dc == 0 { break }
            bytes_push(href_buf, dc)
            hi = hi + 1
        }
        // Use the displayname directly from the file tree
        // Actually, xml_propfind_response takes a bytes handle, not raw stack bytes
        // So we need to copy name into a buffer
        let dn_bytes = bytes_new()
        let mut ci = 0
        for ci < 255 invariant { ci <= 255 } {
            if ci >= dn_i { break }
            let dc = dn_buf[ci]
            if dc == 0 { break }
            bytes_push(dn_bytes, dc)
            ci = ci + 1
        }

        // Parse size from file tree
        let mut size_val = 0
        let mut si = 0
        for si < sz_len {
            let d = bytes_get(dav_file_tree, sz_i + si) - 48
            if d < 0 || d > 9 { break }
            size_val = size_val * 10 + d
            si = si + 1
        }

        xml_propfind_response(entries_buf, href_buf, dn_bytes, size_val, is_coll)
    }
}

// Handle PROPFIND: build and send 207 Multi-Status.
fn server_propfind(afd: i64) {
    let entries = bytes_new()
    server_build_multistatus(entries)
    let body = bytes_new()
    // Wrap entries in multistatus
    let wrapper = bytes_new()
    bytes_push(wrapper, 60); bytes_push(wrapper, 63)
    bytes_append_cstr(wrapper, cstr("xml version=\"1.0\" encoding=\"utf-8\""))
    bytes_push(wrapper, 32); bytes_push(wrapper, 62); bytes_push(wrapper, 10)
    bytes_push(wrapper, 60); bytes_append_cstr(wrapper, cstr("multistatus"))
    bytes_push(wrapper, 32)
    bytes_append_cstr(wrapper, cstr("xmlns=\"DAV:\""))
    bytes_push(wrapper, 62); bytes_push(wrapper, 10)
    if entries != 0 && bytes_len(entries) > 0 {
        bytes_append(wrapper, entries)
    }
    bytes_push(wrapper, 60); bytes_push(wrapper, 47)
    bytes_append_cstr(wrapper, cstr("multistatus"))
    bytes_push(wrapper, 62)
    body = wrapper
    let resp = http_response(cstr("207 Multi-Status"), body)
    write_buf(afd, peek64(resp), bytes_len(resp))
}

// ── MKCOL handler ───────────────────────────────────────────────────────

// Handle MKCOL: create a collection. Returns 1 if handled, 0 otherwise.
// Sends 201 Created on success.
fn server_mkcol(afd: i64) {
    server_send_status(afd, cstr("201 Created"))
}

// ── GET/PUT handler ─────────────────────────────────────────────────────

// Handle GET or PUT. Returns 1 if handled.
fn server_get_put(afd: i64, is_put: i64) {
    if is_put != 0 {
        // PUT, accept any content, respond with 201
        // In a real server, we'd read the body from the socket
        // For this stub: read what we can and discard
        let drain [256]
        for {
            let rn = 0 // would be read_buf(afd, ..., ...) in real impl
            if rn <= 0 { break }
        }
        server_send_status(afd, cstr("201 Created"))
    } else {
        // GET, check if there's content to serve
        // For now, return 404 (no real file serving)
        server_send_status(afd, cstr("404 Not Found"))
    }
}

// ── DELETE handler ──────────────────────────────────────────────────────

// Handle DELETE: remove entry from tree. Stub: always returns 204.
fn server_delete(afd: i64) {
    server_send_status(afd, cstr("204 No Content"))
}

// ── MAIN: Handle a WebDAV request ───────────────────────────────────────

pub fn dav_handle(afd: i64, req: i64) {
    let method_buf = bytes_new()
    bytes_append(method_buf, http_method(req))

    // Parse headers to find body length for PUT requests
    let hdr_bytes = bytes_new()
    // Quick header extraction: skip to \r\n\r\n and record what we read before
    let mut content_length = 0
    let req_len = bytes_len(req)
    let mut hdr_pos = bytes_index_of(req, 13) + 2
    for {
        let line_end = bytes_index_of_from(req, 13, hdr_pos)
        if line_end == hdr_pos { break }
        // Copy line to hdr_bytes
        let line_len = line_end - hdr_pos
        let mut li = 0
        for li < line_len invariant { li <= line_len } {
            bytes_push(hdr_bytes, bytes_get(req, hdr_pos + li))
            li = li + 1
        }
        bytes_push(hdr_bytes, 13)
        bytes_push(hdr_bytes, 10)
        hdr_pos = line_end + 2
    }

    // Check Content-Length in headers for PUT
    let hdr_search = 0
    let hdr_n = bytes_len(hdr_bytes)
    // Look for "Content-Length: " in headers
    let mut ci2 = 0
    for ci2 < hdr_n invariant { ci2 <= hdr_n } {
        let c = bytes_get(hdr_bytes, ci2)
        if c == 67 && ci2 + 15 < hdr_n {  // C at ci2
            let cl_found = 1
            let mut k = 0
            for k < 15 {
                if bytes_get(hdr_bytes, ci2 + k) != peek8(cstr("Content-Length: ") + k) {
                    cl_found = 0
                    break
                }
                k = k + 1
            }
            if cl_found != 0 {
                // Parse digits after "Content-Length: "
                let val_start = ci2 + 16
                let mut v = 0
                let mut vi = 0
                for val_start + vi < hdr_n {
                    let d = bytes_get(hdr_bytes, val_start + vi) - 48
                    if d < 0 || d > 9 { break }
                    v = v * 10 + d
                    vi = vi + 1
                }
                content_length = v
                break
            }
        }
        ci2 = ci2 + 1
    }

    // Match method
    if method_starts_with(method_buf, cstr("OPTIONS")) {
        server_options(afd)
    } else if method_starts_with(method_buf, cstr("PROPFIND")) {
        server_propfind(afd)
    } else if method_starts_with(method_buf, cstr("MKCOL")) {
        server_mkcol(afd)
    } else if method_starts_with(method_buf, cstr("DELETE")) {
        server_delete(afd)
    } else if method_starts_with(method_buf, cstr("PUT")) {
        // Drain body from socket
        let buf[2048]
        let mut remaining = content_length
        for {
            if remaining <= 0 { break }
            let chunk = if remaining > 2048 { 2048 } else { remaining }
            // read_buf(afd, buf, chunk) would drain here
            remaining = remaining - chunk
        }
        server_send_status(afd, cstr("201 Created"))
    } else if method_starts_with(method_buf, cstr("GET")) {
        server_send_status(afd, cstr("404 Not Found"))
    } else {
        server_send_status(afd, cstr("501 Not Implemented"))
    }
}