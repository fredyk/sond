//
// lib/any/ident/es_nif.snd: the control character of a Spanish tax identification number (NIF),
// on its nine characters already without separators and in upper case.
//
// Public API:
//   es_nif_valid(p, n) -> i64   1 when the n bytes at p are a NIF whose control character matches
//
// What is accepted:
//   - a DNI: eight digits and the letter TRWAGMYFPDXBNJZSQVHLCKE[number mod 23];
//   - a NIE: X, Y or Z read as 0, 1 or 2, then as a DNI;
//   - K, L or M (RD 1065/2007, art. 19.2 and 20.2): seven digits and the DNI letter of them;
//   - an entity: one of ABCDEFGHJNPQRSUVW, seven digits and a control character computed from them
//     (double the odd positions, add the digits of every product and the even positions, ten minus
//     the last digit of the sum). A, B, E and H end in that digit; P, Q, S, N and W in the letter
//     JABCDEFGHI[digit]; the others in either.
//
// It never allocates and reads only the n bytes it is given.

let ES_NIF_DNI_LETTERS = "TRWAGMYFPDXBNJZSQVHLCKE"
let ES_NIF_ENTITY_LETTERS = "JABCDEFGHI"
let ES_NIF_PERSON = "KLM"
let ES_NIF_ENTITY = "ABCDEFGHJNPQRSUVW"
let ES_NIF_ENTITY_DIGIT = "ABEH"
let ES_NIF_ENTITY_LETTER = "PQSNW"

// The byte at p[i], or -1 when i is outside 0..n.
fn es_nif_at(p: u8[n], n: i64, i: i64) -> i64 {
    if i >= 0 && i < n {
        return p[i]
    }
    -1
}

fn es_nif_is_digit(c: i64) -> i64 {
    if c >= '0' && c <= '9' { return 1 }
    0
}

// The value of the seven digits p[1..8], or -1 when one of them is not a digit.
fn es_nif_seven(p: u8[n], n: i64) -> i64 {
    let mut v = 0
    for i in 1..8 {
        let c = es_nif_at(p, n, i)
        if es_nif_is_digit(c) == 0 { return -1 }
        v = v * 10 + (c - '0')
    }
    v
}

// 1 when the byte c is one of the NUL-terminated bytes at set (a table of this file).
fn es_nif_in(set: i64, c: i64) -> i64 {
    let mut i = 0
    for peek8(set + i) != 0 {
        if peek8(set + i) == c { return 1 }
        i = i + 1
    }
    0
}

fn es_nif_dni_letter(v: i64) -> i64 {
    peek8(ES_NIF_DNI_LETTERS + (v % 23))
}

fn es_nif_valid(p: u8[n], n: i64) -> i64 {
    if n != 9 { return 0 }
    let first = es_nif_at(p, n, 0)
    let last = es_nif_at(p, n, 8)
    let rest = es_nif_seven(p, n)
    // A DNI, or a NIE whose X, Y or Z stands for its first digit.
    let mut lead = -1
    if es_nif_is_digit(first) == 1 { lead = first - '0' }
    if first == 'X' { lead = 0 }
    if first == 'Y' { lead = 1 }
    if first == 'Z' { lead = 2 }
    if lead >= 0 && rest >= 0 {
        if last == es_nif_dni_letter(lead * 10000000 + rest) { return 1 }
        return 0
    }
    if rest < 0 { return 0 }
    if lead >= 0 { return 0 }
    if es_nif_in(ES_NIF_PERSON, first) == 1 {
        if last == es_nif_dni_letter(rest) { return 1 }
        return 0
    }
    if es_nif_in(ES_NIF_ENTITY, first) == 0 { return 0 }
    let mut sum = 0
    for i in 1..8 {
        let mut d = es_nif_at(p, n, i) - '0'
        if i % 2 == 1 {
            d = d * 2
            d = d / 10 + d % 10
        }
        sum = sum + d
    }
    let control = (10 - sum % 10) % 10
    let digit = '0' + control
    let letter = peek8(ES_NIF_ENTITY_LETTERS + control)
    if es_nif_in(ES_NIF_ENTITY_DIGIT, first) == 1 {
        if last == digit { return 1 }
        return 0
    }
    if es_nif_in(ES_NIF_ENTITY_LETTER, first) == 1 {
        if last == letter { return 1 }
        return 0
    }
    if last == digit || last == letter { return 1 }
    0
}
