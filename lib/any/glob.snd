//
// lib/any/glob.snd: wildcard matching of a byte range against a pattern in which '*'
// stands for any run of bytes (the empty one included) and every other byte is literal.
// Both ranges are addressed by i64 pointer and length; nothing is null-terminated.

// glob_match(pat, plen, s, slen) -> 0|1
//   1 when the whole of s[0..slen) matches the whole of pat[0..plen). Linear in practice:
//   on a mismatch only the last star is retried, one byte further on (the classic
//   greedy-with-backtrack scan), so no input makes it exponential. Negative lengths match
//   nothing.
fn glob_match(pat: i64, plen: i64, s: i64, slen: i64) -> i64 {
    if plen < 0 || slen < 0 {
        return 0
    }
    let mut p = 0
    let mut i = 0
    let mut star = -1
    let mut retry = 0
    for i < slen {
        if p < plen && peek8(pat + p) == '*' {
            star = p
            retry = i
            p = p + 1
        } else if p < plen && peek8(pat + p) == peek8(s + i) {
            p = p + 1
            i = i + 1
        } else if star >= 0 {
            retry = retry + 1
            i = retry
            p = star + 1
        } else {
            return 0
        }
    }
    for p < plen && peek8(pat + p) == '*' {
        p = p + 1
    }
    if p == plen { 1 } else { 0 }
}
