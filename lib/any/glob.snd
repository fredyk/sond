//
// lib/any/glob.snd: wildcard matching of a byte range against a pattern in which '*'
// stands for any run of bytes (the empty one included) and every other byte is literal.
// Both ranges are addressed by i64 pointer and length; nothing is null-terminated.

// glob_match(pat, plen, s, slen) -> 0|1
//   1 when the whole of s[0..slen) matches the whole of pat[0..plen). Linear in practice:
//   on a mismatch only the last star is retried, one byte further on (the classic
//   greedy-with-backtrack scan), so no input makes it exponential. Negative lengths match
//   nothing.
fn glob_match(pat: i64, plen: i64, s: i64, slen: i64) -> i64
effects [] {
    if plen < 0 { 0 } else if slen < 0 { 0 } else { glob_scan(pat, plen, s, slen, 0) }
}

// glob_match_ascii_nocase(pat, plen, s, slen) -> 0|1
//   glob_match with the ASCII letters A-Z and a-z compared without their case; every other
//   byte (UTF-8 bytes above 0x7f included) still compares exactly.
fn glob_match_ascii_nocase(pat: i64, plen: i64, s: i64, slen: i64) -> i64
effects [] {
    if plen < 0 { 0 } else if slen < 0 { 0 } else { glob_scan(pat, plen, s, slen, 1) }
}

// The byte c, with an ASCII upper-case letter turned into its lower-case one when fold is 1.
priv fn glob_fold(c: i64, fold: i64) -> i64
effects [] {
    if fold == 1 && c >= 'A' && c <= 'Z' { c + 32 } else { c }
}

priv fn glob_same(a: i64, b: i64, fold: i64) -> (r: i64)
ensures { r >= 0; r <= 1 }
effects [] {
    if glob_fold(a, fold) == glob_fold(b, fold) { 1 } else { 0 }
}

priv fn glob_scan(pat: i64, plen: i64, s: i64, slen: i64, fold: i64) -> i64
requires { plen >= 0; slen >= 0 }
effects [] {
    let mut p = 0
    let mut i = 0
    let mut star = -1
    let mut retry = 0
    let mut failed = 0
    while i < slen && failed == 0 invariant { i >= 0; p >= 0 } {
        if p < plen && peek8(pat + p) == '*' {
            star = p
            retry = i
            p = p + 1
        } else if p < plen && glob_same(peek8(pat + p), peek8(s + i), fold) == 1 {
            p = p + 1
            i = i + 1
        } else if star >= 0 {
            retry = retry + 1
            i = retry
            p = star + 1
        } else {
            failed = 1
        }
    }
    while failed == 0 && p < plen && peek8(pat + p) == '*' invariant { p >= 0 } {
        p = p + 1
    }
    if failed == 0 && p == plen { 1 } else { 0 }
}

// glob_list_match(list, llen, s, slen) -> 0|1
//   list[0..llen) is a comma-separated list of patterns; a pattern that starts with '!'
//   excludes what the rest of it matches. 1 when s matches at least one including pattern and
//   no excluding one, wherever they sit in the list ("a*,!a*-old" takes "app", not "app-old").
//   An empty pattern (and so an empty list) matches nothing. Negative lengths match nothing.
fn glob_list_match(list: i64, llen: i64, s: i64, slen: i64) -> i64
effects [] {
    if llen < 0 { 0 } else if slen < 0 { 0 } else { glob_list_scan(list, llen, s, slen, 0) }
}

// glob_list_match_ascii_nocase(list, llen, s, slen) -> 0|1
//   glob_list_match with every pattern compared as glob_match_ascii_nocase does.
fn glob_list_match_ascii_nocase(list: i64, llen: i64, s: i64, slen: i64) -> i64
effects [] {
    if llen < 0 { 0 } else if slen < 0 { 0 } else { glob_list_scan(list, llen, s, slen, 1) }
}

// 1 when the pattern list[start..end) is not empty and matches s.
priv fn glob_one(list: i64, start: i64, end: i64, s: i64, slen: i64, fold: i64) -> (r: i64)
requires { slen >= 0 }
ensures { r >= 0; r <= 1 }
effects [] {
    if end - start > 0 && start >= 0 {
        if glob_scan(list + start, end - start, s, slen, fold) == 1 { 1 } else { 0 }
    } else {
        0
    }
}

priv fn glob_list_scan(list: i64, llen: i64, s: i64, slen: i64, fold: i64) -> i64
requires { llen >= 0; slen >= 0 }
effects [] {
    let mut included = 0
    let mut excluded = 0
    let mut start = 0
    let mut i = 0
    while i <= llen invariant { i >= 0; start >= 0 } {
        if i == llen || peek8(list + i) == ',' {
            if i > start && peek8(list + start) == '!' {
                if glob_one(list, start + 1, i, s, slen, fold) == 1 { excluded = 1 }
            } else if glob_one(list, start, i, s, slen, fold) == 1 {
                included = 1
            }
            start = i + 1
        }
        i = i + 1
    }
    if excluded == 0 { included } else { 0 }
}
