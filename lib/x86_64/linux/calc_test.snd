include "x86_64/linux/calc.snd"
include "x86_64/linux/testing.snd"
test "single number" { let __t0: string = "42"
    assert_eq(calc_eval(bytes_from_cstr(__t0.utf8)), 42) }
test "addition" { let __t0: string = "2+3"
    assert_eq(calc_eval(bytes_from_cstr(__t0.utf8)), 5) }
test "precedence: mul before add" { let __t0: string = "2+3*4"
    assert_eq(calc_eval(bytes_from_cstr(__t0.utf8)), 14) }
test "parens override precedence" { let __t0: string = "(2+3)*4"
    assert_eq(calc_eval(bytes_from_cstr(__t0.utf8)), 20) }
test "subtraction and division" { let __t0: string = "20-8/4"
    assert_eq(calc_eval(bytes_from_cstr(__t0.utf8)), 18) }
test "spaces are ignored" { let __t0: string = " 7 * ( 1 + 1 ) "
    assert_eq(calc_eval(bytes_from_cstr(__t0.utf8)), 14) }
test "division by zero is guarded to 0" { let __t0: string = "5/0"
    assert_eq(calc_eval(bytes_from_cstr(__t0.utf8)), 0) }
test "a number stops at a non-digit above nine" { let __t0: string = "5x"
    assert_eq(calc_eval(bytes_from_cstr(__t0.utf8)), 5) }
