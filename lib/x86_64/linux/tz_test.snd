//
// Tests for lib/x86_64/linux/tz.snd.
//
// The fixture is a TZif v2 file BUILT HERE, byte by byte, with three offsets that cannot be
// confused with one another (+2h before the first transition, +1h between the two, -1h after).
// Reading the machine's own /etc/localtime instead would make the expected value depend on where
// the test runs and on the time of year, which is the opposite of a test.
//
// One case does use the real file, and asserts only what is true of every zone on earth: the
// offset is a whole number of minutes inside +-26 hours. That catches a parser that returns a
// field of the header, or garbage, without pretending to know which zone this machine is in.

include "x86_64/linux/tz.snd"
include "x86_64/linux/testing.snd"

let TZ_PATH: string = "__tz_test_fixture"
let ABSENT_PATH: string = "__tz_test_definitely_absent_7c2b"
let NOT_TZ: string = "esto no es un TZif en absoluto\n"

let mut fx[64]

// Writes a big-endian 32-bit value.
fn put_be32(p: i64, o: i64, v: i64) {
    poke8(p + o + 0, (v >>> 24) & 0xff)
    poke8(p + o + 1, (v >>> 16) & 0xff)
    poke8(p + o + 2, (v >>> 8) & 0xff)
    poke8(p + o + 3, v & 0xff)
}

// Writes a big-endian 64-bit value.
fn put_be64(p: i64, o: i64, v: i64) {
    put_be32(p, o, (v >>> 32) & 0xffffffff)
    put_be32(p, o + 4, v & 0xffffffff)
}

// Builds a TZif v2 in `fx` and returns its length.
//
// The v1 block is present but EMPTY (no transitions, one type), which is legal and is what a
// modern zone file looks like in spirit: everything that matters is in the 64-bit block behind
// it. A parser that stops at the v1 block therefore reads a file with no transitions at all,
// which is exactly the mistake this fixture is shaped to catch.
fn build_fixture() -> i64 {
    for i in 0..64 { poke64(fx + i * 8, 0) }
    // ── v1 header ──
    poke8(fx + 0, 84)   // 'T'
    poke8(fx + 1, 90)   // 'Z'
    poke8(fx + 2, 105)  // 'i'
    poke8(fx + 3, 102)  // 'f'
    poke8(fx + 4, 50)   // version '2'
    put_be32(fx, 20, 0) // isutcnt
    put_be32(fx, 24, 0) // isstdcnt
    put_be32(fx, 28, 0) // leapcnt
    put_be32(fx, 32, 0) // timecnt
    put_be32(fx, 36, 1) // typecnt
    put_be32(fx, 40, 1) // charcnt
    // ── v1 data: one ttinfo (6 bytes) + one char ──
    let v2 = 44 + 7
    // ── v2 header ──
    poke8(fx + v2 + 0, 84)
    poke8(fx + v2 + 1, 90)
    poke8(fx + v2 + 2, 105)
    poke8(fx + v2 + 3, 102)
    poke8(fx + v2 + 4, 50)
    put_be32(fx, v2 + 20, 0) // isutcnt
    put_be32(fx, v2 + 24, 0) // isstdcnt
    put_be32(fx, v2 + 28, 0) // leapcnt
    put_be32(fx, v2 + 32, 2) // timecnt: two transitions
    put_be32(fx, v2 + 36, 3) // typecnt: three types
    put_be32(fx, v2 + 40, 1) // charcnt
    // ── v2 data ──
    let d = v2 + 44
    put_be64(fx, d, 1000)          // transition 1
    put_be64(fx, d + 8, 2000)      // transition 2
    poke8(fx + d + 16, 0)          // .. uses type 0
    poke8(fx + d + 17, 2)          // .. uses type 2
    // type 0: +1h, and marked DST so it is not the pre-first-transition fallback
    put_be32(fx, d + 18, 3600)
    poke8(fx + d + 22, 1)
    poke8(fx + d + 23, 0)
    // type 1: +2h, standard time -- the first non-DST type, hence the fallback
    put_be32(fx, d + 24, 7200)
    poke8(fx + d + 28, 0)
    poke8(fx + d + 29, 0)
    // type 2: -1h, standard time
    put_be32(fx, d + 30, 0 - 3600)
    poke8(fx + d + 34, 0)
    poke8(fx + d + 35, 0)
    poke8(fx + d + 36, 0)          // the abbreviation characters
    d + 37
}

fn write_file_bytes(path: i64, src: i64, n: i64) -> i64 {
    let fd = open_file(path, O_WRONLY | O_CREAT | O_TRUNC, 420)
    if fd < 0 { return fd }
    let w = write_buf(fd, src, n)
    close_fd(fd)
    w
}

fn strlen_(p: i64) -> i64 {
    let mut n = 0
    for peek8(p + n) != 0 { n = n + 1 }
    n
}

fn write_fixture() -> i64 {
    let n = build_fixture()
    write_file_bytes(TZ_PATH.utf8, fx, n)
}

test "an instant between two transitions takes the offset of the first" {
    assert(write_fixture() > 0)
    assert_eq(tz_offset_from(TZ_PATH.utf8, 1500), 3600)
    remove_file(TZ_PATH.utf8)
}

test "an instant after the last transition keeps its offset, negative included" {
    // A western zone has a NEGATIVE offset, so the 32-bit gmtoff has to be sign-extended. Read
    // as unsigned it would come back as 4294963696, and a clock built on it would be off by
    // 1193 hours -- wrong in a way no plausibility check catches.
    assert(write_fixture() > 0)
    assert_eq(tz_offset_from(TZ_PATH.utf8, 2000), 0 - 3600)
    assert_eq(tz_offset_from(TZ_PATH.utf8, 999999), 0 - 3600)
    remove_file(TZ_PATH.utf8)
}

test "an instant before the first transition falls back to standard time" {
    // Not to type 0 -- that one is DST here. The rule is the first type with isdst = 0, which is
    // what a zone file means by "what this place did before the record starts".
    assert(write_fixture() > 0)
    assert_eq(tz_offset_from(TZ_PATH.utf8, 0), 7200)
    assert_eq(tz_offset_from(TZ_PATH.utf8, 999), 7200)
    remove_file(TZ_PATH.utf8)
}

test "the transition instant itself already belongs to the new offset" {
    // The boundary: a transition at T means the new offset applies AT T, not after it. Off by
    // one second here and the clock is wrong for exactly one second twice a year, which is the
    // kind of thing that is never found by looking.
    assert(write_fixture() > 0)
    assert_eq(tz_offset_from(TZ_PATH.utf8, 999), 7200)
    assert_eq(tz_offset_from(TZ_PATH.utf8, 1000), 3600)
    assert_eq(tz_offset_from(TZ_PATH.utf8, 1999), 3600)
    assert_eq(tz_offset_from(TZ_PATH.utf8, 2000), 0 - 3600)
    remove_file(TZ_PATH.utf8)
}

test "a file that is not there, and one that is not a TZif, are refused" {
    // Refused rather than answered with 0: an offset of 0 is a real answer (it is UTC), so
    // handing it back on failure would put a program in London whenever the file went missing.
    assert_eq(tz_offset_from(ABSENT_PATH.utf8, 0), TZ_ENOFILE)
    assert(write_file_bytes(TZ_PATH.utf8, NOT_TZ.utf8, strlen_(NOT_TZ.utf8)) > 0)
    assert_eq(tz_offset_from(TZ_PATH.utf8, 0), TZ_EFORMAT)
    remove_file(TZ_PATH.utf8)
}

test "this machine's own zone reads as a plausible offset" {
    // The only thing that is true of every zone and every date: whole minutes, within 26 hours.
    // A parser that returned a header field or a byte of the abbreviation would fail this.
    let off = tz_offset()
    assert(off > 0 - 93600)
    assert(off < 93600)
    assert_eq(off % 60, 0)
}

test "a version 1 file is refused instead of read with 32-bit times" {
    // Version 1 has only 32-bit transition times: correct until 2038 and then quietly wrong.
    // A parser that accepts it is right today, which is exactly what makes it dangerous.
    let n = build_fixture()
    poke8(fx + 4, 49)   // version '1'
    assert(write_file_bytes(TZ_PATH.utf8, fx, n) > 0)
    assert_eq(tz_offset_from(TZ_PATH.utf8, 1500), TZ_EFORMAT)
    remove_file(TZ_PATH.utf8)
}

test "a file cut short is refused at every place it can be cut" {
    // Truncation is the normal failure of a file being written, copied or restored, and each of
    // these cuts lands in a different part of the parse: before the header is complete, before
    // the second header, and in the middle of the type records.
    let n = build_fixture()
    assert(write_file_bytes(TZ_PATH.utf8, fx, 20) > 0)
    assert_eq(tz_offset_from(TZ_PATH.utf8, 1500), TZ_EFORMAT)
    assert(write_file_bytes(TZ_PATH.utf8, fx, 60) > 0)
    assert_eq(tz_offset_from(TZ_PATH.utf8, 1500), TZ_EFORMAT)
    assert(write_file_bytes(TZ_PATH.utf8, fx, n - 8) > 0)
    assert_eq(tz_offset_from(TZ_PATH.utf8, 1500), TZ_EFORMAT)
    remove_file(TZ_PATH.utf8)
}

test "a header claiming more types than the file holds is refused" {
    // The counts come from the file, so they are input, not truth. Believing a typecnt the bytes
    // do not back would read the offset from whatever follows the mapping.
    let n = build_fixture()
    put_be32(fx, 44 + 7 + 36, 4000)   // typecnt in the v2 header
    assert(write_file_bytes(TZ_PATH.utf8, fx, n) > 0)
    assert_eq(tz_offset_from(TZ_PATH.utf8, 1500), TZ_EFORMAT)
    remove_file(TZ_PATH.utf8)
}

test "a transition pointing at a type that does not exist is refused" {
    let n = build_fixture()
    poke8(fx + 44 + 7 + 44 + 16, 9)   // first transition -> type 9, of three
    assert(write_file_bytes(TZ_PATH.utf8, fx, n) > 0)
    assert_eq(tz_offset_from(TZ_PATH.utf8, 1500), TZ_EFORMAT)
    remove_file(TZ_PATH.utf8)
}

// A TZif with NO transitions: UTC itself and every fixed-offset zone look like this. Built
// separately rather than by setting timecnt to 0 in the other fixture, because the count and the
// bytes have to agree -- zeroing the count while leaving the transition bytes in place moves the
// type records eight bytes along, and the first attempt at this test failed on that, reading a
// transition time as an offset. The fixture was wrong, not the parser.
fn build_fixture_no_transitions() -> i64 {
    for i in 0..64 { poke64(fx + i * 8, 0) }
    poke8(fx + 0, 84)
    poke8(fx + 1, 90)
    poke8(fx + 2, 105)
    poke8(fx + 3, 102)
    poke8(fx + 4, 50)
    put_be32(fx, 36, 1) // v1 typecnt
    put_be32(fx, 40, 1) // v1 charcnt
    let v2 = 44 + 7
    poke8(fx + v2 + 0, 84)
    poke8(fx + v2 + 1, 90)
    poke8(fx + v2 + 2, 105)
    poke8(fx + v2 + 3, 102)
    poke8(fx + v2 + 4, 50)
    put_be32(fx, v2 + 32, 0) // timecnt: none
    put_be32(fx, v2 + 36, 2) // typecnt
    put_be32(fx, v2 + 40, 1) // charcnt
    let d = v2 + 44
    // type 0 is DST (+1h), type 1 is standard (+2h): the fallback must pick the second.
    put_be32(fx, d, 3600)
    poke8(fx + d + 4, 1)
    poke8(fx + d + 5, 0)
    put_be32(fx, d + 6, 7200)
    poke8(fx + d + 10, 0)
    poke8(fx + d + 11, 0)
    poke8(fx + d + 12, 0)
    d + 13
}

test "a zone with no transitions at all answers with its standard time" {
    let n = build_fixture_no_transitions()
    assert(write_file_bytes(TZ_PATH.utf8, fx, n) > 0)
    assert_eq(tz_offset_from(TZ_PATH.utf8, 1500), 7200)
    remove_file(TZ_PATH.utf8)
}

test "each byte of the magic number is checked, not just the first" {
    // A file that starts with 'T' and continues with anything is not a TZif. Checking only the
    // first byte would accept a text file beginning with "Tabla..." and read its letters as
    // counts, which is how a parser ends up reporting an offset of several thousand hours.
    for bad in 1..4 {
        let n = build_fixture()
        poke8(fx + bad, 88)   // 'X' in place of Z, i or f
        assert(write_file_bytes(TZ_PATH.utf8, fx, n) > 0)
        assert_eq(tz_offset_from(TZ_PATH.utf8, 1500), TZ_EFORMAT)
    }
    remove_file(TZ_PATH.utf8)
}

test "a zone file too big for the buffer is reported, not truncated" {
    // Distinct from EFORMAT on purpose: a file that does not FIT is a sizing problem with an
    // obvious fix, while a malformed one is a corrupt install. Reading the first 8 KiB of a
    // larger file would parse a header whose counts describe bytes that were never read.
    let big = build_fixture()
    let fd = open_file(TZ_PATH.utf8, O_WRONLY | O_CREAT | O_TRUNC, 420)
    assert(fd >= 0)
    for k in 0..300 {
        write_buf(fd, fx, big)      // ~300 * 88 bytes, comfortably over 8 KiB
    }
    close_fd(fd)
    assert_eq(tz_offset_from(TZ_PATH.utf8, 1500), TZ_ETOOBIG)
    remove_file(TZ_PATH.utf8)
}
