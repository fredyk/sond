//
// lib/x86_64/linux/env.snd: reading the process environment.
//
// Public API:
//   env_get(name) -> i64            pointer to the VALUE of `name`, or 0 if unset
//   env_get_or(name, fallback)      the same, but `fallback` instead of 0
//   env_count() -> i64              number of entries in the environment
//   env_name_len(entry) -> i64      length of the KEY part of a "KEY=VALUE" entry
//
// Why it matters: without this, a program that needs a path under the user's home has to embed
// one -- `/home/someone/...` -- and then it only runs on the machine it was written on. Reading
// $HOME is what makes the same binary work for another user.
//
// There is NO /proc here, and no syscall either. The kernel hands the environment to the
// process on the stack at entry, the runtime stashes it, and the `envp(i)` builtin returns the
// i-th "KEY=VALUE" string. That is the same data /proc/self/environ exposes, minus the open,
// the read, the buffer and the dependency on /proc actually being mounted -- which it is not
// inside a minimal container or a chroot, exactly where a static binary is most likely to run.
//
// Arguments need no module at all: `argc()` and `argv(i)` are builtins for the same reason.
//
// All returned pointers point INTO the environment block, which lives as long as the process:
// nothing here allocates or copies, and a caller that wants to keep a value past a modification
// of the environment must copy it.

// Length of the key of a "KEY=VALUE" entry, i.e. the offset of the `=`. An entry with no `=` at
// all (the kernel does not forbid one) has its whole length reported, so it can never match a
// lookup: the comparison below would need a `=` where the string has already ended.
fn env_name_len(entry: i64) -> i64 {
    let mut n = 0
    for peek8(entry + n) != 0 {
        if peek8(entry + n) == 61 { return n }
        n = n + 1
    }
    n
}

// Number of entries in the environment. The list is NULL-terminated, like argv.
fn env_count() -> i64 {
    let mut n = 0
    for envp(n) != 0 {
        n = n + 1
    }
    n
}

// Pointer to the value of `name` (a NUL-terminated string), or 0 if it is not set.
//
// The match must cover the WHOLE key: "PAT" must not find "PATH=...", and "PATHX" must not
// find it either. Comparing up to the `=` on the entry side and up to the NUL on the name side,
// and requiring both to end together, is what gives that -- a comparison over `strlen(name)`
// bytes would accept both.
fn env_get(name: i64) -> i64 {
    let n = env_count()
    for i in 0..n {
        let e = envp(i)
        let klen = env_name_len(e)
        if peek8(e + klen) == 61 {
            let mut j = 0
            for j < klen {
                if peek8(name + j) != peek8(e + j) { break }
                j = j + 1
            }
            // Both ended at the same place: every byte matched and the name has no more.
            if j == klen {
                if peek8(name + klen) == 0 { return e + klen + 1 }
            }
        }
    }
    0
}

// The value of `name`, or `fallback` if it is not set. The point of taking the fallback as a
// pointer rather than returning 0 is that the caller can use the result directly, instead of
// writing the same `if x == 0` at every call site and eventually forgetting one.
fn env_get_or(name: i64, fallback: i64) -> i64 {
    let v = env_get(name)
    if v == 0 { return fallback }
    v
}
