// lib/x86_64/linux/syscall-nums.snd, Linux x86-64 syscall numbers.
//
// Public API (globals, read-only):
//   SYS_read, SYS_write, SYS_open, SYS_close, SYS_fstat, SYS_mmap,
//   SYS_mprotect, SYS_munmap, SYS_brk, SYS_rt_sigaction, SYS_rt_sigprocmask,
//   SYS_rt_sigreturn, SYS_ioctl, SYS_access, SYS_pipe, SYS_select,
//   SYS_dup, SYS_getdents64, SYS_lseek, SYS_getpid, SYS_socket,
//   SYS_connect, SYS_accept, SYS_sendto, SYS_recvfrom, SYS_sendmsg,
//   SYS_recvmsg, SYS_shutdown, SYS_bind, SYS_listen, SYS_getsockname,
//   SYS_getpeername, SYS_setsockopt, SYS_getsockopt, SYS_clone,
//   SYS_fork, SYS_vfork, SYS_execve, SYS_exit, SYS_wait4, SYS_kill,
//   SYS_uname, SYS_fcntl, SYS_truncate, SYS_getcwd, SYS_chdir,
//   SYS_mkdir, SYS_rmdir, SYS_stat, SYS_lstat, SYS_poll, SYS_lseek,
//   SYS_getuid, SYS_gid, SYS_geteuid, SYS_getgid, SYS_getegid,
//   SYS_getrlimit, SYS_arch_prctl, SYS_set_tid_address, SYS_set_robust_list,
//   SYS_futex, SYS_clock_gettime, SYS_nanosleep, SYS_splice, SYS_syscall (itself).

