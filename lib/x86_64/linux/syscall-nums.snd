//
// lib/x86_64/linux/syscall-nums.snd: Linux x86-64 syscall numbers.
//
// Public API (globals, read-only): the `let SYS_*` definitions below, and only those.
//
// There used to be a hand-written list of names here. It had drifted: it announced fifteen
// constants that were never defined (SYS_clock_gettime, SYS_futex, SYS_getcwd, SYS_chdir,
// SYS_mkdir, SYS_rmdir and friends), plus a SYS_gid that is not a Linux syscall at all. A
// duplicated index of a file's own contents always ends up lying, so the file no longer keeps
// one -- the definitions ARE the index. The ones that were announced and real were added.
//
// Values come from the kernel's own table (asm/unistd_64.h), never from memory: a wrong number
// does not fail to compile, it calls a DIFFERENT syscall.

let SYS_read = 0
let SYS_write = 1
let SYS_open = 2
let SYS_close = 3
let SYS_stat = 4
let SYS_fstat = 5
let SYS_lstat = 6
let SYS_poll = 7
let SYS_lseek = 8
let SYS_mmap = 9
let SYS_mprotect = 10
let SYS_munmap = 11
let SYS_brk = 12
let SYS_rt_sigaction = 13
let SYS_rt_sigprocmask = 14
let SYS_rt_sigreturn = 15
let SYS_ioctl = 16
let SYS_pread64 = 17
let SYS_pwrite64 = 18
let SYS_readv = 19
let SYS_writev = 20
let SYS_access = 21
let SYS_pipe = 22
let SYS_select = 23
let SYS_sched_yield = 24
let SYS_mremap = 25
let SYS_msync = 26
let SYS_mincore = 27
let SYS_madvise = 28
let SYS_dup = 32
let SYS_dup2 = 33
let SYS_readlink = 89
let SYS_getuid = 102
let SYS_nanosleep = 35
let SYS_getpid = 39
let SYS_socket = 41
let SYS_connect = 42
let SYS_accept = 43
let SYS_sendto = 44
let SYS_recvfrom = 45
let SYS_sendmsg = 46
let SYS_recvmsg = 47
let SYS_shutdown = 48
let SYS_bind = 49
let SYS_listen = 50
let SYS_getsockname = 51
let SYS_getpeername = 52
let SYS_socketpair = 53
let SYS_setsockopt = 54
let SYS_getsockopt = 55
let SYS_clone = 56
let SYS_fork = 57
let SYS_vfork = 58
let SYS_execve = 59
let SYS_exit = 60
let SYS_wait4 = 61
let SYS_kill = 62
let SYS_uname = 63
let SYS_fcntl = 72
let SYS_truncate = 76
let SYS_getcwd = 79
let SYS_chdir = 80
let SYS_mkdir = 83
let SYS_rmdir = 84
let SYS_unlink = 87
let SYS_getrlimit = 97
let SYS_getgid = 104
let SYS_geteuid = 107
let SYS_getegid = 108
let SYS_setsid = 112
let SYS_arch_prctl = 158
// SYS_time returns whole seconds since the Unix epoch straight in the return value, with no
// buffer to fill: syscall(SYS_time, 0, 0, 0). SYS_clock_gettime is the finer-grained one and
// needs a `struct timespec` to write into, so a caller that only wants a date wants this one.
let SYS_time = 201
let SYS_futex = 202
let SYS_getdents64 = 217
let SYS_set_tid_address = 218
let SYS_clock_gettime = 228
let SYS_set_robust_list = 273
let SYS_splice = 275
let SYS_getrandom = 318
