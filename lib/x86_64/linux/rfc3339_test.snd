//
// Tests for lib/x86_64/linux/rfc3339.snd, against an independent oracle (the calendar
// values were checked against the system clock utilities) and pinned vectors:
//   epoch 0, a leap 29 February 2024, a non-leap year (2100) and a leap century (2000),
//   the second :59, and the two numeric-offset forms.
//
// Every parsed value is written to a one-word out-buffer so a legitimate 0 or negative
// epoch is never confused with the -1 failure sentinel.

include "x86_64/linux/rfc3339.snd"
include "x86_64/linux/testing.snd"

let mut in_buf[64]
let mut out_buf[64]
let mut val[1]

// Copies the `n` bytes at `p` into the byte buffer at `dst`.
fn load(dst: i64, p: i64, n: i64) {
    let d: u8[n] = dst
    let s: u8[n] = p
    for i in 0..n {
        d[i] = s[i]
    }
}

// 1 if the first `n` bytes at `out` equal the `n` bytes at `want`.
fn same(out: i64, want: i64, n: i64) -> i64 {
    let o: u8[n] = out
    let w: u8[n] = want
    for i in 0..n {
        if o[i] != w[i] {
            return 0
        }
    }
    1
}

test "rfc3339: format the epoch itself" {
    assert_eq(rfc3339_format(0, out_buf), 20)
    let want: string = "1970-01-01T00:00:00Z"
    assert_eq(same(out_buf, want.utf8, 20), 1)
    let o: u8[21] = out_buf
    assert_eq(o[20], 0)
}

test "rfc3339: format a plain UTC instant" {
    assert_eq(rfc3339_format(1790253005, out_buf), 20)
    let want: string = "2026-09-24T12:30:05Z"
    assert_eq(same(out_buf, want.utf8, 20), 1)
}

test "rfc3339: format keeps a :59 second" {
    assert_eq(rfc3339_format(1790253059, out_buf), 20)
    let want: string = "2026-09-24T12:30:59Z"
    assert_eq(same(out_buf, want.utf8, 20), 1)
}

test "rfc3339: format a leap day and a leap century" {
    assert_eq(rfc3339_format(1709209805, out_buf), 20)
    let feb29: string = "2024-02-29T12:30:05Z"
    assert_eq(same(out_buf, feb29.utf8, 20), 1)

    assert_eq(rfc3339_format(951827405, out_buf), 20)
    let feb29_2000: string = "2000-02-29T12:30:05Z"
    assert_eq(same(out_buf, feb29_2000.utf8, 20), 1)
}

test "rfc3339: 2100 is not a leap year" {
    assert_eq(rfc3339_format(4102444800, out_buf), 20)
    let jan1: string = "2100-01-01T00:00:00Z"
    assert_eq(same(out_buf, jan1.utf8, 20), 1)

    assert_eq(rfc3339_format(4107456000, out_buf), 20)
    let feb28: string = "2100-02-28T00:00:00Z"
    assert_eq(same(out_buf, feb28.utf8, 20), 1)

    assert_eq(rfc3339_format(4107542400, out_buf), 20)
    let mar1: string = "2100-03-01T00:00:00Z"
    assert_eq(same(out_buf, mar1.utf8, 20), 1)
}

test "rfc3339: a second before the epoch formats as the previous day" {
    assert_eq(rfc3339_format(0 - 1, out_buf), 20)
    let want: string = "1969-12-31T23:59:59Z"
    assert_eq(same(out_buf, want.utf8, 20), 1)
}

test "rfc3339: milliseconds are three digits, zero-padded" {
    assert_eq(rfc3339_format_ms(1790253005123, out_buf), 24)
    let want: string = "2026-09-24T12:30:05.123Z"
    assert_eq(same(out_buf, want.utf8, 24), 1)
    let o: u8[25] = out_buf
    assert_eq(o[24], 0)

    assert_eq(rfc3339_format_ms(1790253005007, out_buf), 24)
    let small: string = "2026-09-24T12:30:05.007Z"
    assert_eq(same(out_buf, small.utf8, 24), 1)

    assert_eq(rfc3339_format_ms(0, out_buf), 24)
    let zero: string = "1970-01-01T00:00:00.000Z"
    assert_eq(same(out_buf, zero.utf8, 24), 1)
}

test "rfc3339: negative milliseconds keep a non-negative fraction" {
    assert_eq(rfc3339_format_ms(0 - 500, out_buf), 24)
    let want: string = "1969-12-31T23:59:59.500Z"
    assert_eq(same(out_buf, want.utf8, 24), 1)
}

test "rfc3339: parse the epoch itself" {
    let t: string = "1970-01-01T00:00:00Z"
    load(in_buf, t.utf8, 20)
    assert_eq(rfc3339_parse(in_buf, 20, val), 0)
    assert_eq(val[0], 0)
}

test "rfc3339: parse a plain UTC instant, seconds and milliseconds" {
    let t: string = "2026-09-24T12:30:05Z"
    load(in_buf, t.utf8, 20)
    assert_eq(rfc3339_parse(in_buf, 20, val), 0)
    assert_eq(val[0], 1790253005)

    let tm: string = "2026-09-24T12:30:05.123Z"
    load(in_buf, tm.utf8, 24)
    assert_eq(rfc3339_parse_ms(in_buf, 24, val), 0)
    assert_eq(val[0], 1790253005123)
}

test "rfc3339: parse floors the seconds of a fractional instant" {
    let tm: string = "2026-09-24T12:30:05.123Z"
    load(in_buf, tm.utf8, 24)
    assert_eq(rfc3339_parse(in_buf, 24, val), 0)
    assert_eq(val[0], 1790253005)
}

test "rfc3339: parse numeric offsets, positive and negative" {
    let plus: string = "2026-09-24T12:30:05+02:00"
    load(in_buf, plus.utf8, 25)
    assert_eq(rfc3339_parse(in_buf, 25, val), 0)
    assert_eq(val[0], 1790245805)

    let minus: string = "2026-09-24T12:30:05-05:30"
    load(in_buf, minus.utf8, 25)
    assert_eq(rfc3339_parse(in_buf, 25, val), 0)
    assert_eq(val[0], 1790272805)
}

test "rfc3339: parse a lowercase separator and zulu" {
    let t: string = "2026-09-24t12:30:05z"
    load(in_buf, t.utf8, 20)
    assert_eq(rfc3339_parse(in_buf, 20, val), 0)
    assert_eq(val[0], 1790253005)
}

test "rfc3339: parse a leap day" {
    let t: string = "2024-02-29T12:30:05Z"
    load(in_buf, t.utf8, 20)
    assert_eq(rfc3339_parse(in_buf, 20, val), 0)
    assert_eq(val[0], 1709209805)
}

test "rfc3339: parse a negative epoch" {
    let t: string = "1969-12-31T23:59:59Z"
    load(in_buf, t.utf8, 20)
    assert_eq(rfc3339_parse(in_buf, 20, val), 0)
    assert_eq(val[0], 0 - 1)
}

test "rfc3339: parse rejects a month or day outside the calendar" {
    let m: string = "2026-13-24T12:30:05Z"
    load(in_buf, m.utf8, 20)
    assert_eq(rfc3339_parse(in_buf, 20, val), 0 - 1)

    let d: string = "2026-02-30T12:30:05Z"
    load(in_buf, d.utf8, 20)
    assert_eq(rfc3339_parse(in_buf, 20, val), 0 - 1)

    let april: string = "2026-04-31T00:00:00Z"
    load(in_buf, april.utf8, 20)
    assert_eq(rfc3339_parse(in_buf, 20, val), 0 - 1)
}

test "rfc3339: parse rejects a malformed separator or a missing zone" {
    let bad_sep: string = "2026-09-24X12:30:05Z"
    load(in_buf, bad_sep.utf8, 20)
    assert_eq(rfc3339_parse(in_buf, 20, val), 0 - 1)

    let no_zone: string = "2026-09-24T12:30:05"
    load(in_buf, no_zone.utf8, 19)
    assert_eq(rfc3339_parse(in_buf, 19, val), 0 - 1)
}

test "rfc3339: parse rejects a bad offset and trailing junk" {
    let bad_off: string = "2026-09-24T12:30:05+2:00"
    load(in_buf, bad_off.utf8, 24)
    assert_eq(rfc3339_parse(in_buf, 24, val), 0 - 1)

    let junk: string = "2026-09-24T12:30:05Zxx"
    load(in_buf, junk.utf8, 23)
    assert_eq(rfc3339_parse(in_buf, 23, val), 0 - 1)
}

test "rfc3339: a leap century parses, a non-leap century does not" {
    let leap: string = "2000-02-29T12:30:05Z"
    load(in_buf, leap.utf8, 20)
    assert_eq(rfc3339_parse(in_buf, 20, val), 0)
    assert_eq(val[0], 951827405)

    let not_leap: string = "2100-02-29T00:00:00Z"
    load(in_buf, not_leap.utf8, 20)
    assert_eq(rfc3339_parse(in_buf, 20, val), 0 - 1)
}

test "rfc3339: parse a first-millennium year exercises the negative era" {
    let t: string = "0000-01-01T00:00:00Z"
    load(in_buf, t.utf8, 20)
    assert_eq(rfc3339_parse_ms(in_buf, 20, val), 0)
    let ms = val[0]
    assert_eq(rfc3339_format_ms(ms, out_buf), 24)
    assert_eq(same(out_buf, t.utf8, 19), 1)
}

test "rfc3339: a fraction longer than milliseconds keeps the first three digits" {
    let t: string = "2026-09-24T12:30:05.123456Z"
    load(in_buf, t.utf8, 27)
    assert_eq(rfc3339_parse_ms(in_buf, 27, val), 0)
    assert_eq(val[0], 1790253005123)
}

test "rfc3339: a short fraction is padded with zeros" {
    let one: string = "2026-09-24T12:30:05.1Z"
    load(in_buf, one.utf8, 22)
    assert_eq(rfc3339_parse_ms(in_buf, 22, val), 0)
    assert_eq(val[0], 1790253005100)

    let two: string = "2026-09-24T12:30:05.12Z"
    load(in_buf, two.utf8, 23)
    assert_eq(rfc3339_parse_ms(in_buf, 23, val), 0)
    assert_eq(val[0], 1790253005120)
}

test "rfc3339: parse rejects non-digits in each fixed field" {
    let year: string = "20a6-09-24T12:30:05Z"
    load(in_buf, year.utf8, 20)
    assert_eq(rfc3339_parse(in_buf, 20, val), 0 - 1)

    let month: string = "2026-0a-24T12:30:05Z"
    load(in_buf, month.utf8, 20)
    assert_eq(rfc3339_parse(in_buf, 20, val), 0 - 1)

    let time: string = "2026-09-24T12:3a:05Z"
    load(in_buf, time.utf8, 20)
    assert_eq(rfc3339_parse(in_buf, 20, val), 0 - 1)
}

test "rfc3339: parse rejects a bad date or time separator and a bad T" {
    let date: string = "2026-09/24T12:30:05Z"
    load(in_buf, date.utf8, 20)
    assert_eq(rfc3339_parse(in_buf, 20, val), 0 - 1)

    let blank: string = "2026-09-24 12:30:05Z"
    load(in_buf, blank.utf8, 20)
    assert_eq(rfc3339_parse(in_buf, 20, val), 0 - 1)
}

test "rfc3339: parse rejects an hour outside the day" {
    let t: string = "2026-09-24T24:00:00Z"
    load(in_buf, t.utf8, 20)
    assert_eq(rfc3339_parse(in_buf, 20, val), 0 - 1)
}

test "rfc3339: parse rejects a fractional dot with no digits and a fraction with no zone" {
    let dot: string = "2026-09-24T12:30:05.Z"
    load(in_buf, dot.utf8, 21)
    assert_eq(rfc3339_parse(in_buf, 21, val), 0 - 1)

    let no_zone: string = "2026-09-24T12:30:05.123"
    load(in_buf, no_zone.utf8, 23)
    assert_eq(rfc3339_parse(in_buf, 23, val), 0 - 1)
}

test "rfc3339: parse rejects a malformed or out-of-range offset" {
    let digit: string = "2026-09-24T12:30:05+0a:00"
    load(in_buf, digit.utf8, 25)
    assert_eq(rfc3339_parse(in_buf, 25, val), 0 - 1)

    let colon: string = "2026-09-24T12:30:05+02-00"
    load(in_buf, colon.utf8, 25)
    assert_eq(rfc3339_parse(in_buf, 25, val), 0 - 1)

    let range: string = "2026-09-24T12:30:05+24:00"
    load(in_buf, range.utf8, 25)
    assert_eq(rfc3339_parse(in_buf, 25, val), 0 - 1)

    let low: string = "2026-09-24T12:30:05+02:0a"
    load(in_buf, low.utf8, 25)
    assert_eq(rfc3339_parse(in_buf, 25, val), 0 - 1)
}

test "rfc3339: parse rejects an unknown zone character" {
    let t: string = "2026-09-24T12:30:05X"
    load(in_buf, t.utf8, 20)
    assert_eq(rfc3339_parse(in_buf, 20, val), 0 - 1)
}

test "rfc3339: the seconds wrapper floors a negative fractional epoch" {
    let t: string = "1969-12-31T23:59:59.500Z"
    load(in_buf, t.utf8, 24)
    assert_eq(rfc3339_parse(in_buf, 24, val), 0)
    assert_eq(val[0], 0 - 1)
}

test "rfc3339: the seconds wrapper propagates a parse failure" {
    let t: string = "2026-13-24T12:30:05Z"
    load(in_buf, t.utf8, 20)
    assert_eq(rfc3339_parse(in_buf, 20, val), 0 - 1)
}

test "rfc3339: format and parse round trip" {
    assert_eq(rfc3339_format(1790253005, out_buf), 20)
    assert_eq(rfc3339_parse(out_buf, 20, val), 0)
    assert_eq(val[0], 1790253005)

    assert_eq(rfc3339_format_ms(1790253005123, out_buf), 24)
    assert_eq(rfc3339_parse_ms(out_buf, 24, val), 0)
    assert_eq(val[0], 1790253005123)
}
