//
// Test of net6.snd: the sockaddr_in6 byte layout, and a real IPv6 loopback (::1) round
// trip proving AF_INET6 sockets connect through the address-family-agnostic net.snd calls.

include "x86_64/linux/net6.snd"
include "x86_64/linux/syscall-nums.snd"
include "x86_64/linux/testing.snd"

// Raw read/write/close so this test's coverage scope stays on net6.snd alone (pulling in
// io.snd would count its splice helpers we do not exercise here).
fn n6_write(fd: i64, buf: i64, n: i64) -> i64 { syscall(SYS_write, fd, buf, n) }
fn n6_read(fd: i64, buf: i64, n: i64) -> i64 { syscall(SYS_read, fd, buf, n) }
fn n6_close(fd: i64) -> i64 { syscall(SYS_close, fd) }

let mut n6_addr[16]
let mut n6_sa[4]
let mut n6_out[16]

test "net6: sockaddr_in6 byte layout (family, big-endian port, address)" {
    let mut i = 0
    for i < 16 { poke8(n6_addr + i, 0); i = i + 1 }
    poke8(n6_addr + 15, 1)                       // ::1
    sockaddr_in6_build(n6_sa, n6_addr, 443)
    assert_eq(peek8(n6_sa + 0), 10)              // AF_INET6
    assert_eq(peek8(n6_sa + 1), 0)
    assert_eq(peek8(n6_sa + 2), 0x01)            // port 443 = 0x01BB, big-endian
    assert_eq(peek8(n6_sa + 3), 0xbb)
    assert_eq(peek8(n6_sa + 23), 1)              // last address byte of ::1
    assert_eq(sockaddr_in6_port(n6_sa), 443)
    sockaddr_in6_ip(n6_sa, n6_out)
    i = 0
    for i < 16 { assert_eq(peek8(n6_out + i), peek8(n6_addr + i)); i = i + 1 }
}

test "net6: an IPv6 loopback round trip over ::1" {
    let mut i = 0
    for i < 16 { poke8(n6_addr + i, 0); i = i + 1 }
    poke8(n6_addr + 15, 1)                       // ::1
    let port = 55611
    let sfd = sock(AF_INET6, SOCK_STREAM, 0)
    set_reuseaddr(sfd)
    sockaddr_in6_build(n6_sa, n6_addr, port)
    bind_sock(sfd, n6_sa, 28)
    listen_sock(sfd, 4)

    let pid = syscall(SYS_fork)
    if pid == 0 {
        let cfd = sock(AF_INET6, SOCK_STREAM, 0)
        let ca[4]
        sockaddr_in6_build(ca, n6_addr, port)
        if connect_sock(cfd, ca, 28) < 0 { syscall(SYS_exit, 2) }
        n6_write(cfd, "hi6", 3)
        n6_close(cfd)
        syscall(SYS_exit, 0)
    }
    let afd = accept_sock(sfd, 0, 0)
    if afd < 0 { n6_close(sfd); assert_eq(1, 0) }
    let buf[8]
    let n = n6_read(afd, buf, 8)
    get_original_dst6(afd, n6_sa)                // exercises the getsockopt path (errors here)
    assert_eq(n, 3)
    assert_eq(peek8(buf + 0), 104)               // 'h'
    n6_close(afd); n6_close(sfd)
    let st[1]
    syscall(SYS_wait4, pid, st, 0, 0)
}
