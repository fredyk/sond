// SPDX-License-Identifier: Apache-2.0
// Tests for the HTTP API server library.
//   sond test lib/x86_64/linux/http-api_test.snd

include "x86_64/linux/http-api.snd"
include "x86_64/linux/http-server.snd"
include "x86_64/linux/testing.snd"
include "x86_64/linux/bytes.snd"
include "x86_64/linux/net.snd"
include "x86_64/linux/io.snd"
include "x86_64/linux/poll.snd"
include "x86_64/linux/map.snd"

// prctl(2): the server child asks to be killed if the test process goes away.
let PRCTL_SYS = 157
let PR_SET_PDEATHSIG = 1
let SIGKILL = 9

// ── percent_decode ────────────────────────────────────────────────

test "percent_decode leaves plain text untouched" {
    let s = bytes_from_str("hello")
    let out = percent_decode(s)
    assert_eq(bytes_eq(out, bytes_from_str("hello")), 1)
}

test "percent_decode decodes plus as space" {
    let s = bytes_from_str("hello+world")
    let out = percent_decode(s)
    assert_eq(bytes_eq(out, bytes_from_str("hello world")), 1)
}

test "percent_decode decodes hex sequences" {
    let s = bytes_from_str("a%21b%2Fc")
    let out = percent_decode(s)
    assert_eq(bytes_eq(out, bytes_from_str("a!b/c")), 1)
}

test "percent_decode handles uppercase hex" {
    let s = bytes_from_str("%41%42%43")
    let out = percent_decode(s)
    assert_eq(bytes_eq(out, bytes_from_str("ABC")), 1)
}

test "percent_decode leaves bare percent at end" {
    let s = bytes_from_str("abc%")
    let out = percent_decode(s)
    assert_eq(bytes_eq(out, bytes_from_str("abc%")), 1)
}

test "percent_decode leaves invalid hex intact" {
    let s = bytes_from_str("a%zz")
    let out = percent_decode(s)
    assert_eq(bytes_eq(out, bytes_from_str("a%zz")), 1)
}

// ── http_query_parse / http_query_get ─────────────────────────────

test "http_query_parse splits key=value pairs" {
    let qs = bytes_from_str("foo=bar&baz=qux")
    let q = http_query_parse(qs)
    let foo = http_query_get(q, "foo")
    assert_eq(bytes_eq(foo, bytes_from_str("bar")), 1)
    let baz = http_query_get(q, "baz")
    assert_eq(bytes_eq(baz, bytes_from_str("qux")), 1)
}

test "http_query_get returns empty buffer for missing key" {
    let qs = bytes_from_str("foo=bar")
    let q = http_query_parse(qs)
    let miss = http_query_get(q, "nope")
    assert_eq(bytes_len(miss), 0)
}

test "http_query_parse decodes percent-encoded values" {
    let qs = bytes_from_str("name=hello+world")
    let q = http_query_parse(qs)
    let v = http_query_get(q, "name")
    assert_eq(bytes_eq(v, bytes_from_str("hello world")), 1)
}

test "http_query_parse handles empty value" {
    let qs = bytes_from_str("key=")
    let q = http_query_parse(qs)
    let v = http_query_get(q, "key")
    assert_eq(bytes_len(v), 0)
}

test "http_query_parse handles key without equals" {
    let qs = bytes_from_str("flag")
    let q = http_query_parse(qs)
    let v = http_query_get(q, "flag")
    assert_eq(bytes_len(v), 0)
}

// ── http_header_get_ci (case-insensitive) ─────────────────────────

test "http_header_get_ci finds header ignoring case" {
    let req = bytes_from_str("GET / HTTP/1.1\r\nContent-Type: application/json\r\nHost: example.com\r\n\r\n")
    let h = http_headers(req)
    let ct = http_header_get_ci(h, "content-type")
    assert_eq(bytes_eq(ct, bytes_from_str("application/json")), 1)
}

test "http_header_get_ci finds exact case too" {
    let req = bytes_from_str("GET / HTTP/1.1\r\nContent-Type: text/html\r\n\r\n")
    let h = http_headers(req)
    let ct = http_header_get_ci(h, "Content-Type")
    assert_eq(bytes_eq(ct, bytes_from_str("text/html")), 1)
}

test "http_header_get_ci returns empty for missing header" {
    let req = bytes_from_str("GET / HTTP/1.1\r\nHost: example.com\r\n\r\n")
    let h = http_headers(req)
    let miss = http_header_get_ci(h, "X-Custom")
    assert_eq(bytes_len(miss), 0)
}

// ── http_cookie_get ───────────────────────────────────────────────

test "http_cookie_get extracts named cookie" {
    let req = bytes_from_str("GET / HTTP/1.1\r\nCookie: session=abc123; theme=dark\r\n\r\n")
    let h = http_headers(req)
    let v = http_cookie_get(h, "session")
    assert_eq(bytes_eq(v, bytes_from_str("abc123")), 1)
}

test "http_cookie_get extracts second cookie" {
    let req = bytes_from_str("GET / HTTP/1.1\r\nCookie: session=abc123; theme=dark\r\n\r\n")
    let h = http_headers(req)
    let v = http_cookie_get(h, "theme")
    assert_eq(bytes_eq(v, bytes_from_str("dark")), 1)
}

test "http_cookie_get returns empty for missing cookie" {
    let req = bytes_from_str("GET / HTTP/1.1\r\nCookie: session=abc123\r\n\r\n")
    let h = http_headers(req)
    let v = http_cookie_get(h, "missing")
    assert_eq(bytes_len(v), 0)
}

test "http_cookie_get returns empty with no Cookie header" {
    let req = bytes_from_str("GET / HTTP/1.1\r\nHost: x\r\n\r\n")
    let h = http_headers(req)
    let v = http_cookie_get(h, "anything")
    assert_eq(bytes_len(v), 0)
}

// ── http_request_body ─────────────────────────────────────────────

test "http_request_body reads body by Content-Length" {
    let req = bytes_from_str("POST /submit HTTP/1.1\r\nContent-Length: 13\r\n\r\nhello, world!")
    let body = http_request_body(req)
    assert_eq(bytes_eq(body, bytes_from_str("hello, world!")), 1)
}

test "http_request_body returns empty for GET" {
    let req = bytes_from_str("GET / HTTP/1.1\r\nHost: x\r\n\r\n")
    let body = http_request_body(req)
    assert_eq(bytes_len(body), 0)
}

test "http_request_body handles empty body with Content-Length 0" {
    let req = bytes_from_str("POST / HTTP/1.1\r\nContent-Length: 0\r\n\r\n")
    let body = http_request_body(req)
    assert_eq(bytes_len(body), 0)
}

// ── http_response_json ────────────────────────────────────────────

test "http_response_json builds a 200 with JSON body" {
    let resp = http_response_json("200 OK", bytes_from_str("{\"ok\":true}"))
    let want_prefix = bytes_from_str("HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 11\r\n\r\n{\"ok\":true}")
    assert_eq(bytes_eq(resp, want_prefix), 1)
}

test "http_response_status builds bodyless response" {
    let resp = http_response_status("404 Not Found")
    let want = bytes_from_str("HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\n\r\n")
    assert_eq(bytes_eq(resp, want), 1)
}

test "http_response_redirect builds a 303 with Location" {
    let resp = http_response_redirect("/new-location")
    let want = bytes_from_str("HTTP/1.1 303 See Other\r\nLocation: /new-location\r\nContent-Length: 0\r\n\r\n")
    assert_eq(bytes_eq(resp, want), 1)
}

// ── http_set_cookie ───────────────────────────────────────────────

test "http_set_cookie builds Set-Cookie header with defaults" {
    let hdr = http_set_cookie("session", "abc123", 3600)
    let want = bytes_from_str("Set-Cookie: session=abc123; Path=/; HttpOnly; SameSite=Lax; Max-Age=3600")
    assert_eq(bytes_eq(hdr, want), 1)
}

test "http_set_cookie includes Secure when flag is 1" {
    let hdr = http_set_cookie("tok", "x", 60)
    let hdr2 = http_set_cookie_secure("tok", "x", 60)
    let want = bytes_from_str("Set-Cookie: tok=x; Path=/; HttpOnly; SameSite=Lax; Max-Age=60; Secure")
    assert_eq(bytes_eq(hdr2, want), 1)
}

// ── http_route_match ──────────────────────────────────────────────

test "http_route_match matches exact path" {
    let pat = bytes_from_str("/api/health")
    let path = bytes_from_str("/api/health")
    assert_eq(http_route_match(pat, path), 1)
}

test "http_route_match fails mismatch" {
    let pat = bytes_from_str("/api/health")
    let path = bytes_from_str("/api/users")
    assert_eq(http_route_match(pat, path), 0)
}

test "http_route_match extracts {id} segment" {
    let pat = bytes_from_str("/api/users/{id}")
    let path = bytes_from_str("/api/users/42")
    assert_eq(http_route_match(pat, path), 1)
    let id = http_route_param(pat, path, "id")
    assert_eq(bytes_eq(id, bytes_from_str("42")), 1)
}

test "http_route_match extracts {id} from nested path" {
    let pat = bytes_from_str("/api/threads/{id}/messages")
    let path = bytes_from_str("/api/threads/7/messages")
    assert_eq(http_route_match(pat, path), 1)
    let id = http_route_param(pat, path, "id")
    assert_eq(bytes_eq(id, bytes_from_str("7")), 1)
}

test "http_route_match fails on segment count mismatch" {
    let pat = bytes_from_str("/api/{a}/{b}")
    let path = bytes_from_str("/api/1")
    assert_eq(http_route_match(pat, path), 0)
}

test "http_route_match fails when wildcard doesn't match" {
    let pat = bytes_from_str("/api/{id}")
    let path = bytes_from_str("/api/")
    assert_eq(http_route_match(pat, path), 0)
}

// ── http_method_allowed (405 vs 404) ──────────────────────────────

test "http_method_allowed returns 1 for registered method" {
    let allowed = bytes_from_str("GET,POST")
    assert_eq(http_method_allowed(allowed, "GET"), 1)
}

test "http_method_allowed returns 0 for unregistered method" {
    let allowed = bytes_from_str("GET,POST")
    assert_eq(http_method_allowed(allowed, "DELETE"), 0)
}

// ── Integration: real TCP client/server ───────────────────────────

test "full request: GET returns JSON body" {
    let port = 55710
    let ip = 0x7f000001
    let sfd = sock(AF_INET, SOCK_STREAM, 0)
    set_reuseaddr(sfd)
    let sa[2]
    sockaddr_in_build(sa, ip, port)
    bind_sock(sfd, sa, 16)
    listen_sock(sfd, 4)

    let pid = syscall(SYS_fork)
    if pid == 0 {
        // CLIENT
        let cfd = sock(AF_INET, SOCK_STREAM, 0)
        let ca[2]
        sockaddr_in_build(ca, ip, port)
        if connect_sock(cfd, ca, 16) < 0 { syscall(SYS_exit, 2) }
        let rq = bytes_from_str("GET /api/data HTTP/1.1\r\nHost: test\r\n\r\n")
        write_buf(cfd, bytes_data(rq), bytes_len(rq))
        let rbuf[512]
        let rn = read_buf(cfd, rbuf, 512)
        close_fd(cfd)
        let resp = bytes_from_raw(rbuf, rn)
        // Check response starts with 200 and contains JSON
        let ok = bytes_from_str("HTTP/1.1 200 OK")
        let mut ok = 1
        let mut i = 0
        for i < 15 {
            if bytes_get(resp, i) != bytes_get(ok, i) { ok = 0 }
            i = i + 1
        }
        if ok == 1 { syscall(SYS_exit, 0) } else { syscall(SYS_exit, 1) }
    }
    // SERVER
    let afd = accept_sock(sfd, 0, 0)
    let rb[256]
    read_buf(afd, rb, 256)
    let body = bytes_from_str("{\"status\":\"ok\"}")
    let resp = http_response_json("200 OK", body)
    write_buf(afd, bytes_data(resp), bytes_len(resp))
    http_finish(afd)
    close_fd(sfd)
    let st[1]
    syscall(SYS_wait4, pid, st, 0, 0)
    assert_eq((st[0] >> 8) & 255, 0)
}

