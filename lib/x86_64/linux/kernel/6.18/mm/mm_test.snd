// lib/x86_64/linux/kernel/6.18/mm/mm_test.snd
//
// Tests for the page allocator and kmalloc subsystem.
// Run with: sond test lib/x86_64/linux/kernel/6.18/mm/mm_test.snd

include "x86_64/linux/syscall-nums.snd"
include "x86_64/linux/testing.snd"
include "x86_64/linux/kernel/6.18/mm/page_alloc.snd"

// ---------------------------------------------------------------------------
// Helpers (available across all test blocks)
// ---------------------------------------------------------------------------

// Zero n bytes starting at address p. Called after mmap.
fn __memzero(p: i64, n: i64) {
    let mut i = 0
    for i < n {
        poke8(p + i, 0)
        i = i + 1
    }
}

// Set up the page allocator with a new mmap'd backing store.
// Returns the test address (0 = mmap failed).
fn __setup_allocator(npages: i64) -> i64 {
    // Map one page MORE than the pool needs. The extra first page holds the
    // allocator's bitmap, and the pool starts after it.
    //
    // Putting the bitmap inside the pool (at base + 1, say) looks harmless
    // because the bitmap is only a few bytes, but the page it sits in is still
    // handed out by alloc_page. The first caller to write into that page
    // overwrites the bitmap that tracks it, and from then on the allocator is
    // reasoning about its own corrupted state.
    let reg = syscall(SYS_mmap, 0, (npages + 1) * 4096, 3, 34, 0 - 1, 0)
    if reg == 0 {
        return 0
    }
    __memzero(reg, (npages + 1) * 4096)

    let bitmap = reg                 // first page: bitmap only
    let base   = reg + 4096          // pool starts on the next page boundary
    page_alloc_init(bitmap, base, npages)
    // The slab list points into the OLD region, which this call has just
    // replaced. Reset it too, or the next kmalloc scan walks freed memory.
    kmalloc_init()
    reg
}


// ---------------------------------------------------------------------------
// Test: alloc_page returns distinct and 4096-aligned addresses
// ---------------------------------------------------------------------------

test "alloc_page returns distinct and aligned addresses" {
    let reg = __setup_allocator(64)
    assert(reg != 0)

    let p1 = alloc_page()
    assert(p1 != 0)
    let p2 = alloc_page()
    assert(p2 != 0)
    let p3 = alloc_page()
    assert(p3 != 0)

    // Each address must be 4096-aligned.
    assert(p1 % 4096 == 0)
    assert(p2 % 4096 == 0)
    assert(p3 % 4096 == 0)

    // Addresses must be distinct.
    assert_ne(p1, p2)
    assert_ne(p2, p3)
    assert_ne(p1, p3)

    // Each address must point into the backing store.
    assert(p1 >= reg)
    assert(p1 < reg + 64 * 4096)
    assert(p2 >= reg)
    assert(p2 < reg + 64 * 4096)
    assert(p3 >= reg)
    assert(p3 < reg + 64 * 4096)
}

// ---------------------------------------------------------------------------
// Test: after free, the page can be reallocated
// ---------------------------------------------------------------------------

test "alloc_page after free can reallocate the same page" {
    let reg = __setup_allocator(4)
    assert(reg != 0)

    let p1 = alloc_page()
    assert(p1 != 0)
    free_page(p1)

    let p2 = alloc_page()
    assert(p2 != 0)

    // After freeing all but one page, a new alloc should re-use the freed one
    // (or allocate the next one). Either way, p2 must be in-range.
    assert(p2 >= reg)
    assert(p2 < reg + 4 * 4096)
}

// ---------------------------------------------------------------------------
// Test: kmalloc returns non-overlapping pointers
// ---------------------------------------------------------------------------

include "x86_64/linux/kernel/6.18/mm/kmalloc.snd"

test "kmalloc returns non-overlapping pointers" {
    // Use a fresh backing store and init the page allocator.
    let reg = __setup_allocator(4)
    assert(reg != 0)
    // page_alloc_init already called above via __setup_allocator.

    let a = kmalloc(16)
    let b = kmalloc(32)
    let c = kmalloc(64)

    assert(a != 0)
    assert(b != 0)
    assert(c != 0)

    // All must be 8-byte aligned.
    assert(a % 8 == 0)
    assert(b % 8 == 0)
    assert(c % 8 == 0)

    // Different pointers.
    assert_ne(a, b)
    assert_ne(b, c)
    assert_ne(a, c)

    // Write and verify no overlap: write a value to the end of each region.
    // poke64(a, 111) covers [a, a+8).
    // poke64(b, 222) covers [b, b+8).
    // poke64(c, 333) covers [c, c+8).
    poke64(a, 111)
    poke64(b, 222)
    poke64(c, 333)

    assert_eq(peek64(a), 111)
    assert_eq(peek64(b), 222)
    assert_eq(peek64(c), 333)
}

// ---------------------------------------------------------------------------
// Test: kfree and re-alloc gives back the memory
// ---------------------------------------------------------------------------

test "kfree frees memory that can be reused" {
    let reg = __setup_allocator(2)
    assert(reg != 0)

    let a = kmalloc(32)
    assert(a != 0)
    let saved_a = a
    kfree(a)

    let b = kmalloc(32)
    assert(b != 0)
    // b should either be the same as a (best case) or a different address in-range.
    // The important thing is it's valid and in-range.
    assert(b >= reg)
    assert(b < reg + 2 * 4096)
}

// ---------------------------------------------------------------------------
// Test: allocating all pages returns 0 when exhausted
// ---------------------------------------------------------------------------

test "alloc_page returns 0 when all pages are free" {
    let reg = __setup_allocator(2)
    assert(reg != 0)

    let p1 = alloc_page()
    assert(p1 != 0)
    let p2 = alloc_page()
    assert(p2 != 0)

    // 2 pages allocated, 0 free, next should return 0.
    let p3 = alloc_page()
    assert(p3 == 0)
}

// ---------------------------------------------------------------------------
// Test: kmalloc works across many objects (multiple slabs)
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Test: kmalloc rejects invalid sizes without touching the page allocator
// ---------------------------------------------------------------------------

test "kmalloc rejects n <= 0" {
    let reg = __setup_allocator(2)
    assert(reg != 0)
    assert_eq(kmalloc(0), 0)
    assert_eq(kmalloc(-5), 0)
}

test "kmalloc rejects objects larger than MAX_OBJECT (509 bytes)" {
    let reg = __setup_allocator(2)
    assert(reg != 0)
    // 510 rounds up to 512, which is > MAX_OBJECT (509).
    assert_eq(kmalloc(510), 0)
}

// ---------------------------------------------------------------------------
// Test: kfree(0) is a documented no-op
// ---------------------------------------------------------------------------

test "kfree(0) does not crash and leaves the allocator usable" {
    let reg = __setup_allocator(2)
    assert(reg != 0)
    kfree(0)
    let a = kmalloc(16)
    assert(a != 0)
}

// ---------------------------------------------------------------------------
// Test: kfree on one of several live objects keeps the slab alive
// (the __slab_alloced(cur) == 0 branch inside kfree must NOT fire)
// ---------------------------------------------------------------------------

test "kfree on one live object of several does not discard the slab" {
    let reg = __setup_allocator(2)
    assert(reg != 0)

    let a = kmalloc(16)
    let b = kmalloc(16)
    assert(a != 0)
    assert(b != 0)

    kfree(a)   // b is still allocated, the slab must survive

    // b must still be valid and writable.
    poke64(b, 999)
    assert_eq(peek64(b), 999)

    // A same-size alloc should still succeed (room remains in the slab).
    let c = kmalloc(16)
    assert(c != 0)
}

// ---------------------------------------------------------------------------
// Test: __slab_discard unlinking a NON-head slab (prev != 0 branch)
// ---------------------------------------------------------------------------
//
// __alloc_slab always links new slabs at the HEAD of __slab_list, so the
// first slab created ends up behind the second one. Fully draining the
// first slab (while the second, the head, stays alive) forces kfree's walk
// to unlink a slab that is not __slab_list itself.

test "kfree fully draining a non-head slab unlinks it correctly" {
    let reg = __setup_allocator(3)
    assert(reg != 0)

    // 500-byte objects: sz rounds to 504, so 7 fit in one 4KiB slab page
    // ((4096 - 24) / (504 + 8) = 7). The 8th forces a second slab.
    let firsts[7]
    let mut i = 0
    for i < 7 {
        let p = kmalloc(500)
        assert(p != 0)
        firsts[i] = p
        i = i + 1
    }

    // This one lands in a brand-new slab, which becomes the new head.
    let anchor = kmalloc(500)
    assert(anchor != 0)

    // Drain every object from the first (now non-head) slab.
    i = 0
    for i < 7 {
        kfree(firsts[i])
        i = i + 1
    }

    // The pool must still work normally: a fresh alloc succeeds, and the
    // still-live object in the surviving (head) slab is untouched.
    let after = kmalloc(500)
    assert(after != 0)
    poke64(anchor, 12345)
    assert_eq(peek64(anchor), 12345)
}

// ---------------------------------------------------------------------------
// Test: kmalloc returns 0 once the page pool is exhausted
// (the __alloc_slab() == 0 branch inside kmalloc)
// ---------------------------------------------------------------------------

test "kmalloc returns 0 when a new slab is needed but no page remains" {
    let reg = __setup_allocator(1)   // exactly one page for the whole pool
    assert(reg != 0)

    let mut i = 0
    for i < 7 {
        let p = kmalloc(500)
        assert(p != 0)
        i = i + 1
    }
    // The single page is now fully committed to one slab; the 8th
    // allocation needs a second page, and there isn't one.
    assert_eq(kmalloc(500), 0)
}

// ---------------------------------------------------------------------------
// Test: alloc_page before any page_alloc_init call
// ---------------------------------------------------------------------------

test "alloc_page returns 0 before the allocator is initialized" {
    // Each test forks from the program's pristine start state, so __npages
    // is still its zero default here, exercising the __npages <= 0 guard.
    assert_eq(alloc_page(), 0)
}

// ---------------------------------------------------------------------------
// Test: free_page's invalid-address guards (each is a separate branch)
// ---------------------------------------------------------------------------

test "free_page ignores a misaligned address" {
    let reg = __setup_allocator(2)
    assert(reg != 0)
    let p1 = alloc_page()
    assert(p1 != 0)

    free_page(p1 + 1)   // misaligned: off % PAGE_SIZE != 0, must be a no-op

    // Both pages are still considered allocated: p1 was never actually
    // freed, so only one more page should be available.
    let p2 = alloc_page()
    assert(p2 != 0)
    assert_ne(p1, p2)
    assert_eq(alloc_page(), 0)
}

test "free_page ignores an address before the managed range" {
    let reg = __setup_allocator(2)
    assert(reg != 0)
    let base = reg + 4096   // __setup_allocator reserves the first page for the bitmap

    free_page(base - 4096)   // off < 0, must be a no-op

    // The allocator must be completely unaffected: both pages still free.
    let p1 = alloc_page()
    let p2 = alloc_page()
    assert(p1 != 0)
    assert(p2 != 0)
    assert_eq(alloc_page(), 0)
}

test "free_page ignores an aligned address past the managed range" {
    let reg = __setup_allocator(2)
    assert(reg != 0)
    let base = reg + 4096

    free_page(base + 2 * PAGE_SIZE)   // aligned, but idx (2) >= __npages (2)

    let p1 = alloc_page()
    let p2 = alloc_page()
    assert(p1 != 0)
    assert(p2 != 0)
    assert_eq(alloc_page(), 0)
}

test "kmalloc spans multiple slab pages" {
    // 16 pages can hold many objects (508 per slab), so kmalloc(64)
    // will use multiple slab pages in sequence.
    let reg = __setup_allocator(16)
    assert(reg != 0)

    let mut total: i64 = 0
    let mut i = 0
    for i < 300 {
        let p = kmalloc(64)
        if p != 0 {
            poke64(p, i)       // store iteration number inside object
            total = total + 1
        }
        i = i + 1
    }
    // Should have allocated many (if not all) objects, at least one slab
    // should have been created. With 16 pages and 64-byte objects, we get
    // many successful allocations.
    assert(total > 0)
}
