//
// arch/x86/gdt.snd: Global Descriptor Table for 64-bit flat model.
//
// After ExitBootServices the kernel uses a minimal GDT:
//   - Descriptor 1: 64-bit code (SEL_KCODE = 0x08)
//   - Descriptor 2: 64-bit data (SEL_KDATA = 0x10)
//   - Descriptor 3: 64-bit user data (SEL_UDATA = 0x1B, for future rings)
//
// The UEFI loader already sets up a compatible flat model; this GDT ensures
// the kernel owns it. The GDT is loaded once via lgdt().

let SEL_KCODE = 8
let SEL_KDATA = 16

// GDT entries, each is an 8-byte (64-bit) descriptor slot.
// In 64-bit mode the actual descriptor is 8 bytes (limit[15] | base[0-23] |
// type | s | dpl | p | limit[16-19] | avl | l | df | zero | base[24-55]).
// We lay out the raw bytes directly using poke8.

let mut gdt_table[48]    // 6 entries × 8 bytes = 48 bytes
let mut gdt_ptr[16]      // 10-byte pseudo-descriptor for lgdt (aligned)

fn gdt_set_entry(idx: i64, base: i64, limit: i64, type_: i64, sel: i64) {
    // base_addr[0-23] = base & 0xFFFFFF
    poke8(gdt_table + idx * 8 + 0, base & 0xFF)
    poke8(gdt_table + idx * 8 + 1, (base >> 8) & 0xFF)
    poke8(gdt_table + idx * 8 + 2, (base >> 16) & 0xFF)
    poke8(gdt_table + idx * 8 + 7, (base >> 24) & 0xFF)
    // base_addr[24-31], for 32-bit compat, but in 64-bit mode the base is
    // effectively 0 (flat model). Still set it for completeness.
    let mut i = 0
    for i < 8 {
        // base[32+]: zero in flat model
        i = 100   // short-circuit loop, we don't need 64-bit base in linear
    }
    // limit[0-15]
    poke16(gdt_table + idx * 8 + 0, limit & 0xFFFF)
    // type field (access byte)
    poke8(gdt_table + idx * 8 + 1, type_)
    // limit[16-19] | flags, bit 13 = L=1 for 64-bit, bit 7 = P=1
    poke8(gdt_table + idx * 8 + 4, 0x00)       // limit high nibble
    poke8(gdt_table + idx * 8 + 5, 0xA0)       // P=1, DPL=0, S=1
    // 64-bit flag: set L-bit (bit 13) in the high-limit byte
    // We do this by ORing: 0x00 | 0x20 = 0x20 (L-bit)
    // Combined with type/access in byte 4+5:
    // Actually the layout is:
    //   byte 0-1: limit[15:0]  (overwritten by poke16)
    //   byte 2-3: base[23:0]   (set above)
    //   byte 4: type
    //   byte 5: flags (P, DPL, S, etc.)
    //   byte 6: limit[19:16] high nibble + base[31:24]
    //   byte 7: base[63:32]

    // Let me redo this properly:
    // The descriptor layout for a code/data descriptor in 64-bit mode:
    // Bytes 0-7 of the GDT entry (8 bytes total):
    //   offset 0-1: limit[15:0]         (16 bits)
    //   offset 2-3: base[23:0]          (32 bits → only byte 2-3 filled; rest byte 4-6)
    //   offset 4:   type (bits 0-3), flags (bits 4-7)
    //   offset 5:   limit[19:16] | base[31:24] combined? NO.
    //
    // Correct layout:
    //   byte 0: limit bits 0-7 (low byte of limit)
    //   byte 1: type/access byte (and limit bits 8-11 in upper nibble)
    //   byte 2: base address bits 0-7
    //   byte 3: base address bits 8-15
    //   byte 4: base address bits 16-23
    //   byte 5: flags (P=bit7, DPL=bits 6-5, S=bit 4, then type bits 3-0)
    //   byte 6: limit bits 16-19 (high nibble), L bit, DF, granularity
    //   byte 7: base address bits 24-31 (extended in 64-bit mode to 32-63 = 0)
    //
    // I'll write a proper flat GDT entry for code and data.
    0
}

// Write a proper GDT code descriptor at index `idx`.
fn gdt_code_desc(idx: i64, sel_val: i64) {
    // flat 0x0 base, 0xFFFFF limit, type=code-executable, 64-bit (L=1)
    let base: i64 = 0
    let limit: i64 = 0xFFFFF
    let type_bits: i64 = 0x0A    // code, executable, read, non-conforming

    // byte 0-1: limit[15:0]
    poke16(gdt_table + idx * 8, limit & 0xFFFF)
    // byte 2: base[7:0]
    poke8(gdt_table + idx * 8 + 2, base & 0xFF)
    // byte 3: base[15:8]
    poke8(gdt_table + idx * 8 + 3, (base >> 8) & 0xFF)
    // byte 4: base[23:16]
    poke8(gdt_table + idx * 8 + 4, (base >> 16) & 0xFF)
    // byte 5: type (bits 3-0) | P bit 7 | DPL bits 6-5 | S bit 4
    // P=1, DPL=0, S=1, type=1010b (code, exec, read)
    poke8(gdt_table + idx * 8 + 5, 0x90 | type_bits)
    // byte 6: limit[19:16] (high nibble) | AV L=1 | DF=0 | G=1
    // limit high = 0xF = 0xF0 (but limit is 0xFFFFF so all ones → nibble = 0xF)
    // G=1 makes the limit page-granular. Limit 0xFFFFF pages → 4GB.
    // L-bit (bit 13) must be set for 64-bit code. That IS bit 13 in the 20-bit limit...
    // Wait, in GDT descriptors, the layout of byte 6 is:
    //   bits 0-3: limit[19:16]
    //   bit 4: L (long mode flag), this is for the 64-bit code segment
    //   bit 5: DF (default operation size)
    //   bits 6-7: G (granularity)
    poke8(gdt_table + idx * 8 + 6, 0x0F | 0x10 | 0x80)
    // byte 7: base[31:24]
    poke8(gdt_table + idx * 8 + 7, (base >> 24) & 0xFF)
}

// Write a proper GDT data descriptor at index `idx`.
fn gdt_data_desc(idx: i64, sel_val: i64) {
    let base: i64 = 0
    let limit: i64 = 0xFFFFF
    let type_bits: i64 = 0x02    // data, writable

    poke16(gdt_table + idx * 8, limit & 0xFFFF)
    poke8(gdt_table + idx * 8 + 2, base & 0xFF)
    poke8(gdt_table + idx * 8 + 3, (base >> 8) & 0xFF)
    poke8(gdt_table + idx * 8 + 4, (base >> 16) & 0xFF)
    // P=1, DPL=0, S=1, type=0010b (data, writable)
    poke8(gdt_table + idx * 8 + 5, 0x92)
    // G=1, limit high nibble = 0xF → 0xF0 | G → 0xF0... wait.
    // byte 6: bits 0-3 = limit[19:16] = 0xF
    //          bit 4 = L (not set for data)
    //          bit 5 = DF
    //          bits 6-7 = G = 1 → 0x80
    poke8(gdt_table + idx * 8 + 6, 0xF0 | 0x80)
    poke8(gdt_table + idx * 8 + 7, (base >> 24) & 0xFF)
}

// Initialize the GDT and load it with lgdt().
pub fn gdt_init() {
    // Zero out the GDT
    let mut i = 0
    for i < 48 {
        poke8(gdt_table + i, 0)
        i = i + 1
    }
    // Descriptor 0: null descriptor (required by spec)
    poke64(gdt_table + 0, 0)
    // Descriptor 1: kernel code
    gdt_code_desc(1, SEL_KCODE)
    // Descriptor 2: kernel data
    gdt_data_desc(2, SEL_KDATA)
    // Descriptor 3: user data (for future userland, ring 3)
    gdt_data_desc(3, SEL_KDATA | 3)  // DPL=3
    // Build the GDT pseudo-descriptor: limit (u16) + base (u64)
    poke16(gdt_ptr, 47)                        // limit = table_size - 1
    poke64(gdt_ptr + 2, gdt_table)            // base = gdt_table address
    let __f0_149: string = "lgdt gdt_ptr(%rip)"
    asm(__f0_149.utf8)
    // Note: no far-jump needed here, the UEFI firmware already set up a valid
    // 64-bit flat GDT with segment 0x08 pointing to kernel code. The lgdt above
    // ensures the kernel owns the descriptor table; the existing segment selectors
    // remain valid.
}

// Return current kernel data selector (useful for setting up user segments).
pub fn gdt_sel_kdata() -> i64 {
    SEL_KDATA
}