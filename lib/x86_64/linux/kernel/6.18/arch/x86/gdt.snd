//
// arch/x86/gdt.snd: Global Descriptor Table for 64-bit flat model.
//
// After ExitBootServices the kernel uses a minimal GDT:
//   - Descriptor 1: 64-bit code (SEL_KCODE = 0x08)
//   - Descriptor 2: kernel data (SEL_KDATA = 0x10)
//   - Descriptor 3: user data   (SEL_UDATA = 0x1B, ring 3, for future userland)
//
// The UEFI loader already sets up a compatible flat model; this GDT ensures the kernel owns it.
//
// FILLING the table is arithmetic on bytes, and LOADING it is one privileged instruction. They
// are separate functions on purpose: `gdt_build` runs anywhere, so gdt_test.snd checks every
// descriptor byte by byte on a hosted machine, and `gdt_init` is that plus the `lgdt`.
//
// Descriptor layout, 8 bytes:
//   byte 0-1: limit[15:0]
//   byte 2-4: base[23:0]
//   byte 5:   access: P<<7 | DPL<<5 | S<<4 | type
//   byte 6:   limit[19:16] | AVL<<4 | L<<5 | D/B<<6 | G<<7
//   byte 7:   base[31:24]

let SEL_KCODE = 8
let SEL_KDATA = 16
let SEL_UDATA = 27      // entry 3 (0x18) requested at ring 3 (RPL=3)

let TIPO_CODE = 0x0A    // code, readable, non-conforming
let TIPO_DATA = 0x02    // data, writable, grows up

// GDT entries, each an 8-byte descriptor slot.
let mut gdt_table[48]    // 6 entries x 8 bytes = 48 bytes
let mut gdt_ptr[16]      // 10-byte pseudo-descriptor for lgdt (aligned)

// Write one flat descriptor: base 0, limit 4 GiB in 4 KiB pages.
//
// The limit is 20 bits and does not fit in one field: the low 16 go in bytes 0-1 and the top 4
// in the low nibble of byte 6. Writing that nibble as 0xF0 instead of 0x0F leaves the limit at
// 0x0FFFF, which with G=1 is 256 MiB, and the fault that follows lands on some access far from
// here.
fn gdt_desc(idx: i64, tipo: i64, dpl: i64, l: i64, db: i64) {
    let base: i64 = 0
    let limit: i64 = 0xFFFFF
    let e = gdt_table + idx * 8
    poke16(e, limit & 0xFFFF)
    poke8(e + 2, base & 0xFF)
    poke8(e + 3, (base >> 8) & 0xFF)
    poke8(e + 4, (base >> 16) & 0xFF)
    // P=1, S=1: present, and a code/data segment rather than a system one.
    poke8(e + 5, 0x80 | (dpl << 5) | 0x10 | tipo)
    // AVL stays 0. G=1 makes the limit count pages.
    poke8(e + 6, ((limit >> 16) & 0x0F) | (l << 5) | (db << 6) | 0x80)
    poke8(e + 7, (base >> 24) & 0xFF)
}

// Fill the table and the pseudo-descriptor. No privilege, no side effects outside these two
// buffers, and idempotent: every byte is written, never ORed into what was there.
pub fn gdt_build() {
    for i in 0..48 { poke8(gdt_table + i, 0) }
    // Descriptor 0 stays null: the processor requires it and refuses a selector of 0.
    // Descriptor 1: kernel code. L=1 is what makes it 64-bit, and L=1 demands D=0.
    gdt_desc(1, TIPO_CODE, 0, 1, 0)
    // Descriptors 2 and 3: data. L is not defined for data segments, so it stays 0.
    gdt_desc(2, TIPO_DATA, 0, 0, 1)
    // Ring 3, or a userland selector would name a descriptor userland cannot load.
    gdt_desc(3, TIPO_DATA, 3, 0, 1)
    // Pseudo-descriptor: limit (u16) + base (u64). The limit is the size MINUS ONE, so it names
    // the last byte of the table and not the first byte after it.
    poke16(gdt_ptr, 47)
    poke64(gdt_ptr + 2, gdt_table)
}

// Build the GDT and load it.
pub fn gdt_init() {
    gdt_build()
    asm("lgdt gdt_ptr(%rip)")
    // No far jump: the UEFI firmware already left a valid 64-bit flat GDT with 0x08 on kernel
    // code, so the selectors in use stay valid across the load. What changes is who owns the
    // table.
}

// The kernel data selector.
pub fn gdt_sel_kdata() -> i64 {
    SEL_KDATA
}

// The user data selector: entry 3 at ring 3. `SEL_KDATA | 3` is not this: that names the KERNEL
// entry requested from ring 3, which is exactly the request the processor refuses.
pub fn gdt_sel_udata() -> i64 {
    SEL_UDATA
}
