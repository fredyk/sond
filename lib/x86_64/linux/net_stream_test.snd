// Test of net.snd TCP wrappers: real 127.0.0.1 loopback with fork.
// The child connects and sends; the parent accepts, receives, and compares. exit 0 if they match.

include "x86_64/linux/io.snd"
include "any/strings.snd"
include "x86_64/linux/net.snd"

fn puts(s: i64) { write_buf(1, s, strlen(s)) }

fn main() -> i64 {
    let port = 47123
    let ip = 0x7f000001   // 127.0.0.1

    let sfd = sock(AF_INET, SOCK_STREAM, 0)
    let __f0_14: string = "FAIL socket\n"
    if sfd < 0 { let __b0_14: string = __f0_14.utf8 puts(__b0_14.utf8) return 1 }
    set_reuseaddr(sfd)
    let sa[2]
    sockaddr_in_build(sa, ip, port)
    let __f0_19: string = "FAIL bind\n"
    if bind_sock(sfd, sa, 16) < 0 { let __b0_18: string = __f0_19.utf8 puts(__b0_18.utf8) return 1 }
    let __f0_21: string = "FAIL listen\n"
    if listen_sock(sfd, 4) < 0 { let __b0_19: string = __f0_21.utf8 puts(__b0_19.utf8) return 1 }

    let pid = syscall(SYS_fork)
    if pid == 0 {
        // child: connects and sends
        let cfd = sock(AF_INET, SOCK_STREAM, 0)
        let ca[2]
        sockaddr_in_build(ca, ip, port)
        if connect_sock(cfd, ca, 16) < 0 {
            syscall(SYS_exit, 2)
        }
        let __f0_33: string = "hola-tcp-loopback-1234"
        write_buf(cfd, __f0_33.utf8, 22)
        close_fd(cfd)
        syscall(SYS_exit, 0)
    }

    // parent: accepts, reads, compares
    let afd = accept_sock(sfd, 0, 0)
    let __f0_41: string = "FAIL accept\n"
    if afd < 0 { let __b0_37: string = __f0_41.utf8 puts(__b0_37.utf8) return 1 }
    let buf[64]
    let n = read_buf(afd, buf, 64)
    let st[1]
    syscall(SYS_wait4, pid, st, 0, 0)

    let __f0_48: string = "FAIL recv len\n"
    if n != 22 { let __b0_43: string = __f0_48.utf8 puts(__b0_43.utf8) return 1 }
    let exp_text: string = "hola-tcp-loopback-1234"
    let exp = exp_text.utf8
    let mut i = 0
    for i < 22 {
        let __f0_54: string = "FAIL data\n"
        if peek8(buf + i) != peek8(exp + i) { let __b0_48: string = __f0_54.utf8 puts(__b0_48.utf8) return 1 }
        i = i + 1
    }

    // also test the sockaddr_in helpers
    let sa2[2]
    sockaddr_in_build(sa2, 0x0a000205, 443)   // 10.0.2.5:443
    let __f0_62: string = "FAIL sa ip\n"
    if sockaddr_in_ip(sa2) != 0x0a000205 { let __b0_55: string = __f0_62.utf8 puts(__b0_55.utf8) return 1 }
    let __f0_64: string = "FAIL sa port\n"
    if sockaddr_in_port(sa2) != 443 { let __b0_56: string = __f0_64.utf8 puts(__b0_56.utf8) return 1 }

    close_fd(afd)
    close_fd(sfd)
    let __f0_69: string = "OK net.snd TCP loopback\n"
    puts(__f0_69.utf8)
    0
}
