// Test of net.snd TCP wrappers: real 127.0.0.1 loopback with fork.
// The child connects and sends; the parent accepts, receives, and compares. exit 0 if they match.

include "x86_64/linux/io.snd"
include "any/strings.snd"
include "x86_64/linux/net.snd"

fn puts(s: i64) { write_buf(1, s, strlen(s)) }

fn main() -> i64 {
    let port = 47123
    let ip = 0x7f000001   // 127.0.0.1

    let sfd = sock(AF_INET, SOCK_STREAM, 0)
    if sfd < 0 { puts("FAIL socket\n") return 1 }
    set_reuseaddr(sfd)
    let sa[2]
    sockaddr_in_build(sa, ip, port)
    if bind_sock(sfd, sa, 16) < 0 { puts("FAIL bind\n") return 1 }
    if listen_sock(sfd, 4) < 0 { puts("FAIL listen\n") return 1 }

    let pid = syscall(SYS_fork)
    if pid == 0 {
        // child: connects and sends
        let cfd = sock(AF_INET, SOCK_STREAM, 0)
        let ca[2]
        sockaddr_in_build(ca, ip, port)
        if connect_sock(cfd, ca, 16) < 0 {
            syscall(SYS_exit, 2)
        }
        write_buf(cfd, "hola-tcp-loopback-1234", 22)
        close_fd(cfd)
        syscall(SYS_exit, 0)
    }

    // parent: accepts, reads, compares
    let afd = accept_sock(sfd, 0, 0)
    if afd < 0 { puts("FAIL accept\n") return 1 }
    let buf[64]
    let n = read_buf(afd, buf, 64)
    let st[1]
    syscall(SYS_wait4, pid, st, 0, 0)

    if n != 22 { puts("FAIL recv len\n") return 1 }
    let exp = "hola-tcp-loopback-1234"
    let mut i = 0
    for i < 22 {
        if peek8(buf + i) != peek8(exp + i) { puts("FAIL data\n") return 1 }
        i = i + 1
    }

    // also test the sockaddr_in helpers
    let sa2[2]
    sockaddr_in_build(sa2, 0x0a000205, 443)   // 10.0.2.5:443
    if sockaddr_in_ip(sa2) != 0x0a000205 { puts("FAIL sa ip\n") return 1 }
    if sockaddr_in_port(sa2) != 443 { puts("FAIL sa port\n") return 1 }

    close_fd(afd)
    close_fd(sfd)
    puts("OK net.snd TCP loopback\n")
    0
}
