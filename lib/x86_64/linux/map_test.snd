//   sond test lib/x86_64/linux/map_test.snd
include "x86_64/linux/map.snd"
include "x86_64/linux/testing.snd"

test "a new map has no keys" {
    let m = map_new()
    let __s0_6: string = "x"
    assert_eq(map_has(m, bytes_from_cstr(__s0_6.utf8)), 0)
    let __s1_8: string = "x"
    assert_eq(map_get(m, bytes_from_cstr(__s1_8.utf8), 0 - 1), 0 - 1)
}
test "set then get" {
    let m = map_new()
    let __lit0: string = "width"
    map_set(m, bytes_from_cstr(__lit0.utf8), 640)
    let __lit1: string = "height"
    map_set(m, bytes_from_cstr(__lit1.utf8), 480)
    let __s2_17: string = "width"
    assert_eq(map_has(m, bytes_from_cstr(__s2_17.utf8)), 1)
    let __s3_19: string = "width"
    assert_eq(map_get(m, bytes_from_cstr(__s3_19.utf8), 0), 640)
    let __s4_21: string = "height"
    assert_eq(map_get(m, bytes_from_cstr(__s4_21.utf8), 0), 480)
}
test "set updates an existing key in place" {
    let m = map_new()
    let __lit2: string = "k"
    map_set(m, bytes_from_cstr(__lit2.utf8), 1)
    let __lit3: string = "k"
    map_set(m, bytes_from_cstr(__lit3.utf8), 2)
    let __s5_30: string = "k"
    assert_eq(map_get(m, bytes_from_cstr(__s5_30.utf8), 0), 2)
}
test "absent key returns the default" {
    let m = map_new()
    let __lit4: string = "a"
    map_set(m, bytes_from_cstr(__lit4.utf8), 5)
    let __s6_37: string = "b"
    assert_eq(map_get(m, bytes_from_cstr(__s6_37.utf8), 99), 99)
}

// Iteration is public API: callers that need to walk a map (headers, a route table) must not
// reach into its two vecs themselves. These functions are the only supported way in, so the
// layout (parallel keys/vals) stays this module's private business.

test "a new map has length zero" {
    let m = map_new()
    assert_eq(map_len(m), 0)
}

test "map_len counts the entries" {
    let m = map_new()
    let __lit5: string = "a"
    map_set(m, bytes_from_cstr(__lit5.utf8), 1)
    let __lit6: string = "b"
    map_set(m, bytes_from_cstr(__lit6.utf8), 2)
    assert_eq(map_len(m), 2)
}

test "map_len does not grow when a key is updated in place" {
    let m = map_new()
    let __lit7: string = "k"
    map_set(m, bytes_from_cstr(__lit7.utf8), 1)
    let __lit8: string = "k"
    map_set(m, bytes_from_cstr(__lit8.utf8), 2)
    assert_eq(map_len(m), 1)
}

test "map_key_at and map_val_at walk the entries in insertion order" {
    let m = map_new()
    let __lit9: string = "width"
    map_set(m, bytes_from_cstr(__lit9.utf8), 640)
    let __lit10: string = "height"
    map_set(m, bytes_from_cstr(__lit10.utf8), 480)
    let __s7_68: string = "width"
    assert_eq(bytes_eq(map_key_at(m, 0), bytes_from_cstr(__s7_68.utf8)), 1)
    assert_eq(map_val_at(m, 0), 640)
    let __s8_70: string = "height"
    assert_eq(bytes_eq(map_key_at(m, 1), bytes_from_cstr(__s8_70.utf8)), 1)
    assert_eq(map_val_at(m, 1), 480)
}
