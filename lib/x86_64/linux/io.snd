//
// lib/x86_64/linux/io.snd: file I/O on Linux syscalls. No allocator: caller provides buffers.
// API: open_file(path,flags,mode)->fd|-errno ; open_file_str(text,flags,mode)->fd|-errno ;
//      read_buf(fd,buf,n) ; write_buf(fd,buf,n) ;
//      close_fd(fd) ; read_file(path,dst,cap)->bytes|-errno ; remove_file(path)
// Open flags: O_RDONLY, O_WRONLY, O_RDWR, O_CREAT, O_TRUNC, O_APPEND.

include "syscall-nums.snd"
include "x86_64/linux/poll.snd"

// The flags `open` takes. They live here, next to open_file, rather than being redeclared by
// each caller: three modules had their own copy, and a wrong constant does not fail to compile,
// it opens the file in a different mode.
let O_RDONLY = 0
let O_WRONLY = 1
let O_RDWR = 2
let O_CREAT = 64
let O_TRUNC = 512
let O_APPEND = 1024

// A file bigger than the buffer offered for it. Reported by read_file instead of a short read.
let EFBIG = 27

fn open_file(path: i64, flags: i64, mode: i64) -> i64 {
    syscall(SYS_open, path, flags, mode)
}

fn open_file_str(path: string, flags: i64, mode: i64) -> i64 {
    open_file(path, flags, mode)
}

fn read_buf(fd: i64, buf: i64, n: i64) -> i64 {
    syscall(SYS_read, fd, buf, n)
}

fn write_buf(fd: i64, buf: i64, n: i64) -> i64 {
    syscall(SYS_write, fd, buf, n)
}

fn close_fd(fd: i64) -> i64 {
    syscall(SYS_close, fd)
}

// Deletes `path`. Returns 0, or -errno.
fn remove_file(path: i64) -> i64 {
    syscall(SYS_unlink, path)
}

// Reads the WHOLE file at `path` into `dst`, and returns how many bytes that was.
//
// Errors are negative: -errno from the kernel (-2 for a path that is not there), and -EFBIG if
// the file does not fit in `cap`. That last one is the reason this function exists. Every
// project had its own copy of this loop, and every copy filled the buffer and returned `cap`
// when the file was bigger -- handing back a valid-looking PREFIX. A configuration file cut
// mid-line still parses; it just means something else. Truncation has to be an error, because
// the caller has no other way to tell it happened.
//
// The trick for detecting it without a stat: ask for one byte MORE than the caller's buffer
// holds, using the last byte twice. If that read comes back non-empty, there was more file.
fn read_file(path: i64, dst: i64, cap: i64) -> i64 {
    let fd = open_file(path, O_RDONLY, 0)
    if fd < 0 { return fd }
    // A buffer with no room cannot hold a file, not even an empty one -- and the probe below
    // would write at `dst - 1`, OUTSIDE the caller's buffer, which is how a helpful check turns
    // into the bug it was meant to catch.
    if cap <= 0 {
        close_fd(fd)
        return 0 - EFBIG
    }
    let mut total = 0
    for total < cap {
        let n = read_buf(fd, dst + total, cap - total)
        if n < 0 {
            close_fd(fd)
            return n
        }
        if n == 0 { break }
        total = total + n
    }
    if total == cap {
        // The buffer is full. Either the file ended exactly here, or it did not: read one more
        // byte to find out. It goes over the last byte of `dst`, which is already accounted
        // for -- on the truncation path the contents are discarded anyway, and on the exact-fit
        // path this read returns 0 and writes nothing.
        let extra = read_buf(fd, dst + cap - 1, 1)
        if extra > 0 {
            close_fd(fd)
            return 0 - EFBIG
        }
    }
    close_fd(fd)
    total
}

// ── splice: zero-copy kernel forwarding (one fd must be a pipe) ──
// the relay moves data without copying to user-space.

let SPLICE_F_MOVE = 1
let SPLICE_F_MORE = 4

// splice(fd_in, NULL, fd_out, NULL, n, MOVE|MORE). Returns nbytes or -errno.
fn splice_fd(fd_in: i64, fd_out: i64, n: i64) -> i64 {
    syscall(SYS_splice, fd_in, 0, fd_out, 0, n, 5)
}

// Moves up to `n` bytes from fd_in→fd_out via a pipe (pipefd = [2] i32 array
// provided by the caller, created with SYS_pipe). Returns bytes moved (>0),
// 0 on EOF, -1 on error. fd_in/fd_out can be sockets or files.
// How long the drain half below waits for a stalled output to become writable
// before giving up, in milliseconds. A blocking splice into a full output has no
// bound, so if the peer stops reading the process hangs forever. Overridable.
let mut io_splice_idle_ms = 120000

fn splice_pump(fd_in: i64, fd_out: i64, pipefd: i64, n: i64) -> i64 {
    let rd = peek32(pipefd)
    let wr = peek32(pipefd + 4)
    let moved = splice_fd(fd_in, wr, n)
    if moved <= 0 {
        return moved
    }
    let mut out = 0
    for out < moved {
        // Drain non-blocking (MOVE|MORE|NONBLOCK = 7). A plain blocking splice here
        // would hang if fd_out's buffer is full and the peer is not draining, and a
        // POLLOUT poll before the call is not enough: splice can still try to write
        // more than the free space and block. So on EAGAIN, wait, bounded, for the
        // output to become writable and retry.
        let w = syscall(SYS_splice, rd, 0, fd_out, 0, moved - out, 7)
        if w == 0 - 11 {
            let pfd[1]
            pollfd_set(pfd, 0, fd_out, POLLOUT)
            if poll_fds(pfd, 1, io_splice_idle_ms) == 0 {
                return 0 - 1
            }
            continue
        }
        if w <= 0 {
            return 0 - 1
        }
        out = out + w
    }
    moved
}
