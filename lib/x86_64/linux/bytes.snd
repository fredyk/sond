//
// A growable byte buffer over the arena allocator, the workhorse for parsing and building
// wire data (HTTP requests/responses, tokens, output) and the basis for dynamic strings.
//
// A `Bytes` is a HANDLE: an i64 pointing at a 3-word header in the arena, [data, len, cap].
// `data` points at the backing buffer (also in the arena); `len` is bytes used; `cap` is the
// buffer's capacity. The handle stays valid across growth (only the header's `data` field is
// repointed), so callers hold a stable i64. There is no free (the arena reclaims in bulk).

include "x86_64/linux/heap.snd"

// A fresh, empty buffer with a small initial capacity.
pub fn bytes_new() -> i64 {
    let h = heap_alloc(24)            // header: data, len, cap
    let cap = 16
    poke64(h, heap_alloc(cap))        // data
    poke64(h + 8, 0)                  // len
    poke64(h + 16, cap)               // cap
    h
}

// Number of bytes in the buffer.
pub fn bytes_len(b: i64) -> i64 {
    peek64(b + 8)
}

// The byte at index `i` (0-based). Caller ensures `i < bytes_len(b)`.
pub fn bytes_get(b: i64, i: i64) -> i64 {
    peek8(peek64(b) + i)
}

// Append one byte, doubling the backing buffer (copying the old bytes) when full.
pub fn bytes_push(b: i64, byte: i64) {
    let len = peek64(b + 8)
    let cap = peek64(b + 16)
    if len >= cap {
        let ncap = cap * 2
        let ndata = heap_alloc(ncap)
        let src = peek64(b)
        let mut i = 0
        for i < len {
            poke8(ndata + i, peek8(src + i))
            i = i + 1
        }
        poke64(b, ndata)
        poke64(b + 16, ncap)
    }
    poke8(peek64(b) + len, byte)
    poke64(b + 8, len + 1)
}

// Build a buffer from a NUL-terminated C string (e.g. a `cstr("...")` literal).
pub fn bytes_from_cstr(s: i64) -> i64 {
    let b = bytes_new()
    let mut i = 0
    for peek8(s + i) != 0 {
        bytes_push(b, peek8(s + i))
        i = i + 1
    }
    b
}

// 1 if two buffers have the same length and the same bytes, else 0.
pub fn bytes_eq(a: i64, b: i64) -> i64 {
    let n = bytes_len(a)
    if n != bytes_len(b) {
        0
    } else {
        let mut i = 0
        let mut same = 1
        for i < n {
            if bytes_get(a, i) != bytes_get(b, i) {
                same = 0
            }
            i = i + 1
        }
        same
    }
}

// First index of `byte` at or after `from`, or -1 if it does not occur.
pub fn bytes_index_of_from(b: i64, byte: i64, from: i64) -> i64 {
    let n = bytes_len(b)
    let mut i = from
    for i < n {
        if bytes_get(b, i) == byte {
            return i
        }
        i = i + 1
    }
    0 - 1
}

// First index of `byte` in the buffer, or -1 if it does not occur.
pub fn bytes_index_of(b: i64, byte: i64) -> i64 {
    bytes_index_of_from(b, byte, 0)
}

// A new buffer holding bytes [start, end) of `b`.
pub fn bytes_slice(b: i64, start: i64, end: i64) -> i64 {
    let out = bytes_new()
    let mut i = start
    for i < end {
        bytes_push(out, bytes_get(b, i))
        i = i + 1
    }
    out
}

// Append every byte of a NUL-terminated C string to `b`.
pub fn bytes_append_cstr(b: i64, s: i64) {
    let mut i = 0
    for peek8(s + i) != 0 {
        bytes_push(b, peek8(s + i))
        i = i + 1
    }
}

// Append every byte of buffer `src` to `b`.
pub fn bytes_append(b: i64, src: i64) {
    let n = bytes_len(src)
    let mut i = 0
    for i < n {
        bytes_push(b, bytes_get(src, i))
        i = i + 1
    }
}

// Append the decimal ASCII of a non-negative integer to `b` (e.g. 0 -> "0", 42 -> "42").
pub fn bytes_append_int(b: i64, n: i64) {
    if n == 0 {
        bytes_push(b, 48)
    } else {
        // Push digits least-significant first into a temp buffer, then reverse into `b`.
        let tmp = bytes_new()
        let mut v = n
        for v > 0 {
            bytes_push(tmp, 48 + (v % 10))
            v = v / 10
        }
        let mut i = bytes_len(tmp)
        for i > 0 {
            bytes_push(b, bytes_get(tmp, i - 1))
            i = i - 1
        }
    }
}
