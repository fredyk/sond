//   sond test lib/x86_64/linux/vec_test.snd
include "x86_64/linux/vec.snd"
include "x86_64/linux/testing.snd"

test "a new vec is empty" {
    assert_eq(vec_len(vec_new()), 0)
}
test "push then get" {
    let v = vec_new()
    vec_push(v, 100)
    vec_push(v, 200)
    assert_eq(vec_len(v), 2)
    assert_eq(vec_get(v, 0), 100)
    assert_eq(vec_get(v, 1), 200)
}
test "set overwrites an element" {
    let v = vec_new()
    vec_push(v, 1)
    vec_set(v, 0, 42)
    assert_eq(vec_get(v, 0), 42)
}
test "growing past the initial capacity preserves elements" {
    let v = vec_new()
    let mut i = 0
    for i < 50 { vec_push(v, i * i)  i = i + 1 }
    assert_eq(vec_len(v), 50)
    assert_eq(vec_get(v, 0), 0)
    assert_eq(vec_get(v, 7), 49)
    assert_eq(vec_get(v, 49), 2401)
}
