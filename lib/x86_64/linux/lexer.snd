//
// A tokenizer over the byte buffer, the front of a self-hosted Sond compiler. It turns
// source bytes into a token stream (a Vec where each token is two words: kind, then value).
// For an integer the value is the number; for an identifier it is a Bytes handle of its text;
// for punctuation it is 0. Whitespace is skipped. A small but real lexer: numbers, C-style
// identifiers, and the arithmetic/grouping punctuation.

include "x86_64/linux/vec.snd"
include "x86_64/linux/bytes.snd"

let TK_INT = 1
let TK_IDENT = 2
let TK_PLUS = 3
let TK_MINUS = 4
let TK_STAR = 5
let TK_SLASH = 6
let TK_LPAREN = 7
let TK_RPAREN = 8

fn lx_is_digit(c: i64) -> i64 {
    if c < 48 { 0 } else { if c > 57 { 0 } else { 1 } }
}

fn lx_is_alpha(c: i64) -> i64 {
    if c == 95 {
        1
    } else {
        if c >= 65 {
            if c <= 90 { 1 } else { if c >= 97 { if c <= 122 { 1 } else { 0 } } else { 0 } }
        } else {
            0
        }
    }
}

fn lx_punct(c: i64) -> i64 {
    if c == 43 { TK_PLUS } else {
        if c == 45 { TK_MINUS } else {
            if c == 42 { TK_STAR } else {
                if c == 47 { TK_SLASH } else {
                    if c == 40 { TK_LPAREN } else { TK_RPAREN }
                }
            }
        }
    }
}

// Tokenize `s` into a token Vec (two words per token: kind, value).
pub fn lex(s: i64) -> i64 {
    let toks = vec_new()
    let n = bytes_len(s)
    let mut i = 0
    for i < n {
        let c = bytes_get(s, i)
        if c == 32 {
            i = i + 1
        } else {
            if lx_is_digit(c) == 1 {
                let mut acc = 0
                for i < n {
                    let d = bytes_get(s, i)
                    if lx_is_digit(d) == 0 { break }
                    acc = acc * 10 + (d - 48)
                    i = i + 1
                }
                vec_push(toks, TK_INT)
                vec_push(toks, acc)
            } else {
                if lx_is_alpha(c) == 1 {
                    let start = i
                    for i < n {
                        let d = bytes_get(s, i)
                        if lx_is_alpha(d) == 0 {
                            if lx_is_digit(d) == 0 { break }
                        }
                        i = i + 1
                    }
                    vec_push(toks, TK_IDENT)
                    vec_push(toks, bytes_slice(s, start, i))
                } else {
                    vec_push(toks, lx_punct(c))
                    vec_push(toks, 0)
                    i = i + 1
                }
            }
        }
    }
    toks
}

pub fn tok_count(toks: i64) -> i64 { vec_len(toks) / 2 }
pub fn tok_kind(toks: i64, i: i64) -> i64 { vec_get(toks, i * 2) }
pub fn tok_val(toks: i64, i: i64) -> i64 { vec_get(toks, i * 2 + 1) }
