//
// Tests for lib/x86_64/linux/poll.snd.
//
// This file used to be a `main` that printed FAIL and returned 1, which the suite runner does
// not collect: it only picks up files containing `test "` blocks. It had stopped compiling at
// some point -- `.utf8` applied twice, once to the literal and again to the pointer that
// produced -- and nobody found out, because nothing was running it. Rewritten as assertions so
// that it both runs and fails out loud.
//
// Everything happens over a pipe inside this process: no network, no timing beyond a bounded
// poll, nothing that depends on the machine.

include "x86_64/linux/poll.snd"
include "x86_64/linux/testing.snd"

let ONE_BYTE: string = "x"

test "an empty pipe reports no event and the wait ends by itself" {
    let p[1]
    assert(syscall(SYS_pipe, p) >= 0)
    let rd = peek32(p)
    let wr = peek32(p + 4)
    let pfd[1]
    pollfd_set(pfd, 0, rd, POLLIN)
    // 0 is the timeout, not an error: nothing to read, and the call came back anyway.
    assert_eq(poll_fds(pfd, 1, 50), 0)
    syscall(SYS_close, rd)
    syscall(SYS_close, wr)
}

test "a pipe with a byte in it reports POLLIN" {
    let p[1]
    assert(syscall(SYS_pipe, p) >= 0)
    let rd = peek32(p)
    let wr = peek32(p + 4)
    assert_eq(syscall(SYS_write, wr, ONE_BYTE.utf8, 1), 1)
    let pfd[1]
    pollfd_set(pfd, 0, rd, POLLIN)
    assert(poll_fds(pfd, 1, 1000) >= 1)
    // The event has to be POLLIN specifically: a closed peer or an error would also wake the
    // poll, and a reader that only counts the wake-ups reads from a pipe that has nothing.
    assert(pollfd_revents(pfd, 0) & POLLIN != 0)
    syscall(SYS_close, rd)
    syscall(SYS_close, wr)
}

test "a closed writer wakes the poll without POLLIN having to be the reason" {
    // POLLHUP is how the reader learns the other end is gone. Without it a relay waits for data
    // that can never arrive, holding the connection open until something else times out.
    let p[1]
    assert(syscall(SYS_pipe, p) >= 0)
    let rd = peek32(p)
    let wr = peek32(p + 4)
    syscall(SYS_close, wr)
    let pfd[1]
    pollfd_set(pfd, 0, rd, POLLIN)
    assert(poll_fds(pfd, 1, 1000) >= 1)
    assert(pollfd_revents(pfd, 0) & POLLHUP != 0)
    syscall(SYS_close, rd)
}

test "poll_readable says yes only once the byte is actually there" {
    // The shape every network test needs and none of them had: ask whether this one fd has
    // something to read, with a deadline. Written by hand it becomes `set_nonblock` plus one
    // `read`, which is a race -- the read runs before the bytes have crossed, returns EAGAIN,
    // and the test fails on a busy machine while passing on an idle one.
    let p[1]
    assert(syscall(SYS_pipe, p) >= 0)
    let rd = peek32(p)
    let wr = peek32(p + 4)
    // Nothing written yet: the answer is no, and it comes back on its own.
    assert_eq(poll_readable(rd, 50), 0)
    assert_eq(syscall(SYS_write, wr, ONE_BYTE.utf8, 1), 1)
    assert_eq(poll_readable(rd, 1000), 1)
    syscall(SYS_close, rd)
    syscall(SYS_close, wr)
}

test "poll_readable reports the writer hanging up, not just data" {
    // A reader that waits for POLLIN alone waits forever on a peer that closed. The answer to
    // "can I read now?" is yes there too: the read returns 0 and the caller learns it is over.
    let p[1]
    assert(syscall(SYS_pipe, p) >= 0)
    let rd = peek32(p)
    let wr = peek32(p + 4)
    syscall(SYS_close, wr)
    assert_eq(poll_readable(rd, 1000), 1)
    syscall(SYS_close, rd)
}

test "a descriptor that is not open is not read as 'nothing yet'" {
    // POLLNVAL: the fd is closed. `poll` returns 1 -- there IS an event -- but the event is
    // "this is not a descriptor". Counting only POLLIN|POLLHUP|POLLERR turned that into the same
    // 0 the deadline returns, so `while poll_readable(fd, t) == 0 { }` spins forever on a
    // descriptor that will never be anything: the answer never changes and nothing ever fails.
    let p[1]
    assert(syscall(SYS_pipe, p) >= 0)
    let rd = peek32(p)
    let wr = peek32(p + 4)
    syscall(SYS_close, rd)
    syscall(SYS_close, wr)
    // Not 0: a read on it returns EBADF at once, which is how the caller learns.
    assert_ne(poll_readable(rd, 50), 0)
}
