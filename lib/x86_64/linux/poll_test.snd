// Test of poll.snd: a pipe with data must report POLLIN; an empty pipe must not.
// exit 0 if the behavior is correct.

include "x86_64/linux/io.snd"
include "any/strings.snd"
include "x86_64/linux/poll.snd"

fn puts(s: i64) { write_buf(1, s, strlen(s)) }

fn main() -> i64 {
    let p[1]
    let __f0_11: string = "FAIL pipe\n"
    if syscall(SYS_pipe, p) < 0 { let __b0_11: string = __f0_11.utf8 puts(__b0_11.utf8) return 1 }
    let rd = peek32(p)
    let wr = peek32(p + 4)

    let pfd[1]   // one pollfd entry (8B)

    // empty: poll with short timeout must NOT report POLLIN
    pollfd_set(pfd, 0, rd, POLLIN)
    let __f0_20: string = "FAIL empty should timeout\n"
    if poll_fds(pfd, 1, 50) != 0 { let __b0_19: string = __f0_20.utf8 puts(__b0_19.utf8) return 1 }

    // with data: poll must report POLLIN
    let __f0_24: string = "x"
    write_buf(wr, __f0_24.utf8, 1)
    pollfd_set(pfd, 0, rd, POLLIN)
    let r = poll_fds(pfd, 1, 1000)
    let __f0_28: string = "FAIL poll no event\n"
    if r < 1 { let __b0_25: string = __f0_28.utf8 puts(__b0_25.utf8) return 1 }
    let __f0_30: string = "FAIL revents no POLLIN\n"
    if (pollfd_revents(pfd, 0) & POLLIN) == 0 { let __b0_26: string = __f0_30.utf8 puts(__b0_26.utf8) return 1 }

    close_fd(rd)
    close_fd(wr)
    let __f0_35: string = "OK poll\n"
    puts(__f0_35.utf8)
    0
}
