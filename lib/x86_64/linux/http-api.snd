// SPDX-License-Identifier: Apache-2.0
// lib/x86_64/linux/http-api.snd: HTTP/1.1 server primitives for JSON APIs.
// Extends http.snd / http-server.snd with: query string, case-insensitive headers,
// cookies, body reading, route table with {id} patterns, response builders, and a
// fork-per-connection server with read deadlines and an orderly SIGTERM shutdown.

include "x86_64/linux/bytes.snd"
include "x86_64/linux/map.snd"
include "x86_64/linux/http.snd"
include "x86_64/linux/http-server.snd"
include "x86_64/linux/net.snd"
include "x86_64/linux/io.snd"
include "x86_64/linux/poll.snd"

// ── Percent decoding ──────────────────────────────────────────────

fn hex_digit(c: i64) -> i64 {
    if c >= 48 && c <= 57 { return c - 48 }         // '0'-'9'
    if c >= 65 && c <= 70 { return c - 55 }         // 'A'-'F'
    if c >= 97 && c <= 102 { return c - 87 }        // 'a'-'f'
    0 - 1
}

// Decode percent-encoded bytes: %XX -> byte, '+' -> space. Invalid sequences kept as-is.
pub fn percent_decode(src: i64) -> i64 {
    let n = bytes_len(src)
    let out = bytes_new()
    let mut i = 0
    for i < n {
        let c = bytes_get(src, i)
        if c == 43 {                                // '+'
            bytes_push(out, 32)                      // space
            i = i + 1
        } else if c == 37 && i + 2 < n {            // '%' with two chars following
            let hi = hex_digit(bytes_get(src, i + 1))
            let lo = hex_digit(bytes_get(src, i + 2))
            if hi >= 0 && lo >= 0 {
                bytes_push(out, hi * 16 + lo)
                i = i + 3
            } else {
                bytes_push(out, c)
                i = i + 1
            }
        } else {
            bytes_push(out, c)
            i = i + 1
        }
    }
    out
}

// ── Query string ──────────────────────────────────────────────────

// Parse a query string (without '?') into a map of key -> value Bytes.
// Both key and value are percent-decoded.
pub fn http_query_parse(qs: i64) -> i64 {
    let m = map_new()
    let n = bytes_len(qs)
    if n == 0 { return m }
    let mut pos = 0
    for pos < n {
        // Find '=' or '&' or end
        let mut eq = 0 - 1
        let mut amp = 0 - 1
        let mut j = pos
        for j < n {
            let c = bytes_get(qs, j)
            if c == 61 && eq == 0 - 1 { eq = j }     // '='
            if c == 38 { amp = j; break }             // '&'
            j = j + 1
        }
        if amp == 0 - 1 { amp = n }
        let raw_key = if eq >= 0 && eq < amp { bytes_slice(qs, pos, eq) } else { bytes_slice(qs, pos, amp) }
        let raw_val = if eq >= 0 && eq < amp { bytes_slice(qs, eq + 1, amp) } else { bytes_new() }
        let key = percent_decode(raw_key)
        let val = percent_decode(raw_val)
        map_set(m, key, val)
        pos = amp + 1
    }
    m
}

// Get a value from a parsed query map. Returns empty Bytes if key is missing.
pub fn http_query_get(q: i64, key: string) -> i64 {
    let kb = bytes_from_cstr(key.utf8)
    map_get(q, kb, bytes_new())
}

// ── Case-insensitive header lookup ────────────────────────────────

fn to_lower_byte(c: i64) -> i64 {
    if c >= 65 && c <= 90 { return c + 32 }         // A-Z -> a-z
    c
}

// Compare two Bytes buffers ignoring case. 1 if equal, 0 otherwise.
fn bytes_eq_ci(a: i64, b: i64) -> i64 {
    let na = bytes_len(a)
    let nb = bytes_len(b)
    if na != nb { return 0 }
    let mut i = 0
    for i < na {
        if to_lower_byte(bytes_get(a, i)) != to_lower_byte(bytes_get(b, i)) { return 0 }
        i = i + 1
    }
    1
}

// Lookup header by name, case-insensitive. Returns the value Bytes, or empty Bytes.
pub fn http_header_get_ci(headers: i64, name: string) -> i64 {
    let name_b = bytes_from_cstr(name.utf8)
    let n = map_len(headers)
    let mut i = 0
    for i < n {
        if bytes_eq_ci(map_key_at(headers, i), name_b) == 1 {
            return map_val_at(headers, i)
        }
        i = i + 1
    }
    bytes_new()
}

// ── Cookie parsing ────────────────────────────────────────────────

// Extract a cookie value from the Cookie header. Cookies are "name=value; name2=value2".
pub fn http_cookie_get(headers: i64, name: string) -> i64 {
    let cookie_hdr = http_header_get_ci(headers, "cookie")
    let cookie_len = bytes_len(cookie_hdr)
    if cookie_len == 0 { return bytes_new() }
    let name_b = bytes_from_cstr(name.utf8)
    let name_len = bytes_len(name_b)
    let mut pos = 0
    for pos < cookie_len {
        // Skip leading whitespace
        while pos < cookie_len && bytes_get(cookie_hdr, pos) == 32 { pos = pos + 1 }
        // Find '='
        let mut eq = pos
        for eq < cookie_len {
            if bytes_get(cookie_hdr, eq) == 61 { break }
            eq = eq + 1
        }
        if eq >= cookie_len { break }
        // Check if key matches
        if eq - pos == name_len {
            let mut ok = 1
            let mut k = 0
            for k < name_len {
                if bytes_get(cookie_hdr, pos + k) != bytes_get(name_b, k) { ok = 0 }
                k = k + 1
            }
            if ok == 1 {
                // Extract value
                let val_start = eq + 1
                let mut val_end = val_start
                for val_end < cookie_len {
                    let c = bytes_get(cookie_hdr, val_end)
                    if c == 59 || c == 32 { break }  // ';' or space
                    val_end = val_end + 1
                }
                return bytes_slice(cookie_hdr, val_start, val_end)
            }
        }
        // Skip to next ';'
        while pos < cookie_len && bytes_get(cookie_hdr, pos) != 59 { pos = pos + 1 }
        pos = pos + 1
    }
    bytes_new()
}

// ── Body extraction ───────────────────────────────────────────────

// Check if a request buffer contains a complete request (ends with \r\n\r\n).
pub fn http_request_complete(req: i64) -> i64 {
    let n = bytes_len(req)
    if n < 4 { return 0 }
    if bytes_get(req, n - 4) == 13 && bytes_get(req, n - 3) == 10 &&
       bytes_get(req, n - 2) == 13 && bytes_get(req, n - 1) == 10 {
        1
    } else {
        0
    }
}

// 1 when the header block has ended (a \r\n\r\n anywhere), 0 otherwise. Unlike
// http_request_complete this is not fooled by a body that arrived in the same read: a POST
// whose body was already appended still has its header terminator in the middle.
pub fn http_has_header_end(req: i64) -> i64 {
    let n = bytes_len(req)
    let mut i = 0
    for i + 3 < n {
        if bytes_get(req, i) == 13 && bytes_get(req, i + 1) == 10 &&
           bytes_get(req, i + 2) == 13 && bytes_get(req, i + 3) == 10 {
            return 1
        }
        i = i + 1
    }
    0
}

// Extract the body from a parsed request (bytes after the first \r\n\r\n).
pub fn http_request_body(req: i64) -> i64 {
    let n = bytes_len(req)
    let mut i = 0
    for i < n - 3 {
        if bytes_get(req, i) == 13 && bytes_get(req, i + 1) == 10 &&
           bytes_get(req, i + 2) == 13 && bytes_get(req, i + 3) == 10 {
            return bytes_slice(req, i + 4, n)
        }
        i = i + 1
    }
    bytes_new()
}

// Parse Content-Length from headers. Returns the value, or 0 if absent.
fn content_length(h: i64) -> i64 {
    let v = http_header_get_ci(h, "content-length")
    let n = bytes_len(v)
    if n == 0 { return 0 }
    let mut val = 0
    let mut i = 0
    for i < n {
        let c = bytes_get(v, i)
        if c >= 48 && c <= 57 {
            val = val * 10 + (c - 48)
        }
        i = i + 1
    }
    val
}

// Read body from a socket by Content-Length. Returns a Bytes buffer, or empty if no body.
// max_body is the configurable limit; returns 0 in *err if exceeded (caller sends 413).
pub fn http_read_body(afd: i64, h: i64, max_body: i64) -> i64 {
    let cl = content_length(h)
    if cl == 0 { return bytes_new() }
    if cl > max_body {
        // Signal 413: caller checks err
        return bytes_new()
    }
    // Read exactly cl bytes from socket (may need multiple reads)
    let buf = bytes_new()
    let mut remaining = cl
    for remaining > 0 {
        let tmp[4096]
        let n = read_buf(afd, tmp, if remaining < 4096 { remaining } else { 4096 })
        if n <= 0 { break }
        bytes_append(buf, bytes_from_raw(tmp, n))
        remaining = remaining - n
    }
    buf
}

// ── Response builders ─────────────────────────────────────────────

// Build a JSON response with Content-Type: application/json.
pub fn http_response_json(status: string, body: i64) -> i64 {
    let r = bytes_new()
    bytes_append_cstr(r, "HTTP/1.1 ".utf8)
    bytes_append_cstr(r, status.utf8)
    let __lit0: string = "\r\nContent-Type: application/json\r\nContent-Length: "
    bytes_append_cstr(r, __lit0.utf8)
    bytes_append_int(r, bytes_len(body))
    let __lit1: string = "\r\n\r\n"
    bytes_append_cstr(r, __lit1.utf8)
    bytes_append(r, body)
    r
}

// Build a bodyless response with the given status line.
pub fn http_response_status(status: string) -> i64 {
    let r = bytes_new()
    bytes_append_cstr(r, "HTTP/1.1 ".utf8)
    bytes_append_cstr(r, status.utf8)
    let __lit0: string = "\r\nContent-Length: 0\r\n\r\n"
    bytes_append_cstr(r, __lit0.utf8)
    r
}

// Build a 303 See Other redirect response.
pub fn http_response_redirect(location: string) -> i64 {
    let r = bytes_new()
    let __lit0: string = "HTTP/1.1 303 See Other\r\nLocation: "
    bytes_append_cstr(r, __lit0.utf8)
    bytes_append_cstr(r, location.utf8)
    let __lit1: string = "\r\nContent-Length: 0\r\n\r\n"
    bytes_append_cstr(r, __lit1.utf8)
    r
}

// Build a response with custom headers (for Set-Cookie etc.).
pub fn http_response_with_headers(status: string, body: i64, extra_headers: i64) -> i64 {
    let r = bytes_new()
    bytes_append_cstr(r, "HTTP/1.1 ".utf8)
    bytes_append_cstr(r, status.utf8)
    let __lit0: string = "\r\nContent-Type: application/json\r\nContent-Length: "
    bytes_append_cstr(r, __lit0.utf8)
    bytes_append_int(r, bytes_len(body))
    // Add \r\n before each extra header line
    let eh_len = bytes_len(extra_headers)
    if eh_len > 0 {
        bytes_push(r, 13)                             // \r
        bytes_push(r, 10)                             // \n
        bytes_append(r, extra_headers)
    }
    let __lit1: string = "\r\n\r\n"
    bytes_append_cstr(r, __lit1.utf8)
    bytes_append(r, body)
    r
}

// ── Set-Cookie header builder ─────────────────────────────────────

// Build a Set-Cookie header value.
pub fn http_set_cookie(name: string, value: string, max_age: i64) -> i64 {
    let h = bytes_new()
    let __lit0: string = "Set-Cookie: "
    bytes_append_cstr(h, __lit0.utf8)
    bytes_append_cstr(h, name.utf8)
    bytes_push(h, 61)                                 // '='
    bytes_append_cstr(h, value.utf8)
    let __lit1: string = "; Path=/; HttpOnly; SameSite=Lax; Max-Age="
    bytes_append_cstr(h, __lit1.utf8)
    bytes_append_int(h, max_age)
    h
}

// Build a Set-Cookie header with the Secure flag.
pub fn http_set_cookie_secure(name: string, value: string, max_age: i64) -> i64 {
    let h = http_set_cookie(name, value, max_age)
    let __lit0: string = "; Secure"
    bytes_append_cstr(h, __lit0.utf8)
    h
}

// ── Route matching ────────────────────────────────────────────────

// Match a path against a route pattern with {param} segments.
// Returns 1 if the path matches, 0 otherwise.
pub fn http_route_match(pattern: i64, path: i64) -> i64 {
    let pat_len = bytes_len(pattern)
    let path_len = bytes_len(path)
    let mut pi = 0      // pattern index
    let mut qi = 0      // path index

    while pi < pat_len && qi < path_len {
        let pc = bytes_get(pattern, pi)
        if pc == 123 {                              // '{' — start of param
            // Find closing '}'
            let mut close = pi + 1
            for close < pat_len {
                if bytes_get(pattern, close) == 125 { break }  // '}'
                close = close + 1
            }
            if close >= pat_len { return 0 }        // malformed pattern
            // Param segment: must match at least one char, stop at '/'
            if qi >= path_len { return 0 }
            let path_seg_start = qi
            while qi < path_len && bytes_get(path, qi) != 47 { qi = qi + 1 }
            if qi == path_seg_start { return 0 }    // empty segment
            pi = close + 1
        } else {
            // Literal character: must match exactly
            if bytes_get(path, qi) != pc { return 0 }
            pi = pi + 1
            qi = qi + 1
        }
    }
    // Both must be exhausted
    if pi == pat_len && qi == path_len { 1 } else { 0 }
}

// Extract a named parameter from a matched path. Caller must have verified http_route_match.
pub fn http_route_param(pattern: i64, path: i64, param_name: string) -> i64 {
    let pat_len = bytes_len(pattern)
    let path_len = bytes_len(path)
    let param_b = bytes_from_cstr(param_name.utf8)
    let param_len = bytes_len(param_b)
    let mut pi = 0
    let mut qi = 0

    while pi < pat_len && qi < path_len {
        let pc = bytes_get(pattern, pi)
        if pc == 123 {                              // '{'
            let mut close = pi + 1
            for close < pat_len {
                if bytes_get(pattern, close) == 125 { break }
                close = close + 1
            }
            if close >= pat_len { return bytes_new() }
            // Check if this param name matches
            let name_len = close - pi - 1
            if name_len == param_len {
                let mut ok = 1
                let mut k = 0
                for k < param_len {
                    if bytes_get(pattern, pi + 1 + k) != bytes_get(param_b, k) { ok = 0 }
                    k = k + 1
                }
                if ok == 1 {
                    // Extract path segment value
                    let seg_start = qi
                    while qi < path_len && bytes_get(path, qi) != 47 { qi = qi + 1 }
                    return bytes_slice(path, seg_start, qi)
                }
            }
            // Skip path segment
            while qi < path_len && bytes_get(path, qi) != 47 { qi = qi + 1 }
            pi = close + 1
        } else {
            pi = pi + 1
            qi = qi + 1
        }
    }
    bytes_new()
}

// ── Method checking ───────────────────────────────────────────────

// Check if a method is in a comma-separated allowed list (e.g. "GET,POST").
pub fn http_method_allowed(allowed: i64, method: string) -> i64 {
    let method_b = bytes_from_cstr(method.utf8)
    let method_len = bytes_len(method_b)
    let n = bytes_len(allowed)
    let mut pos = 0
    while pos < n {
        let mut end = pos
        while end < n && bytes_get(allowed, end) != 44 { end = end + 1 }  // ','
        let item_len = end - pos
        if item_len == method_len {
            let mut ok = 1
            let mut k = 0
            for k < item_len {
                if bytes_get(allowed, pos + k) != bytes_get(method_b, k) { ok = 0 }
                k = k + 1
            }
            if ok == 1 { return 1 }
        }
        pos = end + 1
    }
    0
}

// ── Clock and sleep ───────────────────────────────────────────────

let HTTP_CLOCK_MONOTONIC = 1

// Milliseconds on the monotonic clock. Deadlines want this and not wall time: the wall clock
// can step (NTP, suspend) and a read timeout that moves with it is not a bound.
pub fn http_now_ms() -> i64 {
    let ts[2]
    syscall(SYS_clock_gettime, HTTP_CLOCK_MONOTONIC, ts)
    ts[0] * 1000 + ts[1] / 1000000
}

pub fn http_sleep_ms(ms: i64) {
    let ts[2]
    ts[0] = ms / 1000
    ts[1] = (ms % 1000) * 1000000
    syscall(SYS_nanosleep, ts, 0)
}

// ── SIGTERM without a handler ─────────────────────────────────────
//
// Sond has no function values (verified: passing a function name is a compile error), so a
// signal handler cannot be registered with rt_sigaction. Instead SIGTERM is BLOCKED: it stays
// pending and never kills the process, and the accept loop polls for it between connections.
// The observable behavior is the one that matters -- stop accepting, finish what is in flight.

let HTTP_SIGTERM = 15
let HTTP_SIG_BLOCK = 0
let HTTP_SYS_rt_sigtimedwait = 128            // rt_sigtimedwait(2), x86-64

fn http_sigterm_block() {
    let set[1]
    set[0] = 1 << (HTTP_SIGTERM - 1)          // sigset_t bit `signo - 1`
    syscall(SYS_rt_sigprocmask, HTTP_SIG_BLOCK, set, 0, 8)
}

// 1 when a SIGTERM is pending, 0 otherwise. Non-blocking (the timeout is zero).
fn http_sigterm_pending() -> i64 {
    let set[1]
    set[0] = 1 << (HTTP_SIGTERM - 1)
    let ts[2]
    ts[0] = 0
    ts[1] = 0
    let si[16]
    if syscall(HTTP_SYS_rt_sigtimedwait, set, si, ts, 8) == HTTP_SIGTERM { 1 } else { 0 }
}

// ── Reading with a deadline ───────────────────────────────────────

// Read a request into a buffer, bounded by timeout_ms. Returns whatever arrived; a caller
// tells a whole request from a fragment with http_has_header_end. A peer that goes silent
// cannot pin its handler forever: the deadline ends the wait.
pub fn http_read_request(afd: i64, cap: i64, timeout_ms: i64) -> i64 {
    let buf = bytes_new()
    let deadline = http_now_ms() + timeout_ms
    for http_has_header_end(buf) == 0 && bytes_len(buf) < cap {
        let left = deadline - http_now_ms()
        if left <= 0 { break }
        if poll_readable(afd, left) <= 0 { break }
        let tmp[4096]
        let n = read_buf(afd, tmp, 4096)
        if n <= 0 { break }
        bytes_append(buf, bytes_from_raw(tmp, n))
    }
    buf
}

// Read up to `want` more bytes within timeout_ms. Returns what arrived; a short result is the
// caller's signal that the peer stalled and the request is incomplete.
fn http_read_exact(afd: i64, want: i64, timeout_ms: i64) -> i64 {
    let buf = bytes_new()
    let deadline = http_now_ms() + timeout_ms
    for bytes_len(buf) < want {
        let left = deadline - http_now_ms()
        if left <= 0 { break }
        if poll_readable(afd, left) <= 0 { break }
        let tmp[4096]
        let n = read_buf(afd, tmp, 4096)
        if n <= 0 { break }
        bytes_append(buf, bytes_from_raw(tmp, n))
    }
    buf
}

// ── Writing ───────────────────────────────────────────────────────

// Write a whole response, retrying past short writes. Returns 0.
pub fn http_write_all(afd: i64, resp: i64) -> i64 {
    let mut off = 0
    let n = bytes_len(resp)
    for off < n {
        let w = write_buf(afd, bytes_data(resp) + off, n - off)
        if w <= 0 { break }
        off = off + w
    }
    0
}

// Send a bodyless status and close the connection (see http_finish).
fn http_reply_status(afd: i64, status: string) -> i64 {
    http_write_all(afd, http_response_status(status))
    http_finish(afd)
    0
}

// ── Request validation ────────────────────────────────────────────

// 1 for a request line `METHOD SP PATH SP HTTP/1.x`; anything else is a 400, never a hang.
fn http_request_line_ok(req: i64) -> i64 {
    let sp1 = bytes_index_of(req, 32)
    if sp1 <= 0 { return 0 }
    let sp2 = bytes_index_of_from(req, 32, sp1 + 1)
    if sp2 <= sp1 + 1 { return 0 }
    let line_end = bytes_index_of_from(req, 13, sp2)
    if line_end < 0 { return 0 }
    if line_end - sp2 - 1 < 5 { return 0 }
    if bytes_eq(bytes_slice(req, sp2 + 1, sp2 + 6), bytes_from_str("HTTP/")) == 1 { 1 } else { 0 }
}

// ── Route table ───────────────────────────────────────────────────
//
// Responses are registered up front, keyed by "METHOD pattern", so the server needs no
// callback to dispatch (Sond has no function values). Applications that compute a response
// per request use http_read_request / http_route_match / http_response_json directly.

struct HttpRouter { responses: i64, delays: i64 }

pub fn http_router_new() -> HttpRouter {
    HttpRouter { responses: map_new(), delays: map_new() }
}

fn http_route_key(method: string, pattern: string) -> i64 {
    let k = bytes_new()
    bytes_append_str(k, method)
    bytes_push(k, 32)                          // space
    bytes_append_str(k, pattern)
    k
}

// Register `response` (a full HTTP response buffer) for METHOD + pattern. `delay_ms` stands in
// for handler work and is what keeps a request in flight across a shutdown in tests.
pub fn http_route_add(r: HttpRouter, method: string, pattern: string, response: i64, delay_ms: i64) {
    let key = http_route_key(method, pattern)
    map_set(r.responses, key, response)
    map_set(r.delays, key, delay_ms)
}

// Walk the table: the first route whose pattern matches and whose method matches wins. A
// pattern that matches with the wrong method makes the answer 405, not 404.
fn http_route_dispatch(afd: i64, r: HttpRouter, method: i64, path: i64) -> i64 {
    let n = map_len(r.responses)
    let mut method_mismatch = 0
    let mut i = 0
    for i < n {
        let key = map_key_at(r.responses, i)
        let sp = bytes_index_of(key, 32)
        let route_method = bytes_slice(key, 0, sp)
        let pattern = bytes_slice(key, sp + 1, bytes_len(key))
        if http_route_match(pattern, path) == 1 {
            if bytes_eq(route_method, method) == 1 {
                let delay = map_get(r.delays, key, 0)
                if delay > 0 { http_sleep_ms(delay) }
                http_write_all(afd, map_val_at(r.responses, i))
                http_finish(afd)
                return 0
            }
            method_mismatch = 1
        }
        i = i + 1
    }
    if method_mismatch == 1 { http_reply_status(afd, "405 Method Not Allowed") } else { http_reply_status(afd, "404 Not Found") }
}

// ── One connection ────────────────────────────────────────────────

// Serve a single connection end to end: read the request within the deadline, reject a bad
// request line or an oversized body, read the body, dispatch. Every path closes the
// connection, so a slow or malformed peer releases its process.
pub fn http_handle_conn(afd: i64, r: HttpRouter, max_body: i64, timeout_ms: i64) -> i64 {
    let req = http_read_request(afd, 8192, timeout_ms)
    if http_has_header_end(req) == 0 || http_request_line_ok(req) == 0 {
        return http_reply_status(afd, "400 Bad Request")
    }
    let method = http_method(req)
    let path = http_path(req)
    let h = http_headers(req)
    let cl = content_length(h)
    if cl > max_body {
        return http_reply_status(afd, "413 Payload Too Large")
    }
    let body = http_request_body(req)
    let have = bytes_len(body)
    if have < cl {
        let rest = http_read_exact(afd, cl - have, timeout_ms)
        if bytes_len(rest) < cl - have {
            return http_reply_status(afd, "400 Bad Request")
        }
        bytes_append(body, rest)
    }
    http_route_dispatch(afd, r, method, path)
}

// ── Server ────────────────────────────────────────────────────────

// Reap every child that has already exited. Returns how many were reaped. WNOHANG keeps a
// finished connection from waiting for the next one to be collected.
fn http_reap_zombies() -> i64 {
    let st[1]
    let mut n = 0
    for {
        let p = syscall(SYS_wait4, 0 - 1, st, 1, 0)
        if p <= 0 { break }
        n = n + 1
    }
    n
}

// Fork-per-connection server with an orderly shutdown. SIGTERM stops the accept loop; the
// parent then waits for the children already serving a connection, up to grace_ms, and
// returns how many were still running when the cap expired. The listening socket is closed
// here, so the caller does not have to.
pub fn http_serve(sfd: i64, r: HttpRouter, max_body: i64, timeout_ms: i64, grace_ms: i64) -> i64 {
    http_sigterm_block()
    let mut children = 0
    let mut serving = 1
    for serving == 1 {
        if http_sigterm_pending() == 1 {
            serving = 0
        } else if poll_readable(sfd, 200) == 1 {
            let afd = accept_sock(sfd, 0, 0)
            if afd >= 0 {
                let pid = syscall(SYS_fork)
                if pid == 0 {
                    http_handle_conn(afd, r, max_body, timeout_ms)
                    syscall(SYS_exit, 0)
                    return 0
                }
                if pid > 0 {
                    close_fd(afd)
                    children = children + 1
                } else {
                    close_fd(afd)
                }
            }
        }
        children = children - http_reap_zombies()
    }
    close_fd(sfd)
    let deadline = http_now_ms() + grace_ms
    for children > 0 && http_now_ms() < deadline {
        http_sleep_ms(5)
        children = children - http_reap_zombies()
    }
    children
}
