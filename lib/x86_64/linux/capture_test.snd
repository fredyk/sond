// Copyright 2026 Jhon Magdalena Vila and the Sond contributors
//
// Tests for lib/x86_64/linux/capture.snd: fork + pipe + execve, with the child's stdout read
// back into the caller's buffer.
//
// This file was a `main` returning 1 on failure, and the suite runner only collects files with
// `test "` blocks: it declared zero tests, so `capture.snd` was in nobody's coverage denominator
// and `sond test lib` listed it as unmeasured. Same shape as the old chacha20 and hkdf files.
//
// Every failure path is provoked for real -- no descriptors left, no processes left -- on this
// process alone: the harness forks a child per test, so what is done here dies with the test.

include "x86_64/linux/capture.snd"
include "x86_64/linux/testing.snd"

let ECHO_PATH: string = "/bin/echo"
let SH_PATH: string = "/bin/sh"
let NADA_PATH: string = "/bin/no-existe-este-programa-4b1c"
let DEVNULL: string = "/dev/null"

let SYS_prlimit64 = 302
let RLIMIT_NOFILE = 7
let RLIMIT_NPROC = 6

let mut buf[64]         // 512 bytes
let mut argv[8]
let mut lim[2]
let mut viejo[2]

let mut arg_hi: string = "hi"
let mut arg_c: string = "-c"
let mut arg_dos: string = "echo fuera >&2; echo dentro"

fn poison(n: i64) {
    for i in 0..n { poke8(buf + i, 0xbb) }
}

test "the child's stdout comes back byte for byte" {
    poke64(argv, ECHO_PATH.utf8)
    poke64(argv + 8, arg_hi.utf8)
    poke64(argv + 16, 0)
    poison(64)
    assert_eq(run_capture(ECHO_PATH.utf8, argv, buf, 512), 3)
    assert_eq(peek8(buf), 104)      // 'h'
    assert_eq(peek8(buf + 1), 105)  // 'i'
    assert_eq(peek8(buf + 2), 10)   // '\n'
    // Nothing beyond what was read: the poison byte is still there.
    assert_eq(peek8(buf + 3), 0xbb)
}

test "what the child writes to stderr is not what it wrote to stdout" {
    // The child's stderr goes to /dev/null on purpose: a command's status messages must not end
    // up inside the bytes the caller is about to parse.
    poke64(argv, SH_PATH.utf8)
    poke64(argv + 8, arg_c.utf8)
    poke64(argv + 16, arg_dos.utf8)
    poke64(argv + 24, 0)
    poison(64)
    assert_eq(run_capture(SH_PATH.utf8, argv, buf, 512), 7)
    let esperado: string = "dentro\n"
    for i in 0..7 { assert_eq(peek8(buf + i), peek8(esperado.utf8 + i)) }
}

test "a command that is not there captures nothing instead of leaking the shell's complaint" {
    poke64(argv, NADA_PATH.utf8)
    poke64(argv + 8, 0)
    poison(64)
    assert_eq(run_capture(NADA_PATH.utf8, argv, buf, 512), 0)
    assert_eq(peek8(buf), 0xbb)
}

test "output longer than the buffer stops at the buffer, and not one byte past it" {
    // `buflen - total` reaches zero and the read loop has to end there. Writing on would corrupt
    // whatever the caller keeps behind the buffer, which is the bug this file exists to prevent.
    poke64(argv, ECHO_PATH.utf8)
    poke64(argv + 8, arg_hi.utf8)
    poke64(argv + 16, 0)
    poison(64)
    assert_eq(run_capture(ECHO_PATH.utf8, argv, buf, 2), 2)
    assert_eq(peek8(buf + 2), 0xbb)
}

test "with no descriptors left there is no pipe, and that is -1" {
    // Not zero: zero is what a command that printed nothing returns, and the caller has to be
    // able to tell "it said nothing" from "it never ran".
    assert_eq(syscall(SYS_prlimit64, 0, RLIMIT_NOFILE, 0, viejo), 0)
    poke64(lim, 4)
    poke64(lim + 8, peek64(viejo + 8))
    assert_eq(syscall(SYS_prlimit64, 0, RLIMIT_NOFILE, lim, 0), 0)
    // Take what few descriptors the new limit still allows, so the pipe has none.
    for i in 0..4 { syscall(SYS_open, DEVNULL.utf8, 0, 0) }
    poke64(argv, ECHO_PATH.utf8)
    poke64(argv + 8, 0)
    let r = run_capture(ECHO_PATH.utf8, argv, buf, 512)
    syscall(SYS_prlimit64, 0, RLIMIT_NOFILE, viejo, 0)
    assert_eq(r, 0 - 1)
}

test "a fork that cannot happen closes the pipe it had already opened" {
    // Both ends, or this leaks two descriptors per attempt: a caller retrying in a loop would run
    // out of them and start failing at the pipe instead, which points at the wrong thing.
    assert_eq(syscall(SYS_prlimit64, 0, RLIMIT_NPROC, 0, viejo), 0)
    poke64(lim, 1)
    poke64(lim + 8, peek64(viejo + 8))
    assert_eq(syscall(SYS_prlimit64, 0, RLIMIT_NPROC, lim, 0), 0)
    poke64(argv, ECHO_PATH.utf8)
    poke64(argv + 8, 0)
    let r = run_capture(ECHO_PATH.utf8, argv, buf, 512)
    syscall(SYS_prlimit64, 0, RLIMIT_NPROC, viejo, 0)
    assert_eq(r, 0 - 1)
    // The descriptors are back: a pipe still fits.
    let fds[1]
    assert(syscall(SYS_pipe, fds) >= 0)
    close_fd(peek32(fds))
    close_fd(peek32(fds + 4))
}
