//
// http-server.snd, reusable primitives for a static-file HTTP server in Sond (hosted Linux).
// The accept loop and routing stay in each application (they differ); this module provides the
// pieces every one of them repeated: a path-safety check, the file size, a bodyless status
// reply, and streaming a file as a 200 with a caller-chosen Content-Type.
//
//   include "x86_64/linux/http-server.snd"
//   ... in the request handler:
//     let name = ...route the path...
//     if name == 0 { http_send_status(afd, cstr("404 Not Found")) }
//     else { http_serve_file(afd, name, my_content_type(name)) }

include "x86_64/linux/io.snd"
include "x86_64/linux/net.snd"
include "x86_64/linux/http.snd"
include "x86_64/linux/bytes.snd"

// A safe request path: only [A-Za-z0-9._/-], 1..256 chars, and no "..", so a request can
// never escape the served root. Subdirectories ('/') are allowed; a bare name is fine too
// (a server that forbids subdirs simply never produces one).
fn http_safe_path(name: i64) -> i64 {
    let n = bytes_len(name)
    if n == 0 { return 0 }
    if n > 256 { return 0 }
    let mut i = 0
    let mut prev_dot = 0
    for i < n {
        let c = bytes_get(name, i)
        let mut ok = 0
        if c >= 'a' && c <= 'z' { ok = 1 }
        if c >= 'A' && c <= 'Z' { ok = 1 }
        if c >= '0' && c <= '9' { ok = 1 }
        if c == '.' || c == '_' || c == '-' || c == '/' { ok = 1 }
        if ok == 0 { return 0 }
        if c == '.' && prev_dot == 1 { return 0 }
        if c == '.' { prev_dot = 1 } else { prev_dot = 0 }
        i = i + 1
    }
    1
}

// The size of an open file, via lseek to the end and back.
fn http_file_size(fd: i64) -> i64 {
    let sz = syscall(SYS_lseek, fd, 0, 2)
    syscall(SYS_lseek, fd, 0, 0)
    sz
}

// Send a bodyless HTTP response with the given status line (e.g. cstr("404 Not Found")).
fn http_send_status(afd: i64, status: i64) {
    let body = bytes_new()
    let resp = http_response(status, body)
    write_buf(afd, peek64(resp), bytes_len(resp))
}

// Open the file at `path` (a `bytes` handle holding a filesystem path) and stream it to `afd`
// as a 200 with `Content-Type: <ctype>` (a cstr); send 404 if it cannot be opened. Returns 0.
fn http_serve_file(afd: i64, path: i64, ctype: i64) -> i64 {
    let p = bytes_new()
    bytes_append(p, path)
    bytes_push(p, 0)                                   // NUL-terminate for open
    let fd = open_file(peek64(p), 0, 0)                // O_RDONLY
    if fd < 0 {
        http_send_status(afd, cstr("404 Not Found"))
        return 0
    }
    let sz = http_file_size(fd)
    let h = bytes_new()
    bytes_append_cstr(h, cstr("HTTP/1.1 200 OK\r\nContent-Type: "))
    bytes_append_cstr(h, ctype)
    bytes_append_cstr(h, cstr("\r\nContent-Length: "))
    bytes_append_int(h, sz)
    bytes_append_cstr(h, cstr("\r\nConnection: close\r\n\r\n"))
    write_buf(afd, peek64(h), bytes_len(h))
    let buf[2048]
    for {
        let rn = read_buf(fd, buf, 16384)
        if rn <= 0 { break }
        write_buf(afd, buf, rn)
    }
    close_fd(fd)
    0
}
