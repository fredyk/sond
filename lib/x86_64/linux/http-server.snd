//
// http-server.snd: reusable primitives for a static-file HTTP server in Sond (hosted Linux).
// The accept loop and routing stay in each application (they differ); this module provides the
// pieces every one of them repeated: a path-safety check, the file size, a bodyless status
// reply, and streaming a file as a 200 with a caller-chosen Content-Type.
//
//   include "x86_64/linux/http-server.snd"
//   ... in the request handler:
//     let name = ...route the path...
//     if name == 0 { http_send_status(afd, "404 Not Found") }
//     else { http_serve_file(afd, name, my_content_type(name)) }

include "x86_64/linux/io.snd"
include "x86_64/linux/net.snd"
include "x86_64/linux/http.snd"
include "x86_64/linux/bytes.snd"

// A safe request path: only [A-Za-z0-9._/-], 1..256 chars, and no "..", so a request can
// never escape the served root. Subdirectories ('/') are allowed; a bare name is fine too
// (a server that forbids subdirs simply never produces one).
fn http_safe_path(name: i64) -> i64 {
    let n = bytes_len(name)
    if n == 0 { return 0 }
    if n > 256 { return 0 }
    let mut i = 0
    let mut prev_dot = 0
    for i < n {
        let c = bytes_get(name, i)
        let mut ok = 0
        if c >= 'a' && c <= 'z' { ok = 1 }
        if c >= 'A' && c <= 'Z' { ok = 1 }
        if c >= '0' && c <= '9' { ok = 1 }
        if c == '.' || c == '_' || c == '-' || c == '/' { ok = 1 }
        if ok == 0 { return 0 }
        if c == '.' && prev_dot == 1 { return 0 }
        if c == '.' { prev_dot = 1 } else { prev_dot = 0 }
        i = i + 1
    }
    1
}

// The size of an open file, via lseek to the end and back.
fn http_file_size(fd: i64) -> i64 {
    let sz = syscall(SYS_lseek, fd, 0, 2)
    syscall(SYS_lseek, fd, 0, 0)
    sz
}

let SHUT_WR = 1

// Gracefully close an accepted connection after the response has been written. Closing a socket
// while unread request bytes are still queued makes Linux reset the connection (RST) instead of
// finishing it (FIN); an upstream proxy such as Cloudflare reports that reset as a 502 to the
// client, intermittently, whenever a request carried more bytes than the handler read (extra
// headers, a body, pipelined data). So: send our FIN with shutdown(SHUT_WR), switch the socket
// to non-blocking and drain whatever is still queued, then close, turning every teardown into a
// clean FIN. Non-blocking drain never hangs on a peer that keeps the connection open.
fn http_finish(afd: i64) -> i64 {
    syscall(SYS_shutdown, afd, SHUT_WR)
    set_nonblock(afd)
    let drain[256]
    for {
        let n = read_buf(afd, drain, 2048)
        if n <= 0 { break }
    }
    close_fd(afd)
    0
}

// Send a 301 Moved Permanently to `location` (a cstr, e.g. "https://example.org/"). Used
// to point one host at another, a technical host redirecting its human-facing root to the
// marketing site. Bodyless and keep-alive, so a pooled connection stays reusable.
fn http_send_redirect(afd: i64, location: i64) {
    let h = bytes_new()
    let __lit0: string = "HTTP/1.1 301 Moved Permanently\r\nLocation: "
    bytes_append_cstr(h, __lit0.utf8)
    bytes_append_cstr(h, location)
    let __lit1: string = "\r\nContent-Length: 0\r\nConnection: keep-alive\r\n\r\n"
    bytes_append_cstr(h, __lit1.utf8)
    write_buf(afd, peek64(h), bytes_len(h))
}

// Send a bodyless HTTP response with the given status line (e.g. "404 Not Found").
fn http_send_status(afd: i64, status: string) {
    let body = bytes_new()
    let resp = http_response(status, body)
    write_buf(afd, peek64(resp), bytes_len(resp))
}

// Open the file at `path` (a `bytes` handle holding a filesystem path) and stream it to `afd`
// as a 200 with `Content-Type: <ctype>` (a cstr); send 404 if it cannot be opened. Returns 0.
// As http_serve_file, but also emit `Cache-Control: <cc>` (a cstr) when `cc` is non-zero. Pass a
// value like "no-store" for artifacts a CDN must never cache, a reproducible release
// tarball served against a freshly-generated checksum desyncs (and every install fails) the
// moment a stale copy lingers at the edge, so releases opt out of caching entirely.
fn http_serve_file_cc(afd: i64, path: i64, ctype: i64, cc: i64) -> i64 {
    let p = bytes_new()
    bytes_append(p, path)
    bytes_push(p, 0)                                   // NUL-terminate for open
    let fd = open_file(peek64(p), 0, 0)                // O_RDONLY
    if fd < 0 {
        http_send_status(afd, "404 Not Found")
        return 0
    }
    let sz = http_file_size(fd)
    let h = bytes_new()
    let __lit3: string = "HTTP/1.1 200 OK\r\nContent-Type: "
    bytes_append_cstr(h, __lit3.utf8)
    bytes_append_cstr(h, ctype)
    let __lit4: string = "\r\nContent-Length: "
    bytes_append_cstr(h, __lit4.utf8)
    bytes_append_int(h, sz)
    if cc != 0 {
        let __lit5: string = "\r\nCache-Control: "
        bytes_append_cstr(h, __lit5.utf8)
        bytes_append_cstr(h, cc)
    }
    let __lit6: string = "\r\nConnection: keep-alive\r\n\r\n"
    bytes_append_cstr(h, __lit6.utf8)
    write_buf(afd, peek64(h), bytes_len(h))
    let buf[2048]
    for {
        let rn = read_buf(fd, buf, 16384)
        if rn <= 0 { break }
        write_buf(afd, buf, rn)
    }
    close_fd(fd)
    0
}

// Stream a file at `path` to `afd` as a 200 with `Content-Type: <ctype>`, no Cache-Control; 404 if
// it cannot be opened. Returns 0.
fn http_serve_file(afd: i64, path: i64, ctype: i64) -> i64 {
    http_serve_file_cc(afd, path, ctype, 0)
}
