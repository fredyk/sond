// Tests for the growable byte buffer (lib/x86_64/linux/bytes.snd).
//   sond test lib/x86_64/linux/bytes_test.snd
include "x86_64/linux/bytes.snd"
include "x86_64/linux/testing.snd"

test "a new buffer is empty" {
    let b = bytes_new()
    assert_eq(bytes_len(b), 0)
}

test "push then read back" {
    let b = bytes_new()
    bytes_push(b, 65)
    bytes_push(b, 66)
    bytes_push(b, 67)
    assert_eq(bytes_len(b), 3)
    assert_eq(bytes_get(b, 0), 65)
    assert_eq(bytes_get(b, 1), 66)
    assert_eq(bytes_get(b, 2), 67)
}

test "growing past the initial capacity preserves the data" {
    let b = bytes_new()
    let mut i = 0
    for i < 100 { bytes_push(b, i & 255)  i = i + 1 }
    assert_eq(bytes_len(b), 100)
    assert_eq(bytes_get(b, 0), 0)
    assert_eq(bytes_get(b, 50), 50)
    assert_eq(bytes_get(b, 99), 99)
}

test "bytes_from_cstr copies a string literal" {
    let __s0_32: string = "Hi!"
    let b = bytes_from_cstr(__s0_32.utf8)
    assert_eq(bytes_len(b), 3)
    assert_eq(bytes_get(b, 0), 72)
    assert_eq(bytes_get(b, 2), 33)
}

test "bytes_eq: equal buffers" {
    let __s1_40: string = "GET"
    let __s2_40: string = "GET"
    assert_eq(bytes_eq(bytes_from_cstr(__s1_40.utf8), bytes_from_cstr(__s2_40.utf8)), 1)
}

test "bytes_eq: different length" {
    let __s3_46: string = "GET"
    let __s4_46: string = "POST"
    assert_eq(bytes_eq(bytes_from_cstr(__s3_46.utf8), bytes_from_cstr(__s4_46.utf8)), 0)
}

test "bytes_eq: same length, different bytes" {
    let __s5_52: string = "GET"
    let __s6_52: string = "PUT"
    assert_eq(bytes_eq(bytes_from_cstr(__s5_52.utf8), bytes_from_cstr(__s6_52.utf8)), 0)
}

test "bytes_index_of: found" {
    let __s7_58: string = "a/b"
    assert_eq(bytes_index_of(bytes_from_cstr(__s7_58.utf8), 47), 1)
}

test "bytes_index_of: not found" {
    let __s8_63: string = "abc"
    assert_eq(bytes_index_of(bytes_from_cstr(__s8_63.utf8), 47), 0 - 1)
}

test "bytes_index_of_from starts at the offset" {
    let __s9_68: string = "a b c"
    let b = bytes_from_cstr(__s9_68.utf8)
    assert_eq(bytes_index_of_from(b, 32, 2), 3)
}

test "bytes_slice extracts a subrange" {
    let __s10_74: string = "GET /x"
    let b = bytes_from_cstr(__s10_74.utf8)
    let path = bytes_slice(b, 4, 6)
    assert_eq(bytes_len(path), 2)
    assert_eq(bytes_get(path, 0), 47)
    assert_eq(bytes_get(path, 1), 120)
}

test "bytes_append_cstr appends a literal" {
    let __s11_83: string = "AB"
    let b = bytes_from_cstr(__s11_83.utf8)
    let __lit0: string = "CD"
    bytes_append_cstr(b, __lit0.utf8)
    assert_eq(bytes_len(b), 4)
    assert_eq(bytes_get(b, 3), 68)
}

test "bytes_append concatenates buffers" {
    let __s12_92: string = "foo"
    let a = bytes_from_cstr(__s12_92.utf8)
    let __lit1: string = "bar"
    bytes_append(a, bytes_from_cstr(__lit1.utf8))
    let __s13_96: string = "foobar"
    assert_eq(bytes_eq(a, bytes_from_cstr(__s13_96.utf8)), 1)
}

test "bytes_append_int: zero" {
    let b = bytes_new()
    bytes_append_int(b, 0)
    let __s14_103: string = "0"
    assert_eq(bytes_eq(b, bytes_from_cstr(__s14_103.utf8)), 1)
}

test "bytes_append_int: multi-digit" {
    let b = bytes_new()
    bytes_append_int(b, 1234)
    let __s15_110: string = "1234"
    assert_eq(bytes_eq(b, bytes_from_cstr(__s15_110.utf8)), 1)
}

test "bytes_from_raw copies a raw region" {
    let mem[2]
    poke8(mem, 65)
    poke8(mem + 1, 66)
    poke8(mem + 2, 67)
    let b = bytes_from_raw(mem, 3)
    let __s16_120: string = "ABC"
    assert_eq(bytes_eq(b, bytes_from_cstr(__s16_120.utf8)), 1)
}

test "bytes_from_str with a literal gives its UTF-8 bytes" {
    let b = bytes_from_str("añb")
    assert_eq(bytes_len(b), 4)
    assert_eq(bytes_get(b, 0), 97)
    assert_eq(bytes_get(b, 1), 195)
    assert_eq(bytes_get(b, 2), 177)
    assert_eq(bytes_get(b, 3), 98)
}

test "bytes_from_str with an empty literal gives an empty buffer" {
    assert_eq(bytes_len(bytes_from_str("")), 0)
}

test "bytes_append_str appends the UTF-8 bytes to an existing buffer" {
    let b = bytes_from_cstr("año".utf8)
    bytes_append_str(b, "ñ")
    assert_eq(bytes_len(b), 6)
    assert_eq(bytes_get(b, 0), 97)
    assert_eq(bytes_get(b, 1), 195)
    assert_eq(bytes_get(b, 2), 177)
    assert_eq(bytes_get(b, 3), 111)
    assert_eq(bytes_get(b, 4), 195)
    assert_eq(bytes_get(b, 5), 177)
}

test "bytes_append_str with an empty literal leaves the buffer untouched" {
    let b = bytes_from_cstr("ok".utf8)
    bytes_append_str(b, "")
    assert_eq(bytes_len(b), 2)
    assert_eq(bytes_get(b, 0), 111)
    assert_eq(bytes_get(b, 1), 107)
}

test "the raw-pointer entry points still work" {
    let b = bytes_from_cstr("xño".utf8)
    bytes_append_cstr(b, "_z".utf8)
    assert_eq(bytes_len(b), 6)
    assert_eq(bytes_get(b, 0), 120)
    assert_eq(bytes_get(b, 1), 195)
    assert_eq(bytes_get(b, 2), 177)
    assert_eq(bytes_get(b, 3), 111)
    assert_eq(bytes_get(b, 4), 95)
    assert_eq(bytes_get(b, 5), 122)
}

test "bytes_from_str with a variable gives the same UTF-8 bytes as the literal" {
    let s: string = "añb"
    let b = bytes_from_str(s)
    assert_eq(bytes_len(b), 4)
    assert_eq(bytes_get(b, 0), 97)
    assert_eq(bytes_get(b, 1), 195)
    assert_eq(bytes_get(b, 2), 177)
    assert_eq(bytes_get(b, 3), 98)
}
