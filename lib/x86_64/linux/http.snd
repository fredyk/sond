//
// Minimal HTTP/1.x request parsing over the byte buffer, the application layer that will
// sit on top of the TCP wrappers (lib/x86_64/linux/net.snd) toward the HTTPS litmus test.
// A request buffer looks like `METHOD SP PATH SP HTTP/1.1 CRLF headers... CRLF CRLF`.

include "x86_64/linux/bytes.snd"
include "x86_64/linux/map.snd"

// The request METHOD: the bytes before the first space of the request line.
pub fn http_method(req: i64) -> i64 {
    let sp = bytes_index_of(req, 32)
    bytes_slice(req, 0, sp)
}

// The request PATH: the bytes between the first and second space of the request line, with any
// `?query` stripped, routing keys on the path alone, and the query string is free for callers to
// use as a cache-buster (e.g. ?v=<content-hash>) without breaking a path-safety check.
pub fn http_path(req: i64) -> i64 {
    let sp1 = bytes_index_of(req, 32)
    let sp2 = bytes_index_of_from(req, 32, sp1 + 1)
    let q = bytes_index_of_from(req, 63, sp1 + 1)      // '?'
    let mut end = sp2
    if q >= 0 && q < sp2 { end = q }
    bytes_slice(req, sp1 + 1, end)
}

// Build a complete HTTP/1.1 response buffer: status line + Content-Length + body.
// `status` is a cstr like "200 OK"; `body` is a byte buffer.
pub fn http_response(status: i64, body: i64) -> i64 {
    let r = bytes_new()
    bytes_append_cstr(r, cstr("HTTP/1.1 "))
    bytes_append_cstr(r, status)
    bytes_append_cstr(r, cstr("\r\nContent-Length: "))
    bytes_append_int(r, bytes_len(body))
    bytes_append_cstr(r, cstr("\r\n\r\n"))
    bytes_append(r, body)
    r
}

// Parse the request's headers into a map of name -> value (both byte buffers). Assumes the
// standard `Name: value CRLF` shape; stops at the blank line that ends the header block.
pub fn http_headers(req: i64) -> i64 {
    let h = map_new()
    let n = bytes_len(req)
    let mut cur = bytes_index_of(req, 13) + 2      // skip the request line's CRLF
    for cur < n {
        let line_end = bytes_index_of_from(req, 13, cur)
        if line_end == cur {
            return h                                // blank line: end of headers
        }
        let colon = bytes_index_of_from(req, 58, cur)
        map_set(h, bytes_slice(req, cur, colon), bytes_slice(req, colon + 2, line_end))
        cur = line_end + 2
    }
    h
}
