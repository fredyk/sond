// Tests for lib/compiler/lexer.snd

include "lexer.snd"
include "x86_64/linux/testing.snd"

fn tok_count(toks: i64) -> i64 { vec_len(toks) / 2 }
fn tok_kind(toks: i64, i: i64) -> i64 { vec_get(toks, i * 2) }
fn tok_val(toks: i64, i: i64) -> i64 { vec_get(toks, i * 2 + 1) }

// --- Numeric & value-carrying tokens ---

test "integer 42" {
    let b = bytes_new()
    bytes_push(b, 52)
    bytes_push(b, 50)
    let t = tokenize(b)
    assert_eq(tok_count(t), 1)
    assert_eq(tok_kind(t, 0), 0)     // TK_INT
    assert_eq(tok_val(t, 0), 42)
}

test "hex 0x3F" {
    let b = bytes_new()
    bytes_push(b, 48)
    bytes_push(b, 120)
    bytes_push(b, 51)
    bytes_push(b, 70)
    let t = tokenize(b)
    assert_eq(tok_count(t), 1)
    assert_eq(tok_kind(t, 0), 0)  // TK_INT
    assert_eq(tok_val(t, 0), 63)  // 3*16+15
}

test "decimal 3.14" {
    let b = bytes_new()
    bytes_push(b, 51)
    bytes_push(b, 46)
    bytes_push(b, 49)
    bytes_push(b, 52)
    let t = tokenize(b)
    assert_eq(tok_count(t), 1)
    assert_eq(tok_kind(t, 0), 1)  // TK_DECIMAL
}

test "string hello" {
    let b = bytes_new()
    bytes_push(b, 34)
    bytes_push(b, 104)
    bytes_push(b, 101)
    bytes_push(b, 108)
    bytes_push(b, 108)
    bytes_push(b, 111)
    bytes_push(b, 34)
    let t = tokenize(b)
    assert_eq(tok_count(t), 1)
    assert_eq(tok_kind(t, 0), 2)    // TK_STR
    assert_ne(tok_val(t, 0), 0)     // bytes handle is non-zero
}

test "string with escape newline" {
    let b = bytes_new()
    bytes_push(b, 34)
    bytes_push(b, 104)
    bytes_push(b, 92)
    bytes_push(b, 110)
    bytes_push(b, 101)
    bytes_push(b, 114)
    bytes_push(b, 34)
    let t = tokenize(b)
    assert_eq(tok_count(t), 1)
    assert_eq(tok_kind(t, 0), 2)  // TK_STR
    let s = tok_val(t, 0)
    assert_eq(bytes_get(s, 0), 104)  // h
    assert_eq(bytes_get(s, 1), 10)   // \n
    assert_eq(bytes_get(s, 2), 101)  // e
    assert_eq(bytes_get(s, 3), 114)  // r
    assert_eq(bytes_len(s), 4)       // h + \n + er
}

test "char literal X" {
    let b = bytes_new()
    bytes_push(b, 39)
    bytes_push(b, 88)
    bytes_push(b, 39)
    let t = tokenize(b)
    assert_eq(tok_count(t), 1)
    assert_eq(tok_kind(t, 0), 0)      // TK_INT
    assert_eq(tok_val(t, 0), 88)
}

test "char escape newline" {
    let b = bytes_new()
    bytes_push(b, 39)
    bytes_push(b, 92)
    bytes_push(b, 110)
    bytes_push(b, 39)
    let t = tokenize(b)
    assert_eq(tok_count(t), 1)
    assert_eq(tok_val(t, 0), 10)
}

test "bool true" {
    let b = bytes_new()
    bytes_push(b, 116)
    bytes_push(b, 114)
