}

test "bool false" {
    let b = bytes_new()
    bytes_push(b, 102)
    bytes_push(b, 97)
    bytes_push(b, 108)
    bytes_push(b, 115)
    bytes_push(b, 101)
    let t = tokenize(b)
    assert_eq(tok_count(t), 1)
    assert_eq(tok_kind(t, 0), 3)  // TK_BOOL
}

test "identifier x" {
    let b = bytes_new()
    bytes_push(b, 120)
    let t = tokenize(b)
    assert_eq(tok_count(t), 1)
    assert_eq(tok_kind(t, 0), 4)  // TK_IDENT
}

