}

test "char literal escape double quote" {
    let a[4] = ['\'', '\\', '"', '\'']
    let t = tokenize_arr(a, 4)
    assert_eq(tok_val(t, 0), 34)
}

test "char literal unknown escape returns the raw code" {
    let a[4] = ['\'', '\\', 'q', '\'']
    let t = tokenize_arr(a, 4)
    assert_eq(tok_val(t, 0), 113)  // 'q'
