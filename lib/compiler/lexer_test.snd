// --- Helpers for building source buffers from arrays of char literals ---
// (top-level fn in a *_test.snd file: does not count against the coverage
// denominator, only the included lexer.snd does, so use freely)

fn push_arr(b: i64, arr: i64, n: i64) {
    let mut i = 0
    for i < n {
        bytes_push(b, arr[i])
        i = i + 1
    }
}

fn tokenize_arr(arr: i64, n: i64) -> i64 {
    let b = bytes_new()
    push_arr(b, arr, n)
    tokenize(b)
}

// --- Ported from compiler/src/lexer_tests.rs: hex literals ---

test "hex 0xff followed by identifier (lexer_tests::tokenizes_a_hex_literal)" {
    let a[5] = ['0', 'x', 'f', 'f', 'z']
    let t = tokenize_arr(a, 5)
    assert_eq(tok_count(t), 2)
    assert_eq(tok_kind(t, 0), 0)    // TK_INT
    assert_eq(tok_val(t, 0), 255)
    assert_eq(tok_kind(t, 1), 4)    // TK_IDENT ('z' is not part of the hex run)
}

test "hex full 64-bit mask wraps to -1 (lexer_tests::tokenizes_a_hex_literal)" {
    let a[18] = ['0', 'x', 'F', 'F', 'F', 'F', 'F', 'F', 'F', 'F', 'F', 'F', 'F', 'F', 'F', 'F', 'F', 'F']
    let t = tokenize_arr(a, 18)
    assert_eq(tok_count(t), 1)
    assert_eq(tok_kind(t, 0), 0)
    assert_eq(tok_val(t, 0), -1)
}

test "hex mixed-zero mask (lexer_tests::tokenizes_a_hex_literal)" {
    let a[18] = ['0', 'x', '0', '0', '0', 'F', 'F', 'F', 'F', 'F', 'F', 'F', 'F', 'F', 'F', '0', '0', '0']
    let t = tokenize_arr(a, 18)
    assert_eq(tok_count(t), 1)
    assert_eq(tok_val(t, 0), 0x000FFFFFFFFFF000)
}

// DISCREPANCY vs compiler/src/lexer.rs: Rust accepts BOTH `0x` and `0X` as the hex
// prefix (`matches!(ahead.peek(), Some('x') | Some('X'))`). lexer.snd's tokenize only
// checks for lowercase 'x' (byte 120): "0X10" is NOT recognized as hex at all, and is
// instead lexed as TK_INT(0) followed by TK_IDENT("X10"). This test encodes the
// CORRECT (Rust) behavior and is expected to FAIL against the current lexer.snd.
test "hex 0X10 uppercase prefix (DISCREPANCY: lexer.snd ignores uppercase X)" {
    let a[4] = ['0', 'X', '1', '0']
    let t = tokenize_arr(a, 4)
    assert_eq(tok_count(t), 1)
    assert_eq(tok_kind(t, 0), 0)    // TK_INT
    assert_eq(tok_val(t, 0), 16)
}

test "int followed by dot and non-digit is not a decimal (lexer_tests-inspired)" {
    let a[6] = ['4', '2', '.', 'f', 'o', 'o']
    let t = tokenize_arr(a, 6)
    assert_eq(tok_count(t), 3)
    assert_eq(tok_kind(t, 0), 0)    // TK_INT 42
    assert_eq(tok_val(t, 0), 42)
    assert_eq(tok_kind(t, 1), 34)   // TK_DOT
    let __f0_515: string = "foo"
    assert_eq(tok_kind(t, 2), 4)    // TK_IDENT __f0_515.utf8
}

// --- Ported from compiler/src/lexer_tests.rs: skips_whitespace ---

test "skips whitespace without newline (lexer_tests::skips_whitespace)" {
    let a[7] = [' ', ' ', '4', '2', '\t', ' ', '7']
    let t = tokenize_arr(a, 7)
    assert_eq(tok_count(t), 2)
    assert_eq(tok_kind(t, 0), 0)
    assert_eq(tok_val(t, 0), 42)
    assert_eq(tok_kind(t, 1), 0)
    assert_eq(tok_val(t, 1), 7)
}

test "bare carriage return is plain whitespace, no semicolon" {
    let a[3] = ['5', '\r', '6']
    let t = tokenize_arr(a, 3)
    assert_eq(tok_count(t), 2)
    assert_eq(tok_val(t, 0), 5)
    assert_eq(tok_val(t, 1), 6)
}

// --- Ported from compiler/src/lexer_tests.rs: tokenizes_string_escapes ---

test "string escape tab" {
    let a[6] = ['"', 'x', '\\', 't', 'y', '"']
    let t = tokenize_arr(a, 6)
    assert_eq(tok_count(t), 1)
    let s = tok_val(t, 0)
    assert_eq(bytes_len(s), 3)
    assert_eq(bytes_get(s, 0), 120)  // x
    assert_eq(bytes_get(s, 1), 9)    // \t
    assert_eq(bytes_get(s, 2), 121)  // y
}

test "string escape carriage return" {
    let a[6] = ['"', 'x', '\\', 'r', 'y', '"']
    let t = tokenize_arr(a, 6)
    let s = tok_val(t, 0)
    assert_eq(bytes_get(s, 1), 13)   // \r
}

test "string escape nul" {
    let a[6] = ['"', 'x', '\\', '0', 'y', '"']
    let t = tokenize_arr(a, 6)
    let s = tok_val(t, 0)
    assert_eq(bytes_len(s), 3)
    assert_eq(bytes_get(s, 1), 0)    // \0
}

test "string escape backslash" {
    let a[6] = ['"', 'x', '\\', '\\', 'y', '"']
    let t = tokenize_arr(a, 6)
    let s = tok_val(t, 0)
    assert_eq(bytes_get(s, 1), 92)   // \\
}

test "string escape double quote" {
    let a[6] = ['"', 'x', '\\', '"', 'y', '"']
    let t = tokenize_arr(a, 6)
    let s = tok_val(t, 0)
    assert_eq(bytes_get(s, 1), 34)   // \"
}

test "string escape single quote" {
    let a[6] = ['"', 'x', '\\', '\'', 'y', '"']
    let t = tokenize_arr(a, 6)
    let s = tok_val(t, 0)
    assert_eq(bytes_get(s, 1), 39)   // \'
}

test "string unknown escape falls back to the raw character" {
    let a[6] = ['"', 'x', '\\', 'q', 'y', '"']
    let t = tokenize_arr(a, 6)
    let s = tok_val(t, 0)
    assert_eq(bytes_len(s), 3)
    assert_eq(bytes_get(s, 1), 113)  // 'q', backslash just dropped
}

// --- Ported from compiler/src/lexer_tests.rs: tokenizes_a_char_literal ---

test "char literal digit zero (lexer_tests::tokenizes_a_char_literal)" {
