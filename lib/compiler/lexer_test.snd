    assert_eq(tok_val(t, 0), 0)
}

test "char literal escape backslash" {
    let a[4] = ['\'', '\\', '\\', '\'']
    let t = tokenize_arr(a, 4)
    assert_eq(tok_val(t, 0), 92)
}

test "char literal escape single quote" {
    let a[4] = ['\'', '\\', '\'', '\'']
