// Copyright 2026 Jhon Magdalena Vila and the Sond contributors
//
// lib/pic/16F/684/serial.snd — the Serial interface, implemented for the PIC16F684
// as a bit-banged 9600 8N1 UART WRITTEN IN SOND (not a backend intrinsic).
//
// TX = RA0, RX = RA1. The whole physical layer is expressed with the generic
// backend primitives — poke8/peek8 (register I/O), delay_loop (calibrated busy
// wait), a `break`-terminated poll, and constant shifts — so it is ordinary,
// verifiable Sond, checked against the Serial interface contract. Nothing UART-shaped
// lives in the compiler.
//
// Register addresses must be literals (the backend folds only literal constants):
//   OSCCON 0x8F  CMCON0 0x19  TRISA 0x85  PORTA 0x05
// The delay_loop counts (8 ~= half a bit, 16 ~= one bit at 8 MHz/9600) are a
// starting point — CALIBRATE on real hardware, exactly like BITDLY before.

include "any/serial.snd"

impl Serial for pic16 {
    fn serial_init() {
        poke8(0x8F, 0x70)   // OSCCON: IRCF=111 -> 8 MHz internal oscillator
        poke8(0x19, 0x07)   // CMCON0: comparators off -> RA1 is a digital input
        poke8(0x85, 0x3E)   // TRISA: RA0 output (TX), RA1..RA5 input
        poke8(0x05, 0x01)   // PORTA: idle the TX line high
    }

    fn serial_getc() -> u8 {
        // Wait for the start bit: poll RA1 until it goes low.
        for {
            if (peek8(0x05) & 2) == 0 { break }
        }
        delay_loop(8)                       // ~half a bit: move to the bit centre
        let mut b = 0
        let mut i = 0
        for i < 8 {
            delay_loop(16)                  // advance ~one bit to the next centre
            let bit = (peek8(0x05) >> 1) & 1 // sample RA1 -> 0/1
            b = (b >> 1) | (bit << 7)       // shift it in, LSB first (rrf-style)
            i = i + 1
        }
        delay_loop(16)                      // step over the stop bit
        b
    }

    fn serial_putc(b: u8) {
        poke8(0x05, 0)                      // start bit (RA0 low)
        delay_loop(16)
        let mut x = b
        let mut i = 0
        for i < 8 {
            poke8(0x05, x & 1)             // drive the data bit (LSB) on RA0
            delay_loop(16)
            x = x >> 1                      // next bit
            i = i + 1
        }
        poke8(0x05, 1)                      // stop bit (RA0 high)
        delay_loop(16)
    }
}
